theorem qcoreLocal : QCoreLocalStatement := by
  intro hLD hQL K K₁ V _ _ _ _ _ _ _ _ _ _ M hM hspan W θ hθ c hc be s hbe hs hint
  refine ⟨LocalQuotientRank.detCT_ne_zero (M := M) (hM := hM) (hspan := hspan) (W := W)
