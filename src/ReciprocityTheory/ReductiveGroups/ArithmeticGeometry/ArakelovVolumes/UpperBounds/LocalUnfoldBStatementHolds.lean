  refine ⟨ρ0, hρ0, fun ρ hρ hρle => ?_⟩
  have hbcl : Metric.ball (0 : V (nd X)) ρ ⊆ Metric.closedBall 0 ρ0 := fun z hz =>
    Metric.ball_subset_closedBall (Metric.ball_subset_ball hρle hz)
