    simp [lact, rmul, mat, cpt, hn]
    change x1 τ a c = ((Matrix.of (x1 τ) * (1 : Matrix (Fin r) (Fin r) ℂ)) *
      (1 : Matrix (Fin r) (Fin r) ℂ)) a c
    rw [Matrix.mul_one, Matrix.mul_one]
    rfl

