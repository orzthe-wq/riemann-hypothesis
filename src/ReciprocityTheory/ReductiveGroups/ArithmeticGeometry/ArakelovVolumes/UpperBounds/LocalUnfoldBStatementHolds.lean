    refine ⟨?_, fun a c hca => ?_⟩
    · show Matrix.det (1 : Matrix (Fin r) (Fin r) ℂ) ≠ 0
      simp
    · show (1 : Matrix (Fin r) (Fin r) ℂ) a c = 0
      exact Matrix.one_apply_ne (ne_of_lt hca).symm
