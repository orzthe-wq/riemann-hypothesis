      · exact Or.inl (hclosed z hz hc)
      · exact Or.inr hc
    rcases hUc.subset_or_subset hWopen isClosed_closure.isOpen_compl hdisj hcover with h | h
    · obtain ⟨z1, hz1U, hz1⟩ := hg0
      exact absurd (Filter.Eventually.self_of_nhds (h hz1U)) hz1
    · intro z hz hev
