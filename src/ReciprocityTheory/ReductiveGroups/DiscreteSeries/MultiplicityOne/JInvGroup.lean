    intro x; funext i j
    change gbar k r γ (gbar k r γ (Matrix.of x)) i j = x i j
    rw [InvGrp.gbar_gbar hE]; rfl
  have hl : ∀ U : Set (Mat k r), (∀ a ∈ U, gbar k r γ a ∈ U) →
      ∀ a ∈ U, ∃ b ∈ U, ∀ x, lmulM a (gb x) = gb (lmulM b x) := by
    intro U hU a ha
    refine ⟨gbar k r γ a, hU a ha, fun x => ?_⟩
    funext i j
