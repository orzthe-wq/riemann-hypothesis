theorem stInvGroup (h : UnitaryGroupStructuralFacts) : StInvGroup := by
  obtain ⟨hB2, -, -, -, hUWb, -⟩ := h
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hHU, hHI, -, hCG, hCN, hCW, -⟩ := hB2
