  rw [mul_smul, h, Finset.sum_comm, Finset.smul_sum]
  unfold Capelli.nnMinus
  simp_rw [Finset.smul_sum, smul_smul]
  refine Finset.sum_congr rfl fun d _ => Finset.sum_congr rfl fun c _ => ?_
  congr 1
  rw [add_comm (c : ℕ)]
  ring

