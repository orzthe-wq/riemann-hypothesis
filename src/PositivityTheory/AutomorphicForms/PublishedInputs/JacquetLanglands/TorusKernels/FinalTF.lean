    exact (hE4b' p).2.2
  have hf_bdd : ∀ f : D.M k, ∃ C, ∀ y : D.Y, ‖f.1 (y.2, D.rep y.1)‖ * nrm k y.2 ≤ C := by
    intro f
    obtain ⟨C, hC⟩ := ((hM f.1).1 f.2).bdd
    exact ⟨C, fun y => hC _ _⟩
  have hrep : ∀ (f : D.M k) p, ∫ y, (K y).1 p * f.1 (y.2, D.rep y.1) ∂ν = f.1 p := by
