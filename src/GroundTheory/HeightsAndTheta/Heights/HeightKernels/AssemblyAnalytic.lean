theorem HadamardPSD.proof : HadamardPSD.Statement := by
  intro n A hA
  by_cases h : ∃ i, A i i = 0
  · obtain ⟨i, hi⟩ := h
    rw [HadamardPSDAux.det_eq_zero_of_diag_eq_zero hA hi, norm_zero]
