    nlinarith [Real.pi_pos]
  have hsum : ∑ μ ∈ T, Real.exp (-π * ‖(μ : EuclideanSpace ℝ (Fin n))‖ ^ 2) ≤
      (T.card : ℝ) * Real.exp (-π * (m : ℝ) ^ 2) := by
    have h := Finset.sum_le_sum hterm
    rwa [Finset.sum_const, nsmul_eq_mul] at h
