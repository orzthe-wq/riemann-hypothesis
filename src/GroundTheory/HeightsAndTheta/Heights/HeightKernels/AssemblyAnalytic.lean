  refine det_eq_zero_of_column_eq_zero i fun k => ?_
  simpa using congrFun hcol k

theorem le_of_diag_pos {n : ℕ} {A : Matrix (Fin n) (Fin n) ℂ} (hA : A.PosSemidef)
