      exact h ⟨⟨p.1, fun j => BlockImageChi.backQ d₀.k₀ M (p.2 j)⟩, BlockImageChi.isSecBasisM_back hIm hp⟩
    unfold blockChi resChi
    rw [dite_eq_right h, dite_eq_right h']

end

