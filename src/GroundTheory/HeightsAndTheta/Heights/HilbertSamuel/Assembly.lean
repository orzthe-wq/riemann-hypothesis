theorem pairVal_eq (m : ConeMetric ℂ (Ix κ)) (n : ℕ) (b b' : MvPolynomial (Ix κ) ℚ) (z : Ix κ → ℂ) :
    pairVal m n b b' z = starRingEnd ℂ (secFun b' z) * secFun b z * (wgt m n z : ℂ) := by
  simp only [pairVal, secFun, wgt, div_eq_mul_inv]
  push_cast
