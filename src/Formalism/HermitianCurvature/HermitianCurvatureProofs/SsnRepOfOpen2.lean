  · rw [Finset.sum_insert hat, Finset.sum_insert hat]
    exact _root_.Formalism.FourierDecayAlt.P.CutMP.Gauge.GC.intw_add hsm (h a (Finset.mem_insert_self a t)) (ih fun i hi => h i (Finset.mem_insert_of_mem hi))

