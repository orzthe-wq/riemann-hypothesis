    rw [← hF0, ← hFa] at h2
    omega
  have hrange : ∀ f, φ f ∈ Aq := fun f => Submodule.mem_map_of_mem (hLK f).1
  refine ⟨fun lenO cc A => ?_, fun hm0 f => ?_⟩
  · let φA : ↥A →+ (T.V ⊗[Qp] BdR) ⧸ F0 := φ.comp A.subtype.toAddMonoidHom
