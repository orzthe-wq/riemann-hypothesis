  have hfd := Formalism.MainNotions.N.Pv.LocalLengthBound.rk_fd_letter₂ W hS c
  have hT₂ : IsCrys PD T₂.ρ := hS.2.2.2.2.2.1.2.1
  have hev : (c.val + d) % 2 = 0 := by simpa [evens] using hc
