    Ring.mul_inverse_cancel _ hU, one_pow, one_smul]

theorem delta_fixes_cocycle_second (x : ↥(W.wachCocyclesDelta T)) (δ : W.Gam) (hδ : δ ∈ W.DelF) :
    W.γD T δ (x : W.DD T × W.DD T).2 = (x : W.DD T × W.DD T).2 := by
