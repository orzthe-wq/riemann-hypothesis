      rw [map_sub, ← hI]; exact Ideal.Quotient.eq.mp hab
    exact sub_eq_zero.mp (Formalism.MainNotions.N.FrobeniusPowerSeries.LTB.uniq hxm h')
  have hsurj : ∀ p : O⟦X⟧, ∃ c : O, Ideal.Quotient.mk I p = Ideal.Quotient.mk I (C c) := by
    intro p
