        exact one_ne_zero)
    have hex := fun 𝔭 => exists_locReps hK hF hs hd S hLfull hLi hM₀ 𝔭
    rw [sum_regroup hK hF hs hd S hLfull hLi hc hs' hn hAfull hAi Z hZL hZn hZA
