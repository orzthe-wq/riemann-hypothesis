      ContinuousAt a (hermOf (Ainf F) σ (gramE σ J Y) hT) ∧
      ∀ T ∈ Ω, gramR (Ainf F) σ J (fun b i => ∑ c, a T c b * ratTup (Ainf F) Y c i) = (T : Matrix _ _ _) := by
