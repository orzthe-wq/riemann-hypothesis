    have h2 : α * (ω₀ / 2) ∉ L.lattice := fun h => hK' _ h ht0 H
    have d1 : ptW 2 L ι W (α * (ω₀ / 2)) + ptW 2 L ι W (α * (ω₀ / 2)) = 0 := by
      rw [← hadd, hzero]
