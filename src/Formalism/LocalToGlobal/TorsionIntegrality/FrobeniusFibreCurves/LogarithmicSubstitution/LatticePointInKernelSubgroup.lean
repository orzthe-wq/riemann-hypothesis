    ⟨Formalism.L2.Th1.B.constantCoeff_fExp h0, (Ser.intS_iff_integral _).2 hI⟩
  refine Ser.oneUnit_of_mul_eq_one hf ?_
  rw [← Formalism.L2.Th1.B.fExp_add h0 h0n, add_neg_cancel]
