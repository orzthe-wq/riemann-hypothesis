variable {E : Type} [Field E] [NumberField E] [StarRing E] (S : Finset (HeightOneSpectrum (𝓞 E))) (p : ℕ) (ϖ : 𝓞 E)
  (hS : ∀ P : HeightOneSpectrum (𝓞 E), (p : 𝓞 E) ∈ P.asIdeal → (P ∈ S ↔ ϖ ∉ P.asIdeal))
