  rw [spMap_spMap_assoc, spMap_spMap_assoc, fst_comp_dualMap]

theorem isEigVec_tr {O : Type} [CommRing O] (act : OAct O G) (f : R →+* R) (hx : x' = spMap f ≫ x) {τ : O →+* R}
