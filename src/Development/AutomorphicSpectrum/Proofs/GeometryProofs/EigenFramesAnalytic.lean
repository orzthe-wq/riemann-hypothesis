    rintro w ⟨b, hb, rfl⟩
    rw [hL] at hb
    exact iota_multi_mem_span_of_mem_span b hb
  · rw [Submodule.span_le, Set.singleton_subset_iff]
    refine Submodule.subset_span ⟨e, fun i => ?_, rfl⟩
    rw [hL]
    exact Submodule.subset_span ⟨i, rfl⟩

