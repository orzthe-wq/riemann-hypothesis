    obtain ⟨ρ, -⟩ := Spec.map_surjective (Spec.map φ ≫ Z.fromSpecStalk (genericPoint Z) ≫ s)
    exact charZero_of_injective_ringHom (R := ℚ) ρ.hom.injective
