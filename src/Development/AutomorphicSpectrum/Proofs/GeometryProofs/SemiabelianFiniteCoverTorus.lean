    Nat.card {x : 𝟙_ (Over (Sp k)) ⟶ G // x ^ 2 = 1} * 2 ^ rk E = 2 ^ (2 * g) := by
  rw [← GlobalTheory.card_torsion_mul_card_toric_torsion k G E g 2 hG dG h2]
  congr 1
  letI := E.addCommGroup
