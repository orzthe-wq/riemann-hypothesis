    · rw [evC_mul_geometry]; exact mul_ne_zero h1 h2
    · rw [_root_.Formalism.L2.Pj.evC_add, evC_mul_geometry, evC_mul_geometry, evC_mul_geometry, ← e1, ← e2]; ring
