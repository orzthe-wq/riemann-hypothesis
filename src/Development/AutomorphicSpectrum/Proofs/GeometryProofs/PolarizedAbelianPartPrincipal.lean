    (LB.pullGen N (fun _ : PUnit => T.q.left) (fun _ => 1) t a.left)
    (LB.pullGen N (fun _ : PUnit => T.q.left) (fun _ => 1) t (snd H G).left)
    (DVR.pullGen_isGen _ _ _ _ ht _) (DVR.pullGen_isGen _ _ _ _ ht _)
