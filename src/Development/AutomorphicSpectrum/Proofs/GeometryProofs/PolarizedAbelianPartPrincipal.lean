theorem unit_eq_char {K : Type} [Field K] [IsAlgClosed K] {X : Type} [AddCommGroup X] [TwoUniqueSums X]
    {G : Over (Sp K)} [GeometricallyIntegral (splitTorus (Sp K) X ⊗ G).hom] (b : 𝟙_ (Over (Sp K)) ⟶ G)
    (ρ : Γ((splitTorus (Sp K) X ⊗ G).left, ⊤)ˣ)
