theorem levi_of_chart {n : ℕ} {Bd : Set ((Σ k, J k) → ℂ)} (χ : SncChart P n Bd) {A : HermLine J}
    (hA : IsSmoothHerm A) {t u : Fin n → ℂ} (ht : t ∈ Metric.ball (0 : Fin n → ℂ) 1) {c c' : K → ℂ}
