  have hℓ0 : t + (0 : ℂ) • u = t := by simp
  have hℓd : HasDerivAt (fun ζ : ℂ => t + ζ • u) u 0 := by
    simpa using ((hasDerivAt_id (0 : ℂ)).smul_const u).const_add t
  have hγ' : AnalyticAt ℂ χ.γ (t + (0 : ℂ) • u) := by rw [hℓ0]; exact hγ
