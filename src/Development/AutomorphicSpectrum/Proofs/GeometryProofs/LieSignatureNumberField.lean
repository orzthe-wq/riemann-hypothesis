theorem exists_weilIs (S : Scheme.{0}) (P : Out.PolAV S) (k : ℕ) (T : Over S) (x y : T ⟶ P.A) (hx : x ^ k = 1)
    (hy : y ^ k = 1) : ∃ c : Γ(T.left, ⊤)ˣ, Out.WeilIs P.A P.L k x y c :=
