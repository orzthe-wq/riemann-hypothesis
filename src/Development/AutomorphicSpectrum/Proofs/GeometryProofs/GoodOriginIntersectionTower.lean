  obtain ⟨d⟩ := GlobalTheory.T.component_data_hodge_first E H D l (Xo l) c Y II K J Ω W Dc Hd S₀ Or z w hw
  obtain ⟨s', hs'⟩ := PhMuFree.exists_smallPart Or d
