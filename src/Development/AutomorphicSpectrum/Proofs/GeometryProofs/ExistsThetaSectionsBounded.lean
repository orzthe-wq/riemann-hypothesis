    intro g hg a θ h
    subst hg
    exact hb _ a θ h
  have hSup : ∀ {g : ℕ} (_ : g = D.g) (a : ArchFrame D.t.PP (emb (σ'.comp (algebraMap L L'))) g) (θ : (Fin g → ℂ) → ℂ),
