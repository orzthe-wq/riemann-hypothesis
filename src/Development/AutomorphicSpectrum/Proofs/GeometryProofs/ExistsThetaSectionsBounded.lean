  exact ⟨s', fun σ' a' => ⟨moveFrame e.cart gw r' (emb_comp σ') a', rfl, rfl, fun v => (Category.assoc _ _ _).symm,
    fun θ => moveFrame_isFn e.cart gw r' (emb_comp σ') a' hs θ⟩⟩

