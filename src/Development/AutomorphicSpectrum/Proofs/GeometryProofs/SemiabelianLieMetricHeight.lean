  refine ⟨r, β.map (dualEquiv e), fun MT hMT B MB hF ε hε σ w => ?_⟩
  letI : Algebra L ℂ := σ.toAlgebra
  let σ' : Lb →+* ℂ := (IsAlgClosed.lift : Lb →ₐ[L] ℂ).toRingHom
  have hσ' : σ'.comp (algebraMap L Lb) = σ := by
    ext a
