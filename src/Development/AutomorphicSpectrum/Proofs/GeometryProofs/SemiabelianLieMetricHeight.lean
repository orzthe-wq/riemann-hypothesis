      intro χ
      have e1 := (_root_.GlobalTheory.CompanionTheory.Ar.TorusPoints.main (Sp L) τ.X (DualNumber L) a0).2.2.2.2.2 (DualNumber ℂ) g1 (MT.pt δ') t' rfl χ
      rw [e1, hMT, hMz]
