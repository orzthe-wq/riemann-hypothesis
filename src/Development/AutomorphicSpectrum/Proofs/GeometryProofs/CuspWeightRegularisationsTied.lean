  | empty => exact ⟨fun _ => 0, analyticAt_const, by simp⟩
  | insert i s hi ih =>
    simp only [Finset.sum_insert hi]
    exact (hf i (Finset.mem_insert_self _ _)).add (ih fun k hk => hf k (Finset.mem_insert_of_mem hk))

