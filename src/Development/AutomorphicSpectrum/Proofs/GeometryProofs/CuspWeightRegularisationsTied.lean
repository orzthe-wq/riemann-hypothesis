theorem cuspW_of_conj (R R' : RiemLat E g Λ) (σ σ' : Ψ → (𝓞 E →+* ℂ))
    (h1 : ∀ I : Submodule (𝓞 E) Λ, IsIsoSub R'.form I ↔ IsIsoSub R.form I)
    (h2 : ∀ I : Submodule (𝓞 E) Λ, IsIsoSub R.form I → ∀ τ, ∀ v ∈ I, ∀ w ∈ I,
