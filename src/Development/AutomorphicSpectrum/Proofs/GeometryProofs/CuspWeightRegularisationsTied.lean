      tendsto_comap.mono_left inf_le_right
    have hid : Tendsto id (𝓝[mcPts P] z ⊓ comap proj (𝓝 xs)) (𝓝 z) :=
      tendsto_id.mono_left (inf_le_left.trans nhdsWithin_le_nhds)
