  · exact forall₄_congr fun v _ w _ => neg_eq_zero
  · exact (congrArg₂ (conjLat R).ip (proj_conjB R.B (σ τ) (R.P v)) (proj_conjB R.B (σ τ) (R.P w))).trans
      (conjLat_ip R _ _)

