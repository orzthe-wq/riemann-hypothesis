    (hfs : ∀ i, f i ∈ modelSmall (o.toTowerOrigin.Or Bn b) (k₀ • u) R₀)
    (hinj : ∀ (v : GlobalTheory.AllWt.Weight Dw) (s : (T.M Bn b).Ω), (∀ i, trOf Rd v (s * f i) = 0) → s = 0)
    (τ : ℕ) (hτ : 0 < τ) {R R' : ℝ} (hR : 0 ≤ R)
