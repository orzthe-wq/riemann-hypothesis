    have h6 := congrArg (fun r : ℝ≥0 => Real.log (r : ℝ)) hvκ
    simp only [NNReal.coe_pow, Real.log_pow] at h6
    rw [← h6, Nat.cast_sub hp.one_le, Nat.cast_one]
