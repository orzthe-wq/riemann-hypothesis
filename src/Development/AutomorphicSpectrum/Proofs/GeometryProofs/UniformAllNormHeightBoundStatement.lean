    have h9 : (0 : ℝ) ≤ if p = 2 then 1 else 0 := by split_ifs <;> norm_num
    simp only [exTwo, GlobalTheory.CovHt.htEx]
    linarith
  rw [abs_div, abs_of_nonneg hG, abs_of_neg hl, div_le_iff₀ (neg_pos.2 hl)]
  have h10 : G ≤ (1 / ((p : ℝ) - 1) + a / n) * (-ℓ) := by
