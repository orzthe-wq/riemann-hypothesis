theorem modelSmall_encard_le [IsGalois ℚ E] (hGv : Top.Given) {r : ℕ} (U : ∀ σ : c.F →+* ℂ, Unf Xo c σ r)
    (h : GenFrEx Xo c) (e : Comp Xo c → Rul Xo c) (hL : CompLaws U h e) (hUn : Ref.UnifAll Xo c) {x : ℝ}
