  set D := Real.log (v (embAt c C s.1 ((δ s.1 : 𝓞 E) : E)))
  set G := Real.log (v (t (some s) : C))
  set a : ℝ := (padicValNat p (discr E).natAbs : ℝ)
  set n : ℝ := (Module.finrank ℚ E : ℝ)
  have ha0 : 0 ≤ a := Nat.cast_nonneg _
