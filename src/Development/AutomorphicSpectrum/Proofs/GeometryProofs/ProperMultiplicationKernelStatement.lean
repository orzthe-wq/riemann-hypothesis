theorem chi_exists (x v : Ov k R ⟶ t.G) (hx : x ≫ f = 1) (hv : v ≫ f' = 1) : ∃ c, Chi w x v c := by
  obtain ⟨u, hu⟩ := pair_exists t.PP.isLB hw hW x v hx hv
