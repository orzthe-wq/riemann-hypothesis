  let _ : Algebra k (Z.presheaf.stalk b) := φ.hom.toAlgebra
  have hφ : Z.fromSpecStalk b ≫ π = spMap (algebraMap k (Z.presheaf.stalk b)) := by
    rw [← Scheme.SpecMap_stalkMap_fromSpecStalk]
