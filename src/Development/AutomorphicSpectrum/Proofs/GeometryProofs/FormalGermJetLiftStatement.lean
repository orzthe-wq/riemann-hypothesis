theorem jet_of_mono {e : Sp k ⟶ Z} {m : ℕ} {x : Sp (Jet k κ m) ⟶ Z} (hu : UnivJet π e x)
    (hxa : spMap ((jetAug : Jet k κ m →ₐ[k] k) : Jet k κ m →+* k) ≫ x = e)
