    (fun U _ h => Finset.prod_congr rfl fun k _ => by rw [cφ_bc])
    (LB.pullGen t.PP.L (cφG t ![jptG t x d y m (0 : Fin 2), jptG t x d y m (1 : Fin 2)]) (cε 2) (e m) (cO f x _ m).left)
