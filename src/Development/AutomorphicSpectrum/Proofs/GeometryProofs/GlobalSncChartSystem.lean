    exact this
  obtain ⟨L, hL, hoff, hon⟩ := _root_.GlobalTheory.CompanionTheory.Ar.lat_glue A.X Ω A.ξ A.Li S₀ (A.dR s) (fun p => A.HT p s) (labelRk D s) (A.Vgen s)
