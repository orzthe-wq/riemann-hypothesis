    induction x using ENat.recTopCoe with
    | top => simp at hnot
    | coe x =>
      have e1 : n ≤ x := by exact_mod_cast hle
      have e2 : ¬ n + 1 ≤ x := by exact_mod_cast hnot
      have : x = n := by omega
      rw [this]

