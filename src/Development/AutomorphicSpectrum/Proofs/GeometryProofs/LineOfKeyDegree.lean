  obtain ⟨C₄, hC₄⟩ := SlopeParameterChoice.full C₁ _ hC₁ hC₂
  refine ⟨max C₄ 0, le_max_right _ _, ?_⟩
  intro E _ _ _ H L _ _ D x hx
