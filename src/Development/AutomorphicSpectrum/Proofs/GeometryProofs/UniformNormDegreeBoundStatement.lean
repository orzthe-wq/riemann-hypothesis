  let Gm : Fin n → Fin (o.toTowerOrigin.Or B b).Fl.deg → GlobalTheory.AllWt.cuspOn U Z (GlobalTheory.AllWt.wtOf Dw v 0) :=
    fun j i => ⟨g j i, hg j i⟩
  have hli' : LinearIndependent ℤ Gm := by
    rw [Fintype.linearIndependent_iff]
    intro a ha
