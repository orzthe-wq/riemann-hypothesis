  intro hRR hG E _ _ _ H Dw l Xo c r U h e hL x hx Y _ T o κ II hC hF hP hT1
  have hgr : ∀ (Z : Comp Xo c) (u : GlobalTheory.AllWt.Weight Dw), (∀ τ, StrictAnti (u τ)) →
