  · rw [h1, h]
    linear_combination d ^ 2 * hq
  · have hu : IsUnit (1 + y * k.eval y) := by
      have := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits (-(y * k.eval y))
        ((IsLocalRing.mem_maximalIdeal _).1 (Submodule.neg_mem _ (Ideal.mul_mem_right _ _ hy)))
