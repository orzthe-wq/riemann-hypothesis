  intro hG E _ _ _ H Dw l Xo c r U h e hCL Y Z u f hf B' la T io e₀ ho y hy hLies hne
  letI := io.toAlgebra
  classical
  obtain ⟨hL, -, -, hAt⟩ := GlobalTheory.Reg.evLaws_genFr_atlas E H Dw l Xo c
  obtain ⟨C, ψ, z₀, t₀, hm, hb⟩ := hAt h T.Fr y.1
