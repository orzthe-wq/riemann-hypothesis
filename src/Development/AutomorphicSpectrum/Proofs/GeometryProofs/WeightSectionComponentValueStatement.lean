    rw [add_sub_cancel_left]
    exact Dvd.dvd.mul_left ((hu.dvd_mul_right).1 this) d

theorem exists_monic {V : Type} [CommRing V] (N : ℕ) [Finite (V ⧸ Ideal.span {(N : V)})] :
