theorem exists_root_adic_complete {V : Type} [CommRing V] (I : Ideal V) [IsAdicComplete I V] (e : V) (he : e ∈ I)
    (q : V[X]) : ∃ y ∈ I, e + y + y ^ 2 * q.eval y = 0 := by
