        by simpa [stdBasis_repr_one] using h ⟨j, 1⟩⟩
    · rintro h ⟨j, a⟩
      fin_cases a
      · simpa [stdBasis_repr_zero] using (h j).1
      · simpa [stdBasis_repr_one] using (h j).2
  have hsq : volume (Complex.reProdIm (Set.Ico (0 : ℝ) 1) (Set.Ico (0 : ℝ) 1)) = 1 := by
