  have hc : 0 ≤ Real.exp (Real.log ((2 * Real.pi) ^ (2 * D.g) * ‖D.B.gramDet σ e‖ ^ 2 / ‖σ k‖) / 8) ^ 2 :=
    by positivity
  refine (pow_left_inj₀ hc hI0 (by norm_num : (4 : ℕ) ≠ 0)).mp ?_
