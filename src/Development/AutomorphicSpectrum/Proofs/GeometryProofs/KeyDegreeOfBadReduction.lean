    unfold IsTanAt
    have e : ((epsIso R).inv ≫ w).left = w.left := by simp [epsIso]
    rw [e]
    exact Eq.trans hw one_left.symm)
  exact ⟨x, by rw [tanVec, hx]; simp⟩

