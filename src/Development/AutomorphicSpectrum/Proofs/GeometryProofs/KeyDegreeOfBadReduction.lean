    simp only [Matrix.of_apply, hS, Matrix.mul_apply, Matrix.transpose_apply]
    rw [he]
    have : ∀ a, e.repr (S (v i)) a = ∑ c, M a c * e.repr (v i) c := fun a => hM (v i) a
    simp only [this, Finset.sum_mul]
