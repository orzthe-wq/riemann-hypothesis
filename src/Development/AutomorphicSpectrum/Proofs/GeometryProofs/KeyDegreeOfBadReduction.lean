    (fun c z w => by simp [smul_dotProduct])
    (fun z w w' => by simp [Matrix.mulVec_add, dotProduct_add])
    (fun c z w => by
      have : star (c • w) = c • star w := by ext j; simp
      rw [this, Matrix.mulVec_smul, dotProduct_smul]
      simp)

