  | 0, f => by simp [tanVec, M.pt_zero]
  | n + 1, f => by
    rw [List.ofFn_succ, List.prod_cons, prod_ofFn_tanVec M, Fin.sum_univ_succ]
    simp only [tanVec, M.add, MonObj.comp_mul]

