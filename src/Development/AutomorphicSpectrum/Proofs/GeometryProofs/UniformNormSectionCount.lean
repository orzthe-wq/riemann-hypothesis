    obtain ⟨N₁, p₁, m₁⟩ := hx
    obtain ⟨N₂, p₂, m₂⟩ := hz
    refine ⟨N₁ * N₂, Nat.mul_pos p₁ p₂, ?_⟩
    have e : ((N₁ * N₂ : ℕ) : Ω) * (x + z) = (N₂ : Ω) * ((N₁ : Ω) * x) + (N₁ : Ω) * ((N₂ : Ω) * z) := by
      push_cast
      ring
    rw [e]
    exact add_mem (mul_mem (natCast_mem _ _) m₁) (mul_mem (natCast_mem _ _) m₂)
  | mul x z _ _ hx hz =>
    obtain ⟨N₁, p₁, m₁⟩ := hx
    obtain ⟨N₂, p₂, m₂⟩ := hz
