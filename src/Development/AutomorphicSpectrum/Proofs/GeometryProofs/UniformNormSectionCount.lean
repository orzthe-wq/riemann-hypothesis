  obtain ⟨c, hc, rfl⟩ := h
  simp only []
  ring

theorem orbit_of_cross {u w : (Σ k, ι k) → ℂ} (hu : ∀ k, ∃ i, u ⟨k, i⟩ ≠ 0)
