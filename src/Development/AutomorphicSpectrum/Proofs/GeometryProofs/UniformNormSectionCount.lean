    have h : (q.den : Ω) * algebraMap ℚ Ω q = (q.num : Ω) := by
      have h' := congrArg (algebraMap ℚ Ω) (Rat.den_mul_eq_num q)
      rw [map_mul, map_natCast, map_intCast] at h'
      exact h'
    rw [h]
    exact intCast_mem _ _
