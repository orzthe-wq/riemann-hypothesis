theorem facts_of_restrict (D : LieLatticeData Ω F n Sg r s) (R : Subalgebra O' Ω) (p : ℕ) (w : Ω) (χ : Sg → F → Ω)
    (φ : Equiv.Perm Sg) (h : D.Facts (R.restrictScalars O) p w χ φ) : D.Facts R p w χ φ :=
