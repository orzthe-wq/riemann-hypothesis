        (tail R.Yo R.r (Real.exp 1)).indicator (fun x => Real.log (R.r x)) ((A.chart j).symm y)) *
          locDens A Φ j y := mul_le_mul_of_nonneg_right key hd
    _ = _ := by ring

end GlobalTheory.CompanionTheory.Ar.Giv.Conv

