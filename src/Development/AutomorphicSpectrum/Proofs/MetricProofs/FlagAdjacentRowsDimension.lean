theorem an_chart_comp {D D' : ℕ} {Y X : Type} [TopologicalSpace Y] [TopologicalSpace X] (B : FinHolAtlas D Y)
    (A : FinHolAtlas D' X) {f : Y → X} (hf : HoloMap B A f) (hV : IsOpen V) {g : (Fin e → ℂ) → Y}
