    (∀ sg, m (ComplexEmbedding.conjugate sg) = m sg) →
    (∀ θ : (𝓞 F)ˣ, ∑ sg : F →+* ℂ, Real.log ‖sg ((θ : 𝓞 F) : F)‖ * m sg = 0) →
    ∀ sg sg', m sg = m sg' := by
