theorem log_eval_smul {g : MRing ι} {dg : K → ℕ} (hg : IsMultiHomog g dg) (c : K → ℂ) (hc : ∀ k, c k ≠ 0)
    {z : (Σ k, ι k) → ℂ} (h0 : eval z (map (Int.castRingHom ℂ) g) ≠ 0) :
