  Real.log ‖eval z (map (Int.castRingHom ℂ) g)‖ - Real.log ‖eval z (map (Int.castRingHom ℂ) h)‖ +
    (1 / 2) * ∑ p, (xiCoef τ a p : ℝ) * (Real.log ((A p).h (fstPt k₀ z)) + Real.log ((A p).h (sndPt k₀ z)))

