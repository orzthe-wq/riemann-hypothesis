  obtain ⟨τ₀⟩ := ‹Nonempty Ψ›
  obtain ⟨s, hs1, hs2⟩ := exists_maximal_linearIndepOn (𝓞 E) (Subtype.val : T → Λ)
  haveI : Finite T := hT.to_subtype
  let r := Nat.card s
  let e : Fin r ≃ s := (Finite.equivFin s).symm
