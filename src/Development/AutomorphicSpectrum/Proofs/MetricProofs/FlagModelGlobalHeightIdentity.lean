  · rw [form_mem_mCoordIdeal_iff w hd] at h0
    exact div_ne_zero h0 (Finset.prod_ne_zero_iff.2 fun k _ => pow_ne_zero _ (hc k))
  · have hb := inBlockChart_of_inChart hp
    refine ⟨hb, hG _ ?_⟩
