    · obtain ⟨C, t₀, phT, r, c⟩ := hR Rp.A B (potOf Rp (fsHerm (stepIdx M p) fun _ => 1)) _ _ BM.m _ (hA' _ hfs') hΘ'
        pL' sL' nL' hn' hB _ ph' C₅ hsw hgb
