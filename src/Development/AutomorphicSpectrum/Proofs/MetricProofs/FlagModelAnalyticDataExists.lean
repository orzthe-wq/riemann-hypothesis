  obtain ⟨hA', hfs', hΘ'⟩ := GlobalTheory.CompanionTheory.Ar.PB.fs_pos_potential (PartialFlagBlocks M p) (stepIdx M p) _ e' Rp
  obtain ⟨hA, hfs, hΘ⟩ := GlobalTheory.CompanionTheory.Ar.PB.fs_pos_potential K ι _ e R
