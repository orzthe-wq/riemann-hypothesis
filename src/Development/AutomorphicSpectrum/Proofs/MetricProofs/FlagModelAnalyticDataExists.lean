  obtain ⟨ph', C₅, hw1, -, hsw, hgb⟩ := _root_.GlobalTheory.CompanionTheory.Ar.PB.stepWeight_exists K ι Φ y Ψ N j M n e BM p (PartialFlagBlocks M p) (stepIdx M p)
