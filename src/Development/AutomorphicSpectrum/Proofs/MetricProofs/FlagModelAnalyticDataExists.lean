  obtain ⟨C', t₀', h1, h2, h3⟩ := hP Rp.A R.A h hh (potOf Rp (fsHerm (stepIdx M p) fun _ => 1)) _
    (potOf R (fsHerm ι fun _ => 1)) _ BM.m _ BM.m _ (hA' _ hfs') hΘ' (hA _ hfs) hΘ pL' sL' nL' hn' nL _ ph₂ phT₂ C₅₂ C t₀
    s2 r2 c2
