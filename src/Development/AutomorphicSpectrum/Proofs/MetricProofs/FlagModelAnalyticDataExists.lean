    (hDc.norm ℝ hne).log (norm_ne_zero_iff.2 hne)
  have hφc : ContDiffAt ℝ 2 (fun y => φ (ψ.symm y)) (ψ x₀) :=
    (((hφ i).contDiffAt ((ψ.isOpen_inter_preimage_symm hW).mem_nhds hmem))).of_le (WithTop.coe_le_coe.2 (le_top : (2 : ℕ∞) ≤ ⊤))
