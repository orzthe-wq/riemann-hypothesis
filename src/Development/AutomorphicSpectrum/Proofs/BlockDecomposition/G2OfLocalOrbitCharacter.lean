        rw [hunit]
        have h1 := GlobalTheory.T.unitaryHeckeCharCM_splitPlace_mul_conjPlace_eq_one E μ e hμ w u hu huw k
        have h2 : μ.locK w kc = (μ.locK u k)⁻¹ := eq_inv_of_mul_eq_one_right h1
        change ((μ.locK w (k * kc⁻¹) : ℂˣ) : ℂ) = _
