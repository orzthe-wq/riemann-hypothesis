    refine lintegral_congr fun x => ?_
    rw [Subgroup.smul_def, smul_eq_mul]
    exact hinv _ (γ⁻¹).2 x
  simp only [e]
  have hm : ∀ γ : Γ, NullMeasurableSet (γ • U ∩ 𝓕) μ := fun γ =>
    ((hU.const_smul γ).nullMeasurableSet).inter h𝓕.nullMeasurableSet
