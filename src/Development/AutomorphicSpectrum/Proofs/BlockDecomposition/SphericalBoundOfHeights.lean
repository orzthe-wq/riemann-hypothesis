    have hs := _root_.GlobalTheory.ResidueEisenstein.summable_height_rpow_reps _ _ _ _ _ _ _ _ _ _ _ hD T hT 1 (((dblSp A).rank : ℝ) - ((r : ℝ) + 1) + ε) (by linarith)
    have hb := hB ε h0 h1
