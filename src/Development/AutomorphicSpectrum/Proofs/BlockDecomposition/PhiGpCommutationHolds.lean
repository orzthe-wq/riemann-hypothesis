  have e : ∀ h : m + (j + 1) = m + j + 1, mcast h (prodGPn ρ τ) = prodGPn ρ τ := fun _ => rfl
  rw [e]
  unfold phiN prodGPn mtw MRep.phiM GRep.tw
  exact X

end GlobalTheory.CompanionTheory.LeibPhi

