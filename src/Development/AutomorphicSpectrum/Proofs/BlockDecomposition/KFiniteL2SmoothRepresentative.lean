      (infGL E a p.1 * finGL E a p.2)⁻¹) '' ({y : GL (Fin a) (Cinf E) | toL y.val ∈ Kc} ×ˢ
        (U : Set (GL (Fin a) (Af E))))) μ := by
    have := ((measurePreserving_mul_left μ g).integrableOn_comp_preimage
