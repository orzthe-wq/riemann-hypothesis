theorem fderiv_hb_one {β : Lie E a → ℂ} (hβ : ContDiff ℝ ∞ β) (y X : Lie E a) :
    fderiv ℝ (fun q => hb β (q, y)) (oneL E a) X = dTest X β y := by
  have e : (fun q => hb β (q, y)) = β ∘ lmul y := rfl
