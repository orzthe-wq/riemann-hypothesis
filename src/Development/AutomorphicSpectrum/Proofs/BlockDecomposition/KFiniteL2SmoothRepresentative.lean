theorem integrand_eq_zero {U : Subgroup (GL (Fin a) (Af E))} {β : Lie E a → ℂ} {Fl : GA E a → ℂ} {g : GA E a}
    {C : Set (GA E a)} {N : Set (Lie E a)}
    (hC : ∀ v ∉ C, GeneralLinearGroup.map (pFin E) v⁻¹ ∈ U → ∀ x ∈ N, toL (Matrix.of (psi v) * Matrix.of x) ∉ tsupport β)
