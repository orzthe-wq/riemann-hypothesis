    have hl : 0 ≤ Real.log r := Real.log_nonneg hr
    have h1 := hpw ⌈|u|⌉₊ u (Nat.le_ceil _) x
    refine h1.trans (mul_le_mul_of_nonneg_right ?_ (NNReal.coe_nonneg _))
