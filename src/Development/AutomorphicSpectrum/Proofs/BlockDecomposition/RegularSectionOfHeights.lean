theorem dil_exists : ∀ (D : D7) (θ : InfFam D), IsInfFam θ → ∀ (n ρ p : ℕ) (hn : ρ + p = n) (M : Maps D hn),
    ∃ e : ℝ → G D n, Continuous e ∧ (∀ u v, e (u + v) = e u * e v) ∧
      ∀ (u : ℝ) (y y' : Mx D ρ p), (∀ τ i j, compAt θ τ y' i j = (Real.exp u : ℂ) * compAt θ τ y i j) →
