  refine ⟨((qr hσ hJ d (-ci) hc : UJ σ J) : GL n A), SetLike.coe_mem _, ?_⟩
  show qrMat σ J d (-ci) *ᵥ y = y'
  rw [qrMat_mulVec, hdy]
  funext i
  simp only [hd, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, one_mul]
  linear_combination (-(y i - y' i)) * hci

