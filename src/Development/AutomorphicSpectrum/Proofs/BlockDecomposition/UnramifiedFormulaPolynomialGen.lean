theorem inv_mod (ϖ : R) (k : ℕ) {a : ℕ} (N : Matrix (Fin a) (Fin a) R) :
    ∃ h, red ϖ k ((1 + ϖ • N) * h) = 1 ∧ red ϖ k (h * (1 + ϖ • N)) = 1 := by
