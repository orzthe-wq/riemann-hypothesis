theorem twist {σ : R →+* R} {ϖ : R} (hσ : σ ϖ = ϖ) {n : ℕ} {T T' H : Matrix (Fin n) (Fin n) R} {t : R}
    (ht : t + σ t = 1) (hH : cT σ H = H) (e b : ℕ)
