      = T + (ϖ ^ (b + 1) * (1 - t) * ϖ ^ e) • H := by
    rw [add_mul, one_mul, Matrix.smul_mul, Matrix.mul_assoc, h2, Matrix.mul_smul, Matrix.mul_one, smul_smul]
  have e2 : T * (T' * H) = ϖ ^ e • H := by
    rw [← Matrix.mul_assoc, h1, Matrix.smul_mul, Matrix.one_mul]
