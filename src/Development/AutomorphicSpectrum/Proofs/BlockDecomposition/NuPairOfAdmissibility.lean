    have hc : derChar k ψ N (d 0) ⟨_, hw⟩ = whitChar ψ (d 1) ⟨u, hu⟩ := by
      have e : (⟨_, hw⟩ : derUnip k N (d 0)) = ⟨r, unipRad_le_derUnip d h hr⟩ * ⟨_, hs⟩ := rfl
      rw [e, map_mul, derChar_eq_one_of_mem_unipRad d h ψ _ hr, one_mul]
