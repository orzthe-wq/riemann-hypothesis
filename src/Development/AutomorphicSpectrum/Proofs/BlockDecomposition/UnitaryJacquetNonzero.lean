    (hdom : ∀ i j, i < j → ordL (T j j) < ordL (T i i))
    (hB : ∀ i j, j < i → B i j = 0)
    (hg : ∀ a c, R (π a) c * T c c = ∑ x, B a x * I (π' x) c) (m : ℕ) :
    ∑ a : Up n m, ordL (T (π' a.1) (π' a.1)) ≤ ∑ a : Up n m, ordL (T (π a.1) (π a.1)) ∧
