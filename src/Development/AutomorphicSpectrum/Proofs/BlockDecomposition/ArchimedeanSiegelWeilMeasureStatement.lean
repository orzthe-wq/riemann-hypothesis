  rw [h3, map_mul, map_ofNat] at h2
  have h4 : ((2 : NumberField.InfinitePlace F → ℝ) w) = 2 := rfl
  rw [Pi.mul_apply, h4] at h2
  push_cast at h2
  linear_combination (-1 / 2 : ℂ) * h2

