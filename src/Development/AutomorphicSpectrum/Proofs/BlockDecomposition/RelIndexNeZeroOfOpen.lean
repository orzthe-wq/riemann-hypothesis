    apply Subtype.ext
    rw [← QuotientGroup.out_eq' a.1, ← QuotientGroup.out_eq' b.1]
    exact QuotientGroup.eq.2 h2
  haveI : Finite {q : H ⧸ V | q.out ∈ K} := Finite.of_injective _ hinj
  exact Set.toFinite _

