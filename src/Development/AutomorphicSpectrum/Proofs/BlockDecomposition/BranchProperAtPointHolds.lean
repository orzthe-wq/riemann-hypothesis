      IsCompact {x | x ∈ Y ∩ B ∧ A x ∈ C} := by
    intro C hC hCD
    have heq : {x | x ∈ Y ∩ B ∧ A x ∈ C} = (Y ∩ closedBall w r) ∩ A ⁻¹' C := by
      ext x
      constructor
      · rintro ⟨⟨hxY, hxb, -⟩, hxC⟩
