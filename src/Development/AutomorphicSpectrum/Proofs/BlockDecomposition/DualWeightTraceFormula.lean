  have hNs : ∀ i j, j ≤ i → N i j = 0 := by
    intro i j hji
    rcases hji.eq_or_lt with rfl | h
    · simp [hN, h2]
    · simp [hN, h1 i j h, Matrix.one_apply_ne h.ne']
  let G : ℂ → Mat n := fun t => 1 + t • N
  have hGt : ∀ t, (G t).BlockTriangular id := fun t i j hij => by
