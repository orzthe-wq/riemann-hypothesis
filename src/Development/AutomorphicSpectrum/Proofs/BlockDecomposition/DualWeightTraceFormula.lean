    exact GlobalTheory.CompanionTheory.GelfAct.hasDerivAt_exp_entry X a b
  have hentry : ∀ i j, HasDerivAt (fun t : ℝ => Rm ν (NormedSpace.exp ((t : ℂ) • X)) i j) (XA ν X i j) 0 := by
    intro i j
