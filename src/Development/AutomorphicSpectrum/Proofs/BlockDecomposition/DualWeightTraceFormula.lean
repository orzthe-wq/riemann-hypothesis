theorem hasDerivAt_Rm (ν : Fin n → ℤ) (X : Mat n) (γ : ℝ → Matrix.unitaryGroup (Fin n) ℂ)
    (hγ : ∀ t : ℝ, (γ t).1 = NormedSpace.exp ((t : ℂ) • X)) (c : Jd n ν → ℂ) :
