  subst hu
  exact (hs K Z Z Y p (𝟙 Z) u).2.2.2.2.1 V T

theorem inU_biInf (hs : SiteLaws) {Z : Scheme.{0}} (q : Z ⟶ Spec (CommRingCat.of K)) {κ : Type} (V : κ → Z.Opens)
