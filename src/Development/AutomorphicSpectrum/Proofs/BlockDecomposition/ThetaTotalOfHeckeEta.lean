    rw [div_le_iff₀ (by positivity)] at h1
    linarith
  have h2 : (1 + r) + (b * r - a * r ^ 2) ≤ 1 + (1 + b) ^ 2 / (4 * a) := by
    have e : (1 + b) ^ 2 / (4 * a) - ((1 + b) * r - a * r ^ 2) = (1 + b - 2 * a * r) ^ 2 / (4 * a) := by
      field_simp
