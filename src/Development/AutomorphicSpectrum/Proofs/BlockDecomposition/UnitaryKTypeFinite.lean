theorem isCompact_maxCpt : IsCompact (GlobalTheory.LinRed.maxCpt G) := by
  have hbd : GlobalTheory.LinRed.maxCpt G ⊆ Set.pi Set.univ fun _ : Fin n => Set.pi Set.univ fun _ : Fin n =>
