    exact ⟨⟨k, hk.1⟩, mem_Kc.2 hk.2, ⟨s, hs⟩, ht, Gp.ext hg⟩
  have hPI : ∀ g : Fin (Module.finrank ℂ S ^ 2 + 1) → Gp G, stdPoly E (fun i => homG hσ (g i)) = 0 := fun g =>
