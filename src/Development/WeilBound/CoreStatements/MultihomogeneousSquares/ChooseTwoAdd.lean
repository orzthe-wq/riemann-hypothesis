theorem coordTie_seg_equiv {K₀ K' K : Type} [Fintype K₀] [Fintype K'] [Fintype K] {J₀ : K₀ → Type} {J' : K' → Type}
    {J : K → Type} [∀ k, Fintype (J₀ k)] [∀ k, Fintype (J' k)] (e : K₀ ⊕ K' ≃ K)
