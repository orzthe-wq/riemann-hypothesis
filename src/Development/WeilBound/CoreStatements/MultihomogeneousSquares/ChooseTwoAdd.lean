theorem exists_inChart_minors (hg : IsCptGen ξ) {κ : Type} (x : κ → Ω) (L : Lat ξ E) {m n r : ℕ}
    (V : Submodule Ω E) (φ : Fin n → Module.Dual Ω E) (b : Fin r → E) (hv : L.IsVB r V)
