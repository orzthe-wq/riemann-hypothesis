      have hjE : ∀ n, j (Ee n) = ∑ k, i (y n k) • j (b k) := fun n => by

        simp only [Ee, map_sum]
        exact Finset.sum_congr rfl fun k _ => hj.1 _ _
      show e' = ∑ n, (cc n : Ω') • j (Ee n)
      simp only [hjE, Finset.smul_sum, smul_smul]
