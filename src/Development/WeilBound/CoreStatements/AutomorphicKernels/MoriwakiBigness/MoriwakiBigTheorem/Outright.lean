      ∏ k, y ⟨k, c0 k⟩ ^ (-(β k + c)) := by
    rw [Fintype.prod_sum_type]
    have hu1 : (∏ u : Unit, segreJoin y ⟨Sum.inl u, Kleiman.SectionsOverLocalization.segreChart c0 c0 (Sum.inl u)⟩ ^
        (-D (Sum.inl u))) = (∏ k, y ⟨k, c0 k⟩) ^ (-c) := by
