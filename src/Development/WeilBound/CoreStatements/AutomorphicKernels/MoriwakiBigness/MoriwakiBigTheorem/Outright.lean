    rw [div_le_iff₀ hpos]
    have hmul : (0 : ℝ) ≤ 2 * (C + 1) * n * ((q : ℝ) + 1) := by positivity
    calc smallSectionCount (IsSmallH (mCoordIdeal y) y (HermLine.zcomb A (fsH ι) (↑q) 1))
          (chartLat y (HermLine.zcomb A (fsH ι) (↑q) 1).a) n
