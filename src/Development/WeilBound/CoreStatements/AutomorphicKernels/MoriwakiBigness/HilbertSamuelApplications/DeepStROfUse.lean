  have hd : (0 : ℝ) < |(discr E : ℝ)| := abs_pos.2 (by exact_mod_cast discr_ne_zero E)
  have he : |(discr E : ℝ)| = ((discr E).natAbs : ℝ) := by
    rw [Nat.cast_natAbs, Int.cast_abs]
  rw [hostRd, Real.log_rpow hd, he]
  ring

