theorem sum_padicVal_log {n : ℕ} (hn : n ≠ 0) {S : Finset ℕ} (hS : ∀ p ∈ S, p.Prime) (hsub : n.primeFactors ⊆ S) :
    ∑ p ∈ S, (padicValNat p n : ℝ) * Real.log p = Real.log n := by
