    rw [AugCot.d_mul, hx0, zero_smul, add_zero]
    change _ • dUnit (R := O) x = _
    rw [hu, smul_comm]

theorem exists_of_cotMap_res_eq_zero (G : PDivGroup p O) (n : ℕ) (y : Cot O (G.A (n + 1)))
