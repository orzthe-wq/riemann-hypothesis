  intro k
  simp only [map_add (f := _), Finsupp.add_apply]
  exact add_mem (he k) (he' k)

theorem zero_mem_intE {d : ℕ} (bs : Module.Basis (Fin d) F E) (v : HeightOneSpectrum (𝓞 F)) :
    (0 : Fv F v ⊗[F] E) ∈ intE bs v := by
