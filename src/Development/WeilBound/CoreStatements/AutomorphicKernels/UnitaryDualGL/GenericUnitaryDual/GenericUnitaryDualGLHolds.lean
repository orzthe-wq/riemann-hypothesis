  have hd3 : ∑ j, ((Zc.dualCl (δ j)).nu (((fun j => -s j) j : ℝ) : ℂ)).1 = N := by
    rw [← hd2]; exact congrArg (fun f : Fin h → IrrGL (k := k) => ∑ j, (f j).1) hfun.symm
