    rw [PositivityTheory.Gud.Symm.Pf.segDual_nu hA, PositivityTheory.Gud.Symm.Pf.segDual_segDual hA]; push_cast; rfl
  simp only [r2, neg_neg] at hM2
  exact hM2.symm

