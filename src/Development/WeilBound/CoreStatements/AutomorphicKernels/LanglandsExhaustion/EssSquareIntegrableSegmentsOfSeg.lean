    show Units.mk0 (c t) (hc0 t) = 1 ↔ σ.ρ (Matrix.GeneralLinearGroup.scalar (Fin n) t) v0 = v0
    rw [hc t v0, Units.ext_iff, Units.val_mk0, Units.val_one]
