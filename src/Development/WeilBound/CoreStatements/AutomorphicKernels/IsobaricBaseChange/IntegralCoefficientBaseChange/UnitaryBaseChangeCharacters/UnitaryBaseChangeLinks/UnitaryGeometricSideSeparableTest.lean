  rw [← Phi_mul_transpose n R, Phi_transpose, mul_smul_comm, smul_smul, ← mul_pow]
  simp [PhiU]

theorem PhiU_sq_comm (g : GL (Fin n) R) : g * (PhiU n R * PhiU n R) = (PhiU n R * PhiU n R) * g := by
  apply Units.ext
  rw [Units.val_mul, Units.val_mul _ g, PhiU_sq]
  simp

