  have h := Subgroup.mem_center_iff.1 hz (x'⁻¹ * x * A * y)
  calc B = (x'⁻¹ * x * A * y) * ((x * A * y)⁻¹ * (x' * B * y')) * y'⁻¹ := by group
    _ = ((x * A * y)⁻¹ * (x' * B * y')) * (x'⁻¹ * x * A * y) * y'⁻¹ := by rw [h]
    _ = _ := by simp only [mul_assoc]

