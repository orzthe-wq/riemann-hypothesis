    rintro _ ⟨s, hs', rfl⟩
    refine ⟨δ • (jac (stdBlocks (fun a => (x a).1) hd) π (zj (fun a => (x a).1) t j) s - Λ • s), ⟨?_, ?_⟩, ?_⟩
    · exact S.toSubmodule.smul_mem _ (S.toSubmodule.sub_mem (S.apply_mem_toSubmodule _ hs') (S.toSubmodule.smul_mem _ hs'))
