    Submodule.span ℚ (chartLatNm y a τ : Set Ω) = ⊤ := by
  classical
  rw [eq_top_iff]
  intro s _
  have halg : ∀ x : Ω, IsAlgebraic ℤ x := fun x =>
    (IsFractionRing.isAlgebraic_iff ℤ ℚ Ω).2 (IsAlgebraic.of_finite ℚ x)
