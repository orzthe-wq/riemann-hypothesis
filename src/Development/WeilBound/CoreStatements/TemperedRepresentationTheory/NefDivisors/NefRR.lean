      _ = (|C| * fc) * T ^ d := by ring
      _ ≤ (ε' * T) * T ^ d := mul_le_mul_of_nonneg_right hT (by positivity)
      _ = ε' * T ^ (d + 1) := by ring
  have h3 : (G + ε') * T ^ (d + 1) / fc + ε' * T ^ (d + 1) / fc ≤ (G + ε) * T ^ (d + 1) / fc := by
    rw [← add_div]
    apply div_le_div_of_nonneg_right _ hfc.le
