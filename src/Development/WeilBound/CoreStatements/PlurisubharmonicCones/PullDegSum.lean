  rw [← hw'e, ← hw'e]
  refine ((_root_.GlobalTheory.CompanionTheory.Ar.HodgeUnique.main E H X' X t' t f m z (w' a) (w' c) (w a) (w c) (hww a) (hww c)).1 _).2 ?_
  rw [hwv, hwv]
  exact hI a c

