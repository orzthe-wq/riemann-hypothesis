  obtain ⟨ρM, hρ, -⟩ := lieModel_exists_unique_act _ t'.G (𝓞 L) (𝟙 _) _ MB (𝓞 E) t'.act.act t'.act.hom t'.act.one
    t'.act.mul t'.act.add
