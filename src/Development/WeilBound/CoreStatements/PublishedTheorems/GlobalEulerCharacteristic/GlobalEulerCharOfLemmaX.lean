          Nat.card M ^ InfinitePlace.nrComplexPlaces F) : ℕ) : ℚ) := by
      push_cast
      rw [← Nat.cast_prod, ← key]
      have : (Nat.card (H1 rhoS) : ℚ) ≠ 0 := by exact_mod_cast hh1
      field_simp
      ring
    exact_mod_cast hq

end

