  haveI : Finite (AA hL 1) := finite_gsH1SUnits hL
  have h1 := d.g_eq_zero_of_finite (AA hL 1)
  rw [d.g_eq (AA hL 1)] at h1
  unfold dMod dTors
  exact sub_eq_zero.1 h1

