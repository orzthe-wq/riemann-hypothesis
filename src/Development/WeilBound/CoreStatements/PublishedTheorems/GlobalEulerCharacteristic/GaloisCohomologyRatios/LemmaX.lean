    by_contra h
    exact hℓS v h hv
  have hcard : Nat.card (Rep.res (PP hL).subtype (gsRoots S ℓ)) = ℓ :=
    (Nat.card_congr f.toEquiv).trans (Nat.card_zmod ℓ)
