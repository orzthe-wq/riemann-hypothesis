    (fun v : S => gsFinFamily (S : Set (HeightOneSpectrum (𝓞 K))) ιs ⟨v.1, Finset.mem_coe.2 v.2⟩) ev (fun v => (hevc v).1) (fun v => (hevc v).2) hev rho hc A eM hM
  obtain ⟨E2, Ev2, h2⟩ := resCmp2B e (locFam S Av) (continuous_locFam S Av)
