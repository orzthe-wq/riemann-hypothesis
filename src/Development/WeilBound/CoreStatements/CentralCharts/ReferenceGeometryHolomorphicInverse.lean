  obtain ⟨hA, hfs, hΘ⟩ := fs_pos_potential K J P n R
  obtain ⟨m₁, m₂, -⟩ := enlarging_constants_smooth_members n R.X R.A (potOf R (fsHerm J fun _ => 1)) L s nb m W
    hL hs snc hn (hA _ hfs) hΘ
