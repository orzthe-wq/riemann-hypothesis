  have h2 : 2 ≤ Module.finrank ℚ E := by
    have := IsTotallyComplex.finrank E
    have h0 : 0 < Module.finrank ℚ E := Module.finrank_pos
    omega
  have h3 : 2 * 1 ≤ N * (N - 1) := Nat.mul_le_mul hN (by omega)
  unfold Top.dimFl
  exact Nat.mul_pos (by omega) (by omega)

