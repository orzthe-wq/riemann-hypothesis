        R.lift x ((R.A.chart j).symm v) ⟨k₀, p⟩) (R.A.chart j x)).ker = ⊥) :
    IsPosPot R.A (potOf R (fsHerm J (Pi.single k₀ 1))) := by
  intro x j y hy w hw
