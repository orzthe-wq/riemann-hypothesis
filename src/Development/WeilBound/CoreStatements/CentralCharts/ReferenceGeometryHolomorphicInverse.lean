    {ph : R.X → ℝ} {phT : ℝ → R.X → ℝ} {line : ℝ → HermLine J} {C₅ C t₀ D₅ D T : ℝ}
    (h : IsMember R L s d u cen ph phT line C₅ C t₀) (h₅ : C₅ ≤ D₅) (hD : |C| ≤ D) (hT0 : 0 < T) (hT : T ≤ t₀)
