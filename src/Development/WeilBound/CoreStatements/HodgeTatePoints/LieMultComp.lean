    · exfalso; have : 4 * (s ^ 2 + t ^ 2 + s - n) + 1 = 0 := by linear_combination e
      omega
    · exfalso; have : 4 * (s ^ 2 + t ^ 2 + s + t - n) + 2 = 0 := by linear_combination e
