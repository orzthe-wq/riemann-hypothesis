  let g : IndSp (points (Fin 2)) ((ofChar (torusChar fun i => unrChar k (![b, a] i))).comp
      (leviTorus k (Fin 2)).symm.toMonoidHom) :=
    constInd (parab k (points (Fin 2))) (sB fun i => unrChar k (![b, a] i)) χ hχ 1 hw
