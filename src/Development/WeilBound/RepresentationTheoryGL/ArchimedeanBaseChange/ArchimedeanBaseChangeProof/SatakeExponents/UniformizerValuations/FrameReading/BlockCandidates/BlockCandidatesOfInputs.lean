  · rintro rfl
    apply hG0
    have : pairSpace (⊥ : Submodule ℂ (Sm E a)) U₂ = ⊥ := by
      unfold pairSpace
      rw [Submodule.span_eq_bot]
      rintro F ⟨φ₁, hφ₁, φ₂, -, rfl⟩
      rw [Submodule.mem_bot] at hφ₁
      subst hφ₁
      funext x
      simp
    rw [this, Submodule.mem_bot] at hG
    exact hG
  · rintro rfl
    apply hG0
    have : pairSpace U₁ (⊥ : Submodule ℂ (Sm E b)) = ⊥ := by
      unfold pairSpace
      rw [Submodule.span_eq_bot]
      rintro F ⟨φ₁, -, φ₂, hφ₂, rfl⟩
      rw [Submodule.mem_bot] at hφ₂
      subst hφ₂
      funext x
      simp
    rw [this, Submodule.mem_bot] at hG
    exact hG

