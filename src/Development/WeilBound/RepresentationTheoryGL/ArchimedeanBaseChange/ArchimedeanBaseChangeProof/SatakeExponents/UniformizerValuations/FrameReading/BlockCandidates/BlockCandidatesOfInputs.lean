  by_contra h0
  obtain ⟨s, hs, a, b, rfl⟩ := hS g h0
  exact hg (Set.mem_biUnion hs ⟨((a : G), (b : G)), ⟨a.2, b.2⟩, rfl⟩)

theorem uSatOf_holds : USatOf := by
  intro hSD E _ _ _ n π w σ hw hcomp hfix
