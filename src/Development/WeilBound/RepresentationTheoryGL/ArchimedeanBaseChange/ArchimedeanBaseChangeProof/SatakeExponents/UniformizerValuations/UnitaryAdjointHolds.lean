theorem compUnit : PositivityTheory.Rg.BcB.F.Eig.CompUnit := by
  rintro E _ _ _ n π hπ w σ ⟨p, hp, hirr, f, hf0, hfm, hf⟩
  obtain ⟨t1, t2, t3, t4, t5, t6⟩ := setup (E := E) n
