theorem compactSpace_quot (hc : ∃ C : Set G, IsCompact C ∧ ∀ g, ∃ γ ∈ Γ, γ * g ∈ C) : CompactSpace (Quot Γ) := by
  obtain ⟨C, hC, h⟩ := hc
