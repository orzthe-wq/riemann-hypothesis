    obtain ⟨-, h1⟩ := (GlobalTheory.CuspRep.isIrreducible_iff _).1 hirr
    have hW : ∀ g v, v ∈ LinearMap.ker f → σ.ρ g v ∈ LinearMap.ker f := fun g v hv => by
