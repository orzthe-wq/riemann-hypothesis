theorem isMulRightInvariant_of_cover (hc : ∃ C : Set G, IsCompact C ∧ ∀ g, ∃ γ ∈ Γ, γ * g ∈ C)
    (μ : Measure G) [μ.IsHaarMeasure] : μ.IsMulRightInvariant := ⟨fun g => by
