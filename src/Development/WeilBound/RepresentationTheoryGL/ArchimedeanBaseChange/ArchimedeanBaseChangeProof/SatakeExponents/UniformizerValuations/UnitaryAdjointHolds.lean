    ext x
    simp only [Set.mem_preimage, Set.mem_image, Set.mem_iUnion]
    constructor
    · rintro ⟨y, hy, e⟩
      obtain ⟨γ, rfl⟩ := mk_eq_iff.1 e
      exact ⟨γ, by simpa using hy⟩
    · rintro ⟨γ, hγ⟩
      exact ⟨_, hγ, mk_eq_iff.2 ⟨γ, by simp⟩⟩
  refine isOpen_coinduced.2 ?_
  change IsOpen (mk Γ ⁻¹' (mk Γ '' U))
