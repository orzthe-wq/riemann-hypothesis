        filter_upwards [(hm (c • v)).coeFn_toL2, (hm v).coeFn_toL2, Lp.coeFn_smul c (hm v).toL2] with q h1 h2 h3
        rw [h1, RingHom.id_apply, h3, Pi.smul_apply, h2, map_smul]
