  refine hPS E a b (f i) _ _ (fun y => ?_) (fun x => ?_) (fd_range₁ f i hs₁ fd₁)
  · obtain ⟨φ, hφ⟩ := hs₁ i y
    exact ⟨φ, subset_hull _ ⟨i, y, hφ⟩, hφ⟩
  · obtain ⟨ψ, hψ⟩ := hs₂ i x
