  have cont₂ : ∀ φ ∈ slices₂ f, Continuous φ.1 := by
    intro φ hφ
    obtain ⟨i, y, hφ'⟩ := hφ
    rw [hφ']; have := hcont i; fun_prop
  have ha₁ := hHA E a (slices₁ f) haut₁
  have ha₂ := hHA E b (slices₂ f) haut₂
  have inf₁ : ∀ τ, HasInfCharGL (hull (slices₁ f)) τ (m₁ τ) := fun τ => ha₁.2 τ (m₁ τ) (hinf₁ τ)
