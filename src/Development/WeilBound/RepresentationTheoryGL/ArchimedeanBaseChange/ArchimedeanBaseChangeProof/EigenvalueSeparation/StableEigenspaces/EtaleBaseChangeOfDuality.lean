theorem mult_prod {A : Set (GA E a)} {B : Set (GA E b)} {n₁ n₂ : ℕ} (h₁ : Mult A n₁) (h₂ : Mult B n₂)
    (x : H E a b) : {γ : ratH E a b | (γ : H E a b) * x ∈ A ×ˢ B}.encard ≤ ((n₁ * n₂ : ℕ) : ℕ∞) := by
