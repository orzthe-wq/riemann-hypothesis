  have hIt := (hW ()).ne
  refine ⟨(Cy : ℝ) * c * n₂ * (1 + R₂) ^ (2 * K) *
    (∫⁻ x, ENNReal.ofReal (wt x ^ (-(2 * K : ℤ))) * ‖F x‖ₑ ^ 2 ∂D.ν).toReal, 2 * K, fun S hS n R hR hn hSz => ?_⟩
