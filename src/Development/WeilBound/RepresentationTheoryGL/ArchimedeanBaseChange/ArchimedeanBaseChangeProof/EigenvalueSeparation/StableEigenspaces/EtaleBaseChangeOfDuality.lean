  refine ⟨fun u hu x => ?_, fun x => ?_⟩
  · have h := hF.1 u hu 1 K₂.one_mem (x, y)
    simpa using h
  · let L : (Kinf E a × Kinf E b → ℂ) →ₗ[ℂ] (Kinf E a → ℂ) := LinearMap.funLeft ℂ ℂ fun k => (k, 1)
