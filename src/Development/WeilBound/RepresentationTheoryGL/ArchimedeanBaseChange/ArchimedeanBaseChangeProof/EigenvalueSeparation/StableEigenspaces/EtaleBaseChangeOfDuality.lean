    (fun γ hγ p hp => wt_mul_le γ hγ p (hSz _ hp.1) (hR₂ _ hp.2)) (mult_prod hn hm₂)).1
  calc ∫⁻ g in S, ‖F (g, y₀)‖ₑ ^ 2 ∂μ
