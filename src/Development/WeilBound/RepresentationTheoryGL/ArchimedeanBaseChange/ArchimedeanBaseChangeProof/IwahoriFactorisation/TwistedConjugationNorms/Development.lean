    have : (-1 : w.adicCompletion E) ^ ((i : ℕ) + i) = 1 := Even.neg_one_pow ⟨i, rfl⟩
    rw [this, one_mul]

theorem TO_le_iw (w : Pl E) (a : ℕ) {s : GLw a w} (hs : s ∈ TO a w) : s ∈ iwGL a w := by
