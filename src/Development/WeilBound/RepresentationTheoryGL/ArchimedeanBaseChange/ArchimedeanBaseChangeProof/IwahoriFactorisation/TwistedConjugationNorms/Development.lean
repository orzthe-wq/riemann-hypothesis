  ·
    simp only [Set.mem_ofPred_eq]
    constructor
    · intro hq
      obtain ⟨m', hm', τ', hτ', e'⟩ := _root_.PositivityTheory.Rg.Bc.ArchbcB.B.M4.contr_tw_tl hU w hw ϖ hϖ a y hy _ hq
      have hh : ((p * m)⁻¹ * q * m')⁻¹ * (tdiag ϖ y * τ) * thL a w ((p * m)⁻¹ * q * m') = tdiag ϖ y * τ' := by
        rw [← e', ← h0]
