    have hu := _root_.GlobalTheory.CompanionTheory.DiagBd.valued_eq_one_of_isCompact_closure_zpowers E w a ⊤ ⟨t, Subgroup.mem_top t⟩ (p * m) _ htc (cpt_top t hcpt)
    have hcTO : c ∈ TO a w := ⟨hcd, fun i => by simpa using hu i⟩
