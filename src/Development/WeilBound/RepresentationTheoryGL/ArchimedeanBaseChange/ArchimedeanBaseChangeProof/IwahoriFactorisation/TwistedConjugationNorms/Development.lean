    have hC'c : IsCompact ((iwGL a w).map (MulAut.conj (p * m)).toMonoidHom : Set (GLw a w)) := by
      rw [Subgroup.coe_map]; exact hIc.image (continuous_conj _)
    have h1 := relIndex_ne_zero_of_isOpen' hC'c hUo
