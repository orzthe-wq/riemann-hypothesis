theorem exists_linv' (W : Submodule ℂ (Kinf E N → ℂ)) (hW : FiniteDimensional ℂ W) (v : InfinitePlace E) :
    ∃ (s : Finset (UN N)) (L : (s → ℂ) →L[ℂ] (Mv W hW v).V), ∀ w : (Mv W hW v).V,
