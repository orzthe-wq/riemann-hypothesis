  rintro ⟨X, hX⟩ -
  have hX' : Xᴴ = X := hX
  have : (⟨X, hX⟩ : Herm E a) = ∑ x, ip X (fr x).1 • fr x := by
    apply Subtype.ext
    simp only [Submodule.coe_sum, Submodule.coe_smul]
    exact (expand X hX').symm
  rw [this]
