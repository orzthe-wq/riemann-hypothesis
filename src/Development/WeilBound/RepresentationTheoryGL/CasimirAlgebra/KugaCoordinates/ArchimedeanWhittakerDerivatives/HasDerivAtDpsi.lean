  ∀ g t, f (g * infGL E a (cu M hM t)) - f g = ∫ s in (0 : ℝ)..t, f' (g * infGL E a (cu M hM s))

theorem intRel_sm (M : Matrix (Fin a) (Fin a) (Cinf E)) (hM : M * M = 0) (φ : Sm E a) :
