    (hM : 3 ≤ M) (hGm : Gm = -(V.gram)ᵀ) (hθ : IsInfFam θ) (hrp : IsRealPart V θ A rp)
    (hσ : ∀ ρ, (σ ρ).1 = tauE D ρ)
    (heq : ∀ (s' : realSU Ψ Gm) (b₀ : ∀ ρ, Upq V ρ), (∀ ρ, UpqT.mat (b₀ ρ) * A ρ =
