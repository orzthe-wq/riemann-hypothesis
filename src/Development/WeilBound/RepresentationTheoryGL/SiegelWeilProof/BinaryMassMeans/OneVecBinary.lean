  have hc : ∀ z : ℂ, star z * z = ((Complex.normSq z : ℝ) : ℂ) := fun z => by
    rw [Complex.normSq_eq_conj_mul_self]; rfl
  simp only [Pi.star_apply]
  rw [hc, Complex.ofReal_re]
  exact Complex.normSq_nonneg _

