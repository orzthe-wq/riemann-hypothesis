    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_sub, fL_apply, fL_apply, d1, d2]
    have e1 := hop_tr_false hB hc b i (pderiv (a, i, true) p)
    have e2 := hop_tr_true hB hc a i (pderiv (b, i, false) p)
