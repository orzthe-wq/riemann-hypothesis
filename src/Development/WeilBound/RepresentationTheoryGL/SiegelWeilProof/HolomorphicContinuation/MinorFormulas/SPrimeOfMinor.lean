    simp only [PositivityTheory.Rg.Sw.WR.G.Amat, PositivityTheory.Rg.Sw.sgn, ↓reduceIte, mul_one]
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin, ← mul_pow]
