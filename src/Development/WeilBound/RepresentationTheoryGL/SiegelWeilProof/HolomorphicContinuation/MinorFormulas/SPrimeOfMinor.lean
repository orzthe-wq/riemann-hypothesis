theorem sec_one_const (b : Bool) {c t : ℝ} (hc : 0 < c) (y : E n) :
    secN (fun _ : Fin m => b) c t 1 (herm y) =
      (((Real.pi : ℂ) / c) ^ n) ^ m * (if b then uM ((t / c : ℝ) : ℂ) y else vM ((t / c : ℝ) : ℂ) y).det ^ m := by
