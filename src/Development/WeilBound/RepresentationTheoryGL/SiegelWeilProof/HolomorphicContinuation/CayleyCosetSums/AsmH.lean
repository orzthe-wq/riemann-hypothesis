theorem lift_mR' (φ : GR n → ℂ) (y : GR n) : lift φ (mR y) = φ y := by
  have h : IsUnit (mR y) ∧ InG (mR y) := ⟨y.1.isUnit, y.2⟩
  unfold lift
  rw [dite_eq_left h]
  congr 1
  ext : 2
  rfl

theorem isUnit_of_inG {x : M2 n} (hx : InG x) : IsUnit x :=
