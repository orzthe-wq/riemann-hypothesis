    have hpm : Continuous fun w : KR n × ℂ => ((w.1 : GR n) * k1, w.2) :=
      (hmc.comp continuous_fst).prodMk continuous_snd
    have hc1 : ContinuousOn (fun w : KR n × ℂ => F ((w.1 : GR n) * k1) w.2) (univ ×ˢ (U ∩ V)) :=
