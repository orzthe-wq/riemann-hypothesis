    exact hfree c fun k => by rw [hyk, ← mul_assoc, hc, zero_mul]
  have hu : IsUnit (x : T) := (IsArtinianRing.isUnit_iff_mem_nonZeroDivisors).2 hnz
  refine ⟨x, x.2, hu, fun k => t k, fun k => a k, fun k => (t k).2, fun k => (a k).2, hyk, ?_⟩
