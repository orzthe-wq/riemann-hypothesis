theorem perm_abs {α : Type 1} {h : ℕ} (P : (Fin h → α) → Prop)
    (hP : ∀ (y : Fin h → α) (j : ℕ) (hj : j + 1 < h), P y → P fun a => y (Equiv.swap ⟨j, by omega⟩ ⟨j + 1, hj⟩ a))
