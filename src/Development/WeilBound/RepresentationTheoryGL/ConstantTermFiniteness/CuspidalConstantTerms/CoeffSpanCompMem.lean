    (hPG : Pᴴ * Formalism.REAL.Jm e * P = gramAt D V τ) (m : ℕ) (X Y : Matrix (Fin V.rank) (Fin m) D.host.E)
    (hW : GlobalTheory.SiegelSet.IsWittFrame D.sp.cm.sig V.gram X Y) (T : Finset (Fin m)) (k : Formalism.REAL.KG e)
