    have a2 : IntOff S (x.submatrix (fun _ : Fin 1 => Fin.last a) id) := fun v hv i j => h v hv _ _
    have b1 := h₁ (x.submatrix Fin.castSucc id)
    have b2 := h₂ (x.submatrix (fun _ : Fin 1 => Fin.last a) id)
