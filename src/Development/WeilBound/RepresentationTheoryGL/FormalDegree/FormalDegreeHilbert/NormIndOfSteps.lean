  obtain ⟨U, hU⟩ := GlobalTheory.CompanionTheory.DSUniq.ds_unique
    CompanionTheory.D.LK.hMultAlg CompanionTheory.D.LK.hKModExists CompanionTheory.D.LK.hOrthCyc
    n ε lam H _ σ (sigLam ε (PsiM T μ) T.w) hl hσ hDS
