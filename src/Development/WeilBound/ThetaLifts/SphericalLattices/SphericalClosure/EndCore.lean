theorem move (hA : ArchOp) (hM : CartanMove) (hp : IsPair B M χX χW om r s r' s') (hp₂ : IsPair B (reM X₂ W₂ M) χX χW om r s r' s')
    {h : UA σ W.J} (hh : h ∈ UAt σ W (evI F))
    (hθ : ∀ w, (mat h).map (piInf (B.emb w)) * W₂.θ w = W.θ w * (mat h).map (piInf (B.emb w))) :
