theorem exists_gi {k : Type} [Field k] {n : ℕ} (A : Matrix (Fin n) (Fin n) k) : ∃ S : Matrix (Fin n) (Fin n) k, A * S * A = A := by
  obtain ⟨g, hg⟩ := (toLin' A).rangeRestrict.exists_rightInverse_of_surjective (LinearMap.range_rangeRestrict _)
