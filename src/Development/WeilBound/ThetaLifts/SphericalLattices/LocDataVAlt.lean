  ext i j
  by_cases hij : i = j
  · subst hij; simp [blow]
  · simp [blow, hij, Ne.symm hij]

theorem blow_map_cA (σ : E →ₐ[F] E) {c : w.adicCompletion E →+* w.adicCompletion E} (hc : IsConjAt σ h c) {n : ℕ}
