          rw [toCompl_tmul, toCompl_tmul, map_mul, mul_assoc]
        rw [e2, show toCompl h (a ⊗ₜ[F] ((e : E) * y i)) = InertChart.complEquiv hw h (a ⊗ₜ[F] ((e : E) * y i)) from rfl,
          RingEquiv.symm_apply_apply]
