    {k L : Type u} [Field k] [Field L]
    {X Y : Scheme.{u}} (pX : X ⟶ Spec (CommRingCat.of k))
    (pY : Y ⟶ Spec (CommRingCat.of L))
    [AlgebraicGeometry.Smooth pX] [AlgebraicGeometry.Smooth pY]
    (f : k →+* L) (q : Y ⟶ X)
