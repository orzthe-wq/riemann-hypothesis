def FewBad (H : Host R) (s : Scale) (bs : R.A → R.A → R.A) : Prop :=
  ∑ p ∈ (Finset.range ⌈s.X'⌉₊).filter (fun p => p.Prime ∧ H.cls p = PrimeClass.inertClass ∧
