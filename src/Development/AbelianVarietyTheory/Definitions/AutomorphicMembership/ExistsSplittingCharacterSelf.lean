    (xi : D.what₂.Tup → Formalism.L2.Host.HChar D.host.E) : Prop where
  chr : ∀ μ (j : Fin D.R.m), Formalism.IndefR.Links.ChrEq (Rc.chr μ (j.1 + 1)) (C.mu0 j * xi μ)
