  · rw [h, Matrix.mulVec_zero, smul_zero]

theorem mul_mem_exSet (ε : AE D) (i : Fin (d.ρ + 1)) : ∀ {g h}, g ∈ d.ExSet ε i → h ∈ d.ExSet ε i → g * h ∈ d.ExSet ε i := by
