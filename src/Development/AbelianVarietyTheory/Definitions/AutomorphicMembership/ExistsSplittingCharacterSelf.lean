  have h4 := congrArg (g' *ᵥ ·) h1
  have h5 := congrArg (g' *ᵥ ·) h3
  simp only [Matrix.mulVec_smul, Matrix.mulVec_sub, Matrix.mulVec_mulVec, smul_sub, smul_neg, hg, Matrix.one_mulVec,
