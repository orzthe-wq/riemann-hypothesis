      (fun k => (Formalism.L2.Pj.homAt (𝟙 (Sp S)) (jetSubstP m fun p : Fin 2 × Fin d =>
        (![fun j => X ((0 : Fin 2), j), fun j => psIn d m ![1] (act (H.bar a) j)] :
