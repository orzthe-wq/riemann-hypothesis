  refine ⟨v, hv, fun m => ?_⟩
  obtain ⟨u, hu, hc⟩ := hr m
  obtain ⟨c₁, hc₁, hm⟩ := ht m
  have hjx : ∀ i : Fin 2, (jptG t' (𝟙 (Sp S)) d x' m i).left ≫ mp.φ = 𝟙 _ ≫ (jptG t x0 d x m i).left := fun i => by
