    (ψ' : W → (P' ⟶ X')) (ψ : W → (P ⟶ X)) (δ : W → ℤ) (v' : LB.Gen (LB.LinComb L' ψ' δ))
    (v : LB.Gen (LB.LinComb L ψ δ)) (l' : Y ⟶ P') (l : Y ⟶ P)
    (hv : ∀ (y : Y) J J', Good L y J → Good L' y J' → val v l y J =
      (∏ k, gw w (l' ≫ ψ' k) y (J ((l' ≫ ψ' k) ≫ F)) (J' (l' ≫ ψ' k)) ^ δ k) * val v' l' y J')
