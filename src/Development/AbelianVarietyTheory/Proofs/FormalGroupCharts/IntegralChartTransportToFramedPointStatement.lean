  rw [val_mul hJ, FrameSym.val_scale _ _ _ _ hJ, val_pull hJ, val_pull hJ, val_pull hJ, ← val_corr hJ hc,
    ← val_corr hJ hc, FrameSym.val_tie w φ' ε a c hm _ y hJ hJ', FrameSym.val_tie w φ' ε a c hm _ y hJ hJ']
