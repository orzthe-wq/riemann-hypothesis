theorem val_of_rel {K : Type} [CommRing K] {X Y : Scheme.{0}} (x : Sp K ⟶ X) (ρ : X ⟶ Y) (p : Sp K ⟶ Y)
    (hp : x ≫ ρ = p) (U : X.Opens) (V : Y.Opens) (W : (Sp K).Opens) (hU : ⊤ ≤ x ⁻¹ᵁ U) (hV : U ≤ ρ ⁻¹ᵁ V)
