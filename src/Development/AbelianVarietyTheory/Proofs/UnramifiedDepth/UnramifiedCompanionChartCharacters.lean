    exact (ha.smul_eq_zero).1 h2
  have h3 : (∑ j, ε j) *ᵥ y = y := by rw [hsum]; simp
  rw [Matrix.sum_mulVec, Finset.sum_eq_single i] at h3
  · exact h3
  · intro b _ hb
    exact hz b hb.symm
  · simp

