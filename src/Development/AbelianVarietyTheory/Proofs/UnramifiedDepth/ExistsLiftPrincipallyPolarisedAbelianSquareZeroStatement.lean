    exact Q.isAb.proper
  have hcomm : IsCommMonObj Q.A := Q.isAb.comm
  have hsecO : ∀ x : 𝟙_ (Over (Sp O)) ⟶ Q.A, x.left ≫ Q.A.hom = 𝟙 _ := fun x => Over.w x
