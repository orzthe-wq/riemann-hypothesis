    (Equiv.ofBijective _ (hbij S)).symm (spMap φ ≫ y)
  have hpt : ∀ S φ, e S (pt S φ) = spMap φ ≫ y := fun S φ =>
    (Equiv.ofBijective _ (hbij S)).apply_symm_apply _
  have pt_nat : ∀ {S S' : LAlg R₀} (f : LHom S S') (φ : A →ₐ[R₀] S),
