    have h3 : (0 : ℝ) < (Algebra.trace ℚ E (β * a ^ n * IsCMField.complexConj E (a ^ n)) : ℚ) := by
      exact_mod_cast h _ (pow_ne_zero n ha0)
    rw [Complex.ratCast_re, Complex.re_sum] at h2
    rw [h2] at h3
