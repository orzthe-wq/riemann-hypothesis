  classical
  rw [← eq_ratCast (algebraMap ℚ Ω)]
  exact algebraMap_trace_eq_sum_algHom_of_card (Nat.card_eq_fintype_card.symm.trans h)
    (P := fun τ : E →+* Ω => τ.toRatAlgHom) (fun τ τ' e => RingHom.ext fun y => AlgHom.congr_fun e y) x

