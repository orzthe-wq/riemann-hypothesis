    · exact le_rfl)
  have h3 : Filter.Tendsto (fun n => ∑ σ, g σ n) Filter.atTop
      (nhds (∑ σ : E →+* ℂ, if InfinitePlace.mk σ = InfinitePlace.mk τ then (τ β).re else 0)) := by
