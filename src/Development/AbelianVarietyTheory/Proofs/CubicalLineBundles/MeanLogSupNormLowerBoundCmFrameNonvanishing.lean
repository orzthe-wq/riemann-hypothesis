  have hNk : Real.log ((FractionalIdeal.absNorm (FractionalIdeal.spanSingleton (𝓞 K)⁰ k) : ℚ) : ℝ) =
      n * (8 * Real.log ((FractionalIdeal.absNorm T.I : ℚ) : ℝ) -
