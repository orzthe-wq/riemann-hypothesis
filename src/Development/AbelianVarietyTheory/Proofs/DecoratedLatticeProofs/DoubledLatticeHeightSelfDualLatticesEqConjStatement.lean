    (h' : ∀ y, y ∈ H' ↔ ∀ i, ((β'⁻¹).val *ᵥ y) i ∈ S) (y : Fin n → R) :
    y ∈ H ↔ (β' * β⁻¹).val *ᵥ y ∈ H' := by
