      obtain ⟨s, t, e⟩ := hcq
      refine IsUnit.of_mul_eq_one (Ideal.Quotient.mk _ t) ?_
      rw [← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq, Ideal.mem_span_singleton]
      exact ⟨-s, by linear_combination e⟩
