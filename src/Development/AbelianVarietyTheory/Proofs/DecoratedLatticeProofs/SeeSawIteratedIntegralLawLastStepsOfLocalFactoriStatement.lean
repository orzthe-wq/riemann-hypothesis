    | cons e l ih =>
      intro g hg
      change g ∈ (e.sum fun g a => (conv l).sum fun h b => Finsupp.single (g * h) (a * b)).support at hg
      obtain ⟨x, hx, hg1⟩ := Finset.mem_biUnion.1 (Finsupp.support_sum hg)
