theorem actO_eq_of_disj : ∀ (D : D7) (S T : HSp D) (P P' : GlobalTheory.FinPl.Pl D → Prop), (∀ x, P x → ¬ P' x) → ∀ g ∈ GlobalTheory.FinPl.grpAt S P, ∀ u : WO S T, GlobalTheory.FinPl.MxAt P' u → actO S T g 1 u = u := by
  intro D S T P P' hPP g hg u hu
