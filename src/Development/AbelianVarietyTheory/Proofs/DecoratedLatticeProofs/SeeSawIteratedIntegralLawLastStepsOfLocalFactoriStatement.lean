    refine GlobalTheory.FinPl.CMAdele_eq_zero_of_infinite_and_finite_components_zero D _ m1.1 fun w => ?_
    by_cases hw : P w
    · exact m2.2 w (hPP w hw)
    · exact m1.2 w hw
  have hg' : g⁻¹ ∈ GlobalTheory.FinPl.grpAt S P := inv_mem hg
