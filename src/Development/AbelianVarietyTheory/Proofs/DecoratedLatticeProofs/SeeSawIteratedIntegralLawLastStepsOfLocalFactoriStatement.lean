    | nil =>
      intro g hg
      have e : conv ([] : List (G →₀ ℂ)) = Finsupp.single 1 1 := rfl
      rw [e] at hg
      rw [Finset.mem_singleton.1 (Finsupp.support_single_subset hg)]
