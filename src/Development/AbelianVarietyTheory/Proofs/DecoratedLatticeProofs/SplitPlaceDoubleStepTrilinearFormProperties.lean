  intro D ψ hψ σ S Q c₁ c₂ _ _ φ hφ Λ _ hΛ
  have hB : BiAct D := GlobalTheory.SeeSaw.biAct_all D
  have hC : ∀ Ξ, IsBiTheta ψ S.B.A S.J.W₀ S.B'.A (biComb ψ S.B.A S.J.W₀ S.B'.A c₁ c₂ (Λ Ξ)) :=
