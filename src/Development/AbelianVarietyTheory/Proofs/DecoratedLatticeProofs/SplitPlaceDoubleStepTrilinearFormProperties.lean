theorem idem_mul {e : AE D} (he : IsSplitIdem D e) : (e + cA D e) * (1 - (e + cA D e)) = 0 := by
  have h1 := he.1
  have h2 := he.2.1
  have h3 : cA D e * cA D e = cA D e := by rw [← map_mul, h1]
  linear_combination -h1 - 2 * h2 - h3

