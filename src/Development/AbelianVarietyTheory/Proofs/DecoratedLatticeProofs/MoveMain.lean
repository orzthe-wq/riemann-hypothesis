  haveI := hW.fin
  have : {PP | PP ∈ (pk W).Pg ∨ QAll W PP} = ((pk W).Pg : Set _) ∪ ⋃ t, ((pk W).Q t : Set _) := by
    ext PP; simp [QAll]
  have hf : Set.Finite {PP | PP ∈ (pk W).Pg ∨ QAll W PP} := by
    rw [this]; exact (Finset.finite_toSet _).union (Set.finite_iUnion fun t => Finset.finite_toSet _)
  exact hf.to_subtype

