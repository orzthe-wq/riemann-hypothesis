    intro h
    rw [h, map_zero] at hϖ'
    exact WithZero.zero_ne_coe hϖ'
  rw [hK] at hk₁ hk₂
  obtain ⟨κ, hκ, h1, h2, h3⟩ := exists_kappa h0 hϖO d t k₁ k₂ ht hk₁ hk₂
  refine ⟨κ, (hK _).symm ▸ hκ, h1, ?_, ?_⟩
  · rw [h2]
    exact ordL_det_mul_diagonal hO hϖ' hk₁ _
