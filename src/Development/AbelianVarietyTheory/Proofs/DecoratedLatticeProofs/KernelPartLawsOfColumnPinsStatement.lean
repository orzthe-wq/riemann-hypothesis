  rw [mul_assoc, ← mul_assoc (k.prod _), ← Finsupp.prod_mul]
  congr 2
  refine Finsupp.prod_congr fun v _ => ?_
  rw [← mul_pow, div_mul_cancel₀ _ (hcD v.1)]

