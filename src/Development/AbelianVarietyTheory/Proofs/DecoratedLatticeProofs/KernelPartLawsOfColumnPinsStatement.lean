  have hm : ∀ x : ℂ, (MvPolynomial.monomial k x : FP D.what₂.Tau S.rank T.rank) = x • MvPolynomial.monomial k 1 := by
    intro x; rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
