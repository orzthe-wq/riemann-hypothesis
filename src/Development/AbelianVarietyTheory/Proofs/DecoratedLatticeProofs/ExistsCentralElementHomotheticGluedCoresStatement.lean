    _ = h • (scal s hs : GL n k) • stdPair k i := by rw [hQs]
    _ = (scal s hs : GL n k) • P := by rw [← hh, smul_smul, smul_smul, scal_comm]

end GlobalTheory.LatPair.StabScal

