  show (s⁻¹ • (1 : Matrix n n k)) *ᵥ x = _
  rw [Matrix.smul_mulVec, one_mulVec]

theorem scal_comm (s : k) (hs : s ≠ 0) (h : GL n k) : h * scal s hs = scal s hs * h := by
