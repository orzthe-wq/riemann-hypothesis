  rw [HypDec.qX, ← Matrix.mulVec_mulVec]; rfl

theorem qY_mulVec_apply {S S₀ : HSp D} {ρ : ℕ} (d : HypDec S S₀ ρ) (y : Fin S.rank → D.host.E) (i : Fin ρ) :
