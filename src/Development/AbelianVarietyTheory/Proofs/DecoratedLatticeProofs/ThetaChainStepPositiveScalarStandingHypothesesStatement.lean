        GlobalTheory.Doubling.npow (GlobalTheory.Core.Rk.IP.hgtL s.V s.Λ a (b : GA D s.V)) ((z : ℂ) - s₁)) mR := by
      have hme : Measurable fun b : GinfC s.V =>
