  let wR : {e : Fin N → ℤ // Antitone e} → ℝ := fun e =>
    μK.real (cell k (Fin N) ϖ e) * (resCard k : ℝ) ^ (-((N : ℝ) / 2) * (sumAbs e.1 : ℝ))
  have hw0 : ∀ e, 0 ≤ wR e := fun e => mul_nonneg measureReal_nonneg (Real.rpow_nonneg hq0.le _)
