  obtain ⟨εβ, hεβ, hnβ⟩ := near β ψ' hψ'
  have hsum := GlobalTheory.summable_nonneg_family_of_differentiableOn c n (ratFun (resCard k) N β) _ εβ hc0 hεβ dβ fun z h1 h2 => by
