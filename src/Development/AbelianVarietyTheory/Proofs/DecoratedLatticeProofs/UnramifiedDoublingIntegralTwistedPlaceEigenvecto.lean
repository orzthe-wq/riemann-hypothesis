    exact mul_le_mul_of_nonneg_right (hbc e) (pow_nonneg (norm_nonneg _) _)
  · have := hid _ hzr
    rw [← ratFun_cpow hq N α s] at this
    exact (funext fun e => hterm e s _) ▸ this

