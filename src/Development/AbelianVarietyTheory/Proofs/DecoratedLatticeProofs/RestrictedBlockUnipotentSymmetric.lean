  rw [hA_add_right]; exact Z_add I g h h'

theorem idem_sum {z0 : VA I} {ew : (I.E ⊗[I.F] Formalism.MainNotions.S.Af I.F)} (hz : z0 ∈ I.Lf) (hzz : ZMod' I g (hA I z0 z0 + 1))
    (hint : ew ∈ IntAf I.F I.E) (hfull : ∀ y ∈ I.Lf, (1 - ew - sigA I ew) • y ∈ mL I g) :
