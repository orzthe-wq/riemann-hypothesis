theorem eq_one_of_rat {θ : InfFam D} (hθ : IsInfFam θ) {δ : GA D T} (h1 : δ ∈ GQ T) (h2 : δ ∈ GfC T) : δ = 1 := by
  obtain ⟨ga, hga, hδ'⟩ := id h1
  have hm : Formalism.L2.Theta.mt T δ = (ga : Matrix (Fin T.rank) (Fin T.rank) D.host.E).map (incA D) :=
