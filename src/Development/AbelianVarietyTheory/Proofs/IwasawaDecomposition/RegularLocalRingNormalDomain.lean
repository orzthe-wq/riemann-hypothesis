    have hxk : x ^ k ≠ 0 := pow_ne_zero _ hx.ne_zero
    apply mul_left_cancel₀ hxk
    calc x ^ k * (a * r) = a * (x ^ k * r) := by ring
      _ = b * s := hrs
      _ = b * (x ^ k * s') := by rw [hs']
      _ = x ^ k * (b * s') := by ring

theorem exists_not_dvd {A : Type u_1} [CommRing A] [IsNoetherianRing A] [IsLocalRing A] {x : A}
