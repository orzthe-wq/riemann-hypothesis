variable {D : D7} {r : ℕ} {Comp : Type}

def moveDict {V : HSp D} {X : Comp → Data D.host.E r} (dict : GA D V → Σ k, Frame (X k).Ψ r)
    (x₀ x₁ : (D.host.E →+* ℂ) → Matrix (Fin r) (Fin r) ℂ) : GA D V → Σ k, Frame (X k).Ψ r :=
