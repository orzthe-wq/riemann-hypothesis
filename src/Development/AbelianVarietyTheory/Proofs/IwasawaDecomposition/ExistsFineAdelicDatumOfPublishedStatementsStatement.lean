  have hbF := h23 hbF'
  have hv : ∀ t PP, PP ∈ R.Pg ∨ PP ∈ R.Q t → ∀ (ξ : (kP PP)ˣ →* ℂˣ) (x : (kP PP)ˣ), ((ξ x : ℂˣ) : ℂ) ∈ c₃.F :=
    fun t PP hPP ξ x => (((le_iSup MC t).trans le_sup_right).trans hc₃) (hC t PP (Finset.mem_union.2 hPP) ξ x)
  have hb0 : b ≠ 0 := fun h0 => by
    obtain ⟨m, hm, e⟩ := hb
