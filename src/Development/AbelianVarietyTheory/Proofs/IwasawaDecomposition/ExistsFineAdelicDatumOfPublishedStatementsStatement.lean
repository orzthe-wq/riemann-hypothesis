    | some _ => ⟨a, haF⟩ / ⟨b, hbF⟩
  let h : ∀ o, (src o).Cl' () → GA D (Vc D i) := fun o =>
    match o with
    | none => h₀
    | some t => hh t
  have hP := pins_merge src c₃ h₃ hs _ hV₃ c0₃ O.lev io₃ hw₃ u h v₀ hR hv
    (fun o => match o with
