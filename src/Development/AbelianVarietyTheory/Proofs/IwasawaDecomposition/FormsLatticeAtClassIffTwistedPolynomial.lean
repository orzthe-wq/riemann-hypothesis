    (h : ∀ y : ι → Matrix (Fin n) (Fin n) ℂ, (∀ τ, (y τ).det ≠ 0) →
      eval (fun k : ι × Fin n × Fin n => y k.1 k.2.1 k.2.2) (map e A) =
