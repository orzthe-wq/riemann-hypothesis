    intro y
    simp only [d, map_prod]
    refine Finset.prod_congr rfl fun τ _ => ?_
    rw [RingHom.map_det]
    congr 1
    ext a b
    simp
  have hd0 : d ≠ 0 := by
    intro h0
    have h1 := hd (fun _ => 1)
    rw [h0] at h1
