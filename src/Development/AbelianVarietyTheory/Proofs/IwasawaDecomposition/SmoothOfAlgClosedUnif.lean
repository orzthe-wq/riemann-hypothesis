theorem projPoints {J : Type} [Fintype J] [DecidableEq J] {EE : M.Lat J} {s : J → Ω'}
    (H : ProjBundle M EE M' φ f s) : ProjPoints M EE M' φ f s := by
  refine ⟨H.hom, fun z' B _ hB => ?_, fun K _ x B hB hE c hc => ?_⟩
