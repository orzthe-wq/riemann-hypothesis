    exact (H.chart W B hW ⟨_, hz⟩ hE).1 z' hz
  obtain ⟨W, hW, hz, hEW⟩ := exists_affine_basis EE B hE
  obtain ⟨i, hi⟩ := Function.ne_iff.1 hc
  replace hi : c i ≠ 0 := hi
  obtain ⟨hti, hind⟩ := H.gen B hB i
