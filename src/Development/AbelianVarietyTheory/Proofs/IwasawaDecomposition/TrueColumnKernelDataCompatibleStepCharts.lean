  subst hJ
  obtain ⟨ι₀, h⟩ := exists_fun (S := S) hLb hv hP hw h2 h3 hk hT hcard r hr
  exact ⟨ι₀, h, fun s j => exists_hasRes hP (s.1 j) (val_coord_le (S := S) hLb hP h3 s.2 j)⟩

