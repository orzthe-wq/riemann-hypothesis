  have k := congrFun (GlobalTheory.T.weilDatum_unique_on_thetaFunctions D ψ hψ V W _ _ o' o'' ho' ho'' (g, h) _ hf) u
  rw [e', e'' g h x y hx hy, LinearMap.smul_apply, e] at k
