  ext i j
  change (pairA D.host.F 0 β ⊗ₜ[D.host.F] (1 : D.host.E)) * (_ ⊗ₜ _) = _ ⊗ₜ _
  rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
