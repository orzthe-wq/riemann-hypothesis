    rw [mem_primeW]
    push_cast
    rw [Pl.val_resChar w]
    exact WithTop.coe_lt_coe.mpr (by have := Pl.ramIdx_pos w; omega)
  rw [h, Submodule.mem_bot] at hl
  have := (Pl.resChar_prime w).ne_zero
  exact this (by exact_mod_cast hl)

