      | zero => simp
      | add y z _ _ hy hz => rw [map_add (f := _)]; exact S.add_mem hy hz
      | smul a y _ hy => rw [map_smulₛₗ]; exact S.smul_mem _ hy
    rw [eq_top_iff]
    intro φ _
