    intro j
    by_contra hne
    have h1 := hhw j
    have h2 : gel k N N j v = hcVal k (fun i => (ν i : k)) j • v := _root_.GlobalTheory.Alc.gel_dualWeyl_field k N ν hν j v (hle hvM')
