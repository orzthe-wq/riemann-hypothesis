theorem exists_pow_intAt_mul (P : HeightOneSpectrum (𝓞 E)) (c : E) :
    ∃ K : ℕ, ∀ e ∈ P.asIdeal ^ K, Formalism.L2.Col.IntAt P (algebraMap (𝓞 E) E e * c) := by
