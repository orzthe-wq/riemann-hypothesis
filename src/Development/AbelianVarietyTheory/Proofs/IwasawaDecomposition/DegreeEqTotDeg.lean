@[reducible] def hostFields {R : Ranks} (H : Host R) : Fields where
  F := H.F
  E := H.E
  K := H.E
  starE := H.cmStar
  starK := H.cmStar
  Tau := Tau R
  deTau := Classical.decEq _
  emb τ := (H.sigmaOf (τ : R.GG) : H.E →+* H.E)

def hostAmb {R : Ranks} {H : Host R} (J : AmbIn H) (χ : Submodule (𝓞 H.E) H.E → ℂ) : Amb (hostFields H) where
  σ₀ := H.φ₀
  δ := J.δ
