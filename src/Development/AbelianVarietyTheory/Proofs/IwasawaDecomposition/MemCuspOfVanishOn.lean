theorem exists_herm_ne_zero {ξ : Fin r → E} (hξ : ξ ≠ 0) : ∃ η ∈ X.Λ, herm X.Gm ξ η ≠ 0 := by
  by_contra h
  push Not at h
  apply hξ
  refine Matrix.eq_zero_of_vecMul_eq_zero X.Gm_det ?_
  funext b
  obtain ⟨l, hl, hm⟩ := LatFin.exists_int_smul_mem X.Λ X.Λ_span (Pi.single b 1)
