  · have h1 : δc Yf = 1 := by
      refine GlobalTheory.tame_heckeChar_eq_one_of_finUnit D δc δ hc ht pd hunr Yf ⟨?_, ?_, ?_⟩ ⟨w₂, hw₂, by rw [hYf2]; exact hy₂c⟩
      · rw [hYf1]; rfl
      · rw [hYf2]; exact hy₂i
      · have hU : Units.map (finPart D).toMonoidHom Yf = y₂ := Units.ext hYf2
