  obtain ⟨b, y₂, hy₂, hy₂i, hy₂i', w₂, hw₂, hy₂c⟩ := GlobalTheory.UnitRootCong.exists_adele_unit_congr_one D pd hA.1 zf y₁ hy₁ hy₁' hy₁r ⟨w, hw', hcong⟩
