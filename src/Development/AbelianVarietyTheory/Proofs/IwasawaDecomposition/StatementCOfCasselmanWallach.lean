theorem monomial {n : ℕ} {g : GL (Fin n) L} (hg : g ∈ GQ0 L n)
    (hint : ∀ i j, IsIntegral ℤ ((g : Matrix (Fin n) (Fin n) L) i j)) (i : Fin n) :
