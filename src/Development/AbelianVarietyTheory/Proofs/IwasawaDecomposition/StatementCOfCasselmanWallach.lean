  have hc0 : 0 < c := Nat.pos_of_ne_zero (by rintro rfl; omega)
  have hη1 : ζ ^ c ≠ 1 := pow_ne_one_of_lt_orderOf hc0.ne' (by rw [hc]; have := hl.two_le; nlinarith)
  have hηl : (ζ ^ c) ^ l = 1 := by rw [← pow_mul, mul_comm, ← hc, pow_orderOf_eq_one]
