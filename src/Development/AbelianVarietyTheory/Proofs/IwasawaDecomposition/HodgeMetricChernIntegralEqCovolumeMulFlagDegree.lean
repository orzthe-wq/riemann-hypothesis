    Measure.restrict_apply' GlobalTheory.HodgeDomain.ActionDeriv.isOpen_domFlat.measurableSet] at h0
  refine measure_mono_null ?_ h0
  intro v hv
  exact ⟨⟨hpos v (hN hv), hv⟩, hN hv⟩


