  intro X px I hI
  let e0 := MulEquiv.ofBijective (ptHom X I hI) ⟨ptHom_injective X I hI, ptHom_surjective X I hI⟩
  refine ⟨e0.symm, fun x => ?_⟩
  have h := e0.apply_symm_apply x
  exact congrArg Subtype.val h

