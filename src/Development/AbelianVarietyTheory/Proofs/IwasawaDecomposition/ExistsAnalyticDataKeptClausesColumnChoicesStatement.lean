  · show (0 : Ainf D.host.F) = 0 * _
    rw [zero_mul]
  · show singleV D.host.F v _ = singleV D.host.F v 1 * _
    refine GlobalTheory.SplitIdem.af_ext _ fun w => ?_
    rw [map_mul]
    by_cases hw : w = v
