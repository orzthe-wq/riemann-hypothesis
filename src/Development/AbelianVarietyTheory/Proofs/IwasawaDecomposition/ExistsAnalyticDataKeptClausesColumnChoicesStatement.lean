      push_cast
      rfl
    · rw [GlobalTheory.SplitIdem.evalV_singleV_ne _ v _ hw, GlobalTheory.SplitIdem.evalV_singleV_ne _ v _ hw, zero_mul]

theorem psiV_int (ψ : AddChar (AF D.host.F) ℂ) (hψ : IsStdChar D ψ (-1)) (v : HeightOneSpectrum (𝓞 D.host.F))
