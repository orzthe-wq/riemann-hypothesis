theorem span_range_equiv {M N ι : Type} [AddCommGroup M] [Module ℂ M] [AddCommGroup N] [Module ℂ N] (T : M ≃ₗ[ℂ] N) {f : ι → M}
    {S : Submodule ℂ M} {S' : Submodule ℂ N} (h : Submodule.span ℂ (Set.range f) = S) (h' : ∀ F, F ∈ S ↔ T F ∈ S') :
