  have h1 : (Set.range fun k => T (f k)) = T.toLinearMap '' Set.range f := by
    rw [← Set.range_comp]; rfl
  rw [h1, ← Submodule.map_span, h]
  ext F
  obtain ⟨F, rfl⟩ := T.surjective F
  rw [Submodule.mem_map_equiv, T.symm_apply_apply]
  exact h' F

