  have hq : (U'.gt e).pG.left ≫ Φ.hom.left = (U.gt e).pG.left := (hlev e).1
  let c : ((thickObj R (maximalIdeal R) e G).left ⟶ D.toPre.P.A.left) → D.toPre.P.L.ι := fun ψ => J (r ≫ ψ)
