  have hterm : ∀ (Z0 : Scheme.{0}) (r0 : Z0 ⟶ (thickObj R (maximalIdeal R) e G).left) (z0 : Z0) (J0 : (Z0 ⟶ D.toPre.P.A.left) → D.toPre.P.L.ι)
