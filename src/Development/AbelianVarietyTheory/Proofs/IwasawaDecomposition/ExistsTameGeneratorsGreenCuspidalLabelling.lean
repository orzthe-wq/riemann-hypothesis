      intro i
      have hi := congrArg (fun r => _root_.AddMonoidAlgebra.coeff (M := ℕ) r i) h
      simp only [Polynomial.coeff_map, Polynomial.coeff_zero, eq_intCast] at hi
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ g).mp hi
