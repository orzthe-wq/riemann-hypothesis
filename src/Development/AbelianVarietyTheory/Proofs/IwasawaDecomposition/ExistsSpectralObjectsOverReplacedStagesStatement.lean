  let Fb : G0g D.nd → Set X.B.I.Gf := fun γ => {z | z ∈ X.B.I.Kset ∧ red z = γ}
  have hFb : ∀ γ, MeasurableSet (Fb γ) ∧ X.B.μf (Fb γ) = X.B.μf (X.B.I.Kg X.B.g) := by
