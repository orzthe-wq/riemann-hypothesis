  intro x s b hb
  have h := hw x s (b + 1) (by simp only [SizeData₂.lifts, Finset.mem_Icc]; omega)
  have e1 : wj D (b + 1) (Gt.gat_pos u v hg ⟨x, s⟩) = (((D.hc (Gt.gat_pos u v hg ⟨x, s⟩)).e ⟨b, hb⟩ : ℚ) : ℝ) := by
    unfold wj
    rw [dite_eq_left (by omega)]
    rfl
  rw [e1] at h
  rw [D.hcW_e]
  apply Rat.cast_injective (α := ℝ)
  unfold wG
  unfold G.kaJ at h
  push_cast
  rw [h]
  push_cast
  ring

