  let ψ : (R[X] ⧸ Ideal.span {G}) →+* T := Ideal.Quotient.lift _ (eval₂RingHom φ t) hker
  have h1 : ψ.comp (Ideal.Quotient.mk (Ideal.span {G})) = eval₂RingHom φ t := by
    ext <;> simp [ψ]
