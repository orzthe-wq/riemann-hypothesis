theorem quasiFinite_quotient_of_isUnit_coeff {R : Type*} [CommRing R] (G : R[X]) (k : ℕ)
    (hc : IsUnit (G.coeff k)) : Algebra.QuasiFinite R (R[X] ⧸ Ideal.span {G}) := by
  refine ⟨fun P _ => ?_⟩
  let f : R[X] →ₐ[R] (R[X] ⧸ Ideal.span {G}) := Ideal.Quotient.mkₐ R _
