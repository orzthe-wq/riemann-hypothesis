    LinearMap.codRestrict (SmFun θ V) ((LinearMap.proj y).comp κ) fun f => hκ f y
  obtain ⟨c, hc⟩ := exists_shift _ _ (glRel_derEnd hθ V τ) hQ L (fun i j => l (Matrix.single i j 1))
    fun i j y f => Subtype.ext (hl _ f y)
