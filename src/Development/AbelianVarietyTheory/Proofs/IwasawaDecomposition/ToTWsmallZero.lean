  | algebraMap r =>
    intro f F hF
    exact ⟨r • F, Submodule.smul_mem _ r hF, by rw [Module.algebraMap_end_apply, lift_smul_left, lift_smul_right]⟩
  | add x y _ _ hx hy =>
