theorem qf_ball_le {f : ℂ → ℂ} (hd : DifferentiableOn ℂ f (Metric.ball 0 1))
    (hpos : ∀ z ∈ Metric.ball (0 : ℂ) 1, 0 < (f z).im) {ζ : ℂ} (hζ : ‖ζ‖ < 1) {M : ℝ}
