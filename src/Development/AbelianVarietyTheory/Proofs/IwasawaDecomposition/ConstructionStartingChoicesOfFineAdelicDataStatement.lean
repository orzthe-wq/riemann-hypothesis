def zeVal (u : D.Word) (μ : D.Tup) : D.LLˣ :=
  if μ = D.mu0 then 1 else if h : ∃ z : D.LLˣ, ZeFact D u μ (D.embLL (z : D.LL)) then h.choose else 1

