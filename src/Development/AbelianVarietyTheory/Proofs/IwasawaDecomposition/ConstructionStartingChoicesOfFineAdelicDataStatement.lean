    · rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun v _ => ?_
      simp [add_smul]
    · rw [map_add (f := _), map_add (f := _), ← hxa, ← hyb]
  zero_mem' := ⟨⟨0, by simp⟩, 0, (TjLat Dd μ j).zero_mem, by simp⟩
