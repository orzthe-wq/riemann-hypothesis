    (hr : ∀ τ, r τ + r (ComplexEmbedding.conjugate τ) = n) (K : IntermediateField ℚ ℂ) [FiniteDimensional ℚ K]
    (hK : ∀ (τ : E →+* ℂ) x, τ x ∈ K) (b : ClassBasis E)
    (hb : ∀ i (z : ℂ), z ^ b.h i = ∏ τ : E →+* ℂ, τ (b.γ i : E) ^ r τ → z ∈ K)
    (𝔞 : Ideal (𝓞 E)) (h𝔞 : 𝔞 ≠ ⊥) : ∃ β : K, β ≠ 0 ∧
