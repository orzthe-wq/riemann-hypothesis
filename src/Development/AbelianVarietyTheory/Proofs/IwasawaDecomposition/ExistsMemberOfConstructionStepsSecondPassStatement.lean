  rw [hy]
  change (Ψ α * ∏ i, ψ i ^ a i) ^ _ = Ψ _
  rw [mul_pow, map_mul, map_pow, map_prod, ← Finset.prod_pow]
  congr 1
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [map_zpow, map_pow, ← hψ i, ← pow_mul, ← hk i, ← zpow_natCast, ← zpow_natCast, ← zpow_mul, ← zpow_mul,
    mul_comm]

