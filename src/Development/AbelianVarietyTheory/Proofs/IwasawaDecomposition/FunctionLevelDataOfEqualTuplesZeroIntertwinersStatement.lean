        GlobalTheory.IndefiniteRowSideFullHecke.SplittingKernelQuotients.IsQuotInt V' r (fun h => star (X v (κ.symm h)) * (e x).1 (PiTensorProduct.tprod ℂ d) (κ.symm h))
