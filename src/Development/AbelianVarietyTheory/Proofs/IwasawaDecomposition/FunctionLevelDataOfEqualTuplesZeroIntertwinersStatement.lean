  refine isQuotInt_congr (funext fun h => ?_) ?_ h1
  · simp only [row, LinearMap.coe_mk, AddHom.coe_mk, star_mul', Complex.star_def, Complex.conj_ofReal]
    ring
  · rw [ellT_unit M d hd, star_one, mul_one, hip, ← hs2]
    push_cast
    ring

