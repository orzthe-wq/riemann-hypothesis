  have : Continuous (ar τ).toHomUnits :=
    Units.continuous_iff.2 ⟨hc τ, ((hc τ).comp continuous_inv).congr fun g => by simp [← map_inv]⟩
  exact (continuous_const.mul this).mul continuous_const

