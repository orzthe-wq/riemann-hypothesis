def SameOrb (p q : Σ k, Frame (X k).Ψ r) : Prop := ∃ γ ∈ (X p.1).Γ, q = ⟨p.1, lact γ p.2⟩

theorem sameOrb_equivalence : Equivalence (SameOrb X) := by
