    subst h; omega
  · simp only [pairing, LinearMap.sum_apply, LinearMap.smul_apply]
    rw [Finset.sum_eq_single m (fun d _ hd => by rw [MvPowerSeries.coeff_monomial_ne hd, smul_zero])
