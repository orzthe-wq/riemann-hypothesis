    simpa [Pi.mul_def] using this.deriv
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 2 := by
    rcases n with _ | _ | m
    · have := he.self_of_nhds; simp [hs₀] at this; exact absurd this.symm hu0
