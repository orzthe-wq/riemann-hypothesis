noncomputable def transl {K : Type} [TopologicalSpace K] {f : (Fin g → ℂ) → ℂ}
    (hf : Differentiable ℂ f) (γ : C(K, Fin g → ℂ)) (z : Fin g → ℂ) : C(K, ℂ) :=
  ⟨fun k => f (z + γ k), hf.continuous.comp (continuous_const.add γ.continuous)⟩

