  exact Q.add_mem (_root_.GlobalTheory.PowerMembershipInertiaEigenvalues.main T Q hQ a _ h1) (_root_.GlobalTheory.PowerMembershipInertiaEigenvalues.main T Q hQ b _ (hQ _ h2))

