  obtain ⟨n, hn⟩ := (_root_.GlobalTheory.GLq.trIdem (Gn g d) (eU g d ψ) χ).1 (_root_.GlobalTheory.Adopt.whittakerJacquetIdempotents_properties_primeField g d 0 0 ψ).1 hchar
