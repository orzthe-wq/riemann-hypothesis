  have hnorm := _root_.GlobalTheory.GLq.GGNorm.gg_norm g ψ hψ n hn
  have hdec := (_root_.GlobalTheory.charDec (Gn g n) (gg ψ n)).2.1 (gg_isClass ψ n)
