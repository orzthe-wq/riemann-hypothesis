  have key : ∀ M ∈ S, ∃ ρ : Gn g n → ℂ, IsIrr ρ ∧ wh ψ ρ ≠ 0 ∧ ip ρ (hcL M.toList n) ≠ 0 :=
    fun M hM => _root_.GlobalTheory.GLq.GenericConstituent.exists_generic_constituent g ψ hψ M.toList n (hdeg M hM) (hcusp M hM)
