  have h3 := congrArg (PreTilt.coeff (O := Per.OC l) (p := l) 0) h2

  simp only [map_sum, map_pow, h0, one_pow, Finset.sum_const, Finset.card_range, map_zero,
  nsmul_eq_mul, mul_one] at h3
  exact hlm ((CharP.cast_eq_zero_iff _ l m).1 h3)

