      (∀ a k, ‖sh (y a k)‖ ≤ R) ∧ (∀ k, ‖sh (y j0 k)‖ ≤ r) ∧ r ^ l ^ h < ‖sh (y j0 0)‖ ∧
      ∀ i : Fin h, ∑ j, μ j * abelian₂ h i (y j) = 0 := by
