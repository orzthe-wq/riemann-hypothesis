  have hv : j ∈ a.vars :=
    (MvPolynomial.mem_vars_iff_mem_support j).2 ⟨β, hβ, Finsupp.mem_support_iff.2 h⟩
  have hlt : j < i := MvPolynomial.mem_supported.1 ha hv
  omega

theorem led_tri {l : ℕ} (hl : 2 ≤ l) (i : ℕ) (v : Rˣ) {a b : MvPolynomial ℕ R}
