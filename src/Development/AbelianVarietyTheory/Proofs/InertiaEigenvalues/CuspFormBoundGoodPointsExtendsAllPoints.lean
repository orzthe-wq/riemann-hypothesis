    · have e2 : ψ₀ ⟨_, hinv⟩ = (ψ g)⁻¹ := by
        apply eq_inv_of_mul_eq_one_left
        rw [← e1, ← map_mul, ← map_one ψ₀]
        congr 1
        exact Subtype.ext (inv_mul_cancel₀ hg0)
      rw [e2]; exact hi


