      IsUnit Bm → (∀ g, Γ.resΓ g = 1 → ∀ j, TWact (gR g) T g (x j) = x j) →
      (∀ j, TWmap φR T (x j) = ∑ k, I.ioE (Bm k j) • x k) →
      ∀ j i, (e T).repr (x j) i ∈ Set.range I.ioE := by
