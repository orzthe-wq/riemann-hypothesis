  refine ⟨LinearMap.range π, h1, h2, h3, fun c hc => ?_, ?_⟩
  · obtain ⟨z, hz⟩ := h3 c hc
    exact _root_.GlobalTheory.cocycle_dies_dR_of_dies_st l P AI T K V ρ c z hz
  have hφ : ∀ y ∈ Dst P ρ, phiV P ℚ_[l] V y ∈ Dst P ρ := fun y hy =>
    (mem_Dst P ρ).mpr fun g => by
