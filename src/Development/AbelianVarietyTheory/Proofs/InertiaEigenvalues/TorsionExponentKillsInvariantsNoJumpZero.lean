  obtain ⟨Θ⟩ := GlobalTheory.ThetaTie.nonempty_thetaL D l
  obtain ⟨Dm, U, g, hD, hA⟩ := GlobalTheory.Cyc.Decomp.exists_decompletion D HW F l K s LL h T M0 h0 hW d M A hM
  have hKm : K.1 ≤ Ks K (mN l s (M0 + h0)) :=
