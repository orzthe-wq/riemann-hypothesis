  have hfg : ∀ s, f (u s).1 = s.1 := by
    intro s
    simp [f, hu_mulVec]
  have hemb : IsEmbedding (fun s => (u s).1) :=
    IsEmbedding.of_comp hg hf (by
      have : f ∘ (fun s => (u s).1) = Subtype.val := funext hfg
