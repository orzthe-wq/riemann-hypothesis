          rw [Algebra.smul_def, star_mul, IsScalarTower.algebraMap_apply F E A.L,
            A.star_E,
            _root_.GlobalTheory.JR.Unram.star_fix,
            ← IsScalarTower.algebraMap_apply, ← Algebra.commutes, ← Algebra.smul_def]
          rfl }
