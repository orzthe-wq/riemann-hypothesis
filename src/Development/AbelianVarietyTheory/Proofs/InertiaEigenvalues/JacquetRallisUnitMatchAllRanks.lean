      simp only [Set.mem_setOf_eq, hfg, hu_mulVec]
    · rintro ⟨h₁, h₂⟩
      refine ⟨⟨f m, h₁⟩, ?_⟩
      apply Matrix.toLin'.injective
      apply LinearMap.ext
      intro v
      rw [Matrix.toLin'_apply, Matrix.toLin'_apply, hu_mulVec]
      exact (Set.mem_iInter.1 h₂ v).symm
