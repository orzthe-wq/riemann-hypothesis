    charpoly_separable_of_isGen A r τ p hτ j Ax.1 hAx
  have hcent : ∀ t : Matrix.unitaryGroup (Fin r) E, t.1 * Ax.1 = Ax.1 * t.1 →
      ∃ s, A.uHom hx s = t := by
    intro t ht
    let φ : A.L →ₗ[E] A.L :=
