          funext X; simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]; ring
        have d1 : IsTest (W1 h u' - u') := isTest_sub (hW1r.1 h u' htG) htG
        have d2 : IsTest (W2 h u - u) := isTest_sub (hW2r.1 h u htU) htU
