          have hs : W1 h u' - u' = (-1 : ℂ) • u' + W1 h u' := by
            funext Y; simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]; ring
          rw [hW1r.2.2.1 g h u' htG, hs, hW1r.2.2.2 g (-1) u' (W1 h u') htG (hW1r.1 h u' htG)]
          funext Y; simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]; ring
