theorem matchAt_of_mul [Unram F E] {r : ℕ} (M : Meas (r + 1) F E) (φ : F → ℂ) {f' : Gl (r + 1) F → ℂ}
    {f : Hn (r + 1) F E → ℂ} {a : Inv (r + 1) F} (h0 : φ (mom (sec a) 0) ≠ 0)
