  rcases h with rfl | rfl
  · by_cases h0 : (m : K) = 0 ∨ (r : K) = 0 ∨ (N : K) ^ d' = 0
    · refine ⟨0, ?_⟩
      rcases h0 with h | h | h <;> simp [h]
    · push Not at h0
      obtain ⟨a, b, c⟩ := h0
      refine ⟨1, ?_⟩
      push_cast
      rw [mul_pow]
      field_simp
  · exact ⟨0, by simp⟩

