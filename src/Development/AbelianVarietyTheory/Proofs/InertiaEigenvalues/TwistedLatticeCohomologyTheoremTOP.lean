variable {k : Type} [Field k] {l : ℕ} [hl : Fact l.Prime] [CharP k l]
  {R : RingPG k l} {ι : k⸨X⸩ →ₐ[k] k⸨X⸩} (hι : IsCyclotomic R ι)
