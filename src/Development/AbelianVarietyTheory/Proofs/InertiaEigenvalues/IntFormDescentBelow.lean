      (AdjoinRoot.mk (h.map g)).comp (Polynomial.mapRingHom g) := by
    ext <;> simp
  exact DFunLike.congr_fun this f

theorem trace_adjoinRoot_map : ∀ (R S : Type) [CommRing R] [CommRing S] (g : R →+* S) (h : R[X]),
