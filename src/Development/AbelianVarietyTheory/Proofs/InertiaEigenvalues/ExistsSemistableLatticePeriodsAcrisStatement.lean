  change f.mapMatrix _ = ∑ i ∈ Finset.range d, f (a i) • (f.mapMatrix N) ^ i

  rw [map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [← map_pow]
  ext a b
  simp [RingHom.mapMatrix_apply]

theorem texp_map {R R' : Type} [CommRing R] [CommRing R'] (q : ℚ →+* R) (q' : ℚ →+* R') (f : R →+* R') {d : ℕ}
