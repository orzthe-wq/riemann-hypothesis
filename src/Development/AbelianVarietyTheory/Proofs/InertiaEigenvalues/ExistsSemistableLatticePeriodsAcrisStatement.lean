  have hcσ : ∀ g : ↥(GK K), c.map (Per.σD (g : GQ l)) = c := by
    intro g
    have hσ1 : Q₀.map (Per.σD (g : GQ l)) * Q₀'.map (Per.σD (g : GQ l)) = 1 := by
      rw [← Matrix.map_mul, hQQ, Matrix.map_one _ (map_zero _) (map_one _)]
