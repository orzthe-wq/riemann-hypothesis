      rw [hEt σ hσ, ← Matrix.mulVec_sub, ← this, Matrix.mulVec_smul])
  refine ⟨D *ᵥ x, mulVec_mem_ball hint hx, fun σ hσ => ?_⟩
  have := hxe σ hσ
  simp only at this ⊢
  rw [twAct_mulVec act χ i M U D σ (hcomm σ hσ), ← Matrix.mulVec_sub, ← this, Matrix.mulVec_smul,
