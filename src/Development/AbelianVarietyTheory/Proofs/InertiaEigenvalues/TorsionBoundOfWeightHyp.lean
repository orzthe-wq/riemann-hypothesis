theorem sandwich {act : GQ l →* (PadicComplex l ≃+* PadicComplex l)} {χ : GQ l →* ℚ_[l]ˣ}
    {K : FinExt l} {m d : ℕ} {M U : GQ l → Matrix (Fin d) (Fin d) (PadicComplex l)}
    {D : Matrix (Fin d) (Fin d) (PadicComplex l)} {g : GQ l} (hD : IsDec act χ K m M D U g)
    (i : ℤ) (n : ℕ)
