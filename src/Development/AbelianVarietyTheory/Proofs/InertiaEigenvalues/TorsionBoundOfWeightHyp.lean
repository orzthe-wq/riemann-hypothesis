    ⟨(continuous_const.matrix_mulVec continuous_id).comp_continuousOn hc.1,
      fun σ hσ => mulVec_mem_ball hEint (hc.2.1 σ hσ), fun σ hσ τ hτ => by
        simp only [hc.2.2 σ hσ τ hτ, Matrix.mulVec_add, hEt σ hσ]⟩
    (by
      obtain ⟨x, hx, hxe⟩ := hk
