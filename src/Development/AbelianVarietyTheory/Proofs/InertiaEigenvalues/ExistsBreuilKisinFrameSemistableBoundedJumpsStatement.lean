    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
    rw [Nat.add_sub_cancel_left] at hdA hdA'
    choose A₀ hA₀ using hdA
    choose A₀' hA₀' using hdA'
    refine ⟨lower bk hτ F (Matrix.of A₀) (Matrix.of A₀') ?_ ?_, rfl, rfl⟩
    · ext i j; simp [hA₀ i j]
    · ext i j; simp [hA₀' i j]

