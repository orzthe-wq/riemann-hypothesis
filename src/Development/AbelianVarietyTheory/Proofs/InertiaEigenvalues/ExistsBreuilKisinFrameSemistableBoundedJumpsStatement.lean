  rw [eY, hfil]
  set Y := (X'J * κJ * XJ.map (Per.σDp g)) i j
  set P := (Matrix.of A0 * RJ * Matrix.of B0) i j
  have hσu : Per.σDp g u * Per.σDp g ui = 1 := by rw [← map_mul, hui, map_one]
