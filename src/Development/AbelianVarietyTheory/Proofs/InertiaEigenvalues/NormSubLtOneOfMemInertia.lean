  intro σ₀ hσ₀ hσ₀B

  let lift : (L ≃ₐ[ℚ_[l]] L) → GQ l := fun s =>
    if h : ∃ σ ∈ N, AlgEquiv.restrictNormalHom L σ = s then h.choose else 1
