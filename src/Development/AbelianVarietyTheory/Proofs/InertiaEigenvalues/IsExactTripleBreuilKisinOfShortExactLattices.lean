  have hex := _root_.GlobalTheory.BKReal.SESExact.homW_exact_middle t ϖ hS hF hH
  let φ : (ZMod a → A O K) →+* OW l O := (inclO l O).toRingHom.comp (ϖ.iTot t K).toRingHom
