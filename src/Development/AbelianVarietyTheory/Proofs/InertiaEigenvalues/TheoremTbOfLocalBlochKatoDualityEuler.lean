        LinearMap.lTensor T Nb.mkQ (TensorProduct.map (ρT g) (ρM g) x) := by
    intro g x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul t m => simp [hqb]
    | add x y hx hy => simp only [map_add (f := _), hx, hy]
