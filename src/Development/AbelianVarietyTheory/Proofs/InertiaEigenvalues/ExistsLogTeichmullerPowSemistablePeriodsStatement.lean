    linear_combination hsa + hsb - hE
  · set_option synthInstance.maxHeartbeats 200000 in
    simp only [map_add (f := algebraMap (Per.Acris0 l) (Per.Acris l)), map_mul, map_natCast]
    push_cast
    linear_combination hza + hzb

