  intro T _ _ p q n c c' h
  obtain ⟨m, P, h₁, h₂, h₃⟩ := exists_family_invariant_of_fockInner
    (Harm.rowHighest (κ := Fin n) ℂ c c') (Harm.rowHighest_ne_bot h c c')
