    (b * B + a * D) * Aᵀ - (b * A + a * C) * Bᵀ = a := by
  have e : (b * B + a * D) * Aᵀ - (b * A + a * C) * Bᵀ =
      b * (B * Aᵀ + -(A * Bᵀ)) + a * (D * Aᵀ + -(C * Bᵀ)) := by
    simp only [Matrix.mul_add, Matrix.add_mul, Matrix.mul_neg,
      Matrix.mul_assoc]; abel
  rw [e, h, h']; simp

