  · exact Matrix.isUnit_nonsing_inv_det _ hP
  · have h0 : ThFr.hMat X bas idx x = 0 := Matrix.nonsing_inv_apply_not_isUnit _ hP
    have ht : tauMat X bas idx x = 0 := by
      rw [ThFr.tauMat, h0, Matrix.zero_mul]
    rw [ht] at h
