variable {κ ι : Type} [Fintype κ] [Fintype ι] [DecidableEq ι] in
private lemma exp_mul_mul_exp_mul_eq_of_add_eq (d Θ X Y Z W : ℂ) (h : X + Y = Z + W) :
    Complex.exp X * (d * Complex.exp Y * Θ) = d * Complex.exp Z * (Complex.exp W * Θ) := by
