theorem up_smul_mem {v : Sp E n} (hv : v ∈ d.at P.1) : q • v ∈ d₀.at P.1 := by
  rw [up_at hP hq hq2 hd₀ h, (up_ok hP hq hq2 hd₀ h).f_smul P q v hv, Ideal.Quotient.eq_zero_iff_mem.2 hq, zero_mul]
