theorem idxExp_of_eq {P : HeightOneSpectrum (𝓞 E)} {N₁ N₂ : Submodule (𝓞 E) (Sp E n)}
    (h : localization₂ P.asIdeal N₂ = localization₂ P.asIdeal N₁) : idxExp P N₁ N₂ = 0 := by
