theorem phiT_eq (K : Type) [Field K] (d : Deco E a ST SG) (d' : Deco E b ST SG') (x : HomE E a b) :
    phiT K d d' x = if Rel d d' x then 1 else 0 := by
  unfold phiT Rel
  congr

