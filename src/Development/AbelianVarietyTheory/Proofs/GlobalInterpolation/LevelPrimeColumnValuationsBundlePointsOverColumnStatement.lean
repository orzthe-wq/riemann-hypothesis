  | zero => rw [Matrix.mulVec_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [Matrix.mulVec_add]; exact add_mem hx hy
  | smul r x _ hx => rw [Matrix.mulVec_smul]; exact Submodule.smul_mem _ _ hx

