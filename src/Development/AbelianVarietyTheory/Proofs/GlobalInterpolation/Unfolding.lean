theorem proj_incl (hθ : IsInfEmb τ θ) (z : E) :
    (θ.comp (Algebra.TensorProduct.map (fstA F) (AlgHom.id F E)).toRingHom) (inclR (AF F) z) = τ z := by
  rw [← hθ.1 z]
