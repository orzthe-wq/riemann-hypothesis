  have h3 : (B.map (inclR (AF F))).map p = B.map τ := Matrix.ext fun _ _ => proj_incl hθ _
  rw [← h3]
  exact (Matrix.map_mul (f := p)).symm.trans ((congrArg (fun m => m.map p) hg).trans (Matrix.map_mul (f := p)))

