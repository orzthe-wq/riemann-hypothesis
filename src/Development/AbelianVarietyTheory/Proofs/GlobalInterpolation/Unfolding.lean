    refine ⟨⟨W.frame.equivFun.symm (x' 0), ?_⟩, congrArg _ e⟩
    rw [← e] at h1
    exact (hd _ _).symm.trans (h1.trans hxx)

theorem unramified_host (D : D7) : UnramifiedAtFinite D.host.F D.host.E := by
  letI := D.host.cmStar
