theorem exp_int (n : ℤ) : Complex.exp (-(2 * (Real.pi : ℂ)) * Complex.I * ((n : ℝ) : ℂ)) = 1 := by
  rw [← Complex.exp_int_mul_two_pi_mul_I (-n)]
  congr 1
