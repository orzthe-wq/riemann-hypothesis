      unfold zT; rw [if_pos (hsym.2 ho)]
    have hpos : 1 ≤ D.R.N j := by have := rkS X D hN; omega
    have he : ((D.R.N j : ℤ) - 1) = ((NN X.G.P.m X.t j - 1 : ℕ) : ℤ) := by
      rw [← hN.1]; push_cast [Nat.cast_sub hpos]; ring
    rw [hz, kOdd, he, zpow_natCast]
