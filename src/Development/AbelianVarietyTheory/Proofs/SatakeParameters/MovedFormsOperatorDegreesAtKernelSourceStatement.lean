    have hz : zT X D pos (dfr X D hN d f') (pos ⟨v, s⟩) = dfr X D hN d f' (pos ⟨v, s⟩) := by
      unfold zT; rw [if_neg (fun h => ho (hsym.1 h))]
    have h2 := congrFun (congrFun (hE ho) a) t
    rw [Matrix.map_apply] at h2
    rw [h0, h2, hz]
    rfl

