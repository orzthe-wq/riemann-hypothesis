  have hc : ((Finset.univ : Finset (Fin (R.k - 1))).val.map
      (fun i => twistedJump P j s ⌊P.v i⌋)).filter
        (fun u : ℤ => |u| ≤ ((⌊η⌋₊ + R.t + 2 : ℕ) : ℤ)) = 0 := by
