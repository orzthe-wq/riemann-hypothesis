    {Pl0 I0 Ty : Type} {B : BlockDat K G Pl0} (D : InertDat3 B I0 Ty) {X : Finset (G → K)}
    {p : Typ3 K Pl0 I0 Ty} (hp : p ∈ D.ixFin3 X) : p.1 ∈ B.resSet X := by
