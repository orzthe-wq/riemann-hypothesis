  simp_rw [hterm]
  rw [map_prod]
  exact (Fintype.prod_sigma (fun x => ι (embT D (pos x) (M : Matrix (Fin n) (Fin n) D.host.E).det ^ (-(wT X D pos j (pos x)))))).symm.trans
    (Fintype.prod_equiv pos _ _ (fun _ => rfl))

