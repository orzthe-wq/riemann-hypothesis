theorem eq_zero_of_le_pow {x K r : ℝ} (hx : 0 ≤ x) (hK : 0 ≤ K) (hr0 : 0 ≤ r) (hr : r < 1)
    (h : ∀ N : ℕ, x ≤ K * r ^ N) : x = 0 := by
  by_contra hne
  have hpos : 0 < x := lt_of_le_of_ne hx (Ne.symm hne)
