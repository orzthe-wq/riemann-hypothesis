    z * topDat Ch sel mu cst (m2 + 1) P y y₂ := by
  intro X Pr R Ch sel S mu cst L G m2 hOk hU b P hP g z hmid g' z' htop y y₁ y₂ hδ hq
  classical
  have hm := hOk.hm
  have hcst := hOk.cst_ok
