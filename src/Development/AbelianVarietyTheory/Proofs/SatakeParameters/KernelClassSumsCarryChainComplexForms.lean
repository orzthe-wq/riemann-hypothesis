  obtain ⟨P, hP, rfl⟩ := hf
  obtain ⟨n, h1, h2, h3, h4⟩ := _root_.GlobalTheory.KerWtStep.trueWt_step D u C A Pm M i hi
  have hle : D.R.N i ≤ D.R.N (i + 1) := by
    unfold Ranks.N
    exact Nat.add_le_add_left (Nat.mul_le_mul_right _ (Nat.le_succ _)) _
