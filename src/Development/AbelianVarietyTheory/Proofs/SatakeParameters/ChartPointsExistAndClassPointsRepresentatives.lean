      (((ratA F B)⁻¹ * g * ratA F B : GL (Fin N) (E ⊗[F] FiniteAdeleRing (𝓞 F) F)) :
        Matrix (Fin N) (Fin N) (E ⊗[F] FiniteAdeleRing (𝓞 F) F)) i j ∈ Formalism.L2.Herm.intAf F E := by
