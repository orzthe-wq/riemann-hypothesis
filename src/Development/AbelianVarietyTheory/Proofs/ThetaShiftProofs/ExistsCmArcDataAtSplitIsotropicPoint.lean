              typeP := (hasType_baseChange E H _ _ f _ _ (a true) ρ 1 0).1 hinj X.typeP
              typeM := (hasType_baseChange E H _ _ f _ _ (a false) ρ 0 1).1 hinj X.typeM
              typeB := (hasType_baseChange E H _ _ f _ _ mb ρ p q).1 hinj X.typeB
