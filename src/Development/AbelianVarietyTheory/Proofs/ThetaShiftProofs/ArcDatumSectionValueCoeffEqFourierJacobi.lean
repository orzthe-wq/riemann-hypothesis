theorem betaAt_comp (f : X' ≃ₗ[𝓞 E] X) (ξ : Module.Dual ℤ X) {N : ℕ} {be : LinearMap.BilinForm ℤ X}
    {be' : LinearMap.BilinForm ℤ X'} (hbe : ∀ y z, be' y z = be (f y) (f z)) {ν₀ : E} {jj : ℤ}
