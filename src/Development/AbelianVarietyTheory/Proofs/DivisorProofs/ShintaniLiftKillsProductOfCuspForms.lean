    have h := (ZMod.natCast_eq_natCast_iff _ _ _).2 ha
    have hv : ∀ r : ZMod (l' + 1), (((r.val + (l' + 1) * (a (ef.symm r)).val : ℕ) : ZMod ((l' + 1) * m))).val
        = r.val + (l' + 1) * (a (ef.symm r)).val := fun r =>
