    simp only [hv]
    rw [h]; push_cast
    rw [← Equiv.sum_comp ef.symm (fun j : Fin (l' + 1) => (k : ZMod (q ^ ((l' + 1) * m) - 1)) *
      (q : ZMod (q ^ ((l' + 1) * m) - 1)) ^ (j : ℕ) * ((q : ZMod (q ^ ((l' + 1) * m) - 1)) ^ (l' + 1)) ^ (a j : ℕ))]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [pow_add (q : ZMod (q ^ ((l' + 1) * m) - 1)) r.val, hef, mul_assoc, ← pow_mul]
