def e8LB {S : Scheme.{0}} (G₀ : Over S) [GrpObj G₀] (L : LB G₀.left) (W : Matrix (Fin 8) (Fin 8) ℤ) :
    LB (powObj G₀ 8).left :=
  LB.LinComb L (K := (Fin 8 × Fin 8) × Fin 4)
    (fun k => lamPts (powPr G₀ k.1.1) (powPr G₀ k.1.2) k.2) (fun k => -(W k.1.1 k.1.2 * negε k.2))

