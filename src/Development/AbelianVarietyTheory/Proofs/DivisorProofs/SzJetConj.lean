    QAll (Sz l lam r) N fun τ => f τ - g τ := by
  obtain ⟨a, ha, hs⟩ := hf
  obtain ⟨b, hb, ht⟩ := hg
  exact ⟨_, (_root_.GlobalTheory.QFam.hasQ_linear N).2.1 f g a b ha hb, fun n => ((_root_.GlobalTheory.QFam.SzSum.sz_ring l lam).2.1 r _ _ (hs n) (ht n)).2⟩

