  have := hab₀.smooth
  have := hab₀.proper
  have := hab₀.geomConnected
  obtain ⟨φ₂₀, hsq₀⟩ := exists_isSquare hpb₀.1.w
  have hpb₂₀ := isPullback_of_isSquare hpb₀.1 hsq₀
  have : IsProper (B₀ ⊗ B₀).hom := by
