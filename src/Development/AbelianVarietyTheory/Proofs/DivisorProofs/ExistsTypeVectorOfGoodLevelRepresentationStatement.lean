  let ρ : ResF v ≃+* kP PP :=
    (splitResidueEquiv (GlobalTheory.SplitProjChart.emb φ)).symm.trans (Ideal.quotEquivOfEq (congrArg HeightOneSpectrum.asIdeal hP))
  refine ⟨s, ρ, fun k i j => ?_⟩
  obtain ⟨y, hy⟩ := hst k
