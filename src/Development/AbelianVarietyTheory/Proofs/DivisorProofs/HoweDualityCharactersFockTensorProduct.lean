    rw [this]
    exact N.sub_mem hn (Submodule.mem_sup_right hd)
  ·
    obtain ⟨f₀, hf₀⟩ := _root_.GlobalTheory.HoweR.hw_le_span_sup_coinv P Q R S x μ' hJ
