  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
  have h : ((‖σ a‖ ^ 2 : ℝ) : ℂ) = starRingEnd ℂ (σ a) * σ a := by
    rw [Complex.conj_mul']
    push_cast
    rfl
  rw [h]
  ring

