def avg (hσ : IsURepOn (UJset ε) σ) (u : H) : Poly n →ₗ[ℂ] H where
  toFun P := ∫ k : KG ε, ev (toMK k) P • σ (toMK k) u ∂(muK ε)
  map_add' P Q := by
    rw [← integral_add (integrable_avg hσ u P) (integrable_avg hσ u Q)]
