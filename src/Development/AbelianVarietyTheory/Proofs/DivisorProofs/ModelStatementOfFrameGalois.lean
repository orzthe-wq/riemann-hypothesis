    rw [← MultilinearMap.map_update_sum]
    congr 2
    apply Subtype.ext
    simp only [Submodule.coe_sum, Submodule.coe_smul]
    conv_rhs => rw [← sum_rowComp _ M hM _ hcol]

    rw [show rowDiv O a a 1 (∑ w ∈ Fintype.piFinset (fun _ : Fin N => Finset.range (M + 1)),
