  exact _root_.GlobalTheory.eq_of_isAffineOpen_of_ringKrullDim_le_one X hX V (ReciprocityTheory.ChartRestriction.G.Out.nonzeroLocus t) hV (fun x hx => (key x (hVW hx)).2 hx)
    (fun z hz hz1 => (key z (hW z hz1)).1 hz)

