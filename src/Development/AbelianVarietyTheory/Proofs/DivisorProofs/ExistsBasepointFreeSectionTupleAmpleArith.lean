variable {T : Scheme.{0}}

def tp (L : LB T) (k : ℕ) : LB T :=
  Nat.rec (LB.triv T) (fun _ M => CechPic.tens L M) k

theorem isLB_tp {L : LB T} (hL : L.IsLB) : ∀ k, (tp L k).IsLB
