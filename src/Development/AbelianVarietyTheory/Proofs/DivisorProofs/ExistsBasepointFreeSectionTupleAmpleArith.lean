    intro i j
    by_cases hij : i = j
    · exact ⟨0, fun h => (h hij).elim⟩
    obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp (hm i j hij)
    exact ⟨z, fun _ => ⟨hz, by rw [← hyz]; simpa using hy⟩⟩
