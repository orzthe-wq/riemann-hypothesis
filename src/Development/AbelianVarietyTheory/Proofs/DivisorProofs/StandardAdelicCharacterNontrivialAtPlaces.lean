  rw [_root_.GlobalTheory.TraceRealEmbeddingSum.trace_eq_sum_mult_mul_re, Algebra.trace_prod_apply, PI.ProdFormulaE.Tr.trace_pi, PI.ProdFormulaE.Tr.trace_pi,
