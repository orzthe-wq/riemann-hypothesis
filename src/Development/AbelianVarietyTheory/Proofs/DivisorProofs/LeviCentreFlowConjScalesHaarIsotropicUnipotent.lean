theorem adMat_one' {p : ℕ} : adMat F (1 : Matrix (Fin p) (Fin p) E) = 1 := Matrix.map_one _ (map_zero _) (map_one _)

theorem adMat_zero' {p q : ℕ} : adMat F (0 : Matrix (Fin p) (Fin q) E) = 0 := Matrix.map_zero _ (map_zero _)

