  intro a ha
  have h := GlobalTheory.LatVac.symp_smul_smul σ JA JB (-1) a 1 x u
  rw [hx a ha, one_smul, mul_one, Tw.VacIndic.symp_zero_left] at h
  rw [smul_eq_mul]
  exact h.symm

