      · change Smooth (pullback.snd P.A.hom p); infer_instance
      · change IsProper (pullback.snd P.A.hom p); infer_instance
      · change GeometricallyConnected (pullback.snd P.A.hom p); infer_instance
    refine ⟨{ X := PUnit
              B := _
              isAbelian := hab
