  refine ⟨this, _root_.GlobalTheory.KeySmoothBase.isDiscreteValuationRing_atPrime_span ?_⟩
  intro h
  exact hϖ.ne_zero (PowerSeries.C_injective (h.trans (map_zero _).symm))

