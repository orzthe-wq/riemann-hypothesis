theorem exists_galois (B : Type) [CommRing B] [Module.Finite ℤ B] :
    ∃ (N : IntermediateField ℚ ℂ) (_ : NumberField N) (_ : IsGalois ℚ N), ∀ χ : B →+* ℂ,
