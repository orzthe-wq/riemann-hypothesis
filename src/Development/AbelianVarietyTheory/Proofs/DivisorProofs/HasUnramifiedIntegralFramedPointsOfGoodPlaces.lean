theorem exists_ell_fibre {E : Type} [Field E] [NumberField E] [IsCMField E] (H : Host E) :
    ∃ (M : IntermediateField ℚ ℂ) (_ : NumberField M) (ω : 𝓞 M) (C : GlobalTheory.CM.Ell H (𝓞 M) ω) (C₀ : GlobalTheory.CompRat.Curve H)
