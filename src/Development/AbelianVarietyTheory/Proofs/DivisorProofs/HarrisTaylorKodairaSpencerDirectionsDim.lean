    intro x; rw [hPx, map_smul, map_sub, map_smul, hA2]
    linear_combination (norm := module) (0:k) • x
  have hPfix : ∀ x, A x = r • x → P x = x := by
    intro x hx; rw [hPx, hx]
    linear_combination (norm := module) hc1 • x
  have hPkill : ∀ x, A x = r' • x → P x = 0 := by
