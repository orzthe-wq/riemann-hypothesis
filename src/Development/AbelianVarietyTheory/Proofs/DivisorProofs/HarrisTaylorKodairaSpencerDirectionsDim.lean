  obtain ⟨I, -⟩ := o₀.geom k (𝟙 _) β (by rw [Category.id_comp, ht])
  have hc : ∀ c : 𝓞 D.F, LinearMap.charpoly (GlobalTheory.HTCount.crysAct o₀ (algebraMap (𝓞 D.F) D.O c)) =
