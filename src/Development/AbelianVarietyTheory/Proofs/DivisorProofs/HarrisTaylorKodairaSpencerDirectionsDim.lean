      have h := hAP v
      linear_combination (norm := module) c • h - hc1 • v + hc1 • P v
    rw [e]; exact F.smul_mem _ hv
  have hwP : ∀ (F : Submodule k H) v, r' • v - A v ∈ F → P v ∈ F := by
    intro F v hv
    have e : P v = (-c) • (r' • v - A v) := by
      have h := hAP v
      linear_combination (norm := module) (-c) • h - hc1 • P v
    rw [e]; exact F.smul_mem _ hv
