          Module.Projective (k ⊗[ℤ] 𝓞 F) (HdR A₀) := by
  intro F _ _ k _ H A₀ _ _ hA a
  exact projective_of_baseChange k (AlgebraicClosure k) A₀ hA a
    (H _ (GlobalTheory.isAbelianScheme_pullback_obj _ A₀ hA) _)

