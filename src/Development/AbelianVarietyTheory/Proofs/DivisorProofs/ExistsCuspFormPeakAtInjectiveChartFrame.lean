    ((fun u => lact (γ.1)⁻¹ u) ⁻¹' GlobalTheory.Unfold.satFrames X x A).indicator φ
  have hχm : ∀ γ, Measurable (χ γ) := fun γ =>
    hφ.indicator ((GlobalTheory.Unfold.continuous_lact X _).measurable hS)
