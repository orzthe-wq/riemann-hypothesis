    have h1 : (1 : ℝ) ≤ i.factorial := by exact_mod_cast i.factorial_pos
    calc (Real.pi ^ m)⁻¹ ≤ (Real.pi ^ i)⁻¹ :=
          inv_anti₀ (pow_pos Real.pi_pos _) (pow_le_pow_right₀ hπ1 hi')
