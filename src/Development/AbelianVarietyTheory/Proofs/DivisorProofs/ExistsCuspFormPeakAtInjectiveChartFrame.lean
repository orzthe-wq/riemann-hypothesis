      GlobalTheory.Unfold.rmul_mem_satFrames_iff X x A _ hb, hφB u hu b hb]
  have hterm : ∀ γ : X.Γ, ∫⁻ z in A, φ (lact γ.1 (cpt X x z)) ∂muF X x =
      ∫⁻ z, χ γ (cpt X x z) ∂muF X x := by
