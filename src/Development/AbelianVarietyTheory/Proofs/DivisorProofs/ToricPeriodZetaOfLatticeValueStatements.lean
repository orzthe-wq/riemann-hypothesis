        rw [show algebraMap (𝓞 E) E r₀ = (r₀ : E) from rfl]; push_cast; ring, map_mul]
    ring
  rw [e, psiAt_add, h _ (Ideal.mul_mem_right _ _ hπP), one_mul]
  apply psiAt_eq_one
  rw [map_mul, ht]
  calc WithZero.exp ((1 + diffExp w : ℕ) : ℤ) * Valued.v (r - algebraMap (𝓞 E) (w.adicCompletion E) r₀)
