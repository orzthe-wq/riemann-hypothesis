  · rintro ⟨n, r, t, ht, rfl⟩
    exact Submodule.sum_mem _ fun i _ => by
      rw [← Algebra.smul_def]
      exact Submodule.smul_mem _ _ (Submodule.subset_span (ht i))
  · intro hx
