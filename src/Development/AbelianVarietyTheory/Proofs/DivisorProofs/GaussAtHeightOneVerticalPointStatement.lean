  have hb1 : algebraMap _ X.functionField b ≠ 0 :=
    fun h => hb0 (IsFractionRing.injective (X.presheaf.stalk x) X.functionField (h.trans (map_zero _).symm))
  rw [← algebraMap_cstAt p x, ← map_pow, ht, map_mul, map_mul]
