  constructor
  · intro hv
    refine ⟨1, (maximalIdeal.isMaximal T).ne_top ∘ (Ideal.eq_top_of_isUnit_mem _ · isUnit_one), ?_⟩
    rw [map_one, one_mul, mem_spanBy_iff]
