      exact hcomp D.G D.F hGF y
  · apply le_antisymm
    · intro x hx
      rw [LinearMap.mem_ker, ha] at hx
      obtain ⟨y, hy⟩ := GlobalTheory.DetInv.ker_map_subset_im_map (Ainf p O) C f (xi ε) (nu ε) h D.F D.G
