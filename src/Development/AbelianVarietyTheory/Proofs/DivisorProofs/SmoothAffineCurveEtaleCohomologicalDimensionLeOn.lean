private theorem cone_qis_of_natural_homotopyEquiv {P C : Type*} [Category P] [Category C] [Abelian C]
    (F : P ⥤ C) (G : P ⥤ CochainComplex C ℤ) {X₁ X₂ X₃ X₄ : P}
    (u' : X₁ ⟶ X₂) (u : X₃ ⟶ X₄) (a : X₁ ⟶ X₃) (b : X₂ ⟶ X₄)
