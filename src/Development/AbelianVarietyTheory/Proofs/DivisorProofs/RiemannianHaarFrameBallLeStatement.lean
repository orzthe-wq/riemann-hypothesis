  all_goals simp only [LinearMap.coe_comp, Function.comp_apply, Complex.reLm_coe, Complex.imLm_coe, LinearMap.restrictScalars_apply, ContinuousLinearMap.coe_coe, PiLp.proj_apply, boxEnt, if_true]
