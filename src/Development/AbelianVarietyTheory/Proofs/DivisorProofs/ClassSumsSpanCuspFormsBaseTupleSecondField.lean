theorem mem_of_mul {X : Type} {S : Submodule ℂ (X → ℂ)} {a φ ψ : X → ℂ} (ha : ∀ x, a x ≠ 0) {I : Type} {s : I → X → ℂ}
    {u : ℂ} (hu : u ≠ 0) (hφ : φ ∈ Submodule.span ℂ (Set.range s)) (hs : ∀ j, ∃ p ∈ S, ∀ x, s j x = a x * p x)
