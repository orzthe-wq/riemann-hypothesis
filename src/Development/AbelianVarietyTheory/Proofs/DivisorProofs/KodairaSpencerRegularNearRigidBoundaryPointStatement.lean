  have d0 : d 0 = 0 := by simpa using hadd 0 0
  have d1 : d 1 = 0 := by simpa using hd 1 1
  let g₁ : Γ(X, W.1) →+* DualNumber C :=
    { toFun := fun r => TrivSqZeroExt.inl (ψ r) + TrivSqZeroExt.inr (d (ψ r))
