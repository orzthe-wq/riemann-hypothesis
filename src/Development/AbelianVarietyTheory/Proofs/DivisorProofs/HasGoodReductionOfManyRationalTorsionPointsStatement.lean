      a ≫ G.hom = spMap (algebraMap k (FractionRing (PowerSeries k))) ∧
      ¬ ∃ b : Sp (PowerSeries k) ⟶ G.left, spMap (algebraMap (PowerSeries k) (FractionRing (PowerSeries k))) ≫ b = a := by
