    rw [finprod_eq_zero _ U.u h0 hfin, mul_zero]
  rw [hfu] at hne
  have hmem := Set.mem_of_indicator_ne_zero hne
  obtain ⟨A, hA, rfl⟩ := ht
  obtain ⟨a, ha, b, hb, e⟩ := U.frame.mem_iwahoriCoset.1 hmem
