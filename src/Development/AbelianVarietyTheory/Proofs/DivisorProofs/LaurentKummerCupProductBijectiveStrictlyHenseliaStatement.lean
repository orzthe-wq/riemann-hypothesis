theorem exist (B : Subalgebra ℤ A) {T : Type} [CommRing T] [HenselianLocalRing T]
    (f : RB A B →+* T) (ψ : O A B →+* ResidueField T) (hψ : ψ.comp (algebraMap _ _) = (residue T).comp f) :
