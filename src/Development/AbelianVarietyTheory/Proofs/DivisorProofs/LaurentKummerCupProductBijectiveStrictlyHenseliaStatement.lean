  IsLocalization.lift (M := (pB A B).primeCompl) (isUnit_of_notMem A B)

@[simp] theorem toA_algebraMap (B : Subalgebra ℤ A) (b : B) : toA A B (algebraMap B (RB A B) b) = b :=
