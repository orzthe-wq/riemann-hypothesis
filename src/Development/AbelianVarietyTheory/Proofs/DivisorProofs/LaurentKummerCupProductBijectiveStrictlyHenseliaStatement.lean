def cP : cech (fT A A') ⟶ cech (fB A A') := Arrow.mapCechNerve (constArr A A')

def cS : cech (fB A A') ⟶ cech (fT A A') := Arrow.mapCechNerve (oneArr A A')

abbrev inc : Fin (1 + 1) → (A' →+* A' ⊗[A] A') :=
