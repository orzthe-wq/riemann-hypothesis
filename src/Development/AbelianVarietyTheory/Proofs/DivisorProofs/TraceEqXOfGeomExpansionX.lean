  {e : H ≃ₜ* H'} {ι : H →* Matrix n n ℂ} {ι' : H' →* Matrix n n ℂ} {a : Matrix n n ℂ}
  [MeasurableSpace H] [BorelSpace H] [MeasurableSpace H'] [BorelSpace H']
