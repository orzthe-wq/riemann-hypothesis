  have := h8.proper
  have hfin : IsFinite ((𝟙 (Zob c.A B)) ^ d).left := GlobalTheory.GrpTangent.isFinite_id_pow _ hu
  have hlm : mu ≫ la = 𝟙 B ^ d := hZ.2.2.2.2.2.2.1
