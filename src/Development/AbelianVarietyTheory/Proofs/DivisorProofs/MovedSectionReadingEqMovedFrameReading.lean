    · simp
    · have : (-1 : E) = algebraMap ℚ⟮s⟯ E (-1) := by simp
      rw [this, Algebra.norm_algebraMap, hev.neg_one_pow]
  obtain ⟨j, hj⟩ := exists_neg_one a (y ^ 2) (by rw [← pow_mul, mul_comm, pow_mul, hy, one_pow]) h2
