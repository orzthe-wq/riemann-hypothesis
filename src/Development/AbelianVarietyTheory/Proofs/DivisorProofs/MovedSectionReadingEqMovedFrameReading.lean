  rcases sq_cases s _ (hs' s d hs) (d_nsq s d h3 hs) k k.2 _ h1 with ⟨a, ha⟩ | ⟨b, hb⟩
  · nlinarith [sq_nonneg a]
  · exact rat_nsq d c hd hc (by omega) b (by linarith)

private lemma two_nsq (k : ℚ⟮s⟯) : k ^ 2 ≠ 2 := by
  intro h
