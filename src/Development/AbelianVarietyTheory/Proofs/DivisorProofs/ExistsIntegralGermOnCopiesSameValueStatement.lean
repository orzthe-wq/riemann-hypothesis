theorem contSt_holds : ContSt := by
  intro C _ v τ σ ι _ _ _ W g hg α
  obtain ⟨Q, hQ⟩ := CoeffCont.coeff_subst_eq_eval W g hg α
  obtain ⟨K, hK⟩ := CoeffCont.poly_bound v Q
  refine ⟨⌈K⌉₊, fun s s' hs hs' hss => ?_⟩
