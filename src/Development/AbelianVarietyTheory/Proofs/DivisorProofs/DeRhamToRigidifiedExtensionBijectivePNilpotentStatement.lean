      have e1 : ρ.comp i₁ = restrictR h' hE f := by
        ext x; simp [ρ, i₁, restrictR]
      have e2 : ρ.comp i₂ = restrictR h' hE g := by
        ext x; simp [ρ, i₂, restrictR]
