theorem exists_isTorsChar :
    ∀ (p : ℕ) (R : Type) [CommRing R] (A : Over (Sp R)) [GrpObj A] (G : PDivGroup p R)
      (t : PDivGroup.TorsionTower G A) (N : ℕ) (b : G.A N),
