@[simp] theorem sum_univ_finThree_vecThree : ∑ i ∈ ({0, 1, 2} : Finset (Fin 3)), ![a, b, c] i = a + (b + c) := by
  rw [Finset.sum_insert (by decide : (0 : Fin 3) ∉ ({1, 2} : Finset (Fin 3))), vsum_12]
