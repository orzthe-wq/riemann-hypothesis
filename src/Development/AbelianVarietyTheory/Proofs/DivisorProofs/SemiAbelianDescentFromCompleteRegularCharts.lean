    rw [← cancel_mono i, Category.assoc, hl, H.lift_fst]
  · intro s
    exact H.lift_snd _ _ _
  · intro s m h1 h2
    apply H.hom_ext
    · rw [H.lift_fst, ← h1, Category.assoc, hl]
    · rw [H.lift_snd, h2]

theorem isPullback_of_comp_mono {C : Type*} [Category C] {P X Y W Z : C} {p : P ⟶ X} {q : P ⟶ Y}
