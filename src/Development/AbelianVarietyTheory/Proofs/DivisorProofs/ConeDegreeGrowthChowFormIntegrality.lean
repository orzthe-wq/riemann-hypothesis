theorem growth_hilb_eq (ev : V →ₗ[K] Ω) (D a : ℕ) (ha : 1 ≤ a) (δ : ℕ) (h : IsImageDeg ev D δ) :
    growth D (fun k => hilb ev (a * k)) = (a : ℝ≥0∞) ^ D * δ := by
