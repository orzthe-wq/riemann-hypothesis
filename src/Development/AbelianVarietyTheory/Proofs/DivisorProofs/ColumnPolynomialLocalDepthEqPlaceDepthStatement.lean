variable (L : LogFGL v d) {n : ℕ} {Λ : Type} [Fintype Λ] (β : Λ → Fin n → C) (w : Λ → Fin d → C)

def lin (j : Fin n) : Fin d → MvPowerSeries Λ C :=
  fun e => ∑ l, (β l j * w l e) • (X l : MvPowerSeries Λ C)

def psi : Fin n × Fin d → MvPowerSeries Λ C :=
