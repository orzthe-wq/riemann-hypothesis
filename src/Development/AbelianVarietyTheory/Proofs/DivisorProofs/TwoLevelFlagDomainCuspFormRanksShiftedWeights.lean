def quotT (x : Frame X.Ψ r) : ℝ :=
  X.pnorm (Xa.Fp + T • Xa.L) f x ^ 2 * thetaFac X Xa x /
    sumSq X Xa Fl x ^ ((T : ℝ) + nd X + 6 + 1 / 2)

theorem quotT_inv (hf : X.IsSec (Xa.Fp + T • Xa.L) f) {γ : GL (Fin r) E} (hγ : γ ∈ X.Γ)
