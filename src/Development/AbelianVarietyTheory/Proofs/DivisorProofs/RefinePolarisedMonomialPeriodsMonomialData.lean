      (h (κ ≫ (x * y).left))⁻¹ * h (κ ≫ x.left) * h (κ ≫ y.left) * (h (κ ≫ (1 : T ⟶ B).left))⁻¹ := by
  simp only [Fin.prod_univ_four]
  simp [lamPts, negε]
