  have hmon := GlobalTheory.T.exists_monomial_trivialisation_sqrt_refinedPolarisedData R R₂ Q (σ.comp ρ₁) (rescale D₂ fun χ => et (xe χ)) (xe.trans e) m t r δ hCN₂ hinj hD₃
    hev₃ hb₃ hmono hnn ht0 hr'
