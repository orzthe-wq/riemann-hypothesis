      = ∑ w, ∑ u, ∑ v, (S v u * a' v w) • c w (e y u) := L (fun v u w => (S v u * a' v w) • c w (e y u))
    _ = ∑ w, ∑ u, (∑ v, a' v w * S v u) • c w (e y u) := by
