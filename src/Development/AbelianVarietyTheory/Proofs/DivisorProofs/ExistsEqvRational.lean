  apply CartesianMonoidalCategory.hom_ext
  · rw [Category.assoc, mTw_fst, ← Category.assoc, mTw_fst, Category.assoc, twK_comp_eq_id h, Category.comp_id,
      Category.id_comp]
  · rw [Category.assoc, mTw_snd, mTw_snd, Category.id_comp]

