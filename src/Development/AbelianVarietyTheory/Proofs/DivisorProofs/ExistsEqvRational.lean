  · simp only [translT]
    rw [Category.assoc, Category.assoc, lift_fst, mTw_fst, ← Category.assoc, lift_fst]
  · simp only [translT]
    rw [Category.assoc, Category.assoc, lift_snd, mTw_snd, lift_snd]
