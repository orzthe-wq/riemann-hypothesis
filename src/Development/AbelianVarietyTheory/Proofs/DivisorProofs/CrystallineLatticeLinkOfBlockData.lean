      LinearIndependent F (fun j => red (c j)) := by
  intro m
  induction m with
  | zero =>
    intro _
    exact ⟨Fin.elim0, fun j => j.elim0, linearIndependent_empty_type⟩
  | succ m ih =>
    intro hm
    obtain ⟨c, hcV, hci⟩ := ih (Nat.le_of_succ_le hm)
