      {z : (Qv v ⊗[ℚ] G.C)ˣ | ∃ g : (Qv v ⊗[ℚ] G.C)ˣ, z = g * yV G y v * g⁻¹} := by
    ext z
    simp only [Set.mem_setOf_eq]
    constructor
    · rintro ⟨g, rfl⟩
