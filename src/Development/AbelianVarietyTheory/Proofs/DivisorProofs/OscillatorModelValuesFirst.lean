    have := GlobalTheory.RestrMeas.lintegral_fin_prod_eq_prod (μ := fun _ : Fin n => ν.restrict F)
      (f := fun k t => ENNReal.ofReal (φ (e s k + t)))
      fun k => (hφ.comp (continuous_const.add continuous_id)).measurable.aemeasurable
    refine this.trans ?_
