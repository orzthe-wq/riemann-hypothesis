theorem prod_monomial' {R σ ι : Type} [CommRing R] (s : Finset ι) (n : ι → σ →₀ ℕ) (c : ι → R) :
    ∏ i ∈ s, (monomial (n i) (c i) : MvPowerSeries σ R) =
