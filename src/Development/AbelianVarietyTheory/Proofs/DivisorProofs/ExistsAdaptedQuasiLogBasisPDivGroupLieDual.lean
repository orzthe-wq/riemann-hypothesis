  obtain ⟨b, z, hbz, hl⟩ := _root_.GlobalTheory.PDivGroup.dual_lie_exists_eval_mod_pow p O G l 1
  rw [pow_one] at hbz
  obtain ⟨f, s, y, hf, hs, hy⟩ := _root_.GlobalTheory.QLog.additive_mod_p_is_defect p O E hF G d c b z hbz
