theorem eq_of_mem_closure [Finite Γ] (ρ : Γ →* Aut X) (γ : Γ) (x : X)
    (h : x ∈ closure ({(ρ γ).asIso.hom x} : Set X)) : (ρ γ).asIso.hom x = x := by
