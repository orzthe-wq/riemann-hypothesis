    (h : ∃ b ∈ Ideal.span {p}, q = algebraMap B Q b) : ∃ b ∈ (⊤ : Ideal B), c * q = algebraMap B Q b := by
  obtain ⟨b, hb, e⟩ := h
  obtain ⟨b', rfl⟩ := Ideal.mem_span_singleton'.1 hb
  refine ⟨b', Submodule.mem_top, ?_⟩
  rw [e, map_mul, ← mul_assoc, mul_comm c, mul_assoc, hc, mul_one]

