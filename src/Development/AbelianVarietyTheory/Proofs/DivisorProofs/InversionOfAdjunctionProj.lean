  haveI : IsProper s := IsProper.of_comp s p
  obtain ⟨S', hS'⟩ := DivOver.exists_over ℂ X Y p s hbir S
  obtain ⟨σ, hσz, hS'σ⟩ := DivOver.isAt_lift ℂ X Y p s hbir inferInstance S' S hS' z hSz
