  congr 1
  funext i
  simp only [up]
  rw [map_up θ Θ hΘ, hν]

theorem map_defect (θ : B →+* O) (Θ : Q →+* C) (hΘ : ∀ b, Θ (algebraMap B Q b) = algebraMap O C (θ b))
