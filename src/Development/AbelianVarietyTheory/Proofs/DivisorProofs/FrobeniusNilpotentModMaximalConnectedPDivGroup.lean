  unfold defect
  rw [map_sub, map_subst hs]
  congr 1
  · ext α; simp [coeff_map]
  · congr 1
    funext i
    simp only [up]
    rw [map_up θ Θ hΘ, MapNMul.map_nmul B O θ d μ hμ]
    congr 2
    funext j
    exact hν j

