  · by_cases hwz : w = z
    · subst hwz
      exact absurd ((off_add_smul X p n (Δ + (1 - δ) • D) B c w hoff).1.2 hkw) hw
    · exact _root_.GlobalTheory.ClosureDimensionSpecialization.dim_closure_le_of_specializes X z w j hzw hwz hdim
