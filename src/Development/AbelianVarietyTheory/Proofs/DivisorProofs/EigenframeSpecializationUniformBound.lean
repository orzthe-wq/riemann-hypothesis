  let b : U → Fin m → ℝ := fun s a => realDotC (μ s a) (v s)
  have hdot : Continuous (fun p : (Fin g → ℂ) × (Fin g → ℂ) => realDotC p.1 p.2) := by
    unfold realDotC; fun_prop
  have hμa : ∀ a, Continuous (fun s : U => μ s a) := fun a => (continuous_apply a).comp hμ
