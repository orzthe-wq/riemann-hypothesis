    (h : ∀ (F : Type) [Field F] [IsAlgClosed F] [Algebra (FractionRing T.V) F] (z : O), ((β z : c.F) : ℂ) = zeta l.A →
      ∃ I : (letI := H.starRing; TateIsoQ Dm D.toPre oD F),
