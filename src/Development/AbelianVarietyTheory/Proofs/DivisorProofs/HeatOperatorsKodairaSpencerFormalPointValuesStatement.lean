    have := (AddMonoidHom.mk' d' hadd).map_zsmul m y
    simp only [AddMonoidHom.mk'_apply, zsmul_eq_mul] at this
    simp only [Algebra.smul_def, eq_intCast]
    rw [this]; simp
  · have h1 := hmul 1 1
    simp only [RingHom.id_apply, _root_.one_mul, _root_.mul_one] at h1
