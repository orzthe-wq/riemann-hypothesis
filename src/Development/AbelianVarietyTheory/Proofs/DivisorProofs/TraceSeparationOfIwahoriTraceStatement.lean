  have hT1 := _root_.GlobalTheory.IndefiniteRowSideFullHecke.RangeTrace.hasFinTrace_of_range_le X (H ∘ₗ B) Z hrange
  let e : (Fin (Module.finrank ℂ S) → R) ≃ₗ[ℂ] Z := LinearEquiv.ofInjective Φ' hinj'
