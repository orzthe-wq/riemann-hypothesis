  rw [hz] at he
  have e₁ := hf _ h₁
  have e₂ := hf _ h₂
  simp only [Darboux.rho] at e₁ e₂
  rw [Darboux.rho, he, schr_boxFun ψ hψ, e₁, e₂, symp_dbl_toCols]
  funext x
  simp only [boxFun, Pi.smul_apply, smul_eq_mul, star_mul', star_apply_eq_neg ψ hψ, mul_sub]
