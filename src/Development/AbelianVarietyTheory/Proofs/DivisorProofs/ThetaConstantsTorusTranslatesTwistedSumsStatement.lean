      g₂.b = g₁.b ∧ (∀ z J, Good 𝔪.D.toPre.P.L z J → (val w₂ (𝟙 _) z J).val = cstH z u⁻¹ * (val w₁ (𝟙 _) z J).val) ∧
      ∀ (s : Fam 𝔪.D.toPre (FractionRing V) 1) (β : 𝔪.D.toPre.X), coef s g₂ w₂ β =
