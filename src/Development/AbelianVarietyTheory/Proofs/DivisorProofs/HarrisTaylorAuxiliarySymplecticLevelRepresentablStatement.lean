    (fun c g => g ≫ o.act.act c)
    (fun n g g' c => Out.WeilIs A PP.L n g g' (unitOn c)) (fun n g g' c => Out.WeilIs A PP.L n g g' (unitOn c))
    ρ ρ' (Units.map φ.toMonoidHom) (Units.map φ'.toMonoidHom)
