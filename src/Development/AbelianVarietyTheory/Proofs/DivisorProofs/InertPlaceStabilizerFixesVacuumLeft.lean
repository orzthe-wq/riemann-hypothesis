  obtain ⟨t, ht, b, hb, hbL, hspan⟩ := exists_basis F E v n X.L hX.lat
  let Bm : Matrix (Fin n) (Fin n) E := Matrix.of b
  have hBm : IsUnit Bm := Matrix.linearIndependent_rows_iff_isUnit.1 hb
