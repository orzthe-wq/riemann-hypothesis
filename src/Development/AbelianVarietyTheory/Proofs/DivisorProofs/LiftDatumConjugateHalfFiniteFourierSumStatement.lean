theorem trace_redM {D : D7} (PP : Pl D.host.E) {a b : ℕ} {A : Matrix (Fin a) (Fin b) (EAf D)} {B : Matrix (Fin b) (Fin a) (EAf D)}
    (hA : IsIntM A) (hB : IsIntM B) :
    ∃ h : Matrix.trace (A * B) ∈ Formalism.L2.Herm.intAf D.host.F D.host.E,
