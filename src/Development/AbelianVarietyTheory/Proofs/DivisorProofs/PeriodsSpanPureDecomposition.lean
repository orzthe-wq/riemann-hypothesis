    exact tor r x
  · show Φ (I'.ev (p ^ (r + s)) x) ^ p ^ s = Φ (I'.ev (p ^ r) x)
    rw [← map_pow, pow_add]
    exact congrArg Φ (I'.tower _ _ (q0 r) (q0 s) x)
  · obtain ⟨z, hz⟩ := E1 _ (q0 r) _ _ (tor r x) (tor r y)
    have i1 := I'.isom _ (q0 r) (k • x) (k • y)
