    have i3 : e 1 (Φ (I'.ev (p ^ r) x) ^ p ^ r) (Φ (I'.ev (p ^ r) y) ^ p ^ r) 1 := by rw [tor, tor]; exact e11
    have i4 := E4 _ _ _ _ _ i3
    rw [one_mul, sq] at i4
    have i5 := E2 _ _ _ _ _ (E3 _ (p ^ r) _ _ _ hz) i4
    have eF : D.toG.EF (k • x) (k • y) = (c : ℤ) * (D.EF x y * m) := by
      show D.EF (k • x) (k • y) = _
