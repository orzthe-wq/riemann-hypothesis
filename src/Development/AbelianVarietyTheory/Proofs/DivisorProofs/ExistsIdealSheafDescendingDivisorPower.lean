def USetup.regSet (X₁ : USetup C) : Set X₁.M.Z := {z | X₁.S.R ≤ X₁.M.O z}

theorem USetup.isOpen_regSet (X₁ : USetup C) : IsOpen X₁.regSet := by
  obtain ⟨s, hs⟩ := X₁.S.fg
  have e : X₁.regSet = ⋂ a ∈ s, {z | a ∈ X₁.M.O z} := by
    ext z
