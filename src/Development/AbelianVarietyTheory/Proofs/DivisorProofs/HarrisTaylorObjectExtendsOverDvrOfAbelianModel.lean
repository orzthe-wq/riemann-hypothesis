theorem sp_point {R W R' : Type} [CommRing R] [CommRing W] [CommRing R'] (gm : R →+* W) (β : R →+* R')
    (x : Sp R' ⟶ Sp W) (hx : x ≫ spMap gm = spMap β) : ∃ β₀ : W →+* R', spMap β₀ = x ∧ β₀.comp gm = β := by
  refine ⟨(Spec.preimage x).hom, by simp [spMap], ?_⟩
