def mixφ {R : Type} [CommRing R] [IsDomain R] (D₁ D₂ : DegPre R) (b : D₁.P.A ⟶ D₂.P.A) (α : D₁.X) :
    PUnit.{1} ⊕ Fin 4 → (D₁.P.A.left ⟶ D₁.P.A.left ⨿ D₂.P.A.left) :=
  Sum.elim (fun _ => b.left ≫ coprod.inr) (fun k => D₁.famφB α k ≫ coprod.inl)

