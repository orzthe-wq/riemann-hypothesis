    rintro rfl
    apply hw; funext i; rw [hv i, zero_mul]; rfl
  have hsum : ∑ i, a i * v i = 1 := by
    apply mul_left_cancel₀ hc0
    rw [mul_one, Finset.mul_sum]
    conv_rhs => rw [← ha]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hv i]; ring
