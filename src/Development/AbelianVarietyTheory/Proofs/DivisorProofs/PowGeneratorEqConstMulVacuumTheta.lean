    split_ifs
    · exact one_mem _
    · exact zero_mem _

theorem ne_zero_of_meanOne {X : Data E r} {bas : (Fin g ⊕ Fin g → ℤ) ≃ₗ[ℤ] X.Λ} {idx : Fin g ≃ X.Ψ × Fin r}
    {x : Frame X.Ψ r} {L : Lt E r} {ϑ : (Fin g → ℂ) → ℂ} (h : MeanOne X bas idx x L ϑ) : ϑ ≠ 0 := by
