  have hT := GlobalTheory.Chain.VacVec.cart_isCartanInv M
  have hu := (Matrix.isUnit_iff_isUnit_det _).1 (M.fr_unit τ)
  obtain ⟨ε, hε, -, ht⟩ := hBT
