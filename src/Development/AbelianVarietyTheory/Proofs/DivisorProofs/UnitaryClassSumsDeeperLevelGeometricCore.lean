theorem exists_lift (hs : Function.Surjective yy) (hc : D.Compat yy₁ yy) [Module.Free ℤ Y] {κ : X₁.S.Gam}
    (hκ : κ ∈ yy₁.ker) : ∃ h ∈ yy.ker, D.m • h = D.lab κ := by
