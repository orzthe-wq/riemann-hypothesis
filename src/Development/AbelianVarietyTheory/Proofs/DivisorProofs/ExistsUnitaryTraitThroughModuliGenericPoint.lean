          ∀ (p : ℕ) (W : ValuationSubring ℂ) (hp : p.Prime) (hW : (p : ℂ) ∈ W.nonunits) (b : 𝓞 c.F →+* c.V W),
            (∀ x, ((b x : c.V W) : c.F) = (x : c.F)) → Dominates Ygl (s.Y p W hp hW ⟨l, c, hg p hp⟩) b := by
