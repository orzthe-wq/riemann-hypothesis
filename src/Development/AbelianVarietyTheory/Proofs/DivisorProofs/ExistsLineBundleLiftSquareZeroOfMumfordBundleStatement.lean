  · simp only [gen]
    rw [_root_.ReciprocityTheory.ChartRestriction.G.DVR.res_res', _root_.ReciprocityTheory.ChartRestriction.G.DVR.res_res']
    exact (coc hL m m' T.m _ _ _).symm
