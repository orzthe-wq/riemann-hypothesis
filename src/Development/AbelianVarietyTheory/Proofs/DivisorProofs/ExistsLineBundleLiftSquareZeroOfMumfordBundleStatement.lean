    σ, 0, fun T T' a ↦ ?_, hσ, (map_zero _).symm, fun T T' T'' a b ↦ ⟨map_zero _, ?_⟩⟩
  · have := congrArg (fun f ↦ f.hom (w _ _ ((pH P L).map a)).val)
