      have ht : yb (ψ.symm z) = spMap ((y z : B →ₐ[ℂ] ℂ) : B →+* ℂ) := by simp [yb]
      obtain ⟨u, τ, hu, hτ⟩ := exists_fibre h𝒜 ht (hφ z) (hL z) hb.1 (P (ψ.symm z)) hb.2.1 hb.2.2.1 hb.2.2.2.1
        hb.2.2.2.2
