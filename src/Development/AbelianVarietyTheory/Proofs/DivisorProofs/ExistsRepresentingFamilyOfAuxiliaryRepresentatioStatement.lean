theorem exists_sympLev_pull {S S' : Scheme.{0}} {s : S ⟶ Sp R} {s' : S' ⟶ Sp R} {o : Obj b N s} {o' : Obj b N s'}
    {f : S' ⟶ S} (m : ObjMap o' o f) {h M : ℕ} {B : Type} [CommRing B] {ζ : B} {t₁ : S ⟶ Sp B}
