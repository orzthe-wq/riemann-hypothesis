          (SemiHom.ofHom (𝟙 G)) (SemiHom.ofHom (𝟙 G)) (fun n a => rfl) _ _ _
          (hP k k (RingHom.id k) G G _ _ cc (c k G h) _ _ hμ' (hlaw k G h) hcc (hc k G h) _)
