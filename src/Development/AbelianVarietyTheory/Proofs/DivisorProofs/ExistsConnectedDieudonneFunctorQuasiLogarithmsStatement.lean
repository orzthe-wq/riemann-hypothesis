          (hP k k (RingHom.id k) G G _ _ (c k G h) (c k G h) _ _ (hlaw k G h) (hlaw k G h) (hc k G h)
            (hc k G h) _) x).symm.trans
          (chartPull_id (c k G h) (hlaw k G h) _
