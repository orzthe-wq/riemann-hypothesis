  have key : ∀ A : Matrix (Fin r) (Fin r) R, (∀ i j, A i j ∈ S) → ∀ w : Fin r → R, (∀ i, w i ∈ S) →
      ∀ i, Matrix.mulVec A w i ∈ S := by
    intro A hA w hw i
