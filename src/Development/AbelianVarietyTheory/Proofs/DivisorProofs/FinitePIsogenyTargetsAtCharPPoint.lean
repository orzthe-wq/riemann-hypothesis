    rw [hD0, ← hp]
    change (η[A]).left (((c ≫ y) ≫ A.hom) _) = (η[A]).left p
    exact congrArg (η[A]).left (Subsingleton.elim (α := Spec (CommRingCat.of k)) _ _)
