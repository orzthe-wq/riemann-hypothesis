  rw [TopCat.Presheaf.germ, counitAb]
  erw [colimit.ι_desc_apply]
  rfl

end GlobalTheory.SkyMod

namespace GlobalTheory.SkyMod

variable {X : Scheme.{u}} (x : X)

def counitApp (M : ModuleCat.{u} (X.presheaf.stalk x)) :
