  rw [cls_pull o.isLB _ h1, cls_pull o.isLB _ h2, ← pull_comp, ← pull_comp, ← Over.comp_left, ← Over.comp_left,
    comp_lift, comp_lift, lift_fst_assoc, lift_snd, lift_fst, lift_snd_assoc] at k
