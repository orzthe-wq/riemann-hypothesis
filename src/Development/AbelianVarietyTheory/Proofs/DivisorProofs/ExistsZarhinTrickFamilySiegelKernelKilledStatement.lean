  have h1 := pull_isLB o.isLB (lift (fst o.A o.A ≫ act a) (snd o.A o.A)).left
  have h2 := pull_isLB o.isLB (lift (fst o.A o.A) (snd o.A o.A ≫ act (bar' a))).left
