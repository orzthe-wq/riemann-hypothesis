        (∀ j, (P j).map ψ *ᵥ (ψ ∘ B₀ j) = ψ ∘ B₀ j) ∧ ∀ v, ∃! a : Fin N → S, v = ∑ j, a j • (ψ ∘ B₀ j) := by
