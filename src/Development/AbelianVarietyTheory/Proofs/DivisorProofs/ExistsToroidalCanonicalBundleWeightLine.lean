  choose A₁ hA₁ using fun i j => hsA (i, j) (Finset.mem_univ _)
  have eB : (Matrix.of B₁).map (algebraMap R L) = (s : R) • Bm := by ext i j; exact hB₁ i j
  have eA : (Matrix.of A₁).map (algebraMap R L) = (s' : R) • Am := by ext i j; exact hA₁ i j
