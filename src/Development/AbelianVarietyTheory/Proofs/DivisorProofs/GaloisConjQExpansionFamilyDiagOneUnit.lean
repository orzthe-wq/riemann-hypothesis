  refine ⟨n, ?_⟩
  have h4 : (N : F) * c * ν = (N : ℚ) • (ν * c) := by
    rw [Algebra.smul_def, map_natCast]; ring
  rw [Algebra.traceForm_apply, h4, map_smul, smul_eq_mul] at hn
