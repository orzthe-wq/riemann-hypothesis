  obtain ⟨s, hs, -⟩ := A.left.sheaf.existsUnique_gluing' V U (fun i => homOfLE (hVU i)) hcov b hcompat
  refine ⟨s, fun z hz => ?_⟩
  have h1 := hb ⟨z, hz⟩ z (hzW z hz)
  have h2 := GlobalTheory.valAt'_map (u.ex z).left (homOfLE (hVU ⟨z, hz⟩)).op s (hzW z hz)
