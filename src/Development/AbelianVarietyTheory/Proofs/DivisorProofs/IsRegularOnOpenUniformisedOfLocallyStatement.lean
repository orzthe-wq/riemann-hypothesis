  let K : Type := {z // z ∈ pre u.ex U}
  let V : K → A.left.Opens := fun z => W z.1
  have hVU : ∀ i : K, V i ≤ U := fun i => hWU i.1 i.2
  have hb : ∀ i : K, ∃ b : Γ(A.left, V i), ∀ z ∈ pre u.ex (V i), k z = val u.ex (V i) b z := fun i => hreg i.1 i.2
  choose b hb using hb
