    res hM (M.g i i') * res h' (w.s (i', k')) = res h (w.s (i, k)) * res hL (L.g k k') := by
  exact res_intertwines (w.s (i, k)) (w.s (i', k')) (M.g i i') (L.g k k') _ _ (hw (i, k) (i', k')) h h' hM hL

