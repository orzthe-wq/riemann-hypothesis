  have hσl : ∀ f, σ.hom (α.hom f) = a f := fun f => congr($(P.inl_desc _ _ hw).hom f)
  have hσr : ∀ r, σ.hom (β.hom r) = b r := fun r => congr($(P.inr_desc _ _ hw).hom r)
