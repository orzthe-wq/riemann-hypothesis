theorem fn_eq_of_generic {X : Scheme.{0}} [IsIntegral X] (ξ : X)
    (hξ : ∀ O : X.Opens, (O : Set X).Nonempty → ξ ∈ O) {U : X.Opens} {a b : Γ(X, U)}
