      ∃ i, (b i ⬝ᵥ S.ev 0) / d ≠ 0 ∧ ((b i ⬝ᵥ S.ev 0) / d)⁻¹ ∈ M.O z) :
    ∃ (O : LB (Q.G.hom ⁻¹ᵁ W).toScheme) (τ : S.J → O.Sec), O.IsLB ∧ ⨆ i, nonzeroLocus (τ i) = ⊤ ∧
      (∀ (a : Q.L.L.ι) (k : O.ι), ∃ u : Γ((Q.G.hom ⁻¹ᵁ W).toScheme,
          LB.wchart Q.L.L (fun _ : Fin 1 => (Q.G.hom ⁻¹ᵁ W).ι) (fun _ => a) ⊓ O.U k)ˣ,
