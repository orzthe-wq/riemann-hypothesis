      ∀ (K : Type) [Field K] [IsAlgClosed K] (x : Sp K ⟶ M.Z), Set.range x ⊆ W → ∀ c : S.J → K,
        (∀ (g : Sp K ⟶ (Q.G.hom ⁻¹ᵁ W).toScheme) (k : O.ι), (g ≫ (Q.G.hom ⁻¹ᵁ W).ι) ≫ Q.G.hom = x →
          ∑ i, c i * valF g _ ((τ i).f k) = 0) → c = 0 := by
  obtain ⟨O, τ, hO, hτ, hp, hind, -⟩ := hQ W b haff hb
