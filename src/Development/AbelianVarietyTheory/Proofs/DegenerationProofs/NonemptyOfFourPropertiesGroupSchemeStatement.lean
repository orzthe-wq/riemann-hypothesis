      have hx : ⊤ ≤ x ⁻¹ᵁ ((LPow ρ.P.A ρ.P.L S.N (baseOver (Sp S.R))).pull r₀).U (fun _ _ => jP) := fun y _ => by
        refine mem_pull.2 (Set.mem_iInter.2 fun _ => ?_)
        have := hj' (x := y) trivial
        rw [← hr₀] at this
        exact this
