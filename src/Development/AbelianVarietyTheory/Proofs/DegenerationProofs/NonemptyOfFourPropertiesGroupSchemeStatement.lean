  refine ⟨(hu.map (W.ι.appLE _ V (W.ι.preimage_image_eq V).ge).hom).unit, fun _ => ?_⟩
  refine (valR_appLE j W.ι _ hV f).trans ?_
  rw [hj]
  exact hf

