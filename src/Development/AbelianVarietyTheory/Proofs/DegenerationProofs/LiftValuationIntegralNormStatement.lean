    {t' : LB.Gen (LB.LinComb L' φ' ε')} {r' : Sp F ⟶ Y'} {J' : (Sp F ⟶ X') → L'.ι} (hJ' : Good L' z J')
    (h : val t r z J = val t' r' z J') : vF t r J = vF t' r' J' :=
  (stalkConst z).injective ((const_vF t r hJ).trans ((congrArg Units.val h).trans (const_vF t' r' hJ').symm))
end Val

