    rw [d.tx_ex_smul] at a
    rw [cubN] at ih
    rw [cubN, Finset.prod_range_succ, Nat.cast_succ, add_smul, one_smul, one_mul, Nat.mul_succ, pow_add (d.fr x), pow_succ (d.fr (x + x))]
    replace a := congrArg Additive.ofMul a
