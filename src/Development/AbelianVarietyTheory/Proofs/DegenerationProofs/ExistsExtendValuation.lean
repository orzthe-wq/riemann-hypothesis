  intro S hS
  obtain ⟨h₁, h₂, h₃⟩ := h (S.comap f) fun r => by rw [ValuationSubring.mem_comap, e]; exact hS _
  simp only [valuation_comap_eq_one, e] at h₂ h₃
  exact ⟨h₁, h₂, h₃⟩

