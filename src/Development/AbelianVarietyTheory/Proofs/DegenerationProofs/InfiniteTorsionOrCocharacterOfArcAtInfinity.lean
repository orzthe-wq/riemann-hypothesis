  · rw [CommRingCat.ofHom_comp, Spec.map_comp]
    have : IsIso (CommRingCat.ofHom e.toRingEquiv.toRingHom) := e.toRingEquiv.toCommRingCatIso.isIso_hom
    infer_instance
