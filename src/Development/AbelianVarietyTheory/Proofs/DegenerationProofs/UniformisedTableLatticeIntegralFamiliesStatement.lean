    rw [← ofMul_mul, ← hf _ _ _ hp]
    exact congrArg (fun p => Additive.ofMul (f p)) (qk_ext rfl rfl)
  · exact congrArg (fun p => Additive.ofMul (f p)) (qk_ext (by simpa [r] using hy.symm) hg.symm)

