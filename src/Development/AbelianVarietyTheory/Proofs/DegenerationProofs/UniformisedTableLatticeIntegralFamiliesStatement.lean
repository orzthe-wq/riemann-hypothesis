  rw [cmb_iff] at h ⊢
  intro j
  have hB' : ∀ i, (b i).f j = ∑ i', cHom _ (B i i') * (τ i').f j := fun i => hB i j
  rw [h j]
  exact sum_comp _ a B (fun i => (b i).f j) (fun i => (τ i).f j) hB'

