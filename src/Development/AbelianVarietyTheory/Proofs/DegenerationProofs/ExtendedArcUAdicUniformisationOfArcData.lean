theorem exists_iso_of_generic (h : HomExtSt) (T K : Type) [CommRing T] [IsDomain T] [IsDiscreteValuationRing T]
    [CommRing K] (hK : IsField K) [Algebra T K] [IsFractionRing T K] (G G' : Over (Sp T)) [GrpObj G] [GrpObj G']
