theorem unit_iff {Z : Scheme.{0}} (z : Z ⟶ T'.left) :
    z ≫ p'.left = z ≫ T'.hom ≫ eSec D'.P.A ↔ (z ≫ h) ≫ p.left = (z ≫ h) ≫ T.hom ≫ eSec D.P.A := by
