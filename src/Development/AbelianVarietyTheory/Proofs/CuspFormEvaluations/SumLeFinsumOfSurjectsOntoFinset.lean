    (f : EuclideanSpace ℂ J ≃ₗ[ℝ] EuclideanSpace ℂ J) (x : EuclideanSpace ℂ J) :
    x ∈ I2.lat (b.map f) ↔ f.symm x ∈ I2.lat b := by
  let fz : EuclideanSpace ℂ J ≃ₗ[ℤ] EuclideanSpace ℂ J := f.toAddEquiv.toIntLinearEquiv
