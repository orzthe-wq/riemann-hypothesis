  refine ContinuousOn.div ((pnorm_contOn X _ het.1).pow 2) (ContinuousOn.pow ?_ _)
    fun x hx => (pow_pos (sum_pnorm_pos hnz hx) _).ne'
  exact continuousOn_finsetSum _ fun k _ => (pnorm_contOn X _ (hw k).1).pow 2

