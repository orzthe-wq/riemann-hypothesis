theorem anFacts_back (X : PJ D B P j) (E : PtExt X) (hM : IntAtExt X E) (n : SecNorm B)
    (R : Rdg (PJ.tol2NormAlt n.N n.h0 n.h1 n.h2 n.h3 n.h4 (xplus X E hM))) {N : ℕ} {ka wL wF : WeightFamilies.Wt D j}
