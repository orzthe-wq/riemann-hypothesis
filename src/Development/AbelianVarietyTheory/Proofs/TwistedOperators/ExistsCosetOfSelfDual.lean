  have hMfg : M.FG := by
    have hN : IsNoetherian (𝓞 D.host.E) Λ := isNoetherian_of_fg_of_noetherian _ hfg
    have hc := (IsNoetherian.noetherian (M.comap Λ.subtype)).map Λ.subtype
