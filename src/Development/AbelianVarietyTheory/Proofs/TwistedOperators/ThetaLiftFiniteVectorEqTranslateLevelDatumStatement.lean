  · obtain ⟨h1, h2, h3⟩ := hΛ'' u hu
    rw [partAt_eq] at h1 h3
    simp only [partAt_eq] at h2
    rw [← hbd] at h3
    have hu' : u ∈ GlobalTheory.PlaceModel.half S T e' := (GlobalTheory.PlaceModel.isHalf_iff S T).1 hh
