theorem isNilpotent_sub_one_of_full_block_unipotent {κ : Type} [CommRing κ] {n r : ℕ} (hr : r ≤ n) (h : r = n) {g : GL (Fin n) κ}
    (hg : g ∈ blockTri (blk2 r)) (hn : IsNilpotent ((upperLeftBlock hr g).val - 1)) : IsNilpotent (g.val - 1) := by
