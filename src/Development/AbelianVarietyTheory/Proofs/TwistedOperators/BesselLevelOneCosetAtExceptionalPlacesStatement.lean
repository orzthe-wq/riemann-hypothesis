    (z : k) = t q * ((fun j => p.pr (cA D (a j q))) ᵥ*
      ((G.V (.grid (2 * (σ + 1) + 1) 0)).gram.map (fun c => p.pr (incA D c)) * β.b)) i := by
  intro D hO T L μ0 hL sc G W M hM F hF σ h v hv k _ _ _ _ p β ϖ κ h1 h2 h3 h4 h5 h6 h7 t ht a ha q i
  have hq := q.2
