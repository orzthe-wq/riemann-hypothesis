theorem conj_exp_mul_exp (x : ℝ) : conj (cexp ((x : ℂ) * I)) * cexp ((x : ℂ) * I) = 1 := by
  rw [← Complex.exp_conj, map_mul, Complex.conj_ofReal, Complex.conj_I, ← Complex.exp_add]
