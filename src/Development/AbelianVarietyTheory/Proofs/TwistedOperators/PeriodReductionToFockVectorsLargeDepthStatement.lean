  obtain ⟨hs1, hd1⟩ := sigOK_and_isSelfDualC_grid hL (i + 1) j hp1 hp2
  obtain ⟨hs2, hd2⟩ := sigOK_and_isSelfDualC_grid hL i j (by omega) hp2
