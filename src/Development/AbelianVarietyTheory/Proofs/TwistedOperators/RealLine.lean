    liftP W M (colPath t n) (colFam t n f'') F =
      liftP W M (colPath t n) (colFam t n f) F + liftP W M (colPath t n) (colFam t n f') F
  | 0, _, _, _, j0, _, _, _, _, _ => j0.elim0
