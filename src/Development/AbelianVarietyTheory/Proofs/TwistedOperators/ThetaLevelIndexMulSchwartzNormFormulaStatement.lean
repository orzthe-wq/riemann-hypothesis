    rintro ⟨hA, hB⟩
    apply hc
    intro PP hP
    by_cases hg : PP ∈ Pg
    · rw [locH_of_mem Pg Hl hg]
      exact hA PP hg
    · rw [locH_of_not Pg Hl hg]
      have hq : PP ∈ Q := (Finset.mem_union.1 hP).resolve_left hg
      obtain ⟨g, hg'⟩ := (exists_GL_iff _).2 (hB PP hq).2
      exact ⟨(hB PP hq).1, g, Subgroup.mem_top _, hg'⟩

