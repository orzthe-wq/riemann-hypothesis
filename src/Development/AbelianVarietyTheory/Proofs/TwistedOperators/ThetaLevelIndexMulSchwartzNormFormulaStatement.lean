    unfold omegaG
    split
    · rename_i h
      exfalso
      obtain ⟨hlow, g, hg1, -, hg3⟩ := h
      apply hc
      intro PP hP
      have h3 : (fun PP : ↥Pg => upperLeftBlock hr (g PP)) ∈ Subgroup.pi Set.univ Hl := hg3
