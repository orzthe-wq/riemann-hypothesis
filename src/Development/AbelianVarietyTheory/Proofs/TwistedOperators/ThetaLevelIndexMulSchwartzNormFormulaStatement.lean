    refine ⟨y, hHd, hy, fun heq => hne ?_⟩
    have h1 := hχ y hy (rep (c - d) + rep d)
    have hr : red (rep (c - d) + rep d) = c := by rw [map_add (f := _), hrep, hrep, sub_add_cancel]
    rw [hr, AddSubgroup.coe_add, hB, AddChar.map_add_eq_mul, ← hχd y d, heq] at h1
