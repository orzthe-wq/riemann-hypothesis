  · refine Matrix.ext fun k p => ?_
    simp only [colsOf, Pi.one_apply, one_mul]
    rfl
  · refine Matrix.ext fun k p => ?_
    simp only [colsOf, Pi.one_apply, one_mul]
    rfl

