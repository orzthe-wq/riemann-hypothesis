theorem coords_of_eq {S S₀ : HSp D} {ρ : ℕ} (d : HypDec S S₀ ρ) {x : Fin S.rank → D.host.E} {w w' : Fin ρ → D.host.E}
    {z : Fin S₀.rank → D.host.E} (hx : x = d.e *ᵥ w + d.i₀ *ᵥ z + d.e' *ᵥ w') :
    d.qX *ᵥ x = w ∧ d.q0 *ᵥ x = z ∧ d.qY *ᵥ x = w' := by
