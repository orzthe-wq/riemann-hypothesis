      (∀ v : HeightOneSpectrum (𝓞 F), ¬ I ≤ v.asIdeal → e v = 0) ∧
      (e ⊗ₜ[F] (1 : E) : RA F E) • (h.1 - 1) = 0 ∧ (e ⊗ₜ[F] (1 : E) : RA F E) • (k.1 - 1) = k.1 - 1 ∧
