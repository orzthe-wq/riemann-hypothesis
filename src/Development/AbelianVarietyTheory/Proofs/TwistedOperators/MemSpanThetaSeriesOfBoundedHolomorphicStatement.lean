    ∃ (γ : GL (Fin n) E) (h k : GL (Fin n) (RA F E)) (e : FiniteAdeleRing (𝓞 F) F),
      IsUnE c G γ.1 ∧ IsUnA c G h.1 ∧ IsUnA c G k.1 ∧ g.1 = fm F γ.1 * h.1 * k.1 ∧
