  have he_half : ∀ v : WO S T, IsHalf e (e • v) := fun v a b => by
    rw [Matrix.smul_apply, smul_eq_mul, ← mul_assoc, hee]
  have heint : ∀ u ∈ GlobalTheory.AdForm.stdHom S T, e • u ∈ GlobalTheory.AdForm.stdHom S T := fun u hu =>
