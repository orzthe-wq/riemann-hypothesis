    rw [heq, ← Matrix.mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, Matrix.one_mul]
  have adj : ∀ (C C' G : Matrix (Fin n) (Fin n) R) (w : R), C'.det * w * f = f → f • C = G * (f • C') →
