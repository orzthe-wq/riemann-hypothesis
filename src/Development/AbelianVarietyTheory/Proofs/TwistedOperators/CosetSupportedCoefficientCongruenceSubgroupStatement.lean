  have e0 : (1 - B) = (1 - Matrix.of s).map (Formalism.L2.Herm.intAf D.host.F D.host.E).subtype := by
    ext i j
    rw [Matrix.map_apply, Matrix.sub_apply, Matrix.sub_apply, map_sub, Matrix.of_apply, Matrix.one_apply,
      Matrix.one_apply, ← hsB]
