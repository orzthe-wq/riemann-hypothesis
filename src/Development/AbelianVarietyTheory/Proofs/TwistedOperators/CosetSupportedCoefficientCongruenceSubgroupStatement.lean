    rw [Matrix.smul_apply, Matrix.smul_apply, smul_eq_mul, nsmul_eq_mul, ← mul_assoc,
      show ((k : AE D)) = algebraMap D.host.F (AE D) (k : D.host.F) from (map_natCast _ k).symm,
