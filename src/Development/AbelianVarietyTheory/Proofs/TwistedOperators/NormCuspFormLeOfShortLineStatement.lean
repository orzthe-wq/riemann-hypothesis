  have hs : ∀ w : InfinitePlace (UI.instV fr).F, w = v → Formalism.MainNotions.S.uMat ((Pi.mulSingle v a : (UI.instV fr).Ginf) w) = Formalism.MainNotions.S.uMat a := by
