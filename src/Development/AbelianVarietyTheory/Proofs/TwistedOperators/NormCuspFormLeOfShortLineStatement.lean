  have hG : gramAt D V ((Formalism.L2.Host.tauPl D).symm v) =
      ((fr.P v)⁻¹)ᴴ * Formalism.REAL.Jm (fr.ε v) * (fr.P v)⁻¹ := by
    rw [← fr.spec v]
