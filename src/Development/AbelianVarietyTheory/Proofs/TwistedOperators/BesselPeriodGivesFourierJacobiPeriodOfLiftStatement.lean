  · intro γ hγ h
    obtain ⟨hq, hbes⟩ := Subgroup.mem_inf.1 hγ
    obtain ⟨n, hn, h₁, rfl⟩ := (hdec γ).1 hbes
    obtain ⟨hnq, hhq⟩ := (BesSemi.rat_iff B.d B.o hn h₁).1 hq
