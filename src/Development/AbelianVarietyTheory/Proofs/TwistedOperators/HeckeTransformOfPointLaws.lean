  ext g
  obtain ⟨k, _, _, z, hz⟩ := exists_pt G.left g
  have := h k (z ≫ G.hom) (Over.homMk z rfl)
  change Set.range z ⊆ K ↔ Set.range z ⊆ K' at this
  simpa [hz] using this

theorem kerSet_unique {G G' : Over S} [GrpObj G'] {ψ : G ⟶ G'} {K K' : Set G.left} (h : KerSet ψ K)
