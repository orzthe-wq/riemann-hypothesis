  simp only [this, h0, smul_zero]

theorem conj_map_facts {F E K : Type} [Field F] [Field E] [Field K] [Algebra F E] [Algebra F K] (τ : E →ₐ[F] K)
    {n : ℕ} (β : GL (Fin n) K) (ε g : Matrix (Fin n) (Fin n) E) (hεε : ε * ε = ε) (hgε : g * ε = ε * g)
