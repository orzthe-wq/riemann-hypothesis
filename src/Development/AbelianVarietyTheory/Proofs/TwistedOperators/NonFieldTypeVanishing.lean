        simp only [mul_assoc]
    _ = 0 := by rw [hA, ← mul_assoc (1 - ε), h0]; simp

theorem conj_mem {ε : Matrix (Fin r) (Fin r) k} {N : Subgroup (GL (Fin r) k)}
