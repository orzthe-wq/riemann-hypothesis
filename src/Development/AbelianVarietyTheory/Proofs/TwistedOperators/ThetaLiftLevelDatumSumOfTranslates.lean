    ⟨fmtC S k, fmtC S k⁻¹, by rw [← hmul, mul_inv_cancel, hone], by rw [← hmul, inv_mul_cancel, hone]⟩
  have hfg : (stdL D.host.E S.rank).FG := Submodule.fg_span (Set.finite_range _)
