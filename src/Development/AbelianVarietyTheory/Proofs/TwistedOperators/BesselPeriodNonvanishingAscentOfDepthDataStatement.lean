      mt B n ⬝ rat (a.iso ρ (by omega)) = rat (a.iso ρ (by omega)) + rat (a.iso ρ (by omega)) ⬝ T ∧
      mt B n *ᵥ ratV (a.besDat (neg_ne_zero.2 one_ne_zero) ρ hc).z =
