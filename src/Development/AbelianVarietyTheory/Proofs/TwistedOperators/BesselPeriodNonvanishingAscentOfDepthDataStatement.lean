  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
  split_ifs with hij
  · rw [hij]
    have e := neg_pow_ratio (D := D) i.1
    linear_combination T i j * e
  · rfl

theorem ell_scaled {ρ : ℕ} (b : Fin ρ → AE D) :
