  split_ifs
  · exact one_mem _
  · exact zero_mem _

theorem idem_smul_eq_of_fix {W : HSp D} {L : Lat W} (hL : Submodule.IsFullLattice D.host.E L) {w : Pl D.host.E} {n : ℕ}
    {B : Matrix (Fin W.rank) (Fin n) (EAf D)} (hB : IsBasisAt W w L B) {k : Matrix (Fin W.rank) (Fin W.rank) (EAf D)}
