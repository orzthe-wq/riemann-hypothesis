    intro i
    constructor
    · intro hc
      obtain ⟨s, hs, hm⟩ := cong_congr_left C.X (hyc i) hc
      exact hind (c i) ⟨s, hs, hm⟩
    · intro hc
      refine cong_of_sub_mem C.X ?_
      rw [sub_zero, ← sub_add_cancel (y i) (∑ j, c i j • β j)]
