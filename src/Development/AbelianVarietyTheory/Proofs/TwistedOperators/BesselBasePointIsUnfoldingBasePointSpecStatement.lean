  obtain ⟨⟨P, hP, hPx⟩, hx⟩ := xLast_rat_leftInv D σ B
  refine ⟨fun g => ⟨fun hg => besGrp_le_actUni B hg, fun hg => mem_besGrp_of_actUni B g hg⟩, ?_, ?_⟩
