    have hs := hHas.summable.indicator {y | y ≠ 0}
    have ht : ∑' y, Set.indicator {y | y ≠ 0} a y = 0 := by
      rw [← tsum_subtype]
      exact hvanish
    rw [← ht]
    exact hs.hasSum
