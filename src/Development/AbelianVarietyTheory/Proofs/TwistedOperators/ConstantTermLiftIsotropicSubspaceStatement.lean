theorem exists_right_inv {K : Type*} [Field K] {s r : ℕ} (m : Matrix (Fin s) (Fin r) K) (hm : m.rank = s) :
    ∃ m' : Matrix (Fin r) (Fin s) K, m * m' = 1 := by
