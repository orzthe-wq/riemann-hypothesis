    classical
    have h0 := (hasSum_ite_eq (0 : Matrix (Fin W.rank) (Fin r) D.host.E) (a 0)).add hbsum
    convert h0 using 1
    funext y
    by_cases hy0 : y = 0
    · subst hy0
      simp
    · simp [hy0]
