          intro h
          have e2 : (fun n : NI V C => tm y.1 (ω ((n : GA D V) * g, h) f)) =
              fun n : NI V C => tm y.1 (ω ((n : GA D V), 1) (ω (g, h) f)) := by
            funext n
            rw [hL]
          rw [e2]
