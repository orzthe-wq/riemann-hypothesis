theorem e'_scaled (a : HermitianOrthogonalExtensionData A B c (-1)) (d : HypDec B B₀ ρ) (hd : IsAuxiliaryVectorWittDec a d) (hc : 2 * ρ ≤ c) (i : Fin ρ)
