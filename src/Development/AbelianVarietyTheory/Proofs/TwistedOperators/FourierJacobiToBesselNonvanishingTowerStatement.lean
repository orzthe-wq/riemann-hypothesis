    {h' : GA D J.W₀} (hhq : h' ∈ GQ J.W₀) (g : GA D J.W) :
    ‖ker s Φ h₀ (n * J.d.emb0 h' * g)‖ = ‖ker s Φ h₀ g‖ := by
  have hΨ := s.weil.om_pres (embA B.d B.o h₀, g) _ hΦ
  have hΞ := theta_flBF s hΨ
  have e : s.om (embA B.d B.o h₀, n * J.d.emb0 h' * g) Φ =
