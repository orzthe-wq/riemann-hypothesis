def ker (Φ : WO B.V J.W → ℂ) (h₀ : GA D B.A) (g : GA D J.W) : ℂ := flBF s (s.om (embA B.d B.o h₀, g) Φ) 0

theorem ker_val (hΦ : IsThetaFunO ψ B.V J.W Φ) (h₀ : GA D B.A) {n : GA D J.W} (hn : n ∈ flagN J.d)
