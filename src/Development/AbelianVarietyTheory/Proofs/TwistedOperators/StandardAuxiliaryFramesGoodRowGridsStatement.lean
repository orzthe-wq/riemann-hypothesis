  have h2 := mulVec_latA q hq (mulVec_latA (mt W κ) (inK_maps hκ) h1)
  rw [mulVec_colMul, mulVec_colMul] at h2
  have e : q ⬝ (mt W κ ⬝ (mt W (r * g * κ)⁻¹ ⬝ (x ⬝ u.1.1))) = q ⬝ (mt W g⁻¹ ⬝ x) ⬝ (u' * u.1).1 := by
