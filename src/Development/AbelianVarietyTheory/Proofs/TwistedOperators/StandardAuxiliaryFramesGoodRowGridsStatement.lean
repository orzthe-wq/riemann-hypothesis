    · rw [hi j h k, zero_mul]
    · rw [(hw j i).1 h, mul_zero]
  · intro h; exact absurd (Finset.mem_univ _) h

theorem psi_of_shift (hG : GoodAt dV dW x ψ LV LV₀ LW LW₀ v) (hS : StdAt dV dW p LV LW v) {r g κ : GA D W}
