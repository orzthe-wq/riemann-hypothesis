  have hx : ((-D.host.xi0) ^ (ρ + 1)) ≠ 0 := pow_ne_zero _ (neg_ne_zero.2 GlobalTheory.ChiGrid.cmHost_imaginaryGenerator_ne_zero)
  have hζ : F.ζ (ρ + 1) ≠ 0 := by
