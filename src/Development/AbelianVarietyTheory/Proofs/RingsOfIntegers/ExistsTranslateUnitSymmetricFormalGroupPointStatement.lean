  intro U _ h
  have hb : (translT A θ.pt⁻¹).left ≫ (translPt A θ.pt).left = (snd T A).left := by
    rw [← Over.comp_left, translT_eq, lift_translPt, comp_inv', mul_inv_cancel_left]
