    rw [← Over.comp_left, lift_fst, Over.id_left]
  obtain ⟨a, ha⟩ := GlobalTheory.SymLiftOdd.exists_const hL (fst T A).left (lift (𝟙 T) (1 : T ⟶ A)).left he hs hF hu
  refine ⟨a, fun m y J hJ => ?_⟩
