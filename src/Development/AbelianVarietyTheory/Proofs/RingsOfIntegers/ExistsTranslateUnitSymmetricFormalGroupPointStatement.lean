theorem psum_mem {T : Over (Sp V)} {l : ℕ} (r : limO V d n ⟶ T) (xs : Fin l → (T ⟶ t.G))
    (h : ∀ i, r ≫ xs i ∈ (ptH hX hc n).range) (I : Finset (Fin l)) : r ≫ psum t.G xs I ∈ (ptH hX hc n).range := by
