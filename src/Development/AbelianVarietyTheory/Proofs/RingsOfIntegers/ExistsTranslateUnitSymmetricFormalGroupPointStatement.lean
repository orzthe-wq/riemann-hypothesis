def lam (b : Γ → F) (x y : Γ) : F := b (x * y) * (b x)⁻¹ * (b y)⁻¹ * b 1

def cube (b : Γ → F) (x y z : Γ) : F :=
  b (x * y * z) * (b (x * y))⁻¹ * (b (x * z))⁻¹ * (b (y * z))⁻¹ * b x * b y * b z * (b 1)⁻¹

