theorem lim_mem (W : t.G.left.Opens) (hW : ⊤ ≤ η[t.G].left ⁻¹ᵁ W) : ⊤ ≤ X.left ⁻¹ᵁ W := by
  let χ : PS V 1 d →ₐ[V] V := (jetAug : Jet V _ 0 →ₐ[V] V).comp (jetA _ 0)
