theorem exists_trace_eq_of_isUnit_det {A R : Type} [CommRing A] [CommRing R] [Algebra A R]
    {d : ℕ} (b : Module.Basis (Fin d) A R) (M : Matrix (Fin d) (Fin d) A)
    (h : ∀ x : R, (∑ i, ∑ j, M i j • TensorProduct.tmul A (b i) (b j)) *
