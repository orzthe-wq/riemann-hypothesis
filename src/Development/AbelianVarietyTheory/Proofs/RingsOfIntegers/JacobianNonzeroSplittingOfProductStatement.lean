    (fun α hα a => by
      have := (hsh α α hα.1 hα.1).2.1.1 hα a
      rw [hp] at this
      exact this)
    (fun α hα β hβ h => (hsh α β hα.1 hβ.1).2.2.1 h) f hf
  exact ⟨a, ha.trans (hp a).symm⟩

