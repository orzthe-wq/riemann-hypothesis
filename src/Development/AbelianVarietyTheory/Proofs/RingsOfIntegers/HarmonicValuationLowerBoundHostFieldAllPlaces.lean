      · show IsUnit ((z : ℤ) : T.V)
        rw [h, Int.cast_neg, Int.cast_natCast]; exact h1.neg
    exact ⟨(IsLocalization.lift (M := nonZeroDivisors ℤ) (S := ℚ) hu).toAlgebra⟩

