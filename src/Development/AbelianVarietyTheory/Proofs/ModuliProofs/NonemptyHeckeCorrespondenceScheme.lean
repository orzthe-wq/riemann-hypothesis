  obtain ⟨h₁, h₂⟩ := _root_.GlobalTheory.heckeQuot_unique E H D l Xo 𝔓 p i _ (g ≫ s) oT b₁ b₂ χ₁ χ₂ _ _ _ k₁ k₂ hA hHT
