    convert this using 1
    ext x
    simp only [Set.mem_preimage, Scheme.Hom.comp_apply]
  · rw [hn, reassoc_of% hψ']

theorem overlap (Xo : Moduli D l) {𝔓 : Ideal (𝓞 E)} {p i : ℕ} {S V₁ V₂ : Scheme.{0}} [IsReduced S]
