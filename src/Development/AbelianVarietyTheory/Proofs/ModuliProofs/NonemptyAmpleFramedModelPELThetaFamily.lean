  obtain ⟨c₀, hc₀⟩ := hc ⊥ Ideal.isPrime_bot 0
  obtain ⟨a₀, ha₀⟩ : ∃ a₀, v' a₀ ≠ 0 := ⟨_, hc₀⟩
  let w : GlobalTheory.ZM.Ix g (N' ^ 2) → K := fun a => ⟨v a / v a₀, Subfield.subset_closure (Or.inr ⟨a, a₀, rfl⟩)⟩
  have hw : ∀ a, K.subtype (w a) = (v' a₀)⁻¹ * v' a := fun a => by
