    x₁ (spMap j) hu).1 hu₀
  have hT' := ((_root_.GlobalTheory.ZM.tmap_id_comp_cancel o g k J b S (Sp K₁) (Sp Ω) s (x₁ ≫ s) (spMap i ≫ x ≫ s) t' u₁ u).2
    x₁ (spMap j) hu').1 hu₀
