  · intro W hW f f'
    rw [h.add W (hW.trans inf_le_left), h'.add W (hW.trans inf_le_right)]
    abel
  · intro W hW f f'
    rw [h.mul W (hW.trans inf_le_left), h'.mul W (hW.trans inf_le_right)]
