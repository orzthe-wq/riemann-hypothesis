    constructor
    · intro hl
      apply hb.1
      apply fn_ext
      intro z _
      obtain ⟨J, hJ, -⟩ := exists_good L hL z (Fin.elim0 : Fin 0 → ((T ⊗ G).left ⟶ G.left)) Fin.elim0
        (fun a => a.elim0) (fun k => k.elim0)
