    constructor
    · intro hx
      obtain ⟨J, hJ⟩ := Opens.mem_iSup.1 hx
      have hw : x ∈ LB.wchart C (fun _ : Fin 1 => 𝟙 Z) J := Z.basicOpen_le _ hJ
