    · exact ⟨(coprod.inr : Y ⟶ X ⨿ Y) x, by rw [← Scheme.Hom.comp_apply, coprod.inr_desc]⟩

theorem isOpenImmersion_desc {X Y Z : Scheme.{0}} (f : X ⟶ Z) (g : Y ⟶ Z) [IsOpenImmersion f] [IsOpenImmersion g]
