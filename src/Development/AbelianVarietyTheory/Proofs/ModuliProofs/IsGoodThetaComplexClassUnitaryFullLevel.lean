      Complex.exp (-(2 * Real.pi * Complex.I) * (ν : ℂ) / k) ^ s := by
  obtain ⟨c, hc⟩ := h
  have hm : m = ν * s + k * c := by linarith
  have hk' : (k : ℂ) ≠ 0 := by exact_mod_cast hk.ne'
  rw [← Complex.exp_int_mul, Complex.exp_eq_exp_iff_exists_int]
  refine ⟨-c, ?_⟩
  rw [hm]
  push_cast
  field_simp
  ring

