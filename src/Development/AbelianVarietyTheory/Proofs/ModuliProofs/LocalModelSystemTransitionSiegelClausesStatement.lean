    obtain ⟨n, hn⟩ := hrad
    obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hn
    refine ⟨⟨a * u, ⟨s ^ n, n, rfl⟩⟩, ?_⟩
