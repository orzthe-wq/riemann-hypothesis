      intro a
      rw [← RingHom.mem_ker, hπ, PadicInt.ker_toZModPow, Ideal.mem_span_singleton]; rfl
    constructor
    · intro h
      choose z hz using fun i => (this (y i)).1 (congrFun h i)
      exact ⟨z, funext hz⟩
    · rintro ⟨z, rfl⟩
      exact funext fun i => (this _).2 ⟨z i, rfl⟩
  have hc : ∀ (P R : Matrix κ κ ℤ_[l]), R * P = ((l : ℤ_[l]) ^ N) • 1 →
