  let Ω : (z : Sp F) → (TF (R := V) F ⟶ D'.P.A) → ((Sp F).presheaf.stalk z)ˣ := fun z x => om wD z ν.J ν'.J x.left
  let tu : (z : Sp F) → Fˣ →* ((Sp F).presheaf.stalk z)ˣ := fun z => Units.map (toStk z).toMonoidHom
