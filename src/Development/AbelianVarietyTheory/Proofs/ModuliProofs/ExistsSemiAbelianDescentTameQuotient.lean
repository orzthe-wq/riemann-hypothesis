    (RingHom.ker_isPrime (ev.comp f))
  by_contra! H
  have h1 : ∑ j, ev (f (d j)) * ev (∑ g : Γ, g • (f (c j) * x)) = 0 := by
    simp only [H, mul_zero, Finset.sum_const_zero]
  have h2 : ∑ j, ev (f (d j)) * ev (∑ g : Γ, g • (f (c j) * x)) =
