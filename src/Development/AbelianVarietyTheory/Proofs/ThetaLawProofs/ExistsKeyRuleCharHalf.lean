  · intro R _ _ _ _ x hx hu
    obtain ⟨R', _, _, _, j, x', s', u, hj, hloc, hx', hκ⟩ := exists_kaVal_dvr hL R x (hx ▸ hA) (hx ▸ hu)
    refine ⟨R', inferInstance, inferInstance, inferInstance, j, u, hj, hloc, fun K _ _ _ f xK h => ?_⟩
