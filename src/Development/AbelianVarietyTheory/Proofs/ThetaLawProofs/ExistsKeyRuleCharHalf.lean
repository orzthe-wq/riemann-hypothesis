    refine ContinuousAt.comp (f := fun q => (τ q).map Complex.im) ?_ him.continuousAt
    refine continuousAt_matrix_inv _ ?_
    rw [Ring.inverse_eq_inv']
    exact continuousAt_inv₀ h.ne_zero
