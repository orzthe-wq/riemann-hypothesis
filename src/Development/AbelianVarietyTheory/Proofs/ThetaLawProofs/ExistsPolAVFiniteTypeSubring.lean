  refine IsGrpPullback.cancel (isGrpPullback_pullback A₀ (spMap (Subring.inclusion h))) ?_ ?_
  · exact H.congr (spMap_subtype_comp_inclusion' h).symm (pullback.lift_fst _ _ _).symm
