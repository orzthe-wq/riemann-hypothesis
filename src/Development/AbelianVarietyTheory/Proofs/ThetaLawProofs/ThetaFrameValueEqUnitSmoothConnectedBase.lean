    [Algebra.Smooth ℂ S] (t : (S →ₐ[ℂ] ℂ) → ℂ)
    (h : ∀ (m : ℕ) (B : Set (Fin m → ℂ)) (s : (Fin m → ℂ) → (S →ₐ[ℂ] ℂ)), IsOpen B →
      (∀ a : S, DifferentiableOn ℂ (fun p => s p a) B) → ContinuousOn (fun p => t (s p)) B) :
