      (sq K ⟨P, hg, rig, hr, th, hth, v, hv⟩).basis t ht w hw (a ^ 2) M' (hdim hP hy) ht' hw'
    dsimp only
    rw [indep K ⟨P, hg, rig, hr, th', hth', v', hv'⟩ _ hP hp]
