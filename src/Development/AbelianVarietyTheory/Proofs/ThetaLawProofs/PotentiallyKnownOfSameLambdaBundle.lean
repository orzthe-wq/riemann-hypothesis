  have : IsMonHom (Iso.refl P.A).hom := inferInstanceAs (IsMonHom (𝟙 _))
  exact ⟨𝟙 _, isGrpPullback_of_iso (Iso.refl P.A), rfl, isoPullId (idIso P.L) rfl,
    (isGen_iff _).2 (isoPullId_pgen (idIso_isGen P.isLB) rfl)⟩

