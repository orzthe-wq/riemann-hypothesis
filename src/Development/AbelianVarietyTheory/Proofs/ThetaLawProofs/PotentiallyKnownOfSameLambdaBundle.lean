    simp [dotProduct]
  rw [e2]
  simp only [dotProduct_add, add_dotProduct]
  ring

theorem exists_int_dot {a : Fin g → ℂ} (ha : ∀ i, a i = 0 ∨ a i = 1 / 2) (m : Fin g → ℤ) :
    ∃ k : ℤ, a ⬝ᵥ (fun i => (m i : ℂ)) = k / 2 := by
