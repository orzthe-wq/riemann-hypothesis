theorem isIntegral_zpow {K : Type} [Field K] {ζ : K} (h : IsOfFinOrder ζ) (t : ℤ) : IsIntegral ℤ (ζ ^ t) := by
  obtain ⟨k, hk, e⟩ := isOfFinOrder_iff_pow_eq_one.1 h
  refine IsIntegral.of_pow hk ?_
