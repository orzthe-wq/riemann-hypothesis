theorem isBeta_betaH {n : ℕ} {Λ : GenLat E n}
    (h : ∃ β : c.F, β ≠ 0 ∧ BetaIs (Dw := Dw) c Λ β ∧ BetaAbs (Dw := Dw) c Λ β) :
