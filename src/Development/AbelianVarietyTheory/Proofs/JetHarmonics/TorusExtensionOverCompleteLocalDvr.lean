  obtain ⟨ρ, hρ⟩ := exists_ringAct hG ιD (Φ := Φ) hΦ
  obtain ⟨J, hJ⟩ := exists_mulEquiv U hG (Φ := Φ) hΦ
  choose π hπ using exists_pushEquiv f (H := H)
