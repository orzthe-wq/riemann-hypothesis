    fun a ha => h a (Ideal.pow_le_pow_right (Nat.le_succ n) ha)))) ?_
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, Ideal.Quotient.lift_comp_mk]
  rfl

