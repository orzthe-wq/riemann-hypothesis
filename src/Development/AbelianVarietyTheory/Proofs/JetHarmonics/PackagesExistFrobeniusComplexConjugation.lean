  have h3 := eq_of_heq (Sigma.mk.inj h).2
  obtain ⟨rfl, h4⟩ := Prod.mk.inj h3
  obtain ⟨rfl, rfl⟩ := Prod.mk.inj (pl.injective h4)
  exact ⟨rfl, rfl, rfl⟩

