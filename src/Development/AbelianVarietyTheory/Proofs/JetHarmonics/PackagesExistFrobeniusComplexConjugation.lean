    by_contra hk
    have : k ≠ X.n := fun e => hk (le_of_eq e)
    exact h (by simp [RF.GlobalTheory.wt, this])
  | ch g0 a0 u =>
    by_contra hk
    have : k ≠ X.n := fun e => hk (le_of_eq e)
    exact h (by simp [RF.GlobalTheory.wt, this])
  | mon g0 e N =>
    by_contra hk
    have : ¬ k ≤ N := hk
    exact h (by simp [RF.GlobalTheory.wt, this])

