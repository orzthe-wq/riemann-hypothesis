def lt (ρ : Fin N) (w : Var r tau) (col : Fin 2) : Letter Ty r n := ⟨tau w.1 w.2.2.1, w.2.2.2, pl (ρ, col)⟩

def sub (gm : Orb → ZMod 2 → Matrix (Fin 2) (Fin 2) C) (x : Fin N × Var r tau) : MvPolynomial (Letter Ty r n) C :=
