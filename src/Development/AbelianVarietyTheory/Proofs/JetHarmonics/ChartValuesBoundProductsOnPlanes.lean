  have hG0 : ∀ ρ (x : Fin 2 × Fin dd), constantCoeff (E (pl (ρ, x.1), x.2)) = 0 := fun ρ x => hE0 _
  have hR : ∀ ρ, subst (fun w : ω => (X (ρ, w) : MvPowerSeries (Fin N × ω) C))
      (subst e (F ρ * mvExp (k • ∑ col : Fin 2, inCol col (un1 hl)))) =
