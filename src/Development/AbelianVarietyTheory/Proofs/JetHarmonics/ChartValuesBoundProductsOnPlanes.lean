    (fun a b ha hb => by
      have := (hq _).2 (hadj W W' a b hE ha hb)
      rwa [map_sub, sub_eq_zero] at this)
    hWW π hπ (fun o g o' g' hn => (hq _).2 (horth o g o' g' hn))

