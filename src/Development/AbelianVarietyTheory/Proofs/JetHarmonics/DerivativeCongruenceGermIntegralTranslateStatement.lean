    rw [FBMap.map_ev1 _ (B.A.const a)]
    refine dof_ev_eq_zero (FBMap.mapFB (q.comp β) B) a _ ?_ _
    show (dLin (fun i => MvPowerSeries.map (q.comp β) (B.A.act a i) : Pt (O ⧸ I) 1 d)).mulVec _ = 0
