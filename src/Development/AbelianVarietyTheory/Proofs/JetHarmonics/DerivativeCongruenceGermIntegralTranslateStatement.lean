    apply hio
    have := congrFun he i
    have e₁ : dAct F B a = ((dLin (B.A.act a)).map β).map io := by
      rw [Matrix.map_map, ← RingHom.coe_comp, hβ, ← dLin_map]; rfl
    rw [e₁] at this
    rw [RingHom.map_mulVec]
    exact this.trans (map_mul io _ _).symm
