  have v' : ∀ (y : (UnifPre.GF (G := t.G) F).left) (J), Good P.U.LG.L y J → sval σ' (𝟙 _) y J =
      sval σ₀ (TFK (R := V) F ◁ (Over.pullback (jK V)).map (t.act.act a)).left y J *
