theorem extendByZero_add_eq_mul_of_forall {p : ℕ} {f g k : Fin p → ℕ} {m : ℕ} (h : ∀ i, f i + g i = m * k i) (i : ℕ) :
    ext0 f i + ext0 g i = m * ext0 k i := by
