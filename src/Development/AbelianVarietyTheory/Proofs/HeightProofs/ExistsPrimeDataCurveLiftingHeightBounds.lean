  · intro t' _ ht'
    have : DV.tauEmb D t ≠ DV.tauEmb D t' := fun h => ht' (GlobalTheory.HeightDefinite.tauEmb_inj h).symm
    simp [tauEmb_ne_conj Q hp, this]
  · simp

