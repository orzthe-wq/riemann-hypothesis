  unfold PI4
  have : 2 * b / (WeightFamilies.dimY D j : ℝ) ≤ 2 * b' / (WeightFamilies.dimY D j : ℝ) :=
    div_le_div_of_nonneg_right (by linarith) (Nat.cast_nonneg _)
  linarith




