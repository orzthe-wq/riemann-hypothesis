        ↥(Submodule.span (Kp (xplus X E hM) la (gd2Xplus G E hM).N)
          (zAll (gd2Xplus G E hM) la S T)) : ℝ) =
      Module.finrank (Kp X la G.N) ↥(Submodule.span (Kp X la G.N) (zAll G la S T)) :=
  ⟨Iff.rfl, fun _ _ _ _ => Iff.rfl, fun _ _ => rfl⟩

