  rw [hX₁] at hy₁v
  obtain ⟨x₁, hx₁, hx₁e⟩ := Submodule.mem_map.1 hy₁v
  rw [hX₂] at hy₂v
  obtain ⟨x₂, hx₂, hx₂e⟩ := Submodule.mem_map.1 hy₂v
