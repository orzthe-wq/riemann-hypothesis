      · intro x hx; exact isotropicSpan_first_le_framePairSpace (hnX x hx)
      · intro x hx
        rw [hX₁] at hx
        obtain ⟨y, hy, rfl⟩ := Submodule.mem_map.1 hx
        exact isotropicSpan_second_le_framePairSpace (hnγX y hy)
      · rintro x (rfl | rfl)
        · change n F.z ∈ V0 F G₂
          have : n F.z = F.z + (n F.z - F.z) := by abel
          rw [this]
