  have hx'' : n' v - v + n' x₂ ∈ F.X := Submodule.add_mem _ (hn'P v hvP) (hn'X x₂ hx₂)
  have hy₂' : n.symm y₂ = γ (a v + (n' v - v + n' x₂)) := by
    have e1 : y₂ = g₂ (v + x₂) := by
