            rw [this]
          have h1 : G₁.z = γ F.z := hG₁ (Fin.last r)
          rw [h1]
          have : n (γ F.z) = G₂.z - n (γ (n' F.z - F.z)) := by rw [hz2]; abel
          rw [this]
          exact Submodule.sub_mem _ (lastVector_second_mem_framePairSpace F G₂) (isotropicSpan_second_le_framePairSpace (hnγX _ hx0))
