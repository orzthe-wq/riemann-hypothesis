  simp only [Jm, mul_diagonal, diagonal_mul, Matrix.neg_apply, hab] at h1
  cases hb : ε b <;> simp [hb] at h1
  · linear_combination (-1 / 2 : ℂ) * h1
  · linear_combination (1 / 2 : ℂ) * h1

