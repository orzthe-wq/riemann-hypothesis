theorem apply_eq_zero_of_inP {n : ℕ} {ε : Fin n → Bool} {Y : Matrix (Fin n) (Fin n) ℂ}
    (h : inP ε Y) (a b : Fin n) (hab : ε a = ε b) : Y a b = 0 := by
