    one_flag Z (by exact Nat.cast_ne_zero.mpr (D.mem u').A.T_prime.ne_zero) F' P f' (fun p hp => (hff p hp).2)
  refine ⟨G, G', ⟨hG1, hG1', hG2, hG2', fun p hp => ?_⟩, fun p hp => ?_⟩
