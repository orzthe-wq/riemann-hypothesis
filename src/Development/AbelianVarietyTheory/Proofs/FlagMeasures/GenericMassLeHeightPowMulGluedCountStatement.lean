      rw [Matrix.one_apply]
      split_ifs
      · exact one_mem _
      · exact zero_mem _
    refine ⟨?_, ?_, ?_⟩
    · rw [← sub_add_cancel (A a b) ((1 : Matrix (Fin (D.R.rS + 1)) (Fin (D.R.rS + 1)) (D.s.atP p).Ep) a b), he]
      exact add_mem (mul_mem hθ ho) h1
    · rw [← sub_add_cancel (A' a b) ((1 : Matrix (Fin (D.R.rS + 1)) (Fin (D.R.rS + 1)) (D.s.atP p).Ep) a b), he']
