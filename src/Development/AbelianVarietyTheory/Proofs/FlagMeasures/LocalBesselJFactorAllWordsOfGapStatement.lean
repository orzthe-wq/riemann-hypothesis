theorem hsNormSq_ampJ_translate [CompleteSpace Wp] {ν : Measure (Mt k r)} (hν : ∀ᵐ x ∂ν, Matrix.of x ∈ GG k r) (c : ℝ)
    {Φ : Mat k r → Wp} {Φ' : Mat k r → Wq} {γ a a' : Mat k r} (hγ : γ ∈ GG k r) (ha' : IsUnit a'.det)
