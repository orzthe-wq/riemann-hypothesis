  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [prod_gmap]
    exact Submodule.map_mono h1
  · rw [smulLat_gmap, smulLat_gmap, prod_gmap]
    exact Submodule.map_mono h2
  · intro y' hy'
