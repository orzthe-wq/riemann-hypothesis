    obtain ⟨t, ht⟩ := h7 _ hp _ hq
    exact ⟨t, by simpa only [isom_symm hs] using ht⟩

theorem isDat_gmap {s : V ≃ₗ[K] V} (hs : ∀ x y, H.B (s x) (s y) = H.B x y) {g : ℕ} {L : Submodule (𝓞 K) V}
