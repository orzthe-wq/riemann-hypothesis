    (hi : ∀ i j, H.h (es i) (es j) = 0) (hi' : ∀ i j, H.h (es' i) (es' j) = 0) :
    ∃ S : Frames M.L r k, S.Hm = Matrix.of (fun i j => H.h (b i) (b j)) ∧
