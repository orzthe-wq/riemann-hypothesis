theorem dcrel_of_eqv (Λ : Submodule (𝓞 D.host.E) (VS D).V) {T T' : D.host.E} (F : LFlag (D.sp.Y 0) D.R.rS T)
    {P : LFlag (D.sp.Y 0) D.R.rS T' → Prop} {x y : Formalism.L2.SG.TermDef.Carrier P}
