  ext i j
  rw [actSgn_conj_apply]
  unfold GlobalTheory.LoopV.ofRoots
  split_ifs with h1 h2
  · rfl
  · subst h2
    rw [mul_one, ← mul_pow]
    norm_num
  · simp

