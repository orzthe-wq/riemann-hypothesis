theorem mem_of_loc (Z : LocDat D) (Λ : LV D) (hΛ : Submodule.IsLattice D.host.E Λ) (x : (VS D).V)
    (h : ∀ p, baseChange₂ D p x ∈ lattice₂ D Z.M p Λ) : x ∈ Λ :=
  GlobalTheory.Unfold.LsubG.mem_of_local Z Λ hΛ x h

end GlobalTheory.CompScale

