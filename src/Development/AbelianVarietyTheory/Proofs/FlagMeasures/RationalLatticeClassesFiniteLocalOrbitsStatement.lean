    intro a b
    change LocFacts₂ Z.M p (x (y a)) (x (y b)) = _
    rw [hx, hy]
  | inv x _ hx =>
    intro a b
    change LocFacts₂ Z.M p (x.symm a) (x.symm b) = _
    rw [← hx, LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]

theorem localForm_sub_left (Z : LocDat D) (p : PlF D) (x x' y : Vp D p) :
