  {σ : ι → (K →+* ℂ)} {ρ : ℝ} {β : Fin r → ℕ} {Φ : ι → V → Fin (2 * r + k + 1) → ℂ} {z z' : ι → Fin (2 * r + k + 1) → ℂ}
