theorem rset_eq (hF : ∀ v, IsFrameOf N k (σ v) ρ β (Φ v) (z v) (z' v) (g v)) (v : ι) :
    Rset k r (g v) = Set.range (crd k r N.j β) ∧ IsClosedSub k r (Rset k r (g v)) ∧ Function.Injective (crd k r N.j β) := by
  obtain ⟨-, h1, h2, h3, ⟨c, hc⟩, -⟩ := hF v
