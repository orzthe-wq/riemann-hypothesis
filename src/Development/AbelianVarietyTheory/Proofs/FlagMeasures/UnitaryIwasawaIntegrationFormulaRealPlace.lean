theorem triple_mono {G : Type} [MeasurableSpace G] {N M K : Set G} {μN μM μK : Measure G} (hN : μN Nᶜ = 0)
    (hM : μM Mᶜ = 0) (hK : μK Kᶜ = 0) (δ : G → ENNReal) {F F' : G → G → G → ENNReal}
