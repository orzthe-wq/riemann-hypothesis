      Matrix.mul_assoc, hU', Matrix.mul_one]
  exact_mod_cast h1

private theorem map_mul_right_eq_of_isGaugeSub {n : ℕ} {ε : Fin n → Bool} (A : Submodule ℝ (Matrix (Fin n) (Fin n) ℂ))
    {d : ℕ} (E : Fin d → Matrix (Fin n) (Fin n) ℂ) (hA : ∀ X ∈ A, ∀ Y ∈ A, X * Y ∈ A)
