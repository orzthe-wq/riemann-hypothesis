  have key : ∀ u m, δ m * (V * ((∫⁻ k, F u m k ∂μK) * β)) = V * β * (δ m * ∫⁻ k, F u m k ∂μK) := by
    intro u m; ring
  simp_rw [key, lintegral_const_mul' _ _ hVβ]

