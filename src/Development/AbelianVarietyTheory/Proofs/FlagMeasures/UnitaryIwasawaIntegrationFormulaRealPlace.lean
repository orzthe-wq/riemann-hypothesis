  · rw [he, MeasurableEquiv.map_apply, ← hH]
    have hpre : ⇑(MeasurableEquiv.mulRight l) ⁻¹' (↑H)ᶜ = (↑H : Set (Formalism.REAL.UJ ε))ᶜ := by
