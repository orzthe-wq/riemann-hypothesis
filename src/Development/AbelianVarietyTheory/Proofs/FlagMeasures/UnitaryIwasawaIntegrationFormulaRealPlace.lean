private theorem hs_conjTranspose_mul_mul_of_unitary {n : ℕ} (U X : Matrix (Fin n) (Fin n) ℂ) (hU : Uᴴ * U = 1) :
    Formalism.REAL.hs (Uᴴ * X * U) = Formalism.REAL.hs X := by
