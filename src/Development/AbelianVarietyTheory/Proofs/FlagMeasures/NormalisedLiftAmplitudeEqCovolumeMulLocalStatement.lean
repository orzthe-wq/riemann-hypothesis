private lemma mulVec_mem_spanLt' {n r : ℕ} {e : Fin r → Fin n → ℂ} {A : Matrix (Fin n) (Fin n) ℂ}
    (hA : ∀ b : Fin r, (A - 1) *ᵥ e b ∈ spanLt e b.1) (a : ℕ) :
    ∀ y ∈ spanLt e a, A *ᵥ y ∈ spanLt e a := by
  have hle : spanLt e a ≤ (spanLt e a).comap (Matrix.toLin' A) := by
