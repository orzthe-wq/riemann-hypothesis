    intro x x' hxx
    have h := congrArg (fun w : spanLt e a => Ai *ᵥ (w : Fin n → ℂ)) hxx
    have hc : ∀ w : spanLt e a, ((f w : spanLt e a) : Fin n → ℂ) = A *ᵥ (w : Fin n → ℂ) := fun w => rfl
