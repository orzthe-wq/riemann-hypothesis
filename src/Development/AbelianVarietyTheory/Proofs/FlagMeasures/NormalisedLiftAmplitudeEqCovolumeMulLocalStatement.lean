  have hwv : A *ᵥ (w : Fin n → ℂ) = y := congrArg Subtype.val hw
  have hw' : (w : Fin n → ℂ) = Ai *ᵥ y := by
    rw [← hwv, Matrix.mulVec_mulVec, h2, Matrix.one_mulVec]
  rw [← hw']
  exact w.2

