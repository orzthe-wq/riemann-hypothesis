theorem ext_mul (A : Places F E sig) {n : ℕ} {p} {a b : (Fin n → E) ≃ₗ[E] (Fin n → E)} {a' b'}
    (ha : A.Ext p a a') (hb : A.Ext p b b') : A.Ext p (a * b) (a' * b') := by
