  have hΓfull := full_lattice_of_term G hΓ
  refine ⟨⟨n1 * n0⁻¹, G.N.mul_mem hn1 (G.N.inv_mem hn0), eq_map_of_local A hΛfull hΓfull _ fun p => ?_⟩,
