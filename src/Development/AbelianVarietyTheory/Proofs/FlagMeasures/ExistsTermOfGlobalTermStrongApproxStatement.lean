private theorem full_lattice_of_term {A : Places F E sig} {r k : ℕ} (G : GFrames A r k)
    {d : G.Dat} {Λ : G.Lt} (hΛ : G.IsTerm d Λ) : Submodule.IsFullLattice E Λ := by
