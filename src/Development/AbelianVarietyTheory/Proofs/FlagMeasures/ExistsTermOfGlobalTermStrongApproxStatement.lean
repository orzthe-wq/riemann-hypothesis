    obtain ⟨m0', -, e0'⟩ := hn0' p
    obtain ⟨m1, -, e1⟩ := hn1 p
    obtain ⟨m1', -, e1'⟩ := hn1' p
    obtain ⟨-, -, -, -, s0, -, -, -⟩ := h0 p m0 m0' e0 e0'
    obtain ⟨-, -, -, -, s1, -, -, -⟩ := h1 p m1 m1' e1 e1'
    refine ⟨m1 * m0⁻¹, ext_mul A e1 (ext_inv A e0), ?_⟩
    rw [s0, s1, smul_smul, inv_mul_cancel_right]
  · obtain ⟨m0, -, e0⟩ := hn0 p
    obtain ⟨m0', -, e0'⟩ := hn0' p
    obtain ⟨m1, -, e1⟩ := hn1 p
    obtain ⟨m1', -, e1'⟩ := hn1' p
    obtain ⟨-, -, -, -, -, s0, -, -⟩ := h0 p m0 m0' e0 e0'
    obtain ⟨-, -, -, -, -, s1, -, -⟩ := h1 p m1 m1' e1 e1'
    refine ⟨m1' * m0'⁻¹, ext_mul A e1' (ext_inv A e0'), ?_⟩
