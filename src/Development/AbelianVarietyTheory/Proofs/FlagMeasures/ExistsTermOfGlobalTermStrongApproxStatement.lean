theorem th_mem (S : Frames L r k) : algebraMap F E S.th ∈ L.O := by
  unfold Frames.th
  split_ifs
  · rw [L.O_def]
    exact (isIntegral_algebraMap (R := 𝒪[F]) (A := F) (x := S.ϖ)).algebraMap
