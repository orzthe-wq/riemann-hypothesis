    rfl rfl ⟨hn₂, hm₂, hlin⟩).2 (by
      rw [← hΓ₂]
      funext p
      haveI := ((placesOf (⟨Y.δ, Y.M, Y.agree⟩ : LocDat D)).loc p).lf
      haveI := ((placesOf (⟨Y.δ, Y.M, Y.agree⟩ : LocDat D)).loc p).char0
      exact (GlobalTheory.HL.DatumOf.datOf_term (G.S p) (hΓ.2 p)).symm)
