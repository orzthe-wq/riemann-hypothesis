  obtain ⟨a, ha, rfl⟩ := hx
  obtain ⟨b, hb, rfl⟩ := hy
  unfold Frames.InTh
  exact ⟨a + b, Λ.add_mem ha hb, (smul_add _ _ _).symm⟩

theorem inTh_sub (S : Frames L r k) {Λ : Submodule L.O S.V} {x y : S.V} (hx : S.InTh Λ x)
