  have h := ha (a.symm z)
  rw [LinearEquiv.apply_symm_apply] at h
  change a'.symm (A.bc p z) = A.bc p (a.symm z)
  rw [← h, LinearEquiv.symm_apply_apply]

theorem eq_map_of_local (A : Places F E sig) {n : ℕ} {Λ Γ : Submodule (𝓞 E) (Fin n → E)}
