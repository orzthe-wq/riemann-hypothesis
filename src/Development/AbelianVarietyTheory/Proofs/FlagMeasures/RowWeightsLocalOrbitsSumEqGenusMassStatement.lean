  obtain ⟨g', hg', hm'⟩ := h2
  have e1 : act.smul ⟨g, hg⟩ a = b := (hmv ⟨g, hg⟩ a b).1 hm
  have e2 : act.smul ⟨g', hg'⟩ b = c := (hmv ⟨g', hg'⟩ b c).1 hm'
