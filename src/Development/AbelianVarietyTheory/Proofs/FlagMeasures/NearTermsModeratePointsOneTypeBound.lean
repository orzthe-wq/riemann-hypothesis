      · intro x hx
        simp only [mem_Ioo] at hx ⊢
        omega
      · intro x hx
        simp only [mem_Ioo] at hx ⊢
        omega
      · intro x hx
        simp only [mem_Ioo] at hx
        omega
      · intro x hx
        simp only [mem_Ioo] at hx
        omega
      · intro x hx
        simp only [mem_Ioo] at hx
        congr 1
        omega
    rw [hm, prod_mul_distrib]
    ring
  all_goals first
    | (rw [Finset.disjoint_left]
       intro x hx hx'
       simp only [mem_union, mem_insert, mem_Ioo, mem_singleton] at hx hx'
       omega)
    | (simp only [mem_union, mem_Ioo, mem_singleton]
