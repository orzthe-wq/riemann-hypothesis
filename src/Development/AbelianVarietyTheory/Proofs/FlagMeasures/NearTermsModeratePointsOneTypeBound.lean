    rw [hS'a, (hd _ (by norm_num)).2]
    exact ((hst (1 / 2) (by norm_num)).2.2.1.trans ((hst (1 / 2) (by norm_num)).2.2.2.1 _ (by norm_num))).trans
      (hst (1 / 2)⁻¹ (by norm_num)).2.2.1
