def mu {p : ℕ} [Fact p.Prime] (g : GL3Theta.G1 p) (v : ℂ) : ℝ :=
  if v ∈ g.abelian₂ then 1 else ‖GlobalTheory.ThetaTransl.cval g v‖ ^ 2 * max 1 ‖xAt g v‖

theorem mu_add (D : D7) (p : ℕ) [Fact p.Prime] (cc : Ideal (𝓞 D.host.K)) (δ : ℂ) (g : GL3Theta.G1 p)
