      ∀ h : X.K, h ∈ L → h ≠ 0 → ∀ C : Ω, C ≠ 0 →
        ¬ W.valuation (algebraMap Ω X.K C * (r : X.K) * h ^ (l ^ n) - 1) < 1 := by
    intro r
    by_cases hr : (∀ γ ∈ CongruenceSubgroup.Gamma M, X.sl (ofSL γ) (r : X.K) = r) ∧
        ¬ ∃ c : Ω, c ≠ 0 ∧ ∃ u : X.Kˣ, (∀ γ ∈ CongruenceSubgroup.Gamma M, X.sl (ofSL γ) (u : X.K) = u) ∧
