  haveI : CharZero Ω := algebraRat.charZero Ω
  haveI : @Algebra.IsAlgebraic ℚ Ω _ _ DivisionRing.toRatAlgebra := by
    convert (IsAlgClosure.isAlgebraic : Algebra.IsAlgebraic ℚ Ω)
