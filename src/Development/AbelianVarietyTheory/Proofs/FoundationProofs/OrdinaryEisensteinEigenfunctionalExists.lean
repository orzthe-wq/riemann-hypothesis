theorem alQ_cancel_left (h : (N : ℤ) * a * d - l * b * c = 1) (hN : 0 < N) {A B : M2}
    (hAB : alQ N l a b c d * A = alQ N l a b c d * B) : A = B := by
  have e := congrArg (fun X => (alQ N l a b c d).adjugate * X) hAB
