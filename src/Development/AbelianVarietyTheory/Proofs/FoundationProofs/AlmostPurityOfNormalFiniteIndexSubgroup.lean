    intro σ hσ
    simp only [Set.mem_setOf_eq, not_moves_top_iff] at hσ ⊢
    obtain ⟨r, hr, h1⟩ := hσ
    refine ⟨r, hr, fun x hx => ?_⟩
    have hy : v (σ⁻¹ • x) ≤ 1 := by rw [hv]; exact hx
    have e : σ⁻¹ • x - x = -(σ • (σ⁻¹ • x) - σ⁻¹ • x) := by
      rw [smul_inv_smul]; ring
