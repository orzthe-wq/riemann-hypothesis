      apply IntermediateField.lift_injective
      rw [IntermediateField.lift_adjoin, IntermediateField.lift_top]
      change _ = IntermediateField.adjoin K₀ (t : Set E)
      congr 1
      ext w
      constructor
      · rintro ⟨w, hw, rfl⟩
        exact Finset.mem_subtype.mp hw
