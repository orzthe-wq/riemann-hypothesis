        rintro a b ⟨G, hG, ha⟩ ⟨H, hH, hb⟩
        exact ⟨G + H, by simp [hG, hH], fun j => by simp [ha, hb]⟩
      zero_mem' := ⟨0, by simp, fun j => by simp⟩
