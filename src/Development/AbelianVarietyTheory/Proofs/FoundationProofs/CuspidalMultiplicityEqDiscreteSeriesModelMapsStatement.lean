def stab (w : W) : Subgroup (GfC V) where
  carrier := {g | σ g w = w}
  one_mem' := by simp
  mul_mem' := fun {a b} ha hb => by
    simp only [Set.mem_setOf_eq, map_mul, Module.End.mul_apply] at ha hb ⊢
    rw [hb, ha]
  inv_mem' := fun {a} ha => by
