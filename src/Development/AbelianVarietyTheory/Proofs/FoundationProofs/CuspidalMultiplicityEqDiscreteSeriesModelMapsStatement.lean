    refine congrFun (hvec.equalizer h1 h2 (funext fun u => ?_)) y
    let w : M.sm τ := ⟨M.rep τ g (u τ), GlobalTheory.SmoothStable.rep_mem_sm D V S M τ g hg _ (u τ).2⟩
