  have h2' : ∀ i i', lam (Sum.inr i) < lam (Sum.inr i') ↔ i' < i := fun i i' => h2.lt_iff_gt
  have h4 : ∀ i j, ¬ lam (Sum.inl i) < lam (Sum.inr j) := fun i j => (h3 i j).not_gt
