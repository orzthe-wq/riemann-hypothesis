    have h2 : 2 * P ∉ g.abelian₂ := fun h => hS (by
      rw [show P + Q = 2 * P - (P - Q) by ring]; exact sub_mem h hD)
    have a1 : logc g (P + Q) = logc g (2 * P) := by
      rw [show P + Q = 2 * P + -(P - Q) by ring]
      exact logc_per D cc δ g hg (tors_laq (tors_two hP)) h2 (neg_mem hD)
