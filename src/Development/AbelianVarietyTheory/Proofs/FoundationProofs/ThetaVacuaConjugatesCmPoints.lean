  let x' : Fin n → A₂' := fun i => ⟨y i, hy i⟩
  have hx' : Function.Bijective
      (fun i => (QuotientAddGroup.mk (x' i) : A₂' ⧸ A₁'.addSubgroupOf A₂')) := by
