theorem zr_eq_iff (c : Coef l) (n : ℕ) (z z' : G ℚ Ω → Fin 2 → Qbar l) (hz : ∀ s k, z s k ∈ c.O)
    (hz' : ∀ s k, z' s k ∈ c.O) (s : G ℚ Ω) :
