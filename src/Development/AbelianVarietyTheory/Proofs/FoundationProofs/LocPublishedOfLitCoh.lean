  rw [repG_apply, zr, zr, zr, act_redV, ← redV_add]
  funext k
  simp only [redV]
  rw [red_eq_iff, Pi.add_apply, AddMemClass.coe_add, Vo_mulVec_coe]
  have h := hcoc s t k
  simpa only [Pi.add_apply] using h

