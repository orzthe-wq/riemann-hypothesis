  show red c n ⟨z a k, hz a k⟩ = 0
  rw [red_eq_zero_iff, mem_nbhd]
  have := h k
  simpa [Cg] using this

theorem zr_mul (c : Coef l) (n : ℕ) (V : R2 Ω l) (hD : ∀ s i j, mat V s i j ∈ c.O)
    (z : G ℚ Ω → Fin 2 → Qbar l) (hz : ∀ s k, z s k ∈ c.O)
    (hcoc : ∀ s t, Cv n (z (s * t)) (z s + mat V s *ᵥ z t)) (s t : G ℚ Ω) :
