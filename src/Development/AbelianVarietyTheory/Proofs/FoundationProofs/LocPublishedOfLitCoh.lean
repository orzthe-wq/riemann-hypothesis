theorem zr_eq_zero (c : Coef l) (n : ℕ) (z : G ℚ Ω → Fin 2 → Qbar l) (hz : ∀ s k, z s k ∈ c.O)
    (a : G ℚ Ω) (h : Cv n (z a) 0) : zr c n z hz a = 0 := by
