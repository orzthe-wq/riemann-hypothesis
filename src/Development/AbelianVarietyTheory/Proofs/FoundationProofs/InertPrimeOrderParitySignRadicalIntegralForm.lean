    rw [La0, relIndex_La hδ, e L hL, e _ sd_std, cjL_std]
    refine (relIndex_pi_const _ _).trans ?_
    rw [relIndex_Iid hc.1.1 hn h', idx_cjL, Fintype.card_fin]

