        (AddSubgroup.pi Set.univ fun _ : Fin N => (mulL (Iid D cc) L').toAddSubgroup).map f := fun L' => by
      ext z
      refine (mem_RL_cols L' z).trans ⟨fun h => ⟨fun j i => z i j, fun j _ => h j, rfl⟩, ?_⟩
      rintro ⟨w, hw, rfl⟩ j
