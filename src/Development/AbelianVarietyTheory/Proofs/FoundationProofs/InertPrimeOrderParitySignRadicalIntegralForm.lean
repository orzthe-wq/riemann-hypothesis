theorem prod_sq_norm_embT : ∀ (D : D7) (y : 𝓞 D.host.E),
    ∏ τ, ‖embT D τ (y : D.host.E)‖ ^ 2 = (Ideal.absNorm (Ideal.span {y}) : ℝ) := by
