theorem exists_gen_inv (I : FractionalIdeal R⁰ K) (hI : I ≠ 0) {n : R} (hn : n ≠ 0) :
    ∃ t ∈ I, (∀ s ∈ I, ∃ a : R, ∃ s' ∈ I, s = a • t + n • s') ∧
