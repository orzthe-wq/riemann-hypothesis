  obtain ⟨-, -, hL⟩ := hok
  have hJ := _root_.GlobalTheory.Shin.isChar_J_of_reg F θ hθ a.L (fun p hp => by rw [← hq]; exact hL p hp) _ rfl
  exact jd_isChar hH θ a.L hJ a.D
