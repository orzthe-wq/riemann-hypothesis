  have hx : (x : Matrix (Fin t) (Fin t) F).det ≠ 0 :=
    ((Matrix.isUnit_iff_isUnit_det _).mp x.isUnit).ne_zero
  have ha : algebraMap F (AlgebraicClosure F) (x : Matrix (Fin t) (Fin t) F).det ≠ 0 :=
