      ρ (GlobalTheory.LBC.galAct (σ ^ j) n g) (((I : V →ₗ[ℂ] V) ^ j) x) := by
    intro j
    induction j with
    | zero =>
      intro g x
      rw [pow_zero, pow_zero, GlobalTheory.LBC.galAct_one]
      rfl
    | succ j ih =>
      intro g x
      rw [pow_succ', pow_succ', GlobalTheory.LBC.galAct_mul, Module.End.mul_apply, Module.End.mul_apply, ih]
