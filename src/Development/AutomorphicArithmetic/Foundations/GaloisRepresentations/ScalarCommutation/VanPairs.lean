      (∀ (q : ℕ) [Fact q.Prime] (τ : M →+* PadicAlgCl q), ‖τ ((x⁻¹ : Mˣ) : M)‖ ≤ 1) →
      Units.map ((Ideal.Quotient.mk m.asIdeal : M →+* M ⧸ m.asIdeal) : M →* M ⧸ m.asIdeal) x ∈ T := by
    intro m
    haveI := m.isMaximal
    letI : Field (M ⧸ m.asIdeal) := Ideal.Quotient.field m.asIdeal
