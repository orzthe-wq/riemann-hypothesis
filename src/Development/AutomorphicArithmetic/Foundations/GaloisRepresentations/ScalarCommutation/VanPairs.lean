  have hs : ∀ y, π (s y) = y := Function.surjInv_eq hπ
  have hcomp : ∀ a, π (c (s (π a))) = π (c a) := by
    intro a
    have h := hker (s (π a) - a) (by rw [map_sub, hs, sub_self])
    rw [map_sub, map_sub, sub_eq_zero] at h
    exact h
