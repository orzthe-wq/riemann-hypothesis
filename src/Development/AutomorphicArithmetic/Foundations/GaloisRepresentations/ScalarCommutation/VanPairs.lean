  let φ : Mˣ → ∀ m : MaximalSpectrum M, (M ⧸ m.asIdeal)ˣ := fun x m =>
    Units.map ((Ideal.Quotient.mk m.asIdeal : M →+* M ⧸ m.asIdeal) : M →* M ⧸ m.asIdeal) x
  have hφ : Function.Injective φ := by
