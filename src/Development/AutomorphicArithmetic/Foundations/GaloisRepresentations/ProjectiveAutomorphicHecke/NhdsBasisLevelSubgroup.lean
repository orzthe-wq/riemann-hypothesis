  · simp only [map_sum, mul_assoc]
    exact Finset.sum_congr rfl fun y _ => hΦ.1 γ _
  · have hx : comp w k ∈ KGL w (n := n) := (mem_lev.1 hk).2.2 w hS hcS
    set x := comp w k with hxdef
