  have sb := isSmoothChar_of_isUnram nb
  obtain ⟨e⟩ := hL _ n t ν b V W σ π (by omega) sν uν sb ub hs hi hu hs' hi' hl
  obtain ⟨a1, a2, a3⟩ := hS _ n (ν * b) V σ (sν.mul sb) (isUnitaryChar_mul uν ub) hs hi hu
