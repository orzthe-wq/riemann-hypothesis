    (β : GlobalTheory.SplitWeil.SB (Matrix (Fin n) (Fin d) k) →ₗ[ℂ] V →ₛₗ[starRingEnd ℂ] W) (hβ : β ≠ 0)
    (he : ∀ (g : GL (Fin n) k) (h : GL (Fin d) k) (Φ Φ₁ : GlobalTheory.SplitWeil.SB (Matrix (Fin n) (Fin d) k)),
