  have u5 : IsUnitarisable (contra π) :=
    GlobalTheory.GenericUnitary.isUnitarisable_of_equiv e.symm (GlobalTheory.SmGL.UnitInd.isUnitarisable_prod₂ (hU _ n V _ a1 a2 a3).1 ud)
