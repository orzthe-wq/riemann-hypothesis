  obtain ⟨⟨ι, hι⟩, -⟩ := _root_.PositivityTheory.KCo.dictX_proof_k F E σ n d B X W M om χX χW hp.base ⟨_, _, hp.herm⟩ ⟨_, _, hp.skew⟩ hp.weil v (t.comp σ)
  exact ⟨_, linW_of_linBar_pk hcm M B.ψ t P Q rfl rfl hι⟩
