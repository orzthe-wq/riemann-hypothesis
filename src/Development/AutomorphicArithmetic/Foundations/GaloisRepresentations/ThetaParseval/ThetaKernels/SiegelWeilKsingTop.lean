  have e : ∀ x, Fz z (mR a * nU (herm x) * mR b) = f (R.ι w (a * nr x * b) * z) := fun x => by
    have e1 : mR a * nU (herm x) * mR b = mR (a * nr x * b) := by rw [mR_mul', mR_mul', hnr]
    simp only [Fz]
    rw [e1, toGR'_mR]
  simp_rw [e] at key
  exact key
end PositivityTheory.SiegelWeilFormula.KSing
