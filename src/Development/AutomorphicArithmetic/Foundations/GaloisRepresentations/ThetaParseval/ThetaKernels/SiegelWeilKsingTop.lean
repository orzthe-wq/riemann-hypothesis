    rintro _ ⟨y', rfl, γ, hγ, x, hγx, hx⟩ h
    refine ⟨x⁻¹ * h, fun g hg => ?_⟩
    have e1 : mR y' * g = mR (y' * mkG g hg) := rfl
    have hy : R.ι w y' = γ * x⁻¹ := by rw [hγx, hx y', mul_inv_cancel_right]
