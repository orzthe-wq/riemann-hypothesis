  by_cases hS : S q
  · have hu2 : u q ^ 2 = -(q : ℂ) := by
      simp only [u, if_pos hS, mul_pow, hsqr, Complex.I_sq]
      ring
    obtain ⟨P₀, hP₀, hf₀, hq₀, hk₀⟩ := hS
    obtain ⟨m₀, hc₀⟩ := res_card P₀ hq hq₀
    obtain ⟨h2, hnd, hs, -⟩ := kept_deg hG hsq hs' hy P₀ hq hq₀ hc₀ hk₀
