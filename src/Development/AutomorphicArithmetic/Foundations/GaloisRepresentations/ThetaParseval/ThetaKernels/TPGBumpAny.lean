  rw [sub_smul, one_smul, sub_eq_zero] at h1
  exact h1.symm

private theorem gen_mem {v : Pl (F := F)} (t : Fv F v) (ht : t ∈ v.adicCompletionIntegers F) : sg v t • (1 : AE F E) ∈ Oh E v :=
