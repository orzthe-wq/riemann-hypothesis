private theorem unit_abs {O A : Type} [CommRing O] [IsLocalRing O] [CommRing A] (φ : O →+* A) (S : Subring A)
    (hφ : ∀ t, φ t ∈ S) (hint : ∀ x ∈ S, φ.IsIntegralElem x) {ϖ : O} (hϖ : ϖ ∈ IsLocalRing.maximalIdeal O) {n : ℕ}
