private theorem part2 {σ : E →ₐ[F] E} {X : Spc F E n} (b c : Matrix (Fin n) (Fin n) (AE F E)) {ϖ : Fv F v} (ϖ0 : ϖ ≠ 0) (k : ℕ) :
