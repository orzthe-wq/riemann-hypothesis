  refine ⟨S.subtype.mapMatrix Q⁻¹, fun i j => (Q⁻¹ i j).2, ?_⟩
  have hQ' : S.subtype.mapMatrix Q = 1 + φ ϖ • M := by
    ext i j
    simp [Q, M', φS, Matrix.one_apply, apply_ite]
    rfl
  rw [← hQ', ← map_mul, hQ, map_one]

