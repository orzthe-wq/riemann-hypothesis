private theorem comp_mem {v : Pl (F := F)} {x : AE F E} (hx : x ∈ Oh E v) : compFin F E v x ∈ SS E v := by
  refine ⟨by rw [sgE_comp, e_smul (oh_at hx)]; exact hx, ?_⟩
