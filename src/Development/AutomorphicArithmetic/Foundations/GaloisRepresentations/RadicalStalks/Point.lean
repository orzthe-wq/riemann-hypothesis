    simpa [x] using this
  obtain ⟨U, hU, hy, -⟩ := exists_isAffineOpen_mem_and_subset (x := g₁ x) (U := ⊤) trivial
  have r1 : Set.range g₁ ⊆ Set.range U.ι := by
    rintro _ ⟨z, rfl⟩
    rw [Subsingleton.elim z x, Scheme.Opens.range_ι]
    exact hy
  have r2 : Set.range g₂ ⊆ Set.range U.ι := by
