  rw [← Nat.card_eq_fintype_card, hq] at h
  have h2 := congrArg χ.kerLift h
  rw [map_pow] at h2
  simpa using h2

private theorem pow_ne_chi [CommRing C] {p : ℕ} [Fact p.Prime] (χ : C →+* k) {f j : ℕ}
    (hq : Nat.card (C ⧸ RingHom.ker χ) = p ^ f) (hj : 0 < j) (hjf : j < f) :
