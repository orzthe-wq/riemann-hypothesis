      simp [comm, semi, map_sub]
    rw [pow_succ, pow_succ, Module.End.mul_apply, Module.End.mul_apply, ih, h1]

private theorem Phi_maps {p : ℕ} (Φ : P →+ P) (semi : ∀ (l : k) x, Φ (l • x) = l ^ p • Φ x)
