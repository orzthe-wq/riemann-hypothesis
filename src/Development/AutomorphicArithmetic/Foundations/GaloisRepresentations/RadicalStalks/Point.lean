private theorem pow_card_chi [CommRing C] (χ : C →+* k) {q : ℕ} (hq0 : q ≠ 0)
    (hq : Nat.card (C ⧸ RingHom.ker χ) = q) (c : C) : χ c ^ q = χ c := by
