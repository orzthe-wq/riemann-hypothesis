    (frobDR p R hR A)^[f] (r • c) = r ^ p ^ f • (frobDR p R hR A)^[f] c := by
  induction f with
  | zero => simp
  | succ f ih =>
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih, GlobalTheory.LinFrob.frobDR_smul p hR, pow_succ,
