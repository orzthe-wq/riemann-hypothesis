private theorem pull_primPull (h : IsGrpPullback A' A (spMap (algebraMap R R')) φ) (e : A ⟶ A) (e' : A' ⟶ A')
    [IsMonHom e] [IsMonHom e'] (he : e'.left ≫ φ = φ ≫ e.left) (c : primDR A) :
