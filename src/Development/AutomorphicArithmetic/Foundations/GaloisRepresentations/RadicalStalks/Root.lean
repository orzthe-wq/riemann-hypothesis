private theorem pow_inj (h : (p : Γ(X, ⊤)) = 0) (U : X.Opens) {a b : Γ(X, U)} (e : a ^ p = b ^ p) :
    a = b := by
  have hU := GlobalTheory.SS.FrobField.cast_zero h U
