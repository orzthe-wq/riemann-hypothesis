      simpa [GlobalTheory.SS.FrobField.powHom] using this
    rw [e, rt_pow, rt_pow, rt_pow, map_add (f := _)])

private def rootPre (h : (p : Γ(X, ⊤)) = 0) : X.toPresheafedSpace.Hom Y.toPresheafedSpace where
