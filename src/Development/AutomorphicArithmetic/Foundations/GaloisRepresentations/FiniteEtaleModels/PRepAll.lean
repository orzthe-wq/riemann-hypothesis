  · rintro ⟨t, ht⟩ _ ⟨t', rfl⟩
    rwa [Subsingleton.elim t' t]

theorem range_sp_subset_compl {k : Type} [Field k] {X : Scheme.{0}} (f : Sp k ⟶ X) (U : Set X) :
    Set.range f ⊆ Uᶜ ↔ ¬ Set.range f ⊆ U := by
