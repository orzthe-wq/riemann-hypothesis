    (Q : Down X₁ X₂ → Prop) (ad : T.X.admitted (T.lev M₁) (T.lev M₂) h)
    (H : ∀ W : Wit T h M₁ M₂, ∃ d : Down X₁ X₂, d.Extends W C₁ C₂ ∧ Q d) :
    ∃ d : Down X₁ X₂, Ok T h (X₁.site.pi T C₁) (X₂.site.pi T C₂) (d.pw k) ∧ Q d := by
