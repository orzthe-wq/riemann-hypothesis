    obtain ⟨y₁, h1, h2⟩ := hg hsp
    obtain ⟨k, _, _, a, ha⟩ := GlobalTheory.FinEt.exists_algClosed_point Y y₁
    let pt : Spec (CommRingCat.of k) := (⊥ : PrimeSpectrum k)
