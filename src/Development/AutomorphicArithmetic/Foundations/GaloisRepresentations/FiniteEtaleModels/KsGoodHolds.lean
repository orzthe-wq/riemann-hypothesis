    (AlgebraicClosure (P.residueField p))))) (IsLocalRing.closedPoint _)) = p
  exact Scheme.fromSpecResidueField_apply p _

private theorem eq_of_geomPoints {P Y B : Scheme.{0}} [IsReduced P] (a b : P ⟶ Y) (g : Y ⟶ B) [IsSeparated g]
