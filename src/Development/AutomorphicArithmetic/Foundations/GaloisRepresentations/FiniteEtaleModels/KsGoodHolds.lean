      intro r hr
      have h3 : r ∈ (PrimeSpectrum.comap f.hom (⊥ : PrimeSpectrum k)).asIdeal := by
        simpa [PrimeSpectrum.comap_asIdeal] using hr
      have h4 : PrimeSpectrum.comap f.hom (⊥ : PrimeSpectrum k) = (⊥ : PrimeSpectrum O) := hpt
      rw [h4] at h3
