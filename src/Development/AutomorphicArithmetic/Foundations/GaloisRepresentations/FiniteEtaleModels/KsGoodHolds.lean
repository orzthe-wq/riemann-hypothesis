private theorem exists_geomPoint (P : Scheme.{0}) (p : P) :
    ∃ (Ω : Type) (_ : Field Ω) (_ : IsAlgClosed Ω) (t : Sp Ω ⟶ P) (q : Sp Ω), t q = p := by
