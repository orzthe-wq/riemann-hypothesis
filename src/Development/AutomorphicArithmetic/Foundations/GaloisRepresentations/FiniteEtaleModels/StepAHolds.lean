  exact I.add_mem (I.mul_mem_right _ hx) (I.mul_mem_right _ hy)

private theorem natCast_mem_of_isGen {A : Type} [CommRing A] {a : A} {N : ℕ} {𝔞 : Ideal A} (h : IsGen a N 𝔞) :
