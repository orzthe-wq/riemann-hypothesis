        have : (i : ℕ) < j := hij
        show (i : ℕ) ≤ k
        omega)
    rw [hcard, hjk]
    have h6 := mul_le_mul_of_nonneg_left (sub_le_sub_right hik (J.orderEmbOfFin hcard ⟨0, ha⟩))
      (Int.natCast_nonneg a)
    linarith

