    ϖ' ∈ (IsLocalRing.maximalIdeal V).comap c.hom := by
  rw [mem_basicOpen_fn, not_not] at hx
  have e : f' (y (IsLocalRing.closedPoint V)) = (Spec.map c) (IsLocalRing.closedPoint V) := by
    rw [← hc]; rfl
  rw [e] at hx
  exact hx

