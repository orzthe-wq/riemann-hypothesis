      rw [IsOpenImmersion.lift_fac]
      infer_instance
    haveI : Etale (IsOpenImmersion.lift _ a ha) := Etale.of_comp _ (T.p ⁻¹ᵁ Y.basicOpen (l : Γ(Y, ⊤))).ι
    haveI := T.et
