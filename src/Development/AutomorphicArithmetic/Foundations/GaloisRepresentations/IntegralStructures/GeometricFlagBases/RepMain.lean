      rw [mem]
      intro j' hj'
      by_cases h : j' = j
      · subst h
        omega
      · simp [h]
    have hw := (mem _ _).1 (hinv (c j + 1) g _ hv) i (by omega)
    simpa [Matrix.mulVec, dotProduct, Pi.single_apply] using hw
