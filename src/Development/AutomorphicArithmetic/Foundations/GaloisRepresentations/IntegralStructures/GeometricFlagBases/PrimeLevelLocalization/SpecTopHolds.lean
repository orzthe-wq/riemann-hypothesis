theorem UpperTheory.Gal.Spc.tyEx :
    UpperTheory.Gal.Spc.TyEx := by
  intro E _ _ _ A n p _ S F x U w₀ Up V hOff r W hAux N hrN hSt
  have hS0 : w₀ ∈ V.S := V.shape.mem
