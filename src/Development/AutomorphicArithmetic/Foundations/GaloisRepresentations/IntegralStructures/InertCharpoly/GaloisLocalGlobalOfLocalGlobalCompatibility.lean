  obtain ⟨P, hP, hPe⟩ := hbij.surjOn (hf hxT)
  have e : x = Y P := H.inj _ _ (hg P hP) (hfi (hmap hP) hxT hPe).symm
  rw [e]
  exact (hY P hP).2.2.1

