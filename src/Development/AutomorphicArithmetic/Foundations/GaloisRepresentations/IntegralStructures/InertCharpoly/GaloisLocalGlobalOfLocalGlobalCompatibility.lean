  have d1 := dim_one_of_dvd (H.cusp y (hl.isCusp hy)) fun s t => ⟨_, (T s t : (rc y).charPol ⁅s, t⁆ = _).dvd⟩
  rw [H.dim] at d1
  simp only [decide_eq_true_eq] at h2
  omega

