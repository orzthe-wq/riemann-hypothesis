      S.apply_mem_toSubmodule (b.ρ.mrangeRestrict g) (v := v) hv⟩
    refine (hb.eq_bot_or_eq_top T).imp ?_ ?_ <;> intro e <;>
      exact Subrepresentation.toSubmodule_injective
        (congrArg (fun U : Subrepresentation b.ρ => U.toSubmodule) e)
