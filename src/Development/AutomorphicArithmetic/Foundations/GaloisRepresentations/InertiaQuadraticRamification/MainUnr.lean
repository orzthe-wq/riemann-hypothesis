    refine h7 E X.K Ω A w w' hA hw' (hIne A hA) φ f hf hφ (fun k => ?_)
    rw [key, map_pow, map_pow, hr'D _ ⟨A, hA', hφD⟩, ← orderOf_dvd_iff_pow_eq_one, hord]
