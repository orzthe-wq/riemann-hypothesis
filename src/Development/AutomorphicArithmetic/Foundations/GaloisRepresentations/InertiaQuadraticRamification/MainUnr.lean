  · haveI := X.tower
    have hA' : IsPlaceOver A v := over_under hA
    have hsplit := (h8 E Ω A w hA).1 hw
    obtain ⟨φ₀, hφ₀⟩ := exists_isFrob hA'
    have hvw : normV w = normV v ^ 1 :=
