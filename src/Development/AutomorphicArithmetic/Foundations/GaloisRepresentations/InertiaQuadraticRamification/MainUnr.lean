        Dec (F := maximalRealSubfield E) A := dec_res hφ.1
    have hφF : IsFrob A (normV v) (AlgEquiv.restrictScalarsHom (maximalRealSubfield E) φ) := by
      refine ⟨hφD, fun x hx => ?_⟩
      have := hφ.2 x hx
      rw [hvw] at this
      exact this
