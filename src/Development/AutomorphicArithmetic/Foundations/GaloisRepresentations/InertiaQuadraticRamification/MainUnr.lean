        · rw [MonoidHom.ker_one]
          exact ⟨Good.top, RamSplit.mono le_top hψR⟩
        · rintro g ⟨B, hB, hg⟩
          exact (hu B hB).1 hg
      · obtain ⟨ψ', hψ'G, hψ'R, hψ'n, hψ'T, u', hu'T, hu'⟩ :=
          h3 E Ω U hUG.isOpen T hTf n hn
