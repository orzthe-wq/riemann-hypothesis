  have hL := LB.isLB_div hL1 hL2
  have cL := GlobalTheory.CechPic.cls_div hL1 hL2 hL
  have hev : ∀ {Y : Over (Sp k)} (u : Y ⟶ o.A) (v : Y ⟶ o'.A),
