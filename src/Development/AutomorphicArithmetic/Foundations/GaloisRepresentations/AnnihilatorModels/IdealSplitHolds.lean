      rw [← hcomp, pull_comp] at h'
      simp only [lift_fst_snd, Over.id_left, pull_id] at h'
      show cls (Hecke.lbPow o.P c) (LB.isLB_linComb o.isLB _ _) =
        cls (o'.P.pull (sq2 ψ)) (pull_isLB o'.isLB (sq2 ψ))
      rw [hc, hcls o'.isLB, h']
