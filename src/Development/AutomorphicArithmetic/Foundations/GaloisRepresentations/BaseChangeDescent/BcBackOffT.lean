  · obtain ⟨⟨ja, ha⟩, ⟨jb, hb⟩⟩ := hcls i s₁ s₂ Pa Pb D hc
    have h1 := ((hZ i w ja jb).2 Pa Pb (preEquiv_symm (hSP E _ _ _ ha)) (preEquiv_symm (hSP E _ _ _ hb))).1
