  · have := h2 (e.symm i) τ; rw [Equiv.apply_symm_apply] at this; exact this.symm

theorem rl_levels (hR : Rd.ReadLimit) (E : Type) [Field E] [NumberField E] [IsCMField E] (a b : ℕ) (Ma : Mods E a)
