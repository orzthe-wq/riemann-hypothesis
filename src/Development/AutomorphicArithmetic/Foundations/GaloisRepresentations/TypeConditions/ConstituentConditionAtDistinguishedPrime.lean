theorem crys_unram_of_lgc (D : D7) (htie : SumRepresentations.tie0 D) (hadm : SumRepresentations.adm1 D) (hLGC : large₂ D) (i : D.nd.Loc)
    (r : D.nd.X i → (Formalism.ConjugateSelfDual.G D.host.E D.nd.Om →* GL (Fin D.R.nV) (D.nd.O i)))
