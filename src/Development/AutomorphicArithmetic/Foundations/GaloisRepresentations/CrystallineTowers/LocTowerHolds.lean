    obtain ⟨n, hn⟩ := h m
    exact ⟨a ⊗ₜ n, by simp [hn]⟩
  | add x y hx hy =>
    rw [map_add (f := _)]
    exact Submodule.add_mem _ hx hy

private theorem bc_sum {R L M N J : Type*} [CommRing R] [CommRing L] [Algebra R L] [AddCommGroup M] [AddCommGroup N]
