    Finsupp.addHom_ext fun j m ↦ by
      rw [bcSum_single]
      simp [L, E, hf]
  change Function.Bijective (bcSum e ψ) ↔ Function.Bijective L
  rw [hL]
  exact Function.Bijective.of_comp_iff L E.symm.bijective

