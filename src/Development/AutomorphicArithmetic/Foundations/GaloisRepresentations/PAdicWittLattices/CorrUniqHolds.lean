  obtain ⟨t1, ht1, hu1⟩ := hex (ZMod (l ^ k))
  have huniq : ∀ t, IsTransfer (ZMod (l ^ k)) f t → t = transfer (ZMod (l ^ k)) f := fun t ht =>
    (hu1 t ht).trans (hu1 _ (transfer_spec _ ⟨t1, ht1⟩)).symm
