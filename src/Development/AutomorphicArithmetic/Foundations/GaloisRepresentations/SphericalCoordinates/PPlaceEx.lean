  have h3 : Matrix.trace (((starRingEnd ℂ).mapMatrix) (G.psi v c)) = (starRingEnd ℂ) (Matrix.trace (G.psi v c)) := by

    simp [Matrix.trace, map_sum]
  rw [h3, Complex.add_conj]

