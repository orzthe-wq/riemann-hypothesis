  have hB : starRingEnd ℂ (∏ i, (1 - ty i x * ev i)) = ∏ τ, B τ := by
    rw [map_prod]
    simp only [map_sub, map_one, map_mul]
    rw [prod_ty ty ev (fun τ r => 1 - starRingEnd ℂ (τ x) * starRingEnd ℂ r)]
