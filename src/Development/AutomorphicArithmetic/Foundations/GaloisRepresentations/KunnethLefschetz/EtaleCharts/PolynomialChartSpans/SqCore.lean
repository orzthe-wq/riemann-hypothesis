    linear_combination (T' * Dk) * hl - (T' * Dl) * hk
  have hu : T * T' * b ^ n ∈ nonZeroDivisors A :=
    mul_mem (mul_mem hT hT') (hb.pow n).mem_nonZeroDivisors
  exact sub_eq_zero.1 ((mul_right_mem_nonZeroDivisors_eq_zero_iff hu).1 h0)

