variable {R : Type} [CommRing R] {W : Scheme.{0}} (s : W ⟶ Sp R) {M : ℕ}

private lemma rho_comp {Y : Scheme.{0}} (h : Y ⟶ W) (r : R) : rho (h ≫ s) r = h.appTop (rho s r) := by
