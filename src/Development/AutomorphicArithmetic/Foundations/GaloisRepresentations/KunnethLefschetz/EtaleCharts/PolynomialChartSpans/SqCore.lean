  refine Eq.trans ?_ (rho_comp s U.ι r).symm
  refine Eq.trans ?_ (phi_C s U x r)
  rfl

private lemma loc_preimage (U : W.Opens) (x : Fin (M + 1) → Γ(W, U)) (m : Fin (M + 1))
