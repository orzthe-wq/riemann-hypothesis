    IsPullback (GlobalTheory.KS.powMap f φ hφ k ≫ e.inv) ((GlobalTheory.KS.pow A' k).hom ≫ s') q g := by
  have P := (GlobalTheory.KS.PowPB.powMap_isPullback S S' A A' f φ hφ H k).paste_vert hf
