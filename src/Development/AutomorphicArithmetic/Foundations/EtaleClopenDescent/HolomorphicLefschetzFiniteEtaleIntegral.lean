    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨_, n, rfl⟩
      rw [hres, map_pow]
      exact (IsUnit.of_mul_eq_one _ hwv).pow n
    · intro t
      obtain ⟨N, hN⟩ := (hloc _).1 ((ringW _).2 ⟨t, rfl⟩)
      obtain ⟨a, ha⟩ := (ringl _).1 hN
      refine ⟨⟨a, ⟨wf ^ N, N, rfl⟩⟩, ?_⟩
      apply germ_injective_of_isIntegral Z (genericPoint Z) hgW
      simp only [hres]
