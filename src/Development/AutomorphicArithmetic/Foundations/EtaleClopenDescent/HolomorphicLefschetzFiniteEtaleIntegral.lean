theorem SemiHom.mDR_ιMulti_D {σ : R →+* R'} {α : B →+* B'} (h : SemiHom σ α) (q : ℕ) (v : Fin q → B) :
    h.mDR (ExteriorAlgebra.ιMulti B q fun i => D R B (v i)) =
