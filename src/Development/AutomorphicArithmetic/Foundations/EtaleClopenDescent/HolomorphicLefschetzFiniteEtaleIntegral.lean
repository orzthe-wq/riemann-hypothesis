  · subst hli; exact hP
  have eW : U l ⊓ U i = ({l, i} : Finset (Fin (d + 1))).inf U := by simp
  have hW : IsAffineOpen (U l ⊓ U i) := eW ▸ hU.affine {l, i} ⟨l, by simp⟩
  have hUl : IsAffineOpen (U l) := by simpa using hU.affine {l} ⟨l, by simp⟩
