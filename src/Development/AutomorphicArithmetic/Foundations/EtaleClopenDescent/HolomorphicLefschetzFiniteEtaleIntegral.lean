    apply germ_injective_of_isIntegral Z (genericPoint Z) hgW
    rw [map_mul, map_one, germ_resG hle hgW hgl, hw, hvf, ← map_mul,
      div_mul_div_comm, mul_comm (x i), div_self (mul_ne_zero (hx.pd.ne _) (hx.pd.ne _)), map_one]
