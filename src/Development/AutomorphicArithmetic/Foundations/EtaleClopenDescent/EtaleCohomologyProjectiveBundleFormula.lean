private abbrev Ac (N : ℕ) : Act := (BC N).sub ((Q1 N).comap (βC N))

private theorem isUnit_cyclotomicPeriod_deRham {N : ℕ} {A : CommRingCat.{0}} (p : Ob (Ac N) A) :
    IsUnit ((show Um N A × Um 2 A from p.pt.1).2.1 1) := by
