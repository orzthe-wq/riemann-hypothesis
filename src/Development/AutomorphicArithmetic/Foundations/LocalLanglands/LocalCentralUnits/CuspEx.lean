    refine (hψ _).1 fun x => ?_
    obtain ⟨t, ht⟩ := hs (ofAdd ((f ^ (-j')) x))
    have h1 := DFunLike.congr_fun e t
    rw [eta_apply, eta_apply, ht, toAdd_ofAdd] at h1
