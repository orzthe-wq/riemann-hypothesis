    rw [map_mul, toAdd_mul, map_add (f := _), ofAdd_add, map_mul]

private theorem eta_apply (f : RingAut K) (ψ : Multiplicative K →* ℂˣ) (π : Ine (F := E) A →* Multiplicative K) (j : ℤ)
