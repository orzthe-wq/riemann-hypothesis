    (fun x => c * (dl w x.1 * pw ξ x.1)) (fun x => (hCC x.1 x.2).1) u hu hu0
    (fun x => by rw [← dcos_eq]; exact heig x.1 x.2)
  obtain ⟨y, hy⟩ : ∃ y : Jacquet P'.ρ (GlobalTheory.SmGL.unipB (w.adicCompletion E) (Fin m)), y = Submodule.Quotient.mk u' :=
    ⟨_, rfl⟩
