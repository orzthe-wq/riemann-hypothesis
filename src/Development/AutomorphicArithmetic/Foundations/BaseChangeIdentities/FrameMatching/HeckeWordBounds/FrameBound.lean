      have hb := h1 E hE n d hd hM a ha N w hwB
      by_cases hmu : w ∈ d.S₀ ∨ (w ∈ d.Bad ∧ IsSplitAt w)
      · have e : MLM.muAt d w = d.μ w := by simp only [MLM.muAt, if_pos hmu]
