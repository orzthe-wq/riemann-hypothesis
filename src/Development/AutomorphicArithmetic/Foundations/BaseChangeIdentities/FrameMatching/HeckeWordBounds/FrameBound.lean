  refine GlobalTheory.CompanionTheory.HintLevel.hint_eq_level _ K K' _ hKK (fun k hk x => ?_) hN
  show f₁ (x * k) * f₂ ((x * k)⁻¹ * y) = f₁ x * f₂ (x⁻¹ * y)
  rw [h₁ x k hk, mul_inv_rev, mul_assoc, h₂ _ (K'.inv_mem hk)]

