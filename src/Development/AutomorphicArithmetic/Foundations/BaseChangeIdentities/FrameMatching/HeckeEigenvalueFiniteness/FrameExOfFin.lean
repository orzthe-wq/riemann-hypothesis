theorem xn_hi (β : Fin (n / 2) → ℂˣ) (k : Fin n) (h1 : ¬ k.val < n / 2) (h : n - 1 - k.val < n / 2) :
    ‖(xiOf n β k : ℂ)‖ = ‖(β ⟨n - 1 - k.val, h⟩ : ℂ)‖⁻¹ := by
