  refine ⟨_, ⟨_, M * l ^ (n + 1), κ × ι, inferInstance, _, a', x', hMp, hM', ?_, htr, hf', hx' _, rfl⟩,
    hc a' (Units.mk0 h hh) x' (hx' _) hprod⟩
  exact inf_le_inf_right _ (hH.trans inf_le_left)

end

