private theorem frac (M M' : ℕ) [NeZero M] (h : M' = M) (a : ℤ) (z : ZMod M) (hz : (a : ZMod M) = z) :
    ∃ j : ℤ, (a : ℚ) / (M' : ℚ) = (z.val : ℚ) / M + j := by
