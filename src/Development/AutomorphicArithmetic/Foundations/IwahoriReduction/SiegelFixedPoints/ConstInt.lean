    exact congrArg (fun f => f ⟨x, hx⟩) hlin
  refine ⟨fun g => if h : g ∈ geo F K Kb then η₀ (r ⟨g, h⟩) else 0, ?_, ?_⟩
  · have : (fun g : geo F K Kb => (fun g => if h : g ∈ geo F K Kb then η₀ (r ⟨g, h⟩) else 0)
        (g : Kb ≃ₐ[F] Kb)) = η₀ ∘ r := by
