    rw [Finset.prod_product]
    show X.gal (ρ y) (f y) = _
    rw [hf1, hFF, map_pow, map_prod, ← Finset.prod_pow]
    refine Finset.prod_congr rfl fun r₀ _ => ?_
    rw [map_prod, ← Finset.prod_pow]
