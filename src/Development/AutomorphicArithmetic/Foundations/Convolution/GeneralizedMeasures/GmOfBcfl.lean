    exact Finset.sum_eq_zero fun i hi => by rw [h i hi x hx, mul_zero]
  · have e : ∀ y, twKQ θ (∑ i ∈ s, c i • f i) y = ∑ i ∈ s, c i * twKQ θ (f i) y :=
      fun y => twK_sum θ s c f _
    unfold twInt
