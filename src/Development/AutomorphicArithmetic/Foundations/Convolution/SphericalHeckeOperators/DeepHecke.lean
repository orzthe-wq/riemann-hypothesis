  exact congrArg (fun x : HeckeAlgebra μ => (x : GL (Fin n) F → ℂ))
    (HeckeAlgebra.isIdempotentElem_idem (μ := μ) (isCompact_integralGL F n) (isOpen_integralGL F n)).eq

end Aux3

