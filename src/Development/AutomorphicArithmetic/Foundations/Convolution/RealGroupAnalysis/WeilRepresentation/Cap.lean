    Commute (Xa θ x a b) (y j) := by
  fin_cases a <;> fin_cases b
  · exact h 1 j
  · exact (h 2 j).add_left ((h 3 j).smul_left θ)
  · exact (h 2 j).sub_left ((h 3 j).smul_left θ)
  · exact h 0 j

