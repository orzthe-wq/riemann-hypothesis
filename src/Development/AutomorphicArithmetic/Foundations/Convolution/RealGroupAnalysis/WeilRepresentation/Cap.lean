private theorem coord_half {E : Type} [Field E] [NumberField E] [_root_.NumberField.IsTotallyComplex E] (σ τ : E →+* ℂ) :
    (1 / 2 : ℂ) * (coord σ (atEmb τ 1) - Complex.I * coord σ (atEmb τ Complex.I)) = if σ = τ then 1 else 0 := by
