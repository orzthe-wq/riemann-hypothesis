      _ = (O.d w' j * W.Om (wW F)) * O.p D.δ w i := congrArg (· * O.p D.δ w i) (dW F E D W O w' j).symm
      _ = O.d w' j * (W.Om (wW F) * O.p D.δ w i) := mul_assoc _ _ _
