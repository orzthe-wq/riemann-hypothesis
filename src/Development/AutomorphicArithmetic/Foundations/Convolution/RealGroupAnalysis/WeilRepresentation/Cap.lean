    intro σ
    rw [smul_smul, ← sub_smul, smul_smul, coord_half]
    split_ifs <;> simp
  rw [hx, hy, Finset.smul_sum, ← Finset.sum_sub_distrib, Finset.smul_sum]
  simp only [hz]
  simp

