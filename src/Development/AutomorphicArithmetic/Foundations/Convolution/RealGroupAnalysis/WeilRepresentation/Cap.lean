variable {A : Type*} [Ring A] [Algebra ℂ A]

private def Xa (θ : ℂ) (x : Fin 4 → A) : Fin 2 → Fin 2 → A :=
  ![![x 1, x 2 + θ • x 3], ![x 2 - θ • x 3, x 0]]

private noncomputable def Da (θ : ℂ) (d : Fin 4 → A) : Fin 2 → Fin 2 → A :=
  ![![d 1, (2 : ℂ)⁻¹ • (d 2 + θ⁻¹ • d 3)], ![(2 : ℂ)⁻¹ • (d 2 - θ⁻¹ • d 3), d 0]]

