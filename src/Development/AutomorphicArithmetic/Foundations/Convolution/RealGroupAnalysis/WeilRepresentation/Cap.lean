    Commute (Xa θ x a b) (Xa θ x c d) := by
  have h' := Xa_comm_coord θ h a b
  fin_cases c <;> fin_cases d
  · exact h' 1
  · exact (h' 2).add_right ((h' 3).smul_right θ)
  · exact (h' 2).sub_right ((h' 3).smul_right θ)
  · exact h' 0

