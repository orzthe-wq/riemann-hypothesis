  obtain ⟨hsq, -, hθ⟩ := (coordMk F E D).2.1 τ
  have hx : ∀ i j, Commute (O.x (pl F τ) i) (O.x (pl F τ) j) := fun i j => (weyl F O _ _ i j).1
  have hd : ∀ i j, Commute (O.d (pl F τ) i) (O.d (pl F τ) j) := fun i j => dComm F E D W O _ _ i j
