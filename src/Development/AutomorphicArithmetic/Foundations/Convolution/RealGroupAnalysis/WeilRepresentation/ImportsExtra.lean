    have hcont1 : Continuous fun p : IdeleGroup F × G1 F => Wf f.1 (gl (mD p.1 * p.2)) :=
      hWc.comp (continuous_gl.comp ((continuous_mD.comp continuous_fst).mul continuous_snd))
