    obtain ⟨M, L, hM, hb⟩ := GlobalTheory.CompanionTheory.EpConvB.exists_majorant hmem (C := {1}) isCompact_singleton N
    refine ⟨Real.exp (∑ _w : InfinitePlace F, R ^ 2) * M, L, mul_nonneg (Real.exp_pos _).le hM, fun v => ?_⟩
