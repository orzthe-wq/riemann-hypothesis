  have hker := slKer F E D W φ₂ (slZero F E D W v ϖ hϖ hGd hAn φ₂ hn hw)
  let u : G1 F → ℂ := fun g => f g * ThRow 0 0 (W.Om g φ).1
  have hu : ∀ γ g, u (ratS F γ * g) = u g := by
