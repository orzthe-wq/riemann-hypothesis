    have e : io c A (u⁻¹).val * u.val = 1 := by
      conv_lhs => rw [← hu]
      rw [← map_mul, Units.inv_mul, map_one]
    calc io c A (u⁻¹).val = io c A (u⁻¹).val * (u.val * (u⁻¹).val) := by rw [Units.mul_inv, mul_one]
      _ = (u⁻¹).val := by rw [← mul_assoc, e, one_mul]
