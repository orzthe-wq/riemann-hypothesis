  have hιa : ∀ t, ι t = UpperTheory.ConvolutionTheory.D.io c A t := fun _ => rfl
  have hinv : ∀ t, ι (ι t) = t := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => simp
    | tmul r a => simp only [hιa, hio, hc2]
