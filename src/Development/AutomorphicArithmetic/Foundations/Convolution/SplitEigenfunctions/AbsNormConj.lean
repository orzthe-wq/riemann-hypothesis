    have e : dM (s ^ 2) = (gl (mD s))⁻¹ * Matrix.GeneralLinearGroup.scalar (Fin 2) s := by
      rw [← gl_mD_mul_dM_sq, inv_mul_cancel_left]
    rw [gl_mul, gl_inv]
