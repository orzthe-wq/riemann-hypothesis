  have ht1 : pInf E (t : A E) = 1 := by
    have h1 : Units.map (pInf E).toMonoidHom t = 1 := by
      have h2 := congrArg (Units.map (pInf E).toMonoidHom) ht
      rw [map_mul, map_pow, hs, hr] at h2
      exact (mul_eq_left.1 h2.symm)
