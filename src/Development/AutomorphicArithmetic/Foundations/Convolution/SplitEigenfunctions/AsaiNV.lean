  refine ⟨fun y x hne v hv => ?_, fun t ht hL y x => ?_⟩
  · rw [whittaker_lieDerivative_linear hc] at hne
    by_contra hcon
    have h1 : Wo D (lie E 2 X f).1 (em E (aE y) * infGL E 2 x) = 0 := by
