    intro y hy
    rcases Q.irred _ (Submodule.map_subtype_le _ _) hst with h | h
    · have hm : y.1 ∈ (LinearMap.ker B.flip).map Q.V.subtype :=
        ⟨y, LinearMap.mem_ker.2 (LinearMap.ext hy), rfl⟩
      rw [h] at hm
