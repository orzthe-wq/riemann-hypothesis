    · exfalso
      refine hne (LinearMap.ext fun x => LinearMap.ext fun z => ?_)
      have hz : z.1 ∈ (LinearMap.ker B.flip).map Q.V.subtype := by rw [h]; exact z.2
      obtain ⟨u, hu, e⟩ := hz
