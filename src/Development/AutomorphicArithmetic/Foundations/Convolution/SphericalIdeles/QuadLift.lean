    · rintro ⟨y, hy, h⟩
      exact ⟨y, y.2, fun h0 => hy (Subtype.ext h0), fun t => congrArg Subtype.val (h t)⟩
    · rintro ⟨y, hyP, hy, h⟩
      exact ⟨⟨y, hyP⟩, fun h0 => hy (congrArg Subtype.val h0), fun t => Subtype.ext (h t)⟩
