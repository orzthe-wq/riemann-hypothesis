private theorem finSpace (ρ : Typ E r) (B : ℝ) : ∃ W : Submodule ℂ (cuspForms E r), FiniteDimensional ℂ W ∧
    ∀ (S) (b : Blo S r), Killed ρ.ρ b.f.1 → (∀ τ i, ‖b.Λ τ i‖ ≤ B) → (⟨b.f.1, b.cusp⟩ : cuspForms E r) ∈ W := by
