    intro t a b
    exact LinearIsometry.inner_map_map (⟨u t, hiso t⟩ : E →ₗᵢ[ℂ] E) a b
  have h0' : ∀ a : E, u 0 a = a := by
    intro a
    rw [h0]
    rfl
  have hskew : ∀ a b : E, inner ℂ (D a) b + inner ℂ a (D b) = 0 := by
    intro a b
    have h1 := (hder a).inner ℂ (hder b)
