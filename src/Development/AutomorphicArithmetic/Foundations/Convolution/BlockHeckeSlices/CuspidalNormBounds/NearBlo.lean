    have hw0 : w ≠ 0 := hw.2
    have hconst : ∀ t : ℝ, Complex.exp (-(z * t)) • u t w = w := by
      have hd : ∀ t : ℝ, HasDerivAt (fun s : ℝ => Complex.exp (-(z * s)) • u s w) 0 t := by
