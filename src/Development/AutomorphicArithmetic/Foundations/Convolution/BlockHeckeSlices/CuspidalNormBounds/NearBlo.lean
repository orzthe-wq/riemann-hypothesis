            (Complex.exp (-(z * t)) * (-z)) t := by
          have hl : HasDerivAt (fun s : ℝ => -(z * (s : ℂ))) (-z) t := by
            have h : HasDerivAt (fun s : ℝ => (s : ℂ)) 1 t := by
              simpa using (hasDerivAt_id t).ofReal_comp
