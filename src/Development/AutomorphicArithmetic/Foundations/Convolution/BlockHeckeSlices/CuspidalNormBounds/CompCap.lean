      hφ.level.preimage (GlobalTheory.GLSlice.continuous_embGL _)
    refine Subgroup.isOpen_of_mem_nhds (stab Φ) (g := 1) (Filter.mem_of_superset (ho.mem_nhds (by simp)) fun k hk => ?_)
    refine Subtype.ext (funext fun g => ?_)
