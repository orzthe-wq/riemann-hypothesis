      have hB2 : B₂ < w.re := lt_of_le_of_lt (le_trans (le_max_right _ _) (le_max_left _ _)) hw
      have hB3 : (a : ℝ) - 1 < w.re := lt_of_le_of_lt (le_max_right _ _) hw
