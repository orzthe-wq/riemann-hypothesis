  have hK : ∀ x, x ∈ D.toDet.ker ↔ D.Kills x := fun x => ((d_ker D.toDet x).1).trans (d_toDet D x).2.2.2
  let π := MonoidAlgebra.mapRingHom G (TrivSqZeroExt.fstHom k k k : DualNumber k →+* k)
  have hlift : ∀ z ∈ J, ∃ x ∈ D.toDet.ker, π x = z := by
    intro z hz
