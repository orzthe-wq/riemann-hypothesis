        rw [← g_chmap]
        exact TwoSidedIdeal.subset_span hw
      refine lift_span π fst_surj D.toDet.ker _ ?_ w hw'
      rintro _ ⟨v, hv, rfl⟩
      refine ⟨v, ?_, rfl⟩
