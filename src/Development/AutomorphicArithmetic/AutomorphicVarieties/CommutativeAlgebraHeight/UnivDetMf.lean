    rw [pow_two, eq_bot_iff]
    refine Ideal.mul_le.2 fun r hr s hs => ?_
    rw [mem_maximalIdeal, mem_nonunits_iff, TrivSqZeroExt.isUnit_iff_isUnit_fst, isUnit_iff_ne_zero, not_not] at hr hs
    rw [Ideal.mem_bot]
