  have hcp := GlobalTheory.Published.ParamAboveModel.isComp_loc (w := u) χ
  refine ⟨μ.comp (Dec (F := M) A).subtype, (χ.loc u).comp a, hμc.comp continuous_subtype_val, ha.smooth hcp.1,
