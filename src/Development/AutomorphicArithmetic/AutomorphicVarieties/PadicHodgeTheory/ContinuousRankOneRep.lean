private theorem cont_symm {F K : Type} [Field F] [NumberField F] [Field K] [NumberField K]
    {v : HeightOneSpectrum (𝓞 F)} {w : HeightOneSpectrum (𝓞 K)} (i : v.adicCompletion F ≃+* w.adicCompletion K)
