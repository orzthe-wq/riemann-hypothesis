          apply Finset.sum_le_sum
          intro i _
          apply mul_le_mul_of_nonneg_right _ (by positivity)
          rw [norm_sub_rev]
          exact (hq i).le
      _ = ε / (S + 1) * S := by rw [hS, Finset.mul_sum]
      _ < ε := by
          rw [div_mul_eq_mul_div, div_lt_iff₀ hB]
          nlinarith

