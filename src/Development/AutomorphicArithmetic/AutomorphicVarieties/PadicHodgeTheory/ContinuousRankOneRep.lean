  let t : M →+* Om l := τ.1.comp (algebraMap M (u.adicCompletion M))
  have hjE : ∀ x : 𝓞 M, ‖jE (x : M)‖ < 1 ↔ x ∈ u.asIdeal := fun x =>
    (hj.valuation_lt_one_iff _).symm.trans (h x)
  have ht : ∀ x : 𝓞 M, ‖t (x : M)‖ < 1 ↔ x ∈ u.asIdeal := fun x => by
