  unfold GroundTheory.Automorphic.AutomorphicForm.IsCuspidal at h1
  push Not at h1
  obtain ⟨r, h0, hr, hg⟩ := h1
  obtain ⟨s, rfl⟩ : ∃ s, a = r + s := ⟨a - r, by omega⟩
