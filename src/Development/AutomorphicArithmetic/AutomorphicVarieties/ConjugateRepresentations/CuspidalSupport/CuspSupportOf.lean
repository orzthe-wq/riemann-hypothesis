  obtain ⟨ι, _, n, π, μ, h1, h2⟩ := h
  exact ⟨ι, inferInstance, n, π, μ, hl.trans h1, h2⟩

private theorem supp_two (hS : Step) (hT : SuppTwist) (hA : SuppAdd) {a : ℕ}
