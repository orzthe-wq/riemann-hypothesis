      · show c (v * w) = c v + c w
        rw [hc, htr v ((hU _).1 v.2) _ (hcl' _)]
      · by_cases hA : Over A l
        · exact hdec A hA v (Ine_le_Dec (F := ℚ) A hv) ((hU _).1 v.2)
        · exact hI A hA v hv
      · exact hdec A hA v hv ((hU _).1 v.2)
