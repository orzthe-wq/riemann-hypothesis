    ext s : 1
    apply Units.ext
    show (B.g v : Matrix (Fin 3) (Fin 3) O) * (B₀.r ((F.loc v) s)).mat * ((B.g v)⁻¹ : GL (Fin 3) O) = _
    rw [hBg, hr s, ht s]
