private theorem finite_linearMap_of_finite_module_finite {O M N : Type} [CommRing O] [AddCommGroup M] [Module O M] [AddCommGroup N]
    [Module O N] [Module.Finite O M] [Finite N] : Finite (M →ₗ[O] N) := by
