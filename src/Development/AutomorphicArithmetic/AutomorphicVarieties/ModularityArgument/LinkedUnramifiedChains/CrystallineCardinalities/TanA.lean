    IsCr (GK K).subtype ρ := by
  have := E'.2
  have : IsModuleTopology ℚ_[l] (Fin n → ↥E'.1) := isModuleTopologyOfFiniteDimensional
  exact (isCrIff K ρ).1.2 ((isCrField K ρ).1.2 h)

