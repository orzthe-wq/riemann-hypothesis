private theorem fieldOf {l : ℕ} [Fact l.Prime] (c : Coef l) : ∃ E : FinExt l, (∀ x : c.O, x.1 ∈ E.1) ∧
    ∀ x ∈ E.1, ∃ (m : ℕ) (a : c.O), (l : PadicAlgCl l) ^ m * x = a.1 := by
