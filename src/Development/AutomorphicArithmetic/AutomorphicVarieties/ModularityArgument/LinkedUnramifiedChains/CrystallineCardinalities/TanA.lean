      change _ + (cycA l l E (φ (e.symm g)) : E) * _ = _
      rw [hφ']
      rfl⟩, x, fun g => by
      refine (hx (e.symm g)).trans ?_
      congr 2
      unfold actC
      rw [hφ']
      congr 1
      refine LinearMap.ext fun y => ?_
      change (cycA l l E (φ (e.symm g)) : E) * _ = _
      rw [hφ']
