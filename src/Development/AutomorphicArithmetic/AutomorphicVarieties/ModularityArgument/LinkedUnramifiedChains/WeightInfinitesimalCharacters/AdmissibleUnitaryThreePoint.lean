structure Adm3U {l : ℕ} [Fact l.Prime] {K Ω : Type} [Field K] [NumberField K] [IsCMField K] [Field Ω] [Algebra K Ω] [IsAlgClosure K Ω]
    (ι : Qbar l ≃+* ℂ) (e N : ℕ) (ρ : G K Ω →* GL (Fin 3) (Qbar l)) : Prop extends Adm3 ι e N ρ where
  unl : Th.Unl l N ![(e : ℤ), 0, -(e : ℤ)] ρ

