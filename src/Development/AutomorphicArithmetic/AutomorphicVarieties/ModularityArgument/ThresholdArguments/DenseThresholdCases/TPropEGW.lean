  have hg : ∀ a b : ℕ, (fun j : ℕ => χ (j : ZMod N) * (j : ℂ) ^ (k - 1)) (a * b) =
      (fun j : ℕ => χ (j : ZMod N) * (j : ℂ) ^ (k - 1)) a *
        (fun j : ℕ => χ (j : ZMod N) * (j : ℂ) ^ (k - 1)) b := by
    intro a b
    simp only [Nat.cast_mul, map_mul, mul_pow]
    ring
  have h := sum_div_hecke (fun j : ℕ => χ (j : ZMod N) * (j : ℂ) ^ (k - 1)) hg hp n hn
  beta_reduce at h
  simp only [sigChi]
  exact h

