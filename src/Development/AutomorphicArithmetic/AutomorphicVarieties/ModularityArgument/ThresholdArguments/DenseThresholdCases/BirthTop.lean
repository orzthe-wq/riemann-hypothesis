    simp
  have hne : toB (phi D T₀.pr) ≠ 1 := by
    intro h
    have h' := congrArg (fun u : (Qbar l)ˣ => (u : Qbar l)) hcc'
    rw [h] at h'
    simp only [MonoidHom.one_apply, Units.val_one, Units.val_neg] at h'
