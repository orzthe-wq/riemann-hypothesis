  obtain ⟨k₀, hk₀⟩ := hP l Ω ι D.cc hctx.1.isCC N w (toB (phi D T₀.pr)) θ haux hsp hne
  obtain ⟨n, hn⟩ : ∃ n, n = B + k₀ + 2 := ⟨_, rfl⟩
  have hl1 : 1 ≤ l - 1 := by have := (Fact.out : l.Prime).two_le; omega
