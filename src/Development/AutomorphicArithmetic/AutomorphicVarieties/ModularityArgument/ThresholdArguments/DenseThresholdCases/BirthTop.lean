    (ht : ∀ i j, AdicCont I fun g => t g i j) (i j : Fin 4) : AdicCont I fun g => tn (f g) (t g) i j := by
  fin_cases i <;> fin_cases j <;> simp [tn] <;>
    first
    | exact ac_mul (hf _ _) (ht _ _)
    | exact ac_neg (ac_mul (hf _ _) (ht _ _))

end

