    (h : g.val.charpoly.map ι.toRingHom = UpperTheory.V.Z.Sym.W.psPol φ x) :
    ι (Ga.uf g) = (((φ 0 / φ 1) x : ℂˣ) : ℂ) + ((((φ 0 / φ 1) x)⁻¹ : ℂˣ) : ℂ) := by
  have e := uf_of_charpoly ι g (fun j => φ j x * absPow k (-((((2 : ℕ) : ℂ) - 1) / 2)) x) h
