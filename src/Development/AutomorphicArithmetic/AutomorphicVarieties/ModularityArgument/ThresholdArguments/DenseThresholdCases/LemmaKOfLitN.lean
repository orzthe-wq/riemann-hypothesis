theorem not_dvd_sub (l c M i j : ℕ) (hl : l.Prime) (hc : 1 ≤ c) (hM : M < l ^ c) (hij : j < i) (hi : i < M) :
    ¬ (l : ℤ) ^ (c + M) ∣ (1 + (l : ℤ) ^ c) ^ i - (1 + (l : ℤ) ^ c) ^ j := by
