  rw [← map_pow, ← ofAdd_nsmul, nsmul_eq_mul, ← Nat.cast_mul, hn, ofAdd_toAdd]

theorem prim_map {R k : Type} [CommRing R] [IsDomain R] [Field k] (r : R →+* k) (l ν : ℕ) (hl : l.Prime)
    (hν : 1 ≤ ν) (hr : r l ≠ 0) (ζ : Rˣ) (hζ : IsPrimitiveRoot ζ (l ^ ν)) :
