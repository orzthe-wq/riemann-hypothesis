theorem pe_dvd (l c ν M E : ℕ) (hl : l.Prime) (hc : 1 ≤ c) (hM : M < l ^ c) (hE : E < M) :
    (pe (1 + l ^ c) M E : ZMod (l ^ ν)) ∣ (l : ZMod (l ^ ν)) ^ (M * (c + M)) := by
