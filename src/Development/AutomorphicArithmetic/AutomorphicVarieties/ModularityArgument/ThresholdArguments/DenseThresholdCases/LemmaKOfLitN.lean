theorem exists_index (G : Type) [CommGroup G] [Finite G] [IsCyclic G] (q : ℕ) (hq : q ∣ Nat.card G) :
    ∃ v : G →* Cq q, ∀ u, v u = 1 → ∃ s, u = s ^ q := by
