      exact mul_dvd_mul_left _ (ih g hg)
    · have hc : IsCoprime f ((l : ℤ) ^ ν) :=
        (((Nat.prime_iff_prime_int.1 hl).irreducible.coprime_iff_not_dvd.2 h).symm).pow_right
