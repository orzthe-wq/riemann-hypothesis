private theorem eq_zero_of_smul_mul_eq_mul_of_isNilpotent_constantCoeff {K : Type} [Field K] {n : ℕ} (A Y : Matrix (Fin n) (Fin n) (PowerSeries K)) (e c : PowerSeries K)
