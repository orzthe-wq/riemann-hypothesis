      (Formalism.UG.P.finite_support_cosets hcm hT.2)
    have hT' : Formalism.UG.FinDosetSupp (GlobalTheory.LFun.KGL w (n := n)) (fun g => Formalism.UG.Tj ℂ n (Formalism.UG.Ov E w) ϖ j g⁻¹) := by
      obtain ⟨S, hS⟩ := hT.2
