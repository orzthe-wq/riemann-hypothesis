theorem UpperTheory.V.Z.Win.Gu.halfG :
    TwistLoc → PolG → HalfG := by
  intro hTw hC E Ω _ _ _ _ _ _ l _ ι a ha P hP ρ hρ m hm e he
  set s : ℝ := ((e + a - 1 : ℤ) : ℝ) / 2 with hs
