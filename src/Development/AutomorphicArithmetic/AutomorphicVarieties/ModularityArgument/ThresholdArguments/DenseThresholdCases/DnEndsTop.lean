  have hq : (Ideal.span {((l : ℕ) : 𝓞 ℚ)}).IsPrime := (Ideal.span_singleton_prime hp.ne_zero).2 hp
  have hm : (Ideal.span {((l : ℕ) : 𝓞 ℚ)}).IsMaximal :=
    hq.isMaximal (by rw [Ne, Ideal.span_singleton_eq_bot]; exact hp.ne_zero)
