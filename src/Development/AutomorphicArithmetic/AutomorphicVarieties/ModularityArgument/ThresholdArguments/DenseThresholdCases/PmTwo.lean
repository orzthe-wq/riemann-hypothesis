    by_contra hne
    obtain ⟨a, b, hab⟩ := Nat.Coprime.cast (R := 𝓞 (W.Lp L)) ((Nat.coprime_primes hp hq).2 hne)
    exact v₀.isPrime.ne_top ((Ideal.eq_top_iff_one _).2
      (hab ▸ add_mem (v₀.asIdeal.mul_mem_left a hpv) (v₀.asIdeal.mul_mem_left b hqv)))
