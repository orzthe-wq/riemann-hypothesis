  let St := hStf.toFinset
  have hSt : ∀ v, v ∈ St ↔ ∃ q ∈ S, ((q : ℕ) : 𝓞 (W.Lp L)) ∈ v.asIdeal ∧ ((l : ℕ) : 𝓞 (W.Lp L)) ∉ v.asIdeal :=
    fun v => hStf.mem_toFinset
  have hSt_l : ∀ u ∈ St, ((l : ℕ) : 𝓞 (W.Lp L)) ∉ u.asIdeal := by
    intro u hu
