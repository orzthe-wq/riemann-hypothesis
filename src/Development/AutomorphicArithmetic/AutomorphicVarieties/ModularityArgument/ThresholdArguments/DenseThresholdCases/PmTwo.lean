  rw [ReciprocityTheory.Gal.mem_Dec]
  ext x
  rw [ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem]
  have key := h (s⁻¹ • x)
  have e : s (s⁻¹ • x) = x := ReciprocityTheory.Gal.mul_inv_apply x
  rw [e] at key
  exact key.symm

