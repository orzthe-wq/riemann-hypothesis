private theorem mem_max_of_res {Λ R : Type} [CommRing Λ] [IsLocalRing Λ] [CommRing R] [Algebra Λ R] [IsCO Λ R] {x : R}
    (hx : res Λ R x = 0) : x ∈ maximalIdeal R := by
  by_contra h
  have h1 : IsUnit x := by simpa using h
