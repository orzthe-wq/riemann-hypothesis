theorem UpperTheory.V.Keep.unlL :
    UpperTheory.V.Keep.UnlL := by
  intro Ω _ _ _ l _ c D T hD ho r h w hw A hA
  have hl : A.valuation (l : Ω) < 1 := by
    have h' := (hA ((l : ℕ) : 𝓞 T.L)).2 hw
