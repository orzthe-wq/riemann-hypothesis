  let Aof : W.Plc (W.Lp L) → ValuationSubring Ω := fun v =>
    if h : ((l : ℕ) : 𝓞 (W.Lp L)) ∈ v.asIdeal then A₀ ⟨v, h⟩
    else if v = v₀ then B else Classical.choose (exists_isPlaceOver Ω v)
