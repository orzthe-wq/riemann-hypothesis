      Nat.cast_ne_zero.mpr hq (Ideal.span_singleton_eq_bot.mp hspan)
    simpa only [Ideal.dvd_span_singleton] using h
  have hl0 : l ≠ 0 := (Fact.out : l.Prime).ne_zero
  have hpl : p ≠ l := fun e => hpS (e ▸ hlS)
