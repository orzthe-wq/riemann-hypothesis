-- Decompose the adjoint representation using the block on indices 0 and 2.
private def IsBlockSL2Embedding {R : Type} [CommRing R] (x : GG (m := 3) (R := R)) : Prop :=
  ∃ a b c d : R, a * d - b * c = 1 ∧ x.mat = !![a, 0, b; 0, 1, 0; c, 0, d]

private theorem jmat3_eq {R : Type} [CommRing R] :
    Jmat R 3 = !![0, 0, 1; 0, 1, 0; 1, 0, 0] := by
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

private theorem jmat2_eq {R : Type} [CommRing R] :
    Jmat R 2 = !![0, 1; 1, 0] := by
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

private theorem theta_eq {R : Type} [CommRing R] (X : Matrix (Fin 3) (Fin 3) R) :
    thetaLie X = !![-X 2 2, -X 1 2, -X 0 2; -X 2 1, -X 1 1, -X 0 1; -X 2 0, -X 1 0, -X 0 0] := by
  ext a b
  simp only [thetaLie, jmat3_eq, Matrix.neg_apply, Matrix.mul_apply, Matrix.transpose_apply,
    Fin.sum_univ_three]
  fin_cases a <;> fin_cases b <;>
    simp only [Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons, Fin.isValue, Fin.zero_eta, Fin.mk_one,
      Fin.reduceFinMk] <;> ring

private theorem conj_eq {R : Type} [CommRing R] (a b c d : R) (Y : Matrix (Fin 3) (Fin 3) R) :
    !![a, 0, b; 0, 1, 0; c, 0, d] * Y * !![d, 0, -b; 0, 1, 0; -c, 0, a] =
    !![(a * Y 0 0 + b * Y 2 0) * d - (a * Y 0 2 + b * Y 2 2) * c, a * Y 0 1 + b * Y 2 1,
        -(a * Y 0 0 + b * Y 2 0) * b + (a * Y 0 2 + b * Y 2 2) * a;
      Y 1 0 * d - Y 1 2 * c, Y 1 1, -Y 1 0 * b + Y 1 2 * a;
      (c * Y 0 0 + d * Y 2 0) * d - (c * Y 0 2 + d * Y 2 2) * c, c * Y 0 1 + d * Y 2 1,
        -(c * Y 0 0 + d * Y 2 0) * b + (c * Y 0 2 + d * Y 2 2) * a] := by
  ext i j
  simp only [Matrix.mul_apply, Fin.sum_univ_three]
  fin_cases i <;> fin_cases j <;>
    simp only [Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons, Fin.isValue, Fin.zero_eta, Fin.mk_one,
      Fin.reduceFinMk] <;> ring

private theorem ad_eq {R : Type} [CommRing R] {x : GG (m := 3) (R := R)} {a b c d : R} (h : a * d - b * c = 1)
    (hx : x.mat = !![a, 0, b; 0, 1, 0; c, 0, d]) (X : Matrix (Fin 3) (Fin 3) R) :
    x.adFun X = !![a, 0, b; 0, 1, 0; c, 0, d] * (if x.right = 1 then X else thetaLie X) *
      !![d, 0, -b; 0, 1, 0; -c, 0, a] := by
  have : ((x.left⁻¹ : GL (Fin 3) R) : Matrix (Fin 3) (Fin 3) R) = !![d, 0, -b; 0, 1, 0; -c, 0, a] := by
    apply Units.inv_eq_of_mul_eq_one_right
    change x.mat * _ = 1
    rw [hx]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp only [Matrix.mul_apply, Fin.sum_univ_three, Matrix.one_apply, Matrix.of_apply,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
        Matrix.tail_cons, Fin.isValue, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk,
        Fin.reduceEq, ite_true, ite_false] <;>
      first | ring1 | linear_combination h
  rw [GG.adFun, this, hx]

private def pA {R : Type} [CommRing R] : Matrix (Fin 3) (Fin 3) R →ₗ[R] Matrix (Fin 2) (Fin 2) R := {
  toFun X := !![X 0 0, X 0 2; X 2 0, X 2 2]
  map_add' X Y := by ext i j; fin_cases i <;> fin_cases j <;> rfl
  map_smul' a X := by ext i j; fin_cases i <;> fin_cases j <;> rfl
}

private def sA {R : Type} [CommRing R] : Matrix (Fin 2) (Fin 2) R →ₗ[R] Matrix (Fin 3) (Fin 3) R := {
  toFun Y := !![Y 0 0, 0, Y 0 1; 0, 0, 0; Y 1 0, 0, Y 1 1]
  map_add' X Y := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp only [Matrix.add_apply, Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Fin.isValue, Fin.zero_eta,
        Fin.mk_one, Fin.reduceFinMk, add_zero]
  map_smul' a X := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp only [Matrix.smul_apply, Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Fin.isValue, Fin.zero_eta,
        Fin.mk_one, Fin.reduceFinMk, smul_zero, RingHom.id_apply]
}

private def pB {R : Type} [CommRing R] (t : R) : Matrix (Fin 3) (Fin 3) R →ₗ[R] (Fin 2 → R) := {
  toFun X := ![X 0 1 + t * X 1 2, X 2 1 - t * X 1 0]
  map_add' X Y := by
    ext i
    fin_cases i <;>
      simp only [Pi.add_apply, Matrix.add_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
        Fin.isValue, Fin.zero_eta, Fin.mk_one] <;> ring
  map_smul' a X := by
    ext i
    fin_cases i <;>
      simp only [Pi.smul_apply, Matrix.smul_apply, smul_eq_mul, RingHom.id_apply,
        Matrix.cons_val_zero, Matrix.cons_val_one, Fin.isValue, Fin.zero_eta, Fin.mk_one] <;> ring
}

private def sB {R : Type} [CommRing R] (t : R) : (Fin 2 → R) →ₗ[R] Matrix (Fin 3) (Fin 3) R := {
  toFun v := !![0, v 0, 0; -(t * v 1), 0, t * v 0; 0, v 1, 0]
  map_add' X Y := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp only [Matrix.add_apply, Pi.add_apply, Matrix.of_apply, Matrix.cons_val_zero,
        Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons,
        Fin.isValue, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk] <;> ring
  map_smul' a X := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp only [Matrix.smul_apply, Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Matrix.of_apply,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
        Matrix.tail_cons, Fin.isValue, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk] <;> ring
}

private def pC {R : Type} [CommRing R] : Matrix (Fin 3) (Fin 3) R →ₗ[R] Matrix (Fin 3) (Fin 3) R := {
  toFun X := !![0, 0, 0; 0, X 1 1, 0; 0, 0, 0]
  map_add' X Y := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp only [Matrix.add_apply, Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Fin.isValue, Fin.zero_eta,
        Fin.mk_one, Fin.reduceFinMk, add_zero]
  map_smul' a X := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp only [Matrix.smul_apply, Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Fin.isValue, Fin.zero_eta,
        Fin.mk_one, Fin.reduceFinMk, smul_zero, RingHom.id_apply]
}

private theorem decomp {R : Type} [CommRing R] (u : R) (hu : 2 * u = 1) (X : Matrix (Fin 3) (Fin 3) R) :
    X = sA (pA X) + u • sB 1 (pB 1 X) + u • sB (-1) (pB (-1) X) + pC (pC X) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp only [sA, pA, sB, pB, pC, LinearMap.coe_mk, AddHom.coe_mk, Matrix.add_apply,
      Matrix.smul_apply, smul_eq_mul, Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Fin.isValue, Fin.zero_eta,
      Fin.mk_one, Fin.reduceFinMk] <;>
    first
      | ring1
      | linear_combination (-X 0 1) * hu
      | linear_combination (-X 1 0) * hu
      | linear_combination (-X 1 2) * hu
      | linear_combination (-X 2 1) * hu

private theorem pA_sA {R : Type} [CommRing R] (Y : Matrix (Fin 2) (Fin 2) R) : pA (sA Y) = Y := by
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

private theorem sA_pA_eq_self {R : Type} [CommRing R] (M : Matrix (Fin 3) (Fin 3) R)
    (h01 : M 0 1 = 0) (h10 : M 1 0 = 0) (h11 : M 1 1 = 0) (h12 : M 1 2 = 0) (h21 : M 2 1 = 0) :
    sA (pA M) = M := by
  ext i j
  fin_cases i <;> fin_cases j
  · rfl
  · exact h01.symm
  · rfl
  · exact h10.symm
  · exact h11.symm
  · exact h12.symm
  · rfl
  · exact h21.symm
  · rfl

private theorem ad_sA {R : Type} [CommRing R] {x : GG (m := 3) (R := R)} (hx : IsBlockSL2Embedding x) (Y : Matrix (Fin 2) (Fin 2) R) :
    sA (pA (x.adFun (sA Y))) = x.adFun (sA Y) := by
  obtain ⟨a, b, c, d, h, hx⟩ := hx
  rw [ad_eq h hx]
  by_cases hsign : x.right = 1
  · rw [ite_eq_left hsign, conj_eq]
    apply sA_pA_eq_self
    all_goals
      simp only [sA, LinearMap.coe_mk, AddHom.coe_mk, Matrix.of_apply, Matrix.cons_val_zero,
        Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Fin.isValue]
    all_goals ring
  · rw [ite_eq_right hsign, theta_eq, conj_eq]
    apply sA_pA_eq_self
    all_goals
      simp only [sA, LinearMap.coe_mk, AddHom.coe_mk, Matrix.of_apply, Matrix.cons_val_zero,
        Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Fin.isValue]
      ring

private theorem pA_conj_eq {R : Type} [CommRing R] (a b c d : R) (Y : Matrix (Fin 3) (Fin 3) R) :
    pA (!![a, 0, b; 0, 1, 0; c, 0, d] * Y * !![d, 0, -b; 0, 1, 0; -c, 0, a]) =
      !![(a * Y 0 0 + b * Y 2 0) * d - (a * Y 0 2 + b * Y 2 2) * c,
          -(a * Y 0 0 + b * Y 2 0) * b + (a * Y 0 2 + b * Y 2 2) * a;
         (c * Y 0 0 + d * Y 2 0) * d - (c * Y 0 2 + d * Y 2 2) * c,
          -(c * Y 0 0 + d * Y 2 0) * b + (c * Y 0 2 + d * Y 2 2) * a] := by
  rw [conj_eq]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp only [pA, LinearMap.coe_mk, AddHom.coe_mk, Matrix.of_apply, Matrix.cons_val_zero,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Fin.isValue]

private theorem pA_ad {R : Type} [CommRing R] {x : GG (m := 3) (R := R)} (hx : IsBlockSL2Embedding x) (X : Matrix (Fin 3) (Fin 3) R) :
    pA (x.adFun X) = pA (x.adFun (sA (pA X))) := by
  obtain ⟨a, b, c, d, h, hx⟩ := hx
  rw [ad_eq h hx, ad_eq h hx]
  have h00 : sA (pA X) 0 0 = X 0 0 := by
    simp only [sA, pA, LinearMap.coe_mk, AddHom.coe_mk, Matrix.of_apply, Matrix.cons_val_zero,
      Fin.isValue]
  have h02 : sA (pA X) 0 2 = X 0 2 := by
    simp only [sA, pA, LinearMap.coe_mk, AddHom.coe_mk, Matrix.of_apply, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Fin.isValue]
  have h20 : sA (pA X) 2 0 = X 2 0 := by
    simp only [sA, pA, LinearMap.coe_mk, AddHom.coe_mk, Matrix.of_apply, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Fin.isValue]
  have h22 : sA (pA X) 2 2 = X 2 2 := by
    simp only [sA, pA, LinearMap.coe_mk, AddHom.coe_mk, Matrix.of_apply, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Fin.isValue]
  by_cases hsign : x.right = 1
  · rw [ite_eq_left hsign, ite_eq_left hsign, pA_conj_eq, pA_conj_eq, h00, h02, h20, h22]
  · rw [ite_eq_right hsign, ite_eq_right hsign, pA_conj_eq, pA_conj_eq]
    have ht00 : thetaLie (sA (pA X)) 0 0 = thetaLie X 0 0 := by
      rw [theta_eq, theta_eq]
      simp only [Matrix.of_apply, Matrix.cons_val_zero, Fin.isValue, h22]
    have ht02 : thetaLie (sA (pA X)) 0 2 = thetaLie X 0 2 := by
      rw [theta_eq, theta_eq]
      simp only [Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_two, Matrix.head_cons,
        Matrix.tail_cons, Fin.isValue, h02]
    have ht20 : thetaLie (sA (pA X)) 2 0 = thetaLie X 2 0 := by
      rw [theta_eq, theta_eq]
      simp only [Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_two, Matrix.head_cons,
        Matrix.tail_cons, Fin.isValue, h20]
    have ht22 : thetaLie (sA (pA X)) 2 2 = thetaLie X 2 2 := by
      rw [theta_eq, theta_eq]
      simp only [Matrix.of_apply, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons,
        Fin.isValue, h00]
    rw [ht00, ht02, ht20, ht22]

private def wOf {R : Type} [CommRing R] (x : GG (m := 3) (R := R)) : Matrix (Fin 2) (Fin 2) R :=
  if x.right = 1 then corner x.mat else corner x.mat * Matrix.diagonal ![-1, 1]

private theorem wOf_eq {R : Type} [CommRing R] {x : GG (m := 3) (R := R)} {a b c d : R} (hx : x.mat = !![a, 0, b; 0, 1, 0; c, 0, d]) :
    wOf x = if x.right = 1 then !![a, b; c, d] else !![-a, b; -c, d] := by
  have : corner x.mat = !![a, b; c, d] := by
    rw [hx]
    ext i j
    fin_cases i <;> fin_cases j <;> rfl
  dsimp only [wOf]
  rw [this]
  split_ifs
  · rfl
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.diagonal, Matrix.of_apply,
        Matrix.cons_val_zero, Matrix.cons_val_one, Fin.isValue, Fin.zero_eta, Fin.mk_one,
        Fin.reduceEq, ite_true, ite_false] <;> ring

private theorem pB_ad {R : Type} [CommRing R] {x : GG (m := 3) (R := R)} (hx : IsBlockSL2Embedding x) (t : R) (ht : t * t = 1) (X : Matrix (Fin 3) (Fin 3) R) :
    pB t (x.adFun X) = ((if x.right = 1 then 1 else t) • wOf x) *ᵥ pB t X := by
  obtain ⟨a, b, c, d, h, hx⟩ := hx
  rw [ad_eq h hx, wOf_eq hx]
  by_cases hsign : x.right = 1
  · rw [ite_eq_left hsign, ite_eq_left hsign, ite_eq_left hsign, one_smul, conj_eq]
    ext i
    fin_cases i <;>
      simp only [pB, LinearMap.coe_mk, AddHom.coe_mk, Matrix.mulVec, dotProduct, Fin.sum_univ_two,
        Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
        Matrix.head_cons, Matrix.tail_cons, Fin.isValue, Fin.zero_eta, Fin.mk_one] <;> ring
  · rw [ite_eq_right hsign, ite_eq_right hsign, ite_eq_right hsign, theta_eq, conj_eq]
    ext i
    fin_cases i <;>
      simp only [pB, LinearMap.coe_mk, AddHom.coe_mk, Matrix.mulVec, dotProduct, Fin.sum_univ_two,
        Matrix.smul_apply, smul_eq_mul, Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Fin.isValue, Fin.zero_eta,
        Fin.mk_one] <;>
      first | linear_combination (a * X 1 2 + b * X 1 0) * ht | linear_combination (c * X 1 2 + d * X 1 0) * ht

private theorem ad_sB {R : Type} [CommRing R] {x : GG (m := 3) (R := R)} (hx : IsBlockSL2Embedding x) (t : R) (ht : t * t = 1) (v : Fin 2 → R) :
    sB t (((if x.right = 1 then 1 else t) • wOf x) *ᵥ v) = x.adFun (sB t v) := by
  obtain ⟨a, b, c, d, h, hx⟩ := hx
  rw [ad_eq h hx, wOf_eq hx]
  by_cases hsign : x.right = 1
  · rw [ite_eq_left hsign, ite_eq_left hsign, ite_eq_left hsign, one_smul, conj_eq]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp only [sB, LinearMap.coe_mk, AddHom.coe_mk, Matrix.mulVec, dotProduct, Fin.sum_univ_two,
        Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
        Matrix.head_cons, Matrix.tail_cons, Fin.isValue, Fin.zero_eta, Fin.mk_one,
        Fin.reduceFinMk] <;> ring
  · rw [ite_eq_right hsign, ite_eq_right hsign, ite_eq_right hsign, theta_eq, conj_eq]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp only [sB, LinearMap.coe_mk, AddHom.coe_mk, Matrix.mulVec, dotProduct, Fin.sum_univ_two,
        Matrix.smul_apply, smul_eq_mul, Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Fin.isValue, Fin.zero_eta,
        Fin.mk_one, Fin.reduceFinMk] <;>
      first | ring1 | linear_combination (c * v 0 - d * v 1) * ht | linear_combination (-a * v 0 + b * v 1) * ht

private theorem pC_ad {R : Type} [CommRing R] {x : GG (m := 3) (R := R)} (hx : IsBlockSL2Embedding x) (X : Matrix (Fin 3) (Fin 3) R) :
    pC (x.adFun X) = (if x.right = 1 then 1 else -1 : R) • pC X := by
  obtain ⟨a, b, c, d, h, hx⟩ := hx
  rw [ad_eq h hx]
  by_cases hs : x.right = 1
  · rw [ite_eq_left hs, ite_eq_left hs, one_smul, conj_eq]
    ext i j
    fin_cases i <;> fin_cases j <;> rfl
  · rw [ite_eq_right hs, ite_eq_right hs, theta_eq, conj_eq]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp only [pC, LinearMap.coe_mk, AddHom.coe_mk, Matrix.smul_apply, smul_eq_mul,
        Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
        Matrix.head_cons, Matrix.tail_cons, Fin.isValue, Fin.zero_eta, Fin.mk_one,
        Fin.reduceFinMk] <;> ring

private theorem ad_pC {R : Type} [CommRing R] {x : GG (m := 3) (R := R)} (hx : IsBlockSL2Embedding x) (X : Matrix (Fin 3) (Fin 3) R) :
    x.adFun (pC X) = (if x.right = 1 then 1 else -1 : R) • pC X := by
  obtain ⟨a, b, c, d, h, hx⟩ := hx
  rw [ad_eq h hx]
