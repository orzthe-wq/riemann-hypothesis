    obtain ⟨c, hc⟩ := hconj
    have hpair : ∃ P, IsPairing c W ((Matrix.GeneralLinearGroup.det.comp W).comp (resG ℚ ℚ Ω)) P := by
      let J : GL (Fin 2) (Qbar l) := Matrix.GeneralLinearGroup.mkOfDetNeZero !![0, 1; -1, 0] (by simp [Matrix.det_fin_two])
