    · exact x.elim0
    · obtain rfl : x = y := Fin.ext (by have := x.2; have := y.2; omega)
      exact Equiv.Perm.SameCycle.refl _ _
    · exact isCycle_finRotate.sameCycle
        (by rw [← Equiv.Perm.mem_support, support_finRotate]; exact Finset.mem_univ _)
        (by rw [← Equiv.Perm.mem_support, support_finRotate]; exact Finset.mem_univ _)
