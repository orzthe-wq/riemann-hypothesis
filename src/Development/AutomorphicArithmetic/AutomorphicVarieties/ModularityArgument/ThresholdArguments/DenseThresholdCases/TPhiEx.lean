    refine hker K ?_ fun k hk h => hinj (by rw [hcp, hcp, map_mul, MonoidHom.mem_ker.1 hk, mul_one])
    have : (K : Set H) = ⋂ (h : H) (j : ℕ) (N : ℕ), {k | Ideal.Quotient.mk (I ^ N) ((cp (h * k)).coeff j) =
        Ideal.Quotient.mk (I ^ N) ((cp h).coeff j)} := by
