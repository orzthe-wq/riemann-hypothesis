theorem UpperTheory.Reformulated.B.DeterminantIdentities.phiDet :
    ∀ {n : ℕ} {B A H G : Type} [inst : CommRing B] [inst_1 : CommRing A] [inst_2 : Group H] [inst_3 : Group G]
