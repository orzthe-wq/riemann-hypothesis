  have hinj := Polynomial.map_injective f hf
  let K : Subgroup H :=
    { carrier := {k | ∀ h, cp (h * k) = cp h}
      one_mem' := fun h => by rw [mul_one]
      mul_mem' := fun {a b} ha hb h => by rw [← mul_assoc, hb, ha]
      inv_mem' := fun {a} ha h => by rw [← ha (h * a⁻¹), inv_mul_cancel_right] }
