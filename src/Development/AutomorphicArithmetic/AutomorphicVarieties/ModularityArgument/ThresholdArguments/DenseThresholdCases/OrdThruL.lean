    have hy : ∀ m, M ≤ m → ∃ y ∈ U, ((y : (w.adicCompletion L)ˣ) : w.adicCompletion L) =
        1 + ((l : ℕ) : w.adicCompletion L) ^ m * z := fun m hm => by
