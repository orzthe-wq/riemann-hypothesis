private theorem conv_bump {V : Type} [NormedAddCommGroup V] [InnerProductSpace ℂ V] [FiniteDimensional ℂ V] [CompleteSpace V]
    (κ : ℝ → V →L[ℂ] V) (hκ : Ker κ) (R : ℝ) (hR : ∀ t, R < |t| → κ t = 0) (w : ℝ → V) (hw : Continuous w) (hc : HasCompactSupport w)
