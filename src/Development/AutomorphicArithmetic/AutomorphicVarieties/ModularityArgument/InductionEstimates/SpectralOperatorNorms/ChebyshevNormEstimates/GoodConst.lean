private theorem amp_fix [_root_.NumberField.IsTotallyComplex K] (𝔞 : Amp μ) (m : Measure (AdelicGLn.FiniteAdelicGL K n))
    [m.IsHaarMeasure] (y : Ix K n) (P : LL μ →L[ℂ] LL μ) (h1 : P * 𝔞.A = 𝔞.A) (h2 : 𝔞.A * P = 𝔞.A) :
