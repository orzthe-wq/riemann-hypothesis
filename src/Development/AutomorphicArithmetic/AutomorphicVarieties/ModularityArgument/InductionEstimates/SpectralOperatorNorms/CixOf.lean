    (ha : ∀ g, a g = ∫ k, ∫ k', e k * a₀ (k⁻¹ * g * k'⁻¹) * e k' ∂ν ∂ν) (x : G) :
    ∫ g, a g * φ (x * g) ∂μ = ∫ k, e k * ∫ h, a₀ h * φ (x * k * h) ∂μ ∂ν := by
