  have hC : IsCompact (tsupport a₀ * U) := IsCompact.mul hc hU
  have h1 : ∀ y, ∫ g, b g * φ (y * g) ∂μ = ∫ h, a₀ h * φ (y * h) ∂μ := by
    intro y
    have s1 := res_zpow_neg_mul_res_zpow_neg_eq_inv_res μ ν hU hC hν (fun g k => a₀ (g * k⁻¹) * e k * φ (y * g))
