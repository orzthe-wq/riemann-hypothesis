  have h1 : IntegrableOn (Function.uncurry F) (C ×ˢ U) (μ.prod ν) :=
    hF.continuousOn.integrableOn_compact (hC.prod hU)
  refine h1.integrable_of_ae_notMem_eq_zero ?_
