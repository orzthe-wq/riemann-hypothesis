  exact ⟨a, β, β', hsm', hH, hst', hβ, hβ',
    h a₀ a (hs.trans inter_subset_left) hpos hone ha _ (hβ.2.2 0),
    h' a₀ a (hs.trans inter_subset_right) hpos hone ha _ (hβ'.2.2 0)⟩
