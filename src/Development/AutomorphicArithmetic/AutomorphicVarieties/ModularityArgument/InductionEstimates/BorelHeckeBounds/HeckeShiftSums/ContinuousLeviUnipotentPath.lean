private theorem aeId {d : ℕ} (W : L (Eu d)) (U : ℝ → Eu d) (hU : Continuous U)
    (h : ∀ (β : ℝ → ℂ) (v : Eu d) (u : L (Eu d)), Continuous β → HasCompactSupport β → (∀ᵐ x : ℝ, u x = β x • v) →
