private theorem fs_sum {K : Type} [Field K] [NumberField K] : ∃ (N₀ : ℕ) (C : ℝ), ∀ (x : G1 K (2 + 2)) (S : Finset (Cos K))
    (g : Cos K → ℝ) (B : ℝ), 0 ≤ B →
