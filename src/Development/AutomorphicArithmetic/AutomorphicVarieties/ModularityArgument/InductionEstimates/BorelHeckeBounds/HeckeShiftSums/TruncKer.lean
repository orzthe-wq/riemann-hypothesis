private theorem pow_arith (c : ℝ) (hc : 0 < c) (A B : ℕ) :
    ∃ k : ℕ, ∀ y u : ℝ, 1 ≤ y → 0 ≤ u → u ≤ (y ^ c)⁻¹ → u ^ k * y ^ A ≤ (y ^ B)⁻¹ := by
  obtain ⟨k, hk⟩ := exists_nat_ge (((A : ℝ) + B) / c)
