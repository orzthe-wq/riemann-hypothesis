        mul_le_mul_of_nonneg_right ((h2 ▸ h1).trans h5) hyA.le
    _ = (y ^ B)⁻¹ := by field_simp

private theorem pow_arith2 (c : ℝ) (hc : 0 < c) (N N' : ℕ) :
    ∃ k : ℕ, ∀ y R u : ℝ, 1 ≤ y → 1 ≤ R → y ^ c ≤ R → 0 ≤ u → u ≤ (R ^ c)⁻¹ →
      u ^ k * R ^ N ≤ (y ^ N')⁻¹ := by
