private theorem frame_ex {V : Type} [AddCommGroup V] [Module ℂ V] (S : Submodule ℂ V) [FiniteDimensional ℂ S]
    (B : V → V → ℂ)
    (hlin : ∀ f ∈ S, ∀ f' ∈ S, ∀ f'' ∈ S, ∀ a : ℂ, B f (a • f' + f'') = a * B f f' + B f f'')
    (hsym : ∀ f ∈ S, ∀ f' ∈ S, conj (B f f') = B f' f)
    (hpos : ∀ f ∈ S, f ≠ 0 → 0 < (B f f).re) :
