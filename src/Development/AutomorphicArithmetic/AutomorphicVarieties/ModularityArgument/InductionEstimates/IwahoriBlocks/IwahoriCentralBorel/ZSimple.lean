  rw [← ContinuousLinearMap.integral_comp_comm _ (integrable_orbit μ hI v)]
  refine integral_congr_ae (Eventually.of_forall fun k => ?_)
  simp only [map_smul]
  rw [← UnitaryRep.map_mul_apply, ← UnitaryRep.map_mul_apply, ((levLaws (K := K) n ∅).2.2.1 k h).eq]

