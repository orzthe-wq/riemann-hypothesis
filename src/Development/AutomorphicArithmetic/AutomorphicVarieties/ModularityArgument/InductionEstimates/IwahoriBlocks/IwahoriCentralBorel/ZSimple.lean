private theorem integrable_orbit {κ : Measure (archCompact K n)} {e : archCompact K n → ℂ} (hI : IdemA κ e) (v : L2 μ) :
    Integrable (fun k => e k • rightRegularRep (Gam K n) μ (arc1 k) v) κ := by
