theorem gamma_mono {M N : ℕ} (h : M ∣ N) : CongruenceSubgroup.Gamma N ≤ CongruenceSubgroup.Gamma M := by
  intro γ hγ
  rw [mem_gamma_iff] at hγ ⊢
  exact fun i j => (Int.natCast_dvd_natCast.2 h).trans (hγ i j)

