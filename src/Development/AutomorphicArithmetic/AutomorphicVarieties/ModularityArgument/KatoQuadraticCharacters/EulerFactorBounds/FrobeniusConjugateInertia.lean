    have := hc1 1 1
    simpa using this
  obtain ⟨h, hh⟩ := GlobalTheory.exists_unit_of_cocycle_rightAction_charZero F Q τ hτ (fun q => c q⁻¹ ^ 2)
    (fun q q' => by
      rw [_root_.mul_inv_rev, hc1]
      simp only [Units.val_pow_eq_pow_val, Units.val_mul, hφ, inv_inv, map_pow]
      ring)
    (fun q hq => by
      have e := hc1 q⁻¹ q⁻¹
