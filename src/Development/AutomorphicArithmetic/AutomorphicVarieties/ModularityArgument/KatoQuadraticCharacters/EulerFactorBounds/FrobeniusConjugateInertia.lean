  have hφ0 : ∀ q a, (φ0 q a : F) = τ q⁻¹ a := fun q a => rfl
  let φ : Q →* MulAut Fˣ := MonoidHom.mk' φ0 (by
    intro q q'
    ext a
    simp only [MulAut.mul_apply, hφ0, _root_.mul_inv_rev, hτ])
