    simp only [Pi.smul_apply, smul_eq_mul]
    ring
  rw [e]
  exact (Dvd.dvd.mul_right hb _).neg_right

private theorem up_rz_add_tp_eq_rz_mul_of_eq (M p : ℕ) [NeZero M] (t : Fin 2 → ZMod p) (a c : Fin 2 → ℤ)
    (hc : ∀ i, c i = p * a i + M * ((t i).val : ℤ)) :
