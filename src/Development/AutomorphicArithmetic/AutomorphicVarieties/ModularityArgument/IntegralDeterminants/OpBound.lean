      simp only [hN, _root_.mul_inv_rev, map_mul, mulVec_mulVec]
      rw [← mul_assoc, Rinv', one_mul]
    simp only [h1]
    simp only [hN]
    rw [← Matrix.mulVec_smul, ← heig h, Matrix.mulVec_sum]

  obtain ⟨g0, i0, h0⟩ : ∃ g i, Nf g i ≠ 0 := by
