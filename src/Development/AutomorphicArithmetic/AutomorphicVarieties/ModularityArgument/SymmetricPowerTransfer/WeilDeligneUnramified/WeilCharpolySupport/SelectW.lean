theorem UpperTheory.V.Z.Sym.W.selectW :
    UpperTheory.V.Z.Sym.W.SelectW := by
  intro L _ _ _ X w₀ hw₀
  obtain ⟨P, h₀, hP, him, hinj⟩ :=
    (Set.injOn_singleton (fun w : Plc L => w.under (𝓞 (Lp L))) w₀).exists_subset_injOn_subset_range_eq
      (Set.singleton_subset_iff.mpr hw₀)
  refine ⟨P, hP, Set.singleton_subset_iff.mp h₀, hinj, fun w hw => ?_⟩
  exact him.symm.subset ⟨w, hw, rfl⟩
