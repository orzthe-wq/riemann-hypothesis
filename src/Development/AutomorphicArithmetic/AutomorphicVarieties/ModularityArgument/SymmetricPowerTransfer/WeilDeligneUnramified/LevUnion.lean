  have e1 : (mL w (secW n w g) - 1) ⟨0, by omega⟩ ⟨1, by omega⟩ = 1 := by
    rw [mL, hc]
    simp [g, el, Matrix.transvection]
  rw [e1] at e
  have hv : Valued.v ((m : Kw w)) < 1 := by
