private theorem ddf_ne {B : Bridge L} (T : Spl B) (w : Plc L) (h : IsSplitAt w) (d : Fin 3 → (Kw w)ˣ)
    {v : Pl (Lp L)} (hv : v ≠ un w) : ddf T w h d v = 1 := by
