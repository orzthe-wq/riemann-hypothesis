  have hG : algebraMap K (Lsq K Δ) (QuadraticAlgebra.trace m).re =
      2 * m.re + algebraMap K (Lsq K Δ) τ * m.im := (fix _ hAs).trans hA
  obtain ⟨y, hy⟩ := exG_norm h
