private theorem gram_diag [CharZero K] {c : K} {d m : EL Δ τ} (h : IsDat c d m) :
    ∃ g : K, algebraMap K (Lsq K Δ) g = QuadraticAlgebra.trace m ∧ (g ≠ 0 → ∃ (g2 : K) (b y : Lsq K Δ),
