      = ∑ k, ∑ i, ∑ j, Pm k i * star (Pm k j) * (a i * star (a' j)) := by
        refine Finset.sum_congr rfl fun k _ => ?_
        simp only [Matrix.mulVec, dotProduct, star_sum, star_mul', Finset.sum_mul, Finset.mul_sum]
