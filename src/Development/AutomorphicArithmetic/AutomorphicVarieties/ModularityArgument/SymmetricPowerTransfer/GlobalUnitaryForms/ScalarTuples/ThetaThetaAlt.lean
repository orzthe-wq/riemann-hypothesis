    ext <;> simp [ofE]

private def cmp (b : Bool) (x : EL Δ τ) : Etau K τ := if b then ⟨x.re.re, x.im.re⟩ else ⟨x.re.im, x.im.im⟩

private theorem semi_semi {c : K} {d m : EL Δ τ} (hd : IsDat c d m) (x : Sp Δ τ) : semi d (semi d x) = (x.1, ω * x.2) := by
