private theorem step1 (h : IsLoc O Δ) {c : K} {d m : EL Δ τ} (hd : IsDat c d m) (x y : ι → Sp Δ τ)
    (h0 : Bd O fun i => herm c m (x i) (y i)) (h1 : Bd O fun i => herm c m (semi d (semi d (x i))) (y i))
