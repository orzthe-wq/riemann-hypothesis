theorem sg_out {c t : Kˣ} {d m : EL Δ τ} {δ ι P} (h : Models (c : K) d ((t : K) • m) δ ι P) :
    ∃ (x : (Kˣ ⧸ (powMonoidHom 2 : Kˣ →* Kˣ).range) × (Kˣ ⧸ NE τ)), ∃ P',
