    refine Prod.ext ?_ ?_
    · simp only []
      rw [← mul_assoc, ← map_mul, Units.inv_mul, map_one, one_mul]
    · simp only []
      rw [← mul_assoc, mul_comm _ (ofE Δ (z : Etau K τ)), ofE_inv, one_mul]
  right_inv x := by
