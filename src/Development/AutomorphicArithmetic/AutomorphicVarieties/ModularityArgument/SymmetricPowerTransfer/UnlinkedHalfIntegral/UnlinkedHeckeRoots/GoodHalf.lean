    (Eventually.of_forall (norm_Fn_le hb c u u'))

theorem Fn_translate (φ : G2 → ℂ) (c : HeckeCharacter ℚ) (t u u' g : G2) :
    Fn φ c u u' (g * t) = cdet c t * Fn φ c (t * u) (t * u') g := by
  simp only [Fn, cdet_mul, mul_assoc]
  ring

