        (if p ∣ n then coef f' (n / p) else 0) = coef f' p * coef f' n
    rw [h2 _ (Nat.mul_pos hp.pos hn), h2 _ hp.pos, h2 _ hn, hc]
    by_cases hd : p ∣ n
    · have hm : 1 ≤ n / p := Nat.div_pos (Nat.le_of_dvd hn hd) hp.pos
