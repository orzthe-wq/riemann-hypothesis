def Fn (φ : G2 → ℂ) (c : HeckeCharacter ℚ) (u u' g : G2) : ℂ := φ (g * u) * conj (φ (g * u')) * cdet c g

def Pr (μ : Measure G2) (𝓕 : Set G2) (φ : G2 → ℂ) (c : HeckeCharacter ℚ) (u u' : G2) : ℂ :=
