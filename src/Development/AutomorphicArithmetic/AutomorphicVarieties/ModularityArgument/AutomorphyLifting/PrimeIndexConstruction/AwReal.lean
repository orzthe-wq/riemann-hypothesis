    let g : K →ₐ[F] ℂ := { (starRingEnd ℂ).comp ρ with
      commutes' := fun x => by
        show star (ρ (algebraMap F K x)) = ρ (algebraMap F K x)
        have := hφ x
        simp only [RingHom.comp_apply] at this
        rw [this, Complex.star_def, Complex.conj_ofReal] }
