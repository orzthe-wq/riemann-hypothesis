theorem UpperTheory.V.Z.Tf.GOne.partCS :
    PartCS := by
  intro W q X d A hS x y I σ hσ
  have hq := hS.primes.two
  have hc := convergence_of_landau_euler landauL euler_product_log_bound W q X d A hS
