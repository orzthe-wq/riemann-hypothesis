  have sxx : Summable fun p : {p : W × ℕ // p.1 ∈ I} => ‖lterm q (A x) (A x) σ p.1‖ := hxx.subtype _
  have syy : Summable fun p : {p : W × ℕ // p.1 ∈ I} => ‖lterm q (A y) (A y) σ p.1‖ := hyy.subtype _
  have e1 : (∑' p : {p : W × ℕ // p.1 ∈ I}, lterm q (A x) (A x) σ p.1).re =
