    exact ⟨b + b', add_mem hb hb', fun x => by simp [h, h']⟩
  algebraMap_mem' c := ⟨algebraMap ℂ _ c, Subalgebra.algebraMap_mem _ _, fun x => by simp [Module.algebraMap_end_apply]⟩

