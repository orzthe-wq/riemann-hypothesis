      (Submodule.sub_starProjection_mem_orthogonal y)
  refine Submodule.eq_starProjection_of_mem_orthogonal' (hS a b _ (S.starProjection_apply_mem y)) hz ?_
  rw [← map_add (f := _), add_sub_cancel]

