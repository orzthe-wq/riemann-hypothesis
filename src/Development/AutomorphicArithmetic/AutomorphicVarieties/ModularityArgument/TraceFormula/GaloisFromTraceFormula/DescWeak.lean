theorem descWeak_of_galWeak (hW : GalWeak 4) (hRun : RunTh) : UpperTheory.V.Z.Desc.DescWeak := by
  intro E _ _ _ hunr p _ S _ hsp _ n hn hn4 π hreg hd hsat
