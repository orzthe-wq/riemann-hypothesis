open Classical in
private theorem eF_coord (t τ : E →+* ℂ) (k l i j : Fin a) :
    eF (fun y : GL (Fin a) (Cinf E) => coord t (y.val k l)) τ i j = if t = τ ∧ i = k ∧ j = l then 1 else 0 := by
  have h := dF_eq (f := fun y : GL (Fin a) (Cinf E) => coord t (y.val k l)) (fun _ => rfl)
