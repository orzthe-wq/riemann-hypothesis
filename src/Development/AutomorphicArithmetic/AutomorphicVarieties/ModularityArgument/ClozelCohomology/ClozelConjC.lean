    obtain ⟨Φ, hΦ, e1, r1, d1⟩ := h1
    obtain ⟨Ψ, hΨ, e2, r2, d2⟩ := h2
    refine ⟨Φ * Ψ, hΦ.mul hΨ, fun y => by rw [Pi.mul_apply, Pi.mul_apply, e1, e2], ?_, fun τ i j => ?_⟩
