    obtain ⟨χ, hχ⟩ := twEx E a ha r
    obtain ⟨G, hG⟩ := admEx E a Ξ
    have hd : IsData Ξ r χ G e := ⟨hr, hχ, hG, he⟩
    have hL : IsLev U Ξ (dCo (smLie Ξ) η) := ((harmLin E a n e U Ξ r (q + 1)).2 _).1 hω
