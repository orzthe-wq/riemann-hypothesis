    · refine Or.inl ((Submodule.eq_bot_iff _).2 fun v hv => ?_)
      have h6 : σ.symm ∘ v = 0 := (Submodule.eq_bot_iff _).1 h _ (show σ ∘ (σ.symm ∘ v) ∈ W by rwa [back])
      rw [← back v, h6]
