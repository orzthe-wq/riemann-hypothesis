    have e0 : Matrix.of (toL (Matrix.single i j x)) = Matrix.single i j x := rfl
    rw [h, ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply, fderiv_det_one, e0]
    split_ifs with h3
