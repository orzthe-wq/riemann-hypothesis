private lemma indep_finset {τ : Representation ℂ G W'} {ρ : Representation ℂ G W} (hτ : AbsIrr τ)
    {κ : Type} (b : κ → (W' →ₗ[ℂ] W)) (hb : ∀ i, Intw τ ρ (b i)) (hli : LinearIndependent ℂ b)
    (s : Finset κ) (u : κ → W') (hu : ∑ i ∈ s, b i (u i) = 0) : ∀ i ∈ s, u i = 0 := by
