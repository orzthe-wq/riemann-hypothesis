private theorem proj_inner {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (P M : H →L[ℂ] H) (hs : IsSelfAdjoint P) (hi : P ∘L P = P) (hM : M ∘L P = P ∘L M) (u w : H) :
