  have e2 : Pc μ (Pc μ (M w)) = Pc μ (M w) :=
    Submodule.starProjection_eq_self_iff.2 (Submodule.starProjection_apply_mem _ _)
  rw [e1]
  conv_rhs => rw [← e2]
  exact Submodule.inner_starProjection_left_eq_right _ _ _

