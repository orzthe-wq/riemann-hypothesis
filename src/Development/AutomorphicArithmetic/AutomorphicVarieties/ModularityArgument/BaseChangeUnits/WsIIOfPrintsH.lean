  have e1 : M (P w) = P (M w) := DFunLike.congr_fun hM w
  have e2 : P (P (M w)) = P (M w) := DFunLike.congr_fun hi (M w)
  have e3 : ⟪P u, P (M w)⟫_ℂ = ⟪u, P (P (M w))⟫_ℂ := hs.isSymmetric u (P (M w))
  rw [e1, e3, e2]

