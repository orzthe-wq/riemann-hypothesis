      apply le_antisymm
      · rintro _ ⟨x, hx, rfl⟩
        exact hq i hiT x (Subgroup.mem_inf.1 hx).1
      · intro a ha
        refine ⟨j i a, ?_, hqj i hiT a⟩
        refine Subgroup.mem_inf.2 ⟨hj i hiT a ha, ?_⟩
        simp only [Subgroup.mem_iInf, Subgroup.mem_comap]
        intro k hk
