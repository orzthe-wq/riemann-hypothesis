private def Good (s : Set R) (e : R) : Prop :=
  e ∈ Algebra.adjoin ℂ s ∧ e * e = e ∧ ∀ x ∈ Algebra.adjoin ℂ s, ∃ c : ℂ, e * x * e = c • e

private lemma adj_comm {s t : Set R} (h : ∀ x ∈ s, ∀ y ∈ t, Commute x y) {x y : R}
