    | add p q hp hq => rw [map_add (f := _)]; exact Subalgebra.add_mem _ hp hq

private lemma conj_mul (A x y : Module.End ℂ Y) (hAA : A * A = 1) :
    A * x * A * (A * y * A) = A * (x * y) * A := by
  calc A * x * A * (A * y * A) = A * x * (A * A) * y * A := by simp only [mul_assoc]
