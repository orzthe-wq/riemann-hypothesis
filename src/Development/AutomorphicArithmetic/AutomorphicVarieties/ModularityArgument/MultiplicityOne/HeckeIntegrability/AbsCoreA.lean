    refine ⟨x * x', mul_mem hx hx', y * y', mul_mem hy hy', ?_⟩
    exact ((adj_comm h hx' hy).mul_mul_mul_comm x y').symm

private lemma good_two {s t : Set R} (h : ∀ x ∈ s, ∀ y ∈ t, Commute x y) {e e' : R}
