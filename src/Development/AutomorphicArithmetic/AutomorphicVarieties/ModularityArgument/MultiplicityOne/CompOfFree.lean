private theorem isDec_of_globLev {S : Set (Pl E)} {lam : InfinitePlace E → DomWeight n}
    {K₁ K₂ : ∀ w : Pl E, Subgroup (UL n w)} (h : globLev S K₁ = globLev S K₂) {ι : Type}
    {σ : ι → Submodule ℂ (UA E n → ℂ)} (hd : IsDec S lam K₁ σ) : IsDec S lam K₂ σ := by
