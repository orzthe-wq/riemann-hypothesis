theorem trSph : TrSph := by
  intro hEx hSL E _ _ _ n w τ B hB e
  have hne : fixed τ.ρ (KGL w (n := n)) ≠ ⊥ := hB.1
  have hfr : Module.finrank ℂ (fixed τ.ρ (KGL w (n := n))) = 1 := (hSL E n w τ hne).1
