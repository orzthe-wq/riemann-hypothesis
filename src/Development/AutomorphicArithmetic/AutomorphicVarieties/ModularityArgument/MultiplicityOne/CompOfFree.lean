    (hLev : IsLevelFam (fun w : Pl E => MonoidHom.id (UL n w)) (KL n) K') {ι : Type} [Fintype ι]
    {σ : ι → Submodule ℂ (UA E n → ℂ)} (hdec : IsDec S lam K' σ) (σ₀ : ι → ∀ w : Pl E, SmIrr (UL n w))
