private theorem upperTriangular_fin_three_mul_entries {C : Type} [CommRing C] (A B : Matrix (Fin 3) (Fin 3) C)
    (hA : A 1 0 = 0 ∧ A 2 0 = 0 ∧ A 2 1 = 0) (hB : B 1 0 = 0 ∧ B 2 0 = 0 ∧ B 2 1 = 0) :
