private theorem fin_eq_eI_or_wI_or_esI {C : Type} [CommRing C] (p q : Fin 3 → C)
    (hp : ∀ a b, a ≠ b → IsUnit (p a - p b)) (N : Matrix (Fin 3) (Fin 3) C)
