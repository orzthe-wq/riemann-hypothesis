  refine ⟨8 * C, by positivity, fun E Ω _ _ _ _ _ _ N hN hE l _ D hP e he => ?_⟩
  obtain ⟨r, hr, hk⟩ := hK E Ω N hN hE l D hP e he
  obtain ⟨g, hg, hg'⟩ := hG E Ω N hN hE l D e
  have h1 : minusLen D e ≤ ((r * g : ℕ) : ℕ∞) := by
    push_cast
