    m ≠ ⊤ ∧ (m.toNat : ℝ) * L ≤ ∑ i ∈ T, g i := by
  have hfe : ∑ i ∈ T, f i = ((∑ i ∈ T, (f i).toNat : ℕ) : ℕ∞) := by
    rw [Nat.cast_sum]
