  lift r to ℕ using hr
  have hm : m ≠ ⊤ := by
    rintro rfl
    rw [hfe, ENat.top_mul hr0] at h
    exact ENat.coe_ne_top _ (top_le_iff.1 h)
  lift m to ℕ using hm
  refine ⟨ENat.coe_ne_top _, ?_⟩
  rw [hfe, ← Nat.cast_mul, Nat.cast_le] at h
  simp only [ENat.toNat_coe] at hf ⊢
