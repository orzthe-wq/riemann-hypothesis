  have h3 : ((minusLen D e).toNat : ℝ) ≤ r * g := by exact_mod_cast ENat.toNat_le_of_le_coe h1
  have hl : (1 : ℝ) ≤ l := by exact_mod_cast (Fact.out : l.Prime).one_le
