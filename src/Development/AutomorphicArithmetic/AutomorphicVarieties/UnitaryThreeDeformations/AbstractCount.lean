  obtain ⟨f, hf, hker⟩ := exists_relations F hOk hLV hC g₁ hm u hU W hAd hMin
  have hent : ∀ g x y, W.origin h ((u g).mat x y) = (r0 F.η F.Ψ g).mat x y := by
