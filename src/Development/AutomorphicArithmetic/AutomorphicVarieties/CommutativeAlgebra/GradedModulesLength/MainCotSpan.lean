private theorem chain {k : ℕ} (X : HidaSetting k) (ts : List (Deg k × X.R)) (J : Ideal X.R) (a : X.R)
    (hJ : (GMod.self X.𝒜).IsHomSub J) (hv : Valid X.𝒜 (ts ++ [(0, a)]))
