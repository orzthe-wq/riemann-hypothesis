  rw [h1, e2.length_eq, Module.length_pi_of_fintype]
  simp [Module.length_eq_one]

private theorem weight_eq {τ : Type} (wt : τ → ℤ) (ν : τ →₀ ℕ) :
    Finsupp.weight wt ν = (Finsupp.weight (posW wt) ν : ℤ) - (Finsupp.weight (negW wt) ν : ℤ) := by
