  · simp only [Finsupp.weight_apply, Finsupp.sum, posW, negW, smul_eq_mul, nsmul_eq_mul]
    push_cast
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← mul_sub, Int.toNat_sub_toNat_neg]
