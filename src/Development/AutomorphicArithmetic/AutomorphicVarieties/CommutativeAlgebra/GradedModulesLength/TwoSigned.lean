        GlobalTheory.length_localizedModule_eq_add_of_exact _ f g hf hg hfg
      have ht1 : ∀ σ ∈ S, locLen σ N₁ ≠ ⊤ := fun σ h h' => ht σ h (by rw [hl, h', top_add])
