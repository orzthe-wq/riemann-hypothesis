  have h2 : (⨆ j, G j) ≤ G i ⊔ ⨆ (j) (_ : j ≠ i), G j := iSup_le fun j => by
    by_cases h : j = i
    · subst h; exact le_sup_left
    · exact le_sup_of_le_right (le_iSup₂_of_le j h le_rfl)
  obtain ⟨g, hg, y, hy, rfl⟩ := Submodule.mem_sup.1 (h2 hx')
