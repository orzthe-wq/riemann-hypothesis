          rintro rfl
          exact hw (map_zero _)
        rw [if_neg hm0, hb' m hw, sub_zero]
    obtain ⟨c', hc', hcm⟩ := pf_step W ξ ι t g hg (J ^ n) J
      {m : W.σ →₀ ℕ | Finsupp.weight W.wt m = 0 ∧ m ≠ 0} 0 (fun m hm => hm.1)
      (fun m hm => mono_lemma g J hJ m hm.2) ih _ hF x' hx'
