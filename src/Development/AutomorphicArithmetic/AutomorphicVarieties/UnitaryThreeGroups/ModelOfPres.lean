    (Ideal.quotientKerAlgEquivOfSurjective W.surj).symm.toAlgHom, fun j x hx => ?_⟩
  obtain ⟨F, hF, hFx⟩ := Submodule.mem_map.mp (show (x : R) ∈ W.part j from hx)
