    calc h.toBlocks₁₁ᵀ * (Jmat R 3 * h.toBlocks₂₂ * Jmat R 3)
        = (h.toBlocks₁₁ᵀ * Jmat R 3 * h.toBlocks₂₂) * Jmat R 3 := by
