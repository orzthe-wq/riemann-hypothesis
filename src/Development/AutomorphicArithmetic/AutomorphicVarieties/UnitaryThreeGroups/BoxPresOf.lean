    fromBlocks_multiply] at h1
  simp only [transpose_zero, zero_mul, mul_zero, add_zero, zero_add, Matrix.fromBlocks_inj] at h1
  obtain ⟨-, hk, -, -⟩ := h1
  have hJJ : Jmat R 3 * Jmat R 3 = 1 := Jmat_mul_Jmat 3
