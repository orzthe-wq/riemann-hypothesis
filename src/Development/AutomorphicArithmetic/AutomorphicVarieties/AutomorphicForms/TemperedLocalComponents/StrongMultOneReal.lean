    have h : ∀ x, pInf E (sInf E x) = x := fun x => (TR.infEq E).symm_apply_apply x
    simp [h]
  have h2 : pFin E (TR.infId E u).val = 1 := by
    change (1 : Af E) - 0 + 0 = 1
    simp
  refine TR.ga_ext ?_ ?_
  · rw [TR.pInf_infGL]
    ext i j
    by_cases e : i = j <;> simp [e, h1]
  · rw [TR.pFin_infGL]
    ext i j
    by_cases e : i = j <;> simp [e, h2]

