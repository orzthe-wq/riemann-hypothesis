theorem sHtB : SHtB := by
  intro L _ _ hL N hN c hrat M
  obtain ⟨g, z, hc⟩ := hrat
  classical
  obtain ⟨d, hd, hint⟩ := exists_den
    ((Finset.univ.image fun ij : Fin N × Fin N => gi g ij.1 ij.2) ∪
