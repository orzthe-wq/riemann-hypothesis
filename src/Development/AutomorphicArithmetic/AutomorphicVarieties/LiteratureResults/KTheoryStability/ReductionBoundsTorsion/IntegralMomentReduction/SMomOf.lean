    by_contra hcon
    apply hv0
    funext i
    by_contra hi
    exact hcon ⟨i, by simpa using hi⟩
  have hi0mem : v ((Finset.univ.filter fun i => v i ≠ 0).max' hne) ≠ 0 := by
