def ee (q n : ℕ) : Fin n × Fin q ≃ Fin (q * n) := (Equiv.prodComm _ _).trans finProdFinEquiv

def blkM (q n : ℕ) : (Fin q → Matrix (Fin n) (Fin n) R) →* Matrix (Fin (q * n)) (Fin (q * n)) R where
