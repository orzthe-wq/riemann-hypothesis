          (MeasureTheory.Measure.addHaar : MeasureTheory.Measure (InfinitePlace L → Fin N → ℂ))
            {x | qR h x < √(8 * ρ + 2) ^ 2 * (s / 4)} := by
          rw [MeasureTheory.lintegral_const_mul _ (measurable_one.indicator hbig),
