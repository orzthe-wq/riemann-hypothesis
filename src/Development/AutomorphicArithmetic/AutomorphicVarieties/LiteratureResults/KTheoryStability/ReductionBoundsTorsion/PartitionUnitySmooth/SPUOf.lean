    rw [ENNReal.ofReal_natCast]
  have e2 : ((hT.toFinset.card : ℕ) : ENNReal) *
      ENNReal.ofReal (√(8 * ρ + 2) ^ Module.finrank ℝ (InfinitePlace L → Fin N → ℂ)) =
