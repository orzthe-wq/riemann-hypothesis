    calc (hS.toFinset.card : ENNReal) *
          (MeasureTheory.Measure.addHaar : MeasureTheory.Measure (InfinitePlace L → Fin N → ℂ))
            {x | qR h x < s / 4}
        = ∑ v ∈ hS.toFinset,
