        rw [hc2]
        rw [hq] at hv₀
        nlinarith [hv₀.1, hv₀.2]
      rw [if_pos hx, mul_one, Nat.cast_le]
      refine Finset.card_le_card_of_injOn (fun v => v - v₀) ?_ ?_
      · intro v hv
        rw [Finset.coe_filter] at hv
        obtain ⟨-, hv⟩ := hv
        rw [Finset.mem_coe, Set.Finite.mem_toFinset, Set.mem_setOf_eq, hq, htoR]
