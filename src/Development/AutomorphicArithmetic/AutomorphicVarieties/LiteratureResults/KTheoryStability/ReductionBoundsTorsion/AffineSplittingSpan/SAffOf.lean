  obtain ⟨e', he', hce'⟩ := W'.inj q (c - A - T) hinv' hdc' hι hpr
  obtain ⟨k1, a1, α1, eG, heG, hdecA⟩ := hG q a ha hda
  obtain ⟨k2, b2, β2, e2, he2, hdecB⟩ := W'.tdecomp hG q b hbinv hdb
