    by_contra hcon
    have h0 : f g ≤ n * c := by linarith
    have h1 : Real.log (qht g) ≤ |C| * (1 + n * c) :=
      (hS.le_f g).trans (mul_le_mul (le_abs_self C) (by linarith) (by linarith [hS.f_nonneg g]) (abs_nonneg C))
    have h2 := Real.exp_le_exp.2 h1
