  wt := b.wt
  wt_res k := by rw [← hr]; exact b.wt_res k
  lam := b.lam
  segmentWeightExponent k := by rw [hψ]; exact b.segmentWeightExponent k
  M := b.M
  smul_lam := b.smul_lam
  free := b.free
  fin := b.fin
  supp := b.supp

