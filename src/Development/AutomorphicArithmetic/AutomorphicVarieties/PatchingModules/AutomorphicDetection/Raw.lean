@[reducible] private def ringDesc (A : TWRing b h ut N) (hr : r.psib = r'.psib) (hψ : u'.ψ = u.ψ)
    (rN' : Resid G'.frame O n) (hc : Glob.Compat h' rN' r') (p' : Pair rN' A.R) (hp : p'.ψ = A.p.ψ) :
    TWRing (baseDesc b hr hψ) h' ut N where
