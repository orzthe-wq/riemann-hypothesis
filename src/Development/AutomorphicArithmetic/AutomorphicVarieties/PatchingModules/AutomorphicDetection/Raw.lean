    intro k
    rw [hI, Ideal.mem_span_singleton, PowerSeries.X_dvd_iff]
    have := congrArg (fun q => _root_.AddMonoidAlgebra.coeff (M := ℕ) q k) hdmap
    simpa [Polynomial.coeff_map] using this
