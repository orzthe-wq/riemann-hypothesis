theorem UpperTheory.V.AlgebraTools.exists_tower_limit :
    ∀ (R : Type) [CommRing R] (a : Ideal R) [IsAdicComplete a R] (P : ℕ → Type) [∀ i, AddCommGroup (P i)] [∀ i, Module R (P i)] (π : ∀ k, P (k + 1) →ₗ[R] P k),
