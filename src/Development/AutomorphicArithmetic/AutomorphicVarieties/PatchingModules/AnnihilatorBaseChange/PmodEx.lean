        have hb := bot_tensor S a h'
        have hm : r • (t.baseChange S) n ∈ (a.map (algebraMap R S) • ⊤ : Submodule S (S ⊗[R] X')) :=
          Submodule.smul_mem_smul hr Submodule.mem_top
        rw [hb] at hm
        exact (Submodule.mem_bot S).mp hm
