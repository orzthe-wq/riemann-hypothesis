    (f := fun n => ∑ i ∈ Finset.range n, z i) hcau
  refine ⟨y, ?_, fun n => ?_⟩
  · have h1' := SModEq.sub_mem.1 (hy k)
    have h2' : ∑ i ∈ Finset.range k, z i ∈ (a ^ k • ⊤ : Submodule R F) :=
