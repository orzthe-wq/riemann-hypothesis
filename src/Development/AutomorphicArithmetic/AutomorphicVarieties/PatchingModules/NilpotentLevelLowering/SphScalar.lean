    have h3 : ((iwC k n ⊤).relIndex (KO k (Fin n)) : A) • (v : M) = (trc ρ (KO k (Fin n)) (iwC k n ⊤) v : M) := by
      rw [← h2, Nat.cast_sum]
      simp only [Nat.cast_pow]
      exact congrArg Subtype.val h1
    intro g hg
    apply hreg
    show _ • ρ g v = _ • (v : M)
    rw [← map_smul, h3]
    exact (trc ρ (KO k (Fin n)) (iwC k n ⊤) v).2 g hg
