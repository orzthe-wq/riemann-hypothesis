  have hle : iwC k n ⊤ ≤ KO k (Fin n) := (memIwC k n ⊤).2.1 ▸ iwahori_le_KO k (Fin n)
  have hq : IsUnit (resCard k : ℂ) := (Nat.cast_ne_zero.2 (Nat.card_pos (α := 𝓀[k])).ne').isUnit
