private theorem final_le (M L l q N t B : ℝ) (a b C : ℕ) (hM : M = N * t) (h3 : 3 ≤ M) (hL : L ≤ l)
    (hl : 0 ≤ l) (hlM : l ≤ M) (hq : 0 ≤ q) (hqM : q ≤ M) (hB : 0 ≤ B) (hC : a + 2 * b + 9 ≤ C) (hC' : l * q ≤ C) :
