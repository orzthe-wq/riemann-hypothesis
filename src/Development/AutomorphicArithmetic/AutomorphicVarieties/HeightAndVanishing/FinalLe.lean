    calc ∑ i ∈ O, ∑ e ∈ Finset.Ico 1 t, v i e ≤ ∑ i ∈ O, S := Finset.sum_le_sum h2
      _ = O.card * S := by rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ q * S := mul_le_mul_of_nonneg_right (by exact_mod_cast hq) hS
