  obtain ⟨c₂, hc₂⟩ := dualNO l L G0 T O n y hl hc hΦ hPL hD
  refine ⟨c₁ + c₂ + c₀ + ∑ v, Cv v + ∑ j, Cq j, fun m => ?_⟩
  filter_upwards [hc₂ m, phEqO l L G0 T O n y m hΦ hPL] with N hN hP
  haveI : Finite (Om O m) := ((omFacts l O).2 m).1
