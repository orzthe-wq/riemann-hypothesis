private theorem db_inv {K : Type} [Field K] (g : GL (Fin 3) K) (π : Fin 3 → ZMod 2)
    (h : ∀ a b, π a ≠ pq b → (g : Matrix (Fin 3) (Fin 3) K) a b = 0) (a b : Fin 3) (e : π a ≠ pq b) :
