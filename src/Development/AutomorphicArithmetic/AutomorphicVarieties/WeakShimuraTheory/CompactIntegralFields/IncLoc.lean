  haveI hNn : N.Normal := Subgroup.Normal.of_commutator_le G hcN
  have hcomm : ∀ a b : G ⧸ N, a * b = b * a :=
    (Subgroup.Normal.quotient_commutative_iff_commutator_le.2 hcN).is_comm.comm
