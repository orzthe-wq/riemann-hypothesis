  rw [← hw x, valuation_lt_one_iff' (Ω := Ω), valuation_lt_one_iff' (Ω := Ω), ← hg, ← hg, map_inv₀, g.commutes]

private theorem not_dvd_index {Γ k : Type} [Group Γ] [Field k] [Finite k] {l : ℕ} [hl : Fact l.Prime] [CharP k l]
