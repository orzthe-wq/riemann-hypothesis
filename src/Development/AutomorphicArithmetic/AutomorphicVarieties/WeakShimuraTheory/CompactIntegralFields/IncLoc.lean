    simp only [← hn, zsmul_eq_mul, mul_one, Int.floor_intCast]

private theorem divide {G : Type} [Group G] [TopologicalSpace G] (l : ℕ) [Fact l.Prime]
    (a : G → ℚ) (c : G × G → ℤ) (ha : IsLocallyConstant a)
