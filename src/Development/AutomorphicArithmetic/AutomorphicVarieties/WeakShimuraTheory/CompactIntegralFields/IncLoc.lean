  · intro g h
    have e : ((σ (χ g) + σ (χ h) - σ (χ (g * h)) : ℚ) : AddCircle (1 : ℚ)) = 0 := by
      have hσ' : ∀ y, ((σ y : ℚ) : AddCircle (1 : ℚ)) = y := hσ
