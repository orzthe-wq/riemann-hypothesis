  have hmem : ∀ s : S, Φ s ∈ V := by
    intro s
    have hs : IsIntegral R s := Algebra.IsIntegral.isIntegral s
    have h2 : IsIntegral V (Φ s) := hs.map_of_comp_eq b Φ hΦ.symm
    obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := V) (K := K)).1 h2
