    (QuotientGroup.isQuotientMap_mk _).isOpen_preimage.1 (by
      have := ((_root_.UpperTheory.Reformulated.B.LocallyConstantOfKernel.lc_of_ker γ (Subgroup.isOpen_mono hKγ hK)).comp fun u => (u : k) • m) s
