private theorem re_two {Γ M : Type} [Group Γ] [Monoid M] (a b : Γ →* M) :
    ∃ g, (∃ x, a x ≠ 1) → (∃ y, b y ≠ 1) → a g ≠ 1 ∧ b g ≠ 1 := by
