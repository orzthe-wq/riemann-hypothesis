  have ral : ∀ g, rd c (D.al g) = rd c (Chr.dirG ℚ Ω ξ₀ g) * rd c (Chr.dirG ℚ Ω ξ g) := fun g => by
    rw [show D.al g = chiO ℚ Ω l c.O g * (D.om g)⁻¹ * D.ξ g from rfl, map_mul, map_mul, map_inv, rom, eω, mul_inv_cancel,
