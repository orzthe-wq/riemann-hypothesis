  · obtain ⟨⟨x, hx⟩, y, hy⟩ := h
    by_cases h1 : b x = 1
    · by_cases h2 : a y = 1
      · exact ⟨x * y, fun _ _ => ⟨by rwa [map_mul, h2, mul_one], by rwa [map_mul, h1, one_mul]⟩⟩
      · exact ⟨y, fun _ _ => ⟨h2, hy⟩⟩
    · exact ⟨x, fun _ _ => ⟨hx, h1⟩⟩
