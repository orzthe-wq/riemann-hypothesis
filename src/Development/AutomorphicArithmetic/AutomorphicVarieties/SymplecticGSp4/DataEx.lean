    rw [mul_pow, ← pow_mul, mul_comm (e + b), mul_assoc, pow_mul, hw.1, one_pow, one_mul, mul_comm, pow_mul,
      dirG_pow_one _ (pow_orderOf_eq_one _), one_pow]) (one_pow _) (ce.trans (ce.symm (hb e)) hc)
  obtain ⟨A, hA⟩ := (Chr.placesQ Ω).1 l hl
