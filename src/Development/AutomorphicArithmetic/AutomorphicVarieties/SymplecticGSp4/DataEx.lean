  have hc2 : (psi2 ψ).conductor = 2 ^ c2 ψ := (compCond c.O h.N ψ 2 Nat.prime_two).2.2.2.1.symm
  have sg : (ω ^ e) (-1) * (psi2 ψ (-1) * th1 l ψ (-1)) = 1 := by
