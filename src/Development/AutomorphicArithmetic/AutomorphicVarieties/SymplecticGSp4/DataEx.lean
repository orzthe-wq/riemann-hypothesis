  have hT' : ∀ v ∈ D.T, v.Prime ∧ (D.pl v).valuation (v : Ω) < 1 := fun v hv => ⟨(hT v hv).1, dpl v (hT v hv).1⟩
  have o1 : (ω ^ e) ^ (l ^ f0 l ψ - 1) = 1 := by
    obtain ⟨k, hk⟩ := f4
