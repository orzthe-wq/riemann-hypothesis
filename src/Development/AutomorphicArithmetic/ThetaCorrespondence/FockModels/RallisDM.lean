    (GlobalTheory.ThetaMean.thetaMean om m) (fun f f' hf hf' => thetaMean_add m hi f f' hf hf')
    (fun c f _ => thetaMean_smul m c f) (fun f _ x g => thetaMean_om m f x g) hbdd
