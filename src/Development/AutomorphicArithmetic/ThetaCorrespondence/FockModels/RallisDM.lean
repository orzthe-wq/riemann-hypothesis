  have hv : (((autMeasure B mH).real Set.univ : ℝ) : ℂ) ≠ 0 := by exact_mod_cast (volQuot_pos B mH).ne'
  have hval : (((autMeasure B mH).real Set.univ : ℝ) : ℂ)⁻¹ *
