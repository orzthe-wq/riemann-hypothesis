  have hu : (⋃ r : ι × κ, A r.1 r.2) = Set.univ := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    obtain ⟨i, j, h⟩ := hcov x
    exact ⟨(i, j), h⟩
  have h1 : ∫⁻ x, ‖F x‖ₑ ^ p ∂μ ≤ ∑' r : ι × κ, ∫⁻ x in A r.1 r.2, ‖F x‖ₑ ^ p ∂μ := by
    conv_lhs => rw [← setLIntegral_univ, ← hu]
    exact lintegral_iUnion_le _ _
