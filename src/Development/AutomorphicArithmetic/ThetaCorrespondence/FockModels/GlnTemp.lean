  have hq1 : (1 : ℝ) < (Nat.card 𝓀[k] : ℝ) := by
    exact_mod_cast (Finite.one_lt_card : 1 < Nat.card 𝓀[k])
  have hrad := fun j : Fin (N - 1) => exists_radius_rpow hq1 hp (((j : ℕ) + 1) * (N - ((j : ℕ) + 1)))
    (Nat.mul_pos (by omega) (by omega))
