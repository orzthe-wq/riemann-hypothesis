private def Df (wt : Emb l w → ℤ) (d : Weil h →* (Qbar l)ˣ) : Prop :=
  ∀ κ : ↥(Dec (F := F) A) →* (Qbar l)ˣ, Continuous κ → IsLocAlg h κ wt →
    WDis (Loc.PP l) ι h Bw hj κ (κ.comp (Subgroup.inclusion (Weil_le_Dec h)) * (alg wt).comp a * d)

