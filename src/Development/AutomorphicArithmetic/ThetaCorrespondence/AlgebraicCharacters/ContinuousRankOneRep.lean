private theorem emb_norm {l : ℕ} [Fact l.Prime] (w : HeightOneSpectrum (𝓞 L)) (res : Emb l w → Emb l (below K w))
    (hres : ∀ τ' x, (res τ').1 x = τ'.1 (algebraMap _ _ x)) (τ : Emb l (below K w)) (y : w.adicCompletion L) :
