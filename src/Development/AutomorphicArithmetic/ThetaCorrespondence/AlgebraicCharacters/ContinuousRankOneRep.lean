  haveI : Finite (𝓞 L ⧸ P) := Ideal.finiteQuotientOfFreeOfNeBot _ hne
  exact Nat.card_le_card_of_injective _ (FaithfulSMul.algebraMap_injective (𝓞 F ⧸ v.asIdeal) (𝓞 L ⧸ P))

