private theorem exw (wt : Emb l w → ℤ) : ∃ ν : ↥(Dec (F := F) A) →* (Qbar l)ˣ, Continuous ν ∧ IsLocAlg h ν wt := by
  obtain ⟨E, _, _, _, _, u, hu, Bw', art, χ, n, μ, ν, -, -, -, -, -, -, -, hν, -, H, -⟩ :=
