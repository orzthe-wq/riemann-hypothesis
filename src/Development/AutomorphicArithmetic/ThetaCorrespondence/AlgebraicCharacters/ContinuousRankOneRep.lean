theorem UpperTheory.Lit.CharWD.exField :
    GlobalArtinReciprocity → ExField := by
  intro _ F Ω _ _ _ _ _ A w h a ha σ hσ V hV
  have : IsGalois F Ω := IsAlgClosure.isGalois F Ω
  obtain ⟨V', hVV, hV', h1⟩ := mem_nhds_iff.1 hV
