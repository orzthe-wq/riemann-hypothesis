    rw [normV_eq_pow hw, normV_eq_pow hw', ← pow_mul] at hf
    exact Nat.pow_right_injective (Fact.out : l.Prime).two_le hf
  rw [alpha, alpha, h1, h2, h3]
  push_cast
  ring


