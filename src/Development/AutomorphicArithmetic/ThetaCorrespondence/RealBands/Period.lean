        ≤ (Real.exp Q * ‖c‖ * |s| * hsn (p.A.fr τ * X * (p.A.fr τ)⁻¹)) * b := mul_le_mul_of_nonneg_right hlip' hb0
      _ = ‖c‖ * (Real.exp Q * b * |s| * hsn (p.A.fr τ * X * (p.A.fr τ)⁻¹)) := by ring
  exact le_of_mul_le_mul_left key hc0

