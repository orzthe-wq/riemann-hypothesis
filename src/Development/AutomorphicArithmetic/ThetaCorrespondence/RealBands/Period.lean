      show (1 : Matrix (Fin V.rank) (Fin V.rank) ℂ)ᴴ * Formalism.REAL.Jm (M.ε τ) * 1 = Formalism.REAL.Jm (M.ε τ)
      simp
    rcases hI S0.topologicalClosure S0.isClosed_topologicalClosure hcl with h | h
