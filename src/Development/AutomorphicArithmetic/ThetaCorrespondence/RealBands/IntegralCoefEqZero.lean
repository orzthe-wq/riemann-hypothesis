      rw [k, sub_self]
    · rintro ⟨h1, h2, -⟩
      refine ⟨fun i y hy => ?_, fun y hy => h2 y fun x hx => (herm_eq_zero_iff ε x y).2 (hy x hx)⟩
      fin_cases i
      exact (Submodule.mem_bot ℂ).2 (h1 y hy)
