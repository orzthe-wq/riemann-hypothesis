  have htv : ∀ (u : M.Vec) x, (PiTensorProduct.lift.symm t : MMap M) u x = t (PiTensorProduct.tprod ℂ u) x := by
    intro u x; simp [PiTensorProduct.lift_symm]
  have hT : ∀ gs : ∀ τ, Formalism.IndefR.SchurOrthogonalityAlt.Gt V τ,
