  have p2 : 0 ≤ n ^ b := pow_nonneg (by linarith) _
  have p3 : 0 ≤ L ^ c := pow_nonneg (by linarith) _
  exact mul_le_mul (mul_le_mul h1 h2 p2 (p1.trans h1)) h3 p3 (mul_nonneg (p1.trans h1) (p2.trans h2))

