  have h2 : ((q0 D : ℕ) : 𝓞 D.host.E) ∈ (P.w P.v0).asIdeal := by
    simpa using h1
  exact le_absNorm_of_natPrime_mem (P.w P.v0).isPrime.ne_top (leastSplitAuxiliaryPrimeThetaChain_spec D).1 h2

