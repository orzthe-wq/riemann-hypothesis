    rw [LinearMap.ker_eq_bot']
    intro s hs
    exact Subtype.ext (hP s s.2 fun y hy => congrFun hs ⟨y, hy⟩)
  obtain ⟨L, hL⟩ := LinearMap.exists_leftInverse_of_injective E hE
  let C : ℝ → (P → ℂ) := fun u p => c u p
