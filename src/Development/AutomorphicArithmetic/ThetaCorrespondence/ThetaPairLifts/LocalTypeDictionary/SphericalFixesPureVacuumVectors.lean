theorem schr_box_star [Invertible (2 : R)] (ψ : AddChar R ℂ) (hψ : ∀ a, star (ψ a) = ψ (-a)) {κ : Type} [Fintype κ]
    (w w' : (κ → R) × (κ → R)) (Φ Ψ : (κ → R) → ℂ) :
