      apply Units.ext
      rw [bc_coe, realGL_rat hθ V γ γE hγ, embGL_coe, bc_coe]
      ext a b
      exact hlab _ _
    have : (c.ρ γ).comp e.toLinearMap = e.toLinearMap.comp (rhoK lam (realGL θ V γ)) := by
