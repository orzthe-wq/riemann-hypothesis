theorem co_injective (ch : Choice R) : Function.Injective ch.S.co := by
  obtain ⟨gram, c₀, c₁, ht, hco⟩ := ch.S.co_is
  obtain ⟨e, he⟩ := GlobalTheory.CoefReal.exists_scalarExt D.what₂.embLL _ c₀ ht.mapR.2.1 ht.mapR.2.2
