  rw [mul_inv_cancel₀ h0, _root_.GlobalTheory.ThetaParam.lamC_one] at h
  have h2 := congrArg norm h
  rw [norm_mul, hu.2.2, norm_one, one_mul] at h2
  rw [e, ← h2]

