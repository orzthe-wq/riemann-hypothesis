  let G : MvPolynomial (ι × Fin n × Fin n) L :=
    ∑ m ∈ (F.1 : MvPolynomial (ι × Fin n × Fin n) ℂ).support,
      monomial m (Function.invFun κ (AddMonoidAlgebra.coeff F.1 m))
  have hG : MvPolynomial.map κ G = F.1 := by
    ext m
    rw [coeff_map]
