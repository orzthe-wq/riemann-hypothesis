    have h0 := hsub w
    obtain ⟨w₁, hw₁⟩ : ∃ w₁ : Matrix (Fin T.rank) (Fin S.rank) (Formalism.L2.Theta.AE D),
        w₁ = HMul.hMul (HMul.hMul MT w : Mx D T.rank S.rank) MS := ⟨_, rfl⟩
    rw [← hw₁] at h0
    have t1 : w₁.map (finPart D) = 0 := by
