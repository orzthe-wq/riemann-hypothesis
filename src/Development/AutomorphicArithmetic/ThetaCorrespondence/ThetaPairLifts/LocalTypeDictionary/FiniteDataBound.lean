private theorem tame_int {μ : kˣ →* ℂˣ} (hμ : IsTame μ) (x : kˣ) (hx : valuation k (x : k) = 1) :
    IsIntegral ℤ ((μ x : ℂˣ) : ℂ) := by
  obtain ⟨p, hp⟩ := ValuativeRel.valuation_surjective (K := k) (uniformizer k : ValueGroupWithZero k)
