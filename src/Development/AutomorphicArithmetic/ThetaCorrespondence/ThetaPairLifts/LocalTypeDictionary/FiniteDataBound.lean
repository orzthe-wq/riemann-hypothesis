private lemma isIntegral_pow_div_mul_pow (a b : ℂ) (ha : IsIntegral ℤ a) (hb : IsIntegral ℤ b) (ha0 : a ≠ 0)
    (hb0 : b ≠ 0) (n : ℤ) (M : ℕ) (hn : n.natAbs ≤ M) :
