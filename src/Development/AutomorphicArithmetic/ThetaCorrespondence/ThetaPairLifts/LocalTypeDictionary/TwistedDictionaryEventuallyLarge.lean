    rw [hind, hTm.trans Ψ hΨsb (-x₀) hnx, hTΨ]
    have hlin : heisO ψ S T (-x₀) ((R.card : ℂ)⁻¹ • ∑ r ∈ R, heisO ψ S T r f₀) =
