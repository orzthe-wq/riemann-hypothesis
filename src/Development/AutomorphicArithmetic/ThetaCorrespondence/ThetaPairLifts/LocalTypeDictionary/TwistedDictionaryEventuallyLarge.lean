    refine Finset.sum_congr rfl fun r _ => ?_
    rw [GlobalTheory.FinTranslate.heisO_heisO, smul_smul]

  have hroot : ∀ r ∈ R, ψ (symplOH S T (-x₀) r) ^ (2 * k * k) = 1 := fun r hr =>
