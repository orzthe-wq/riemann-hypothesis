    simp only [halfCoset, Set.mem_setOf_eq, zero_add]
  have hΨ : Ψ = (R.card : ℂ)⁻¹ • ∑ r ∈ R, (fun t => ψ (symplO S T t r) * halfInd e Λ t) := by
    funext t
