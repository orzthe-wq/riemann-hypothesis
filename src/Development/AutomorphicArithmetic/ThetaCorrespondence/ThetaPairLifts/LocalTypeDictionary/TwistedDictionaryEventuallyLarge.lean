  have hth := GlobalTheory.ThetaClosed.isThetaFunO_heisO_all W.ψ_std hf w
  have e := GlobalTheory.OrientedHeis.om_fin_pureTensorO W.ψ _ _ _ _ (W.om p) hom W.θ W.θ_is _ mem.1 _ mem.2
