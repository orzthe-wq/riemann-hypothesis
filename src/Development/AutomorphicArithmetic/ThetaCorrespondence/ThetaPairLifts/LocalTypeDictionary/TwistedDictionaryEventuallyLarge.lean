theorem stdSelfDual {D : D7} {T : Type} {L : LevCh D T} {sc : GlobalTheory.ChiGrid.Consts} {G : GridData L sc} {U : Set T}
    (N : Std G U) {p : Pair T} (hp : DefPair D.R.m p) :
    IsSelfDualC (G.pS p) (N.latS p) ∧ IsSelfDualC (G.pT p) (N.latT p) := by
