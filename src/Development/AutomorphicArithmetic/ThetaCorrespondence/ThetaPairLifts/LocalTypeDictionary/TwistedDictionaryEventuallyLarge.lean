  have hΨsb : IsSBHalf e Λ Ψ := isSBHalf_halfCoset_indicator hk (fun i j => mul_zero _) (by simp)
  have hind : (halfCoset e Λ k x₀).indicator (1 : WO S T → ℂ) = fun t => Ψ (t + -x₀) := by
