  have hζ : ∀ r, ζ r ^ (2 * k * k) = 1 := fun r => Subtype.ext (by
    show (ψ (symplOH S T (-x₀) r.1)) ^ (2 * k * k) = 1
    exact hroot r.1 r.2)
