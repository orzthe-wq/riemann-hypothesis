    (β : V →ₗ[ℂ] Q →ₗ[ℂ] Pi) (S : Submodule ℂ V) (F : Submodule ℂ (Pr →ₗ[ℂ] Pi))
    (hF : factorSpace ρ σ q β S ≤ F)
    (hS : ∀ f ∈ S, ∃ φ : Pr →ₗ[ℂ] Pi, (∀ i, φ ∘ₗ ρ i = σ i ∘ₗ φ) ∧ β f = φ ∘ₗ q)
