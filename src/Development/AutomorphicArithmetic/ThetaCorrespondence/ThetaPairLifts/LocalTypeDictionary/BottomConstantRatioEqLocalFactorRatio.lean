  ext a b
  simp only [Matrix.mul_apply]
  refine Finset.sum_congr rfl fun c _ => ?_
  rw [← hu c b, ← mul_assoc, ← mul_assoc, mul_comm (H a c), mul_comm (P a c), hH]

