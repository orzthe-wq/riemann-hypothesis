      intro ρ
      rw [compAt_mul, compAt_inv]
      split_ifs with e
      · rw [e, hA1]; exact Matrix.nonsing_inv_mul _ hdet
      · rw [hA2 ρ e, inv_one, Matrix.one_mul]
