    set h := atTau θ T τ (compAt θ τ (mt T r)) with hdef
    have hA1 : compAt θ τ (mt T h) = compAt θ τ (mt T r) := hh.2.1
    have hA2 : ∀ ρ, ρ ≠ τ → compAt θ ρ (mt T h) = 1 := hh.2.2
