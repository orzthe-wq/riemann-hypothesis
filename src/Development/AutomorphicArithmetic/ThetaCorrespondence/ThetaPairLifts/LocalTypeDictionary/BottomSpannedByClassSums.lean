      (fun ρ hρ => by
        rw [cr]
        split_ifs with e
        · rfl
        · exact h1 ρ (by simp [e, hρ]))
      (fun ρ i j => by
        rw [cr]
        split_ifs
        · exact one_mem_entry i j
        · exact h2 ρ i j) P hP
