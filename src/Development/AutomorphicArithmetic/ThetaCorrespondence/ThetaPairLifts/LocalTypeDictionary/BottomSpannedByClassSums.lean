    have e : ((1 : GA D S), r) = (1, h) * (1, h⁻¹ * r) := by
      rw [Prod.mk_mul_mk, mul_one, mul_inv_cancel_left]
    rw [e, map_mul, Module.End.mul_apply, e', map_smul, hact, smul_smul]

