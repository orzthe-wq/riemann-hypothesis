    rw [← Finset.prod_pow_eq_pow_sum, map_prod]
    refine Finset.prod_congr rfl fun y _ => ?_
    beta_reduce
    split_ifs <;> simp
  rw [h1, ← monomial_eq, algebraMap_eq, C_mul_monomial]

theorem lowDeg_le {d a : ℕ} (s : Var ι d a →₀ ℕ) : lowDeg s ≤ s.sum fun _ e => e := by
