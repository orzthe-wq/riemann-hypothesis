def lowDeg {d a : ℕ} (s : Var ι d a →₀ ℕ) : ℕ := s.sum fun y e => if (y.2.1 : ℕ) < a then 0 else e

theorem rowSub_lowScal_monomial {d a : ℕ} (t : ℂ) (s : Var ι d a →₀ ℕ) (c : ℂ) :
