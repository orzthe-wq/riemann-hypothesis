    intro a b e
    have e1 : ρ0 a.1 = ρ0 b.1 := Units.ext e
    have e2 : ι a.1 = ι b.1 := (MonoidHom.ofInjective hφ).symm.injective e1
    exact Subtype.ext (hι e2)
  exact card_dvd_of_inj ρ hρ

