      rw [List.map_map, List.map_reverse, List.map_reverse, List.map_ofFn, List.map_ofFn]
      congr 1
      congr 1
      funext a
      simp only [Function.comp_apply, ← map_neg, neg_neg]
      simpa only [E, neg_neg] using congrArg (derEnd hθ τ) (hs (idx a) (idx (a + 1)))
