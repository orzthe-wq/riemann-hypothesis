    (h : IsCuspListed θ (.grid D.R.m j) (liftA Wl M (.down t D.R.m j) Φ F)) :
    IsCuspListed θ (.grid D.R.m j) ((stepAt G Wl t hM j hj dV dW).lift F Φ) := h

