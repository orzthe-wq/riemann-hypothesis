theorem exists_irreducible_subrepresentation_bis (hρ : IsUnitaryRep ρ) {a Q : H →L[ℂ] H}
    (ha : ∀ S : H →L[ℂ] H, (∀ g, S * ρ g = ρ g * S) → S * a = a * S) (hQ : ∀ g, Q * ρ g = ρ g * Q)
