theorem exists_irred_of_finiteDimensional (hρ : IsUnitaryRep ρ) {W E : Submodule ℂ H} (hW : IsSubrep ρ W)
    (hE : FiniteDimensional ℂ E)
    (hS : ∀ (Y : Submodule ℂ H) [Y.HasOrthogonalProjection], IsSubrep ρ Y → Y ≤ W →
