    (hlim : Tendsto (fun t : ℝ => t⁻¹ • (c t - f)) (𝓝[≠] 0) (𝓝 g)) :
    ∀ x, HasDerivAt (fun t => T t (tens (evI F) ⇑f r) x) (tens (evI F) ⇑g r x) 0 := by
