    funext t; rw [hc t]
  rw [e, hasDerivAt_iff_tendsto_slope]
  refine ((((ev _).tendsto g).comp hlim).mul_const (r x)).congr' (Filter.Eventually.of_forall fun t => ?_)
  simp only [Function.comp_apply, tens]
  rw [slope_def_module, hc0]
