  have hPB : ParBoundW D := GlobalTheory.T.theta_chain_occurring_params_norm_half_rank_bound hCRD D hLF
  have hLL : LevelLaw D := GlobalTheory.T.thetaLiftChain_fockVector_levelLaws D
