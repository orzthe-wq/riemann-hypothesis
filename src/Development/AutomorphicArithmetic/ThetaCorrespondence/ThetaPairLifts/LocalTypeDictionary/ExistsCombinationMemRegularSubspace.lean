  have h1 : ∀ k, IsDatum Γ.M' ψ cB (om' (GlobalTheory.IndefiniteRowSideFullHecke.UnitaryConjugation.conjU W₁ (-1) hO.JW₁ k, 1) Φ) (ωB (k, 1) f) := fun k => by
