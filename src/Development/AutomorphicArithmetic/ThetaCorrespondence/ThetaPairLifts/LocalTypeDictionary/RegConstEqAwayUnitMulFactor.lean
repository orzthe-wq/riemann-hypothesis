theorem exists_factors (hL : L.Is μ₀) (i j : Fin D.R.m) (t : T) {M M₀ : Vol G} (hM : M.Is t) (hM₀ : M₀.Is μ₀) :
    ∃ n : Pl D.host.E → ℕ, M.ν (.grid i j) = ((∏ w ∈ L.Q t, n w : ℕ) : ℝ≥0∞) • M₀.ν (.grid i j) ∧
