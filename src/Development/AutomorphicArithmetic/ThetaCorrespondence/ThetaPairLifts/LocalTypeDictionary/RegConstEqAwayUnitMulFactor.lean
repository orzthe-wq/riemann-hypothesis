    M.ν X = (K₁.relIndex K₀ : ℝ≥0∞) • M₀.ν X := by
  obtain ⟨i1, i2, i3, i4, i5, -⟩ := GlobalTheory.Mem.AdelicGroupTop.adelic_unitary_topology D (G.V X)
  unfold GlobalTheory.FunObj.Vol.IsAt at h₁ h₀
