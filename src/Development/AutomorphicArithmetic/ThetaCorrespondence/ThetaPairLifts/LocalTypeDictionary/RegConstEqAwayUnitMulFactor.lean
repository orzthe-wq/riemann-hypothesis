    rw [(depthAt_of_notMem G hw').1, pow_zero, GivenAdm.mem_glLatCong]
    refine and_iff_left_of_imp fun hg a b => ?_
    have := ((GlobalTheory.SplitFlip.mem_KO_iff g).1 hg).1 a b
