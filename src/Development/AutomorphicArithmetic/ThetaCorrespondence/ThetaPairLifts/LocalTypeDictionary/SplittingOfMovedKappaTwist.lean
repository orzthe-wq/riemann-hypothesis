  obtain ⟨ΛS', hΛS', hSd'⟩ := GlobalTheory.MovedDict.isSelfDualC_inV S frS hS Ls' hLs'
  obtain ⟨ΛT', hΛT', hTd'⟩ := GlobalTheory.MovedDict.isSelfDualC_inV T frT hT Lt' hLt'
  rw [← hΛS, ← hΛT] at hf d1 hmove
  rw [← hΛS', ← hΛT'] at d2 hmove
