  { std := h.std,
    hecS := h.hecS,
    hecT := h.hecT,
    resS := h.resS,
    resT := h.resT,
    om_pres := fun p f hf => (thetaFunO_stdLatSp hV).2 (h.om_pres p f ((thetaFunO_stdLatSp hV).1 hf)),
