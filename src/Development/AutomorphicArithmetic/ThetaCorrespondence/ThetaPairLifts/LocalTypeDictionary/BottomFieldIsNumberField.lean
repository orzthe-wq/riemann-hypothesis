      fun y => by rw [hz₁, AddChar.map_zero_eq_one],
      fun y => by rw [hz₂, AddChar.map_zero_eq_one]⟩

  obtain ⟨h1, k, hk, h2, h3⟩ := hSB
  have hmem := mem_algSpan (χ := fun x y : WO S WW => ψ (symplO S WW x y)) (X := half S WW e)
