def sgA (A : Fr M) (τ : D.what₂.Tau) : Fin M.rank → Bool := (frSgn false A).ε τ

theorem comp_quad (A : Fr M) (B : Fr X) (eT : D.what₂.Tau → ℚ) (τ : D.what₂.Tau) {N : Type} [AddCommGroup N] [Module ℂ N]
