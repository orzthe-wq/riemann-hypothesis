    w ∈ ⨅ h : P, LinearMap.ker (gW (h : G) - σ ((ψ h : Kˣ) : K) • LinearMap.id) := by
  rw [Submodule.mem_iInf]
  intro h
  rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply, LinearMap.id_apply, sub_eq_zero]
