theorem evC_single {D : D7} (V : HSp D) (P : Pl D.host.E) (a : List ℤ → ℂ) (d : List ℤ) :
    GlobalTheory.Hk3.evC V P a (Finsupp.single d 1) = if IsLab V P d then a d else 0 := by
  unfold GlobalTheory.Hk3.evC
  rw [Finsupp.sum_single_index]
  · split_ifs <;> simp
