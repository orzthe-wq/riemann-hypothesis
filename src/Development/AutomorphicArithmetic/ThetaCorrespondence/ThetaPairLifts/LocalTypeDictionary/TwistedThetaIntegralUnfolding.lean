    exact ⟨I1, I2⟩
  have ev : ∀ k, 2 * k + 2 ≤ D.R.m → Inv (2 * k) := by
    intro k
    induction k with
    | zero =>
      intro _
      show Inv 0
      obtain ⟨e', he', hs, -⟩ := hb.1
      rw [hInv, h0]
      exact ⟨1, one_mem _, one_mem _, (b 0)⁻¹, inv_mem (grpOff_of_suppAt he' hSf hs), 1,
        ⟨one_mem _, fun y _ => by rw [mt_one, Matrix.one_mulVec]⟩, by rw [mul_one]⟩
    | succ k ih =>
      intro hk
