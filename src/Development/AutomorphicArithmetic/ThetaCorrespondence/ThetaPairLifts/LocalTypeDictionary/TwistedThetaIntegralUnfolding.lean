theorem offAt_of_shape (hS : ShapeAt ch) (hB : ∀ t, ∃ b, IsBase t ch.S.B b) : OffAt ch := by
  classical
  intro t Φ τ hτ M hM d hd P h h0 hne
  obtain ⟨N, N₀, LL, LZ, hmv, -, -, hsh⟩ := hS
  obtain ⟨b, hb⟩ := hB t
