      (sdN (j + 1) (by omega)) (sdN (j + 1 + 1) (by omega)) (vac (j + 1) (by omega)) I1 c2
    rw [hInv, hInv, rowGrp_jac ch.G (j + 1) ((D.R.m - 4 - j) / 2 + 1) (by omega),
