  replace hsh := hsh t M hM
  obtain ⟨e, he, φ, hφ, -⟩ := hτ
  obtain ⟨Sf, hSf⟩ : ∃ Sf : Finset (GlobalTheory.FinPl.Pl D), ∀ v, v ∉ Sf ↔ ∀ w ∈ locPl ch.G t, w.under (𝓞 D.host.F) ≠ v :=
    ⟨(locPl ch.G t).image fun w => w.under (𝓞 D.host.F), fun v => by simp⟩
