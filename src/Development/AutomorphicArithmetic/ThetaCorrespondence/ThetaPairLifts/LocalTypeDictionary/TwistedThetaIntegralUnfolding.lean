    · rw [hk]
      exact (step _ (even_two_mul k) (by omega) (ev k (by omega))).1
  obtain ⟨δ, hδ, hbf, a', ha', ea⟩ := hb.2.1 j hj
  obtain ⟨r, hr, a, ha, x, hx, k, hk, hkl, eq⟩ := cell_of_inBig he hSf (sdN j (by omega)) hbf (hmv j hjm) ((hInv j).1 hI)
