    unfold thIn
    have e1 : ∀ h₀, thetaKO (R.ωP i (t0 Y)) h₀ g₀
        (valAct1 (RefTheta.omStd Ad i (t0 Y)) (h, g) φ (RefTheta.fV Ad i Fm' h₀)) =
        thetaKO (R.ωP i (t0 Y)) (h₀ * (Ad.PV i).ψ h) (g₀ * (Y.PW i).ψ g)
