theorem eq_conj_of_conj_eq (a b x y : G) (e : a * y * a⁻¹ = b * x * b⁻¹) : y = a⁻¹ * b * x * (a⁻¹ * b)⁻¹ :=
  (conj_of_conj_eq a b x y e.symm).symm

