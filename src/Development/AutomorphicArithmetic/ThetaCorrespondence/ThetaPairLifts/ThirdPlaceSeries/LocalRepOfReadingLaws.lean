      rintro _ ⟨x, ⟨u, hu, u', hu', rfl⟩, rfl⟩
      refine ⟨(u : GAf L n ⧸ GlobalTheory.IsotOrth.congSub L n (N * M)), ⟨u, (show NG.Cong L n N u from hu).1, rfl⟩, ?_⟩
