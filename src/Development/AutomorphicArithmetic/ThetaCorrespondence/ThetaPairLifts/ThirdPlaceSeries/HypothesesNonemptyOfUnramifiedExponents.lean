theorem exists_good_alt (hCen : ∀ (D : D7) (_ : PairedCharacterCondition.Pend D), GlobalTheory.Pass.CentralElt D) {D : D7} {nch : NChoice D} (hP : _root_.UpperTheory.GalC.GaloisPreconditions D nch)
