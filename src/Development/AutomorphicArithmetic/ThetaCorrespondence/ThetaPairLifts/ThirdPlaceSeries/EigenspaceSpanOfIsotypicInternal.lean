theorem exists_intertwiner {V : HSp D} {S : D.what₂.Tau → SPar} (h1 : 1 ≤ V.rank)
    (hS : ∀ τ, Gapped (S τ) (16 * (V.rank : ℚ) ^ 19)) (M M' : DSModel V S) :
    ∃ U : ∀ τ, M'.H τ ≃ₗᵢ[ℂ] M.H τ,
