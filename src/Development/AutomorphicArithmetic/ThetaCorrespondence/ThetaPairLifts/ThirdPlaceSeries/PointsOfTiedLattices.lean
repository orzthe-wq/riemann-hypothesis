  rcases hB r t χ π v hχ ht hv hvb with ⟨π₁, π₂, hsph, e⟩ | ⟨s, d, σ, hsupp, hcard⟩
  · have hg : GoodI π₂ := GlobalTheory.AVGood.good_of_isSpherical _root_.GlobalTheory.CompanionTheory.Published.bernsteinZelevinskyFiniteness _
