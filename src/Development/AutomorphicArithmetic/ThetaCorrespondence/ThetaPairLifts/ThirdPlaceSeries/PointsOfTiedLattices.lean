theorem charPol_unr_twist' {rc : ∀ n, Irr k n → WD h} (hrc : _root_.UpperTheory.One.M.RecLawsH rc) {χ : kˣ →* ℂˣ} (hχ : IsSmoothChar χ)
    (σ : Ine (F := E) B) (c : ℂ) (hc : (rc 1 (detIrr 1 χ hχ)).charPol (ineIncl h σ) = X - C c)
