theorem g_io : ∀ (K : Type) [Field K] [NumberField K] (l : ℕ) [Fact l.Prime] (e0 : K →+* PadicAlgCl l) (σ : K →+* ℂ),
    ∃ io : PadicAlgCl l ≃+* ℂ, ∀ x, io (e0 x) = σ x := by
