theorem lhs_smul {i : D.nd.Loc} (s : Sec D i) (r : D.nd.O i) (f : Module.End (D.nd.O i) (D.nd.Mt i))
    (w : TensorProduct (D.nd.O i) (KK D.nd i) (D.nd.Mt i)) :
