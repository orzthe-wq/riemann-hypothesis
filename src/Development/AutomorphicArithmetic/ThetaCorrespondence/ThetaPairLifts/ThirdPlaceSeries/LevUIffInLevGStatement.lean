    ((mt V κ).map p.pr) r s ∈ 𝒪[k] ∧ (r.1 + 1 = V.rank →
      valuation k (((mt V κ).map p.pr) r s - (1 : Matrix (Fin V.rank) (Fin V.rank) k) r s) < 1) := by
