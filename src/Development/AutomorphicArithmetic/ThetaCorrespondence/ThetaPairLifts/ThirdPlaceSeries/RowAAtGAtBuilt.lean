  have hϖ0 : ϖ ≠ 0 := left_ne_zero_of_mul (by rw [hctx.2.2.2.2.2.1]; exact_mod_cast hp.ne_zero)
  have hsub : divs ϖ ⊆ S := fun P hP => hctx.2.2.2.2.2.2.2 P ((mem_divs hϖ0 P).1 hP)
  have hM := Nat.mul_pos hA hB
