    by_cases h0 : Ξ x = 0
    · simp [h0]
    rw [mul_left_comm, map_mul]
    refine mul_le_one' (h1 x) (hb c' x hc0 hc' ((mem_divLat _ _ _).2 fun P hP => ?_))
    by_cases hP' : P ∈ divs ϖ
