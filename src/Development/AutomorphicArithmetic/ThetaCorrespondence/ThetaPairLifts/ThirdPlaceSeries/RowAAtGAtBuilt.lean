  have hc0 : 0 < c' := Nat.pos_of_ne_zero fun h => hc' (h ▸ dvd_zero p)
  have hpn : ∀ P ∈ S \ divs ϖ, ((p ^ n : ℕ) : 𝓞 X.E) ∉ P.asIdeal := fun P hP h => by
    rw [Finset.mem_sdiff, mem_divs hϖ0] at hP
    rw [Nat.cast_pow] at h
