    (hΞ : GlobalTheory.ColPeriod.DatumAt (divs ϖ) S p cB w N N' Ξ) {m : DVar X.Tau a b →₀ ℕ}
    (hrat : ∀ c : ℕ, 0 < c → c ∣ cA * cB → m ∈ RatIdx A S cA c N N' Ξ)
