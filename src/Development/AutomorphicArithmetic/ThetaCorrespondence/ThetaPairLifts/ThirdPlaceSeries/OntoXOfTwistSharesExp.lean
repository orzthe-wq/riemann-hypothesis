    (fun j hj n => (hdd j hj n).2.1)
  refine ⟨dd, ⟨⟨C, G, nab, dd⟩, cE, chiW, x₀, iota, xi, P.asIdeal.map (algebraMap (𝓞 D.host.K) (𝓞 D.host.E))⟩,
