    (GeneratorPullback.powGen U.LG.L _ _ (LB.pullGen U.LG.L _ _ τ (spMap (jetCoef (algebraMap V F) κ m))) q)
    (powGen_isGen_of_isGen _ (pullGen_isGen _ _ _ _ hτ _) q) (fun W _ h => by simp only [a₂, _root_.mul_one])
