  set_option synthInstance.maxHeartbeats 100000 in
    simpa only [hL_apply] using map_sum (hL X.B.I p) v Finset.univ

theorem core (u : D.what₂.Word) (m : X.B.I.Gf) (hmK : m ∈ X.B.I.Kset) (hmN : m ∈ X.NfinU u) (c : ℕ)
