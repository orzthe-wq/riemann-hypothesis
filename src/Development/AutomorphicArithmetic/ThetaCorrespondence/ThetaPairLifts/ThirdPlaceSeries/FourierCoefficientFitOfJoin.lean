theorem ramifiedPlaces_sum_log_absNorm_le {D : D7} {T : Type} {Lc : Formalism.IndefR.Links.LevCh D T} (P : GlobalTheory.ChiGrid.Places Lc) (s : Formalism.BasicNotions.Scale)
