    rw [e1]
    linarith
  · unfold LeafCS FunData.cS
    have e1 : ∑ q ∈ O.S0, (O.cc q : ℝ) * Real.log (O.qq q) ≤ 2 * ∑ q ∈ O.S0, Real.log (O.qq q) := by
      rw [Finset.mul_sum]
