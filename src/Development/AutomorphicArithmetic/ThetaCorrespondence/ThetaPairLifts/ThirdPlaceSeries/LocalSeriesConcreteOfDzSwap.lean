    rw [map_one] at h
    exact h.symm
  · have h := eq_unitOf hχ hp (a * b) (unitOf hp a * unitOf hp b) (by
      have := (red_eq_iff_val hp (((a : ZMod p).val : ℕ) * ((b : ZMod p).val : ℕ) : 𝒪[F]) ((a * b : (ZMod p)ˣ) : ZMod p)).1
