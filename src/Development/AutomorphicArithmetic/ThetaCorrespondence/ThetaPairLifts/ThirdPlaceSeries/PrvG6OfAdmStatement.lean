  refine ⟨O, inferInstance, inferInstance, _root_.GlobalTheory.AlgClosedResidueField.isAlgClosed_residueField O, algebraMap O (Qbar l), fun a b h => Subtype.ext h,
    ?_, fun x => mem_maximalIdeal_unitBall x, ?_⟩
  · ext x
