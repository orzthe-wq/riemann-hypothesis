      ∃ S ∈ ((L.shift (fun _ => t) (fun _ => rfl)).pow τ).smallSec, R S = h := by
  have hr := isRatSec_ratOfSec s₀ hs₀
  have hrτ := GlobalTheory.TrueGeo.SmallSec.isRatSec_pow hr τ
