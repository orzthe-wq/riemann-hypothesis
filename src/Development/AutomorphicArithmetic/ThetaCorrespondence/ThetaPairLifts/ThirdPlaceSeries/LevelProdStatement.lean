  have h2 := GlobalTheory.LocMod.PinInhab.map_mt_eq_one_of_off q (P := (· = q.v)) rfl h0
  have h3 : GlobalTheory.LevIdx.locHom q V F (cutG V _ (one_sub_idemQ_mul_self {q.v}) g) = 1 := by
    symm
    rw [← GlobalTheory.LevIdx.eq_locHom_iff, h2]
