    obtain ⟨hEE, hEU⟩ := transv i j hij hj
    obtain ⟨x, g, hg, hχ⟩ := hgen i j hij hj
    obtain ⟨P, hPdef⟩ : ∃ P, P = b.val * single i j (1 : K) * b⁻¹.val := ⟨_, rfl⟩
