    have hdU := hU' (diagUnit f hf0) (fun a e he hea => by
      rw [diagUnit_val]
      by_cases hae : a = e
      · subst hae; rw [diagonal_apply_eq, one_apply_eq, hflow a he]
      · rw [diagonal_apply_ne _ hae, one_apply_ne hae])

