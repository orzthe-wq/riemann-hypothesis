                Matrix.smul_mul, hPdef]
    have hPQ : P * Q = 0 := by
      calc P * Q = b.val * single i j (1 : K) * (b⁻¹.val * b.val) * single i k 1 := by
              simp only [hQdef, hPdef, Matrix.mul_assoc]
