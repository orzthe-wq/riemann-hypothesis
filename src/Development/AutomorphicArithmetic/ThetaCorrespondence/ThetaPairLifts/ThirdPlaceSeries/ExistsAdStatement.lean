    intro g g' h; congr 1; exact Subtype.ext (Units.ext h)
  have transv : ∀ i j : Fin (r + t), i.val + 1 = j.val → j.val < r →
      single i j (1 : K) * single i j 1 = 0 ∧
      ∀ y : K, ∀ a e : Fin (r + t), e.val < r → e.val ≤ a.val →
