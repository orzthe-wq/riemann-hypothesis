variable {K : Type} [Field K]

theorem normRev_prod {α : Type} (s : Finset α) (P : α → K[X]) :
    C ((∏ c ∈ s, P c).coeff 0)⁻¹ * (∏ c ∈ s, P c).reverse = ∏ c ∈ s, C ((P c).coeff 0)⁻¹ * (P c).reverse := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [reverse]
  | insert a s ha ih =>
