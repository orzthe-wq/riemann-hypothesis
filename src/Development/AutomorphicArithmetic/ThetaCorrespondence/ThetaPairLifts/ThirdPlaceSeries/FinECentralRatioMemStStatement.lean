  have hc := Subgroup.mem_center_iff.1 hz (ratEmb D.sp.cm.sig V.gram γ)
  have h1 := congrArg (fun x => (matHom _ D.sp.cm.sig V.gram (proj D.sp.cm.sig V.gram v x)).val) hc
  simp only [map_mul, proj_ratEmb, Units.val_mul] at h1
