theorem sc_even {k : Type} [Field k] (sc : ℕ → k) (x : k) (h : ∀ j, sc (j + 1 + 1) = sc j * x) (n : ℕ) :
    sc (2 * n) = sc 0 * x ^ n := by
  induction n with
  | zero => simp
  | succ n ih => rw [show 2 * (n + 1) = 2 * n + 1 + 1 by ring, h, ih]; ring

