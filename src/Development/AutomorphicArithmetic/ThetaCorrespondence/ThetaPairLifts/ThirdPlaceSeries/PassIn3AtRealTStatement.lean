def proj (τ : Representation ℂ G V) (A : Subgroup G) [Fintype A] (χ : G → ℂ) : V →ₗ[ℂ] V :=
  ∑ a : A, χ (a : G)⁻¹ • τ a

theorem proj_apply (τ : Representation ℂ G V) (A : Subgroup G) [Fintype A] (χ : G → ℂ) (v : V) :
