theorem edgeSum_conj {ρ k : ℕ} (h : ρ + k < r) {g g' : GL (Fin r) F}
    (e : ∀ i j, (g' : Matrix (Fin r) (Fin r) F) i j = (g : Matrix (Fin r) (Fin r) F) (cyc ρ k h i) (cyc ρ k h j)) :
