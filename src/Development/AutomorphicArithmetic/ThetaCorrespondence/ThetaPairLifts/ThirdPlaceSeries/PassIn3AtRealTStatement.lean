      rw [cyc_val] at a1 a2 a3
      refine h2 i j ?_
      split_ifs at a1 a2 a3 <;> omega
  · rintro ⟨⟨h1, h2⟩, h3⟩
    refine ⟨⟨fun i => h1 _, fun i j hij => ?_⟩, fun i j a1 a2 a3 => ?_⟩
