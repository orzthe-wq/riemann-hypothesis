      ∀ i j : Fin r, j.val < i.val → (g : Matrix (Fin r) (Fin r) F) i j = 0 :=
  ⟨fun h => ⟨h.2, fun _ _ e => h.1 e⟩, fun h => ⟨fun i j e => h.2 i j e, h.1⟩⟩

