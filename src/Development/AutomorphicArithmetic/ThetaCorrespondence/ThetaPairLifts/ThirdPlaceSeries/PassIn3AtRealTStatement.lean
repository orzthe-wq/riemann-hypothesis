    (hS : ∀ g, g ∈ T ↔ w⁻¹ * g * w ∈ S) (hχ : ∀ g, χ (w⁻¹ * g * w) = χ' g) :
    finrank ℂ (eig τ S χ) = finrank ℂ (eig τ T χ') := by
