    ext v
    simp only [Submodule.mem_map, _root_.GlobalTheory.FinGL.Mir.mem_eig]
    constructor
    · rintro ⟨w, hw, rfl⟩ g hg
      obtain ⟨h, hh⟩ := (hT g).1 hg
      refine (key ⟨g, h⟩ _ hh).1 ?_
      have := congrArg Subtype.val (hw _ hh)
