theorem edgeSum_single (Ed : Fin r → Fin r → Prop) [DecidableRel Ed] (g : GL (Fin r) F) {p q : Fin r} (h : Ed p q)
    (h0 : ∀ i j, Ed i j → (i ≠ p ∨ j ≠ q) → (g : Matrix (Fin r) (Fin r) F) i j = 0) :
    edgeSum Ed g = (g : Matrix (Fin r) (Fin r) F) p q := by
