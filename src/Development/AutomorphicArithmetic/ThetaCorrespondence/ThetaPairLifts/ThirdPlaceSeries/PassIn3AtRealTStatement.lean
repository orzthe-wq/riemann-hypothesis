  rw [Finset.sum_eq_single p, Finset.sum_eq_single q, if_pos h]
  · intro j _ hj
    split_ifs with e
    · exact h0 _ _ e (Or.inr hj)
    · rfl
  · simp
  · intro i _ hi
    refine Finset.sum_eq_zero fun j _ => ?_
    split_ifs with e
    · exact h0 _ _ e (Or.inl hi)
    · rfl
  · simp

theorem mem_unip_iff (g : GL (Fin r) F) : g ∈ unip F r ↔
