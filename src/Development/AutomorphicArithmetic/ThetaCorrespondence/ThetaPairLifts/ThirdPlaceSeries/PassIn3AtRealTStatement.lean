  let π : Representation ℂ P M :=
    { toFun := fun p => σM (s p)
      map_one' := by rw [hker (s 1) 1 (by rw [hs 1, map_one]), map_one]
      map_mul' := fun x y => by
        rw [← map_mul]; exact hker _ _ (by rw [map_mul, hs x, hs y, hs (x * y)]) }
