        push_cast
        exact h
      obtain ⟨k, hk⟩ := ENat.ne_top_iff_exists.mp (ne_top_of_le_ne_top (ENat.coe_ne_top _) h')
      rw [← hk] at h'
      rw [← hk, ← hc, ← he]
      simp only [ENat.toNat_coe]
      have := ENat.coe_le_coe.mp h'
      exact_mod_cast this
  rw [mul_div_assoc', ← add_div]
  gcongr

