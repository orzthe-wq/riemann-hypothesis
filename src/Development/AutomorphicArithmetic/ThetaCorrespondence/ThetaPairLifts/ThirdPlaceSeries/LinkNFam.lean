    refine Submodule.mem_inf.mpr ⟨?_, ?_⟩
    · rw [hAu]
      exact LinearMap.mem_range.mpr ⟨α m0, rfl⟩
    · show A • (u : FractionRing O ⊗[O] M) ∈ ⨆ x ∈ (Z : Set X), heckeEig T act x
      rw [← algebraMap_smul (FractionRing O)]
      exact Submodule.smul_mem _ _ hu1
