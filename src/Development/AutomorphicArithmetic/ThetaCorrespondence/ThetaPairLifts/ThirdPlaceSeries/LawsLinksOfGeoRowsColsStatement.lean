    {κ : Type} (yc : κ → Formalism.UG.UPts (sigD D) (gramP D) (FiniteAdeleRing (𝓞 D.host.F) D.host.F)) (z : κ → FrP D → ℂ)
    (hz : z ∈ FiC S (Formalism.L2.Forms.embT D) lam yc) (c : κ) : z c ∈ ValC (gramC (gramP D) (Formalism.L2.Forms.embT D)) lam := by
