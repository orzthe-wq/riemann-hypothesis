  obtain ⟨m₁, h₁⟩ := inCoefLat_pow' R i hβ hsupp ha
  obtain ⟨m₂, h₂⟩ := inCoefLat_pow' R i hβ (GlobalTheory.SplitLinear.suppAt_inv hsupp) ha
  refine ⟨max m₁ m₂, fun h _ y => ⟨fun hy => h₁ (max m₁ m₂) (le_max_left m₁ m₂) h y hy, fun hy => ?_⟩⟩
