  have hmod : p ^ n.totient % n = 1 % n := Nat.ModEq.pow_totient hcop.symm
  rw [pow_eq_pow_mod _ h1, hmod, ← pow_eq_pow_mod _ h1, pow_one]

theorem frob_periodic {K : Type*} [Field K] {p : ℕ} (hp : p.Prime) {x : K}
