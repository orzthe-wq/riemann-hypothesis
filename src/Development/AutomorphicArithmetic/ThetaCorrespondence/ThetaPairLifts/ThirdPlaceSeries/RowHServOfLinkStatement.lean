  rw [add_neg_cancel, zero_pow (pow_ne_zero _ hp.ne_zero)] at h
  exact (neg_eq_of_add_eq_zero_right h.symm).symm

def mu (K : Type*) [Field K] (p : ℕ) : Set K := {ζ | ∃ n, 0 < n ∧ n.Coprime p ∧ ζ ^ n = 1}

