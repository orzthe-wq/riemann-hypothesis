theorem mem_domSpan_iff_of_closed {E : Type} [Field E] [NumberField E] [IsCMField E] {r : ℕ} (X : Data E r)
    (A : Set (Frame X.Ψ r → ℂ)) (h0 : 0 ∈ A) (hadd : ∀ P ∈ A, ∀ Q ∈ A, P + Q ∈ A)
