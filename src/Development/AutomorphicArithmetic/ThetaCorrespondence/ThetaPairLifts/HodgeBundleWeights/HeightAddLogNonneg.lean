    · exact fin_bound hN hF f.2 hv hα h ((mul_add _ _ _).symm.trans_le (h2 la p (hfin.mem_toFinset.2 hp)))
  · intro σ hσ y hy
    show ENNReal.ofReal (homN (U σ) x _ (α • (θ ^ k * (f : Rul Xo c))) _) ^ 2 ≤ _
