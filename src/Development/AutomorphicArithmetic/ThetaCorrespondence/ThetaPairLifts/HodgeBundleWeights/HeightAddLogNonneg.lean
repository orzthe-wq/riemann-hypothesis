  by_cases ht : v f = ⊤
  · rw [hV.smul _ _ hα, hV.mul, ht, EReal.add_top_of_ne_bot (hV.ne_bot _),
      EReal.add_top_of_ne_bot (EReal.coe_ne_bot _)]
    exact le_top
