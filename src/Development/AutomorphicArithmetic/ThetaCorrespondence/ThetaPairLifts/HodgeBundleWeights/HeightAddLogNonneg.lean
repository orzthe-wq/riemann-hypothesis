    _ = _ := by
        rw [mul_pow, ← pow_mul, ← mul_assoc, ← ENNReal.ofReal_pow (Real.exp_pos _).le,
          ← ENNReal.ofReal_pow (Real.exp_pos _).le, ← ENNReal.ofReal_mul (by positivity), ← Real.exp_nat_mul,
          ← Real.exp_nat_mul, ← Real.exp_add]
        congr 3
        push_cast
        ring

