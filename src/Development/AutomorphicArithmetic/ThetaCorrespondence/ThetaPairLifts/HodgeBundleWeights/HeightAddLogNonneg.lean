    have h5 := mul_left_cancel₀ (pow_ne_zero k hθ) (smul_right_injective _ hα h4)
    exact Subtype.ext (sub_eq_zero.1 (eq_zero_of_genVal (sub_mem f.2 g.2) (by rw [map_sub, h5, sub_self])))

