    {la : HeightOneSpectrum (𝓞 c.F)} {v : Rul Xo c → EReal} (hv : v ∈ (recVals Xo c).1 la) {k : ℕ} {α : c.F}
    (hα : α ≠ 0) {b : ℝ} (hb : ((-b : ℝ) : EReal) ≤ v f) (ha : ((8 * k : ℕ) : ℝ) * e la + b ≤ vLa la α) :
    ((8 * k : ℕ) : EReal) * depthOn U Z G v ≤ v (α • (θ ^ k * f)) := by
