  classical
  have hG : GenFrEx Xo c := (Reg.genFrEx_and_genFromTest E H Dw l Xo c).1
  have hFZ : ∀ Z : Comp Xo c, genVal Z F ≠ 0 := by
    intro Z h0
    obtain ⟨y, hy, hne⟩ := hZ Z
