  have hb : Function.Bijective (Cartier.fnOf (X := Sp Ω) ⊤ trivial) := by
    refine ⟨fnOf_injective _ _, fun a => ?_⟩
    obtain ⟨U, hU, s, hs⟩ := (Sp Ω).presheaf.germ_exist (x := η) a
    obtain rfl : U = ⊤ := top_unique fun x _ => (Subsingleton.elim η x) ▸ hU
