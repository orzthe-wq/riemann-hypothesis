theorem etaleNeighborhoods_equalize_parallel_maps : LateralTheory.EWeil.AbsorbPf.Coeq := by
  intro A B C Ω _ ι gB gC hB hC φB φC hφB hφC u v hu hv hφu hφv
  letI := gB.hom.toAlgebra
  letI := gC.hom.toAlgebra
