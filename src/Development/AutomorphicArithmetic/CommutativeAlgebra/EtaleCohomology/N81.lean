  map {j k} f := Under.homMk (F.map f) (by simpa using (t.naturality f).symm)
  map_id j := by ext; simp
  map_comp f g := by ext; simp

@[simps]
def cone {D O : CommRingCat.{0}} (o : D ⟶ O) {J : Type} [SmallCategory J] (F : J ⥤ CommRingCat.{0})
