  · intro C D E Z c f g u v hpo _ hf hg
    have hv : AlgRes v := p3 f g u v hpo (p2 c f hf)
    have := p1 (c ≫ g) v hg hv
    rw [hpo.w, ← Category.assoc]; exact this
  · intro C D c f hc hf
    exact p1 c f hc (p4 f hf)
