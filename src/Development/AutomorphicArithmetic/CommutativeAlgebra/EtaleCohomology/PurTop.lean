      AlgebraicTopology.alternatingFaceMapComplex C ⋙ HomologicalComplex.eval C _ n :=
    NatIso.ofComponents (fun X => Iso.refl _) (fun {X Y} f => (Category.comp_id _).trans (Category.id_comp _).symm)
