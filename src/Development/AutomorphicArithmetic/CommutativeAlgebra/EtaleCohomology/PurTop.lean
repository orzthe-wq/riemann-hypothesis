    Function.Bijective (Ideal.quotientMap K φ h) := by
  subst e; subst hK; exact hb

theorem LeafLocIso_of (hZ : LeafZ) (hQ : LeafQuot) : LeafLocIso := by
  intro H d P V h
  have := P.cl
  set A := Γ(P.X, V.1)
