private theorem root_dvd (D : Datum p) {r : ℤ} {w : Ideal (𝓞 D.F)} (hw : w ≠ ⊤) (hu : uIdeal D r ≤ w) :
    (p : ℤ) ∣ r ^ 2 - D.tr * r + D.nm := by
