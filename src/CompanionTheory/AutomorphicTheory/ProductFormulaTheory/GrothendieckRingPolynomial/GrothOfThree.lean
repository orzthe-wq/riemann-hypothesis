  have h3 : (jhMult (IrrGL.rep y) π).toNat = (jhMult (IrrGL.rep y) π').toNat := by exact_mod_cast h2
  rw [← ENat.natCast_toNat (jhMult_ne_top y.2.rep.irr hπ), ← ENat.natCast_toNat (jhMult_ne_top y.2.rep.irr hπ'), h3]

