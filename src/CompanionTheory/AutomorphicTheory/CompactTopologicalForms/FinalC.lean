  have h2 : R * o ≤ (R + 1) ^ 4 * (N * n ^ 2) :=
    calc R * o ≤ R * (N * n) := mul_le_mul_of_nonneg_left ho hR
      _ ≤ (R + 1) ^ 4 * (N * n ^ 2) :=
