      (fun s hs f' hf' g hg => (hts _ ht).2.2 s hs f' hf' g (jdc_om_sub_gpos _ hg))
    exact congrArg _ (trJB_congr hpl e fun g hg => hth g (jdc_om_of _ _ hg.1 hg.2))

