theorem kbs_arith (R n N o A : ℝ) (hR : 0 ≤ R) (hn : 1 ≤ n) (hN : 0 ≤ N) (ho : o ≤ N * n)
    (hA : 18 * (R + 1) ^ 4 * (N * n ^ 2 + n ^ 3) ≤ A) : 12 * (R + 1) * n ^ 2 + 6 * R * o + 0 ≤ A := by
