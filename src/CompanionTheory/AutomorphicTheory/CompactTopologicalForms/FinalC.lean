  have h3 : 0 ≤ (R + 1) ^ 4 * n ^ 3 := by positivity
  have h4 : 0 ≤ (R + 1) ^ 4 * (N * n ^ 2) := by positivity
  nlinarith

theorem hatProdJB (hH : HatProdB) (hPoly : JDPolyOK) {Wp Wq : Type} [NormedAddCommGroup Wp] [InnerProductSpace ℂ Wp]
