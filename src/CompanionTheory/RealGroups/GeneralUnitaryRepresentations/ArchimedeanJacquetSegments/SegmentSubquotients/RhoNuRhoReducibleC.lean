    conv_rhs => rw [← QuotientGroup.out_eq' q]
    rfl
  rw [Finset.sum_congr rfl fun q _ => key q]
  exact Fintype.sum_equiv (MulAction.toPerm κ') _ _ (fun q => rfl)

